+	var persisted config.GPTAccountMonitorConfig
+	require.NoError(t, json.Unmarshal([]byte(settings.value), &persisted))
+	require.Equal(t, expected, persisted)
+	require.Equal(t, expected, s.cfg)
+	// Fixed fields do not change the effective configuration or the scan key.
