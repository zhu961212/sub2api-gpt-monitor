+package repository
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/alicebob/miniredis/v2"
+	"github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/require"
+)
+
+func newGPTMonitorTestStore(t *testing.T) (*gptAccountMonitorStore, *miniredis.Miniredis) {
+	t.Helper()
+	mr := miniredis.RunT(t)
+	rdb := redis.NewClient(&redis.Options{Addr: mr.Addr(), MaxRetries: -1})
+	t.Cleanup(func() { _ = rdb.Close() })
+	return NewGPTAccountMonitorStore(rdb).(*gptAccountMonitorStore), mr
+}
+
+func TestGPTMonitorStoreLeaseOwnership(t *testing.T) {
+	s, mr := newGPTMonitorTestStore(t)
+	ctx := context.Background()
+	ok, err := s.Acquire(ctx, "first", time.Minute)
+	require.NoError(t, err)
+	require.True(t, ok)
+	ok, err = s.Acquire(ctx, "second", time.Minute)
+	require.NoError(t, err)
+	require.False(t, ok)
+	ok, err = s.Owns(ctx, "first")
+	require.NoError(t, err)
+	require.True(t, ok)
+	ok, err = s.Owns(ctx, "second")
+	require.NoError(t, err)
+	require.False(t, ok)
+	mr.FastForward(40 * time.Second)
+	ok, err = s.Renew(ctx, "second", time.Minute)
+	require.NoError(t, err)
+	require.False(t, ok)
+	require.Equal(t, 20*time.Second, mr.TTL(gptAccountMonitorLeaseKey))
+	ok, err = s.Renew(ctx, "first", time.Minute)
+	require.NoError(t, err)
+	require.True(t, ok)
+	require.Equal(t, time.Minute, mr.TTL(gptAccountMonitorLeaseKey))
+	require.NoError(t, s.Release(ctx, "second"))
+	require.True(t, mr.Exists(gptAccountMonitorLeaseKey))
+	require.NoError(t, s.Release(ctx, "first"))
+	require.False(t, mr.Exists(gptAccountMonitorLeaseKey))
+}
+
+func TestGPTMonitorStoreLeaseExpiryRejectsLateRenewAndRelease(t *testing.T) {
+	s, mr := newGPTMonitorTestStore(t)
+	ctx := context.Background()
+	ok, err := s.Acquire(ctx, "old", time.Minute)
+	require.NoError(t, err)
+	require.True(t, ok)
+	mr.FastForward(55 * time.Second)
+	ok, err = s.Owns(ctx, "old")
+	require.NoError(t, err)
+	require.False(t, ok, "five seconds remaining is not enough to authorize a scheduling mutation")
+	mr.FastForward(5 * time.Second)
+	ok, err = s.Renew(ctx, "old", time.Minute)
+	require.NoError(t, err)
+	require.False(t, ok, "expired lease must never be recreated by renewal")
+	ok, err = s.Acquire(ctx, "new", time.Minute)
+	require.NoError(t, err)
+	require.True(t, ok)
+	ok, err = s.Renew(ctx, "old", 2*time.Minute)
+	require.NoError(t, err)
+	require.False(t, ok)
+	require.NoError(t, s.Release(ctx, "old"))
+	owner, err := mr.Get(gptAccountMonitorLeaseKey)
+	require.NoError(t, err)
+	require.Equal(t, "new", owner)
+	require.Equal(t, time.Minute, mr.TTL(gptAccountMonitorLeaseKey))
+
+	// A broken non-expiring key does not authorize monitoring or allow renewal.
+	require.NoError(t, mr.Set(gptAccountMonitorLeaseKey, "new"))
+	ok, err = s.Owns(ctx, "new")
+	require.NoError(t, err)
+	require.False(t, ok)
+	ok, err = s.Renew(ctx, "new", time.Minute)
+	require.NoError(t, err)
+	require.False(t, ok)
+}
+
+func TestGPTMonitorStoreNextRunIsConfigurationScopedAndExpires(t *testing.T) {
+	s, mr := newGPTMonitorTestStore(t)
+	ctx := context.Background()
+	next, err := s.NextRun(ctx, "config-a")
+	require.NoError(t, err)
+	require.True(t, next.IsZero())
+	want := time.Date(2026, 10, 13, 10, 30, 0, 0, time.UTC)
+	require.NoError(t, s.SetNextRun(ctx, "config-a", want))
+	next, err = s.NextRun(ctx, "config-a")
+	require.NoError(t, err)
+	require.Equal(t, want, next)
+	next, err = s.NextRun(ctx, "config-b")
+	require.NoError(t, err)
+	require.True(t, next.IsZero())
+	key, err := s.nextRunKey("config-a")
+	require.NoError(t, err)
+	require.Equal(t, 7*24*time.Hour, mr.TTL(key))
+	mr.FastForward(7 * 24 * time.Hour)
+	next, err = s.NextRun(ctx, "config-a")
+	require.NoError(t, err)
+	require.True(t, next.IsZero())
+	for _, corrupt := range []string{"not-a-time", "0", "-1"} {
+		require.NoError(t, mr.Set(key, corrupt))
+		_, err = s.NextRun(ctx, "config-a")
+		require.Error(t, err, "corrupt shared state must fail closed")
+	}
+}
+
+func TestGPTMonitorStoreRejectsInvalidOrUnavailableState(t *testing.T) {
+	s, _ := newGPTMonitorTestStore(t)
+	ctx := context.Background()
+	for _, owner := range []string{"", "  "} {
+		_, err := s.Acquire(ctx, owner, time.Minute)
+		require.Error(t, err)
+		_, err = s.Renew(ctx, owner, time.Minute)
+		require.Error(t, err)
+		_, err = s.Owns(ctx, owner)
+		require.Error(t, err)
+		require.Error(t, s.Release(ctx, owner))
+	}
+	for _, ttl := range []time.Duration{-time.Second, 0, time.Second, 5 * time.Second} {
+		_, err := s.Acquire(ctx, "owner", ttl)
+		require.Error(t, err)
+		_, err = s.Renew(ctx, "owner", ttl)
+		require.Error(t, err)
+	}
+	for _, hash := range []string{"", " hash", strings.Repeat("x", 257)} {
+		_, err := s.NextRun(ctx, hash)
+		require.Error(t, err)
+		require.Error(t, s.SetNextRun(ctx, hash, time.Now()))
+	}
+	require.Error(t, s.SetNextRun(ctx, "valid", time.Time{}))
+	require.NoError(t, s.rdb.Close())
+	ok, err := s.Owns(ctx, "owner")
+	require.Error(t, err)
+	require.False(t, ok)
+	ok, err = s.Acquire(ctx, "owner", time.Minute)
+	require.Error(t, err)
+	require.False(t, ok)
+	_, err = s.NextRun(ctx, "config")
+	require.Error(t, err)
+}
diff --git a/backend/internal/service/gpt_account_monitor_management.go b/backend/internal/service/gpt_account_monitor_management.go
