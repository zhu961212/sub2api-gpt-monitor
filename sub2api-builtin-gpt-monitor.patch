+type gptMonitorRefreshClient struct {
+	OpenAIOAuthClient
+	calls int
+	proxy string
+	err   error
+}
+
+func (c *gptMonitorRefreshClient) RefreshTokenWithClientID(_ context.Context, _, proxy, _ string) (*openai.TokenResponse, error) {
+	c.calls++
+	c.proxy = proxy
+	if c.err != nil {
+		return nil, c.err
+	}
