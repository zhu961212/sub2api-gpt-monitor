+// SetGPTMonitorSchedulableIfMatch changes only the scheduling switch while both
+// the account and the proxy still match the snapshot that was actually probed.
+// Administrator edits, expiry, or a changed proxy invalidate the result.
+func (r *accountRepository) SetGPTMonitorSchedulableIfMatch(ctx context.Context, snapshot *service.Account, schedulable bool) (bool, error) {
+	now := time.Now()
+	if snapshot == nil || snapshot.ID <= 0 || snapshot.Platform != service.PlatformOpenAI ||
+		snapshot.Type != service.AccountTypeOAuth || snapshot.Status != service.StatusActive ||
+		snapshot.ParentAccountID != nil || snapshot.ProxyID == nil || snapshot.Proxy == nil ||
+		snapshot.Proxy.ID != *snapshot.ProxyID || snapshot.Proxy.Status != service.StatusActive ||
+		snapshot.Proxy.IsExpired(now) || (snapshot.ExpiresAt != nil && !snapshot.ExpiresAt.After(now)) {
+		return false, nil
+	}
+	proxy := snapshot.Proxy
+	proxyPredicates := []dbpredicate.Proxy{
+		dbproxy.IDEQ(*snapshot.ProxyID), dbproxy.UpdatedAtEQ(proxy.UpdatedAt),
+		dbproxy.ProtocolEQ(proxy.Protocol), dbproxy.HostEQ(proxy.Host), dbproxy.PortEQ(proxy.Port),
+		dbproxy.DeletedAtIsNil(), dbproxy.StatusEQ(service.StatusActive),
+		dbproxy.Or(dbproxy.ExpiresAtIsNil(), dbproxy.ExpiresAtGT(now)),
+	}
+	if proxy.Username == "" {
+		proxyPredicates = append(proxyPredicates, dbproxy.Or(dbproxy.UsernameEQ(""), dbproxy.UsernameIsNil()))
+	} else {
+		proxyPredicates = append(proxyPredicates, dbproxy.UsernameEQ(proxy.Username))
+	}
+	if proxy.Password == "" {
+		proxyPredicates = append(proxyPredicates, dbproxy.Or(dbproxy.PasswordEQ(""), dbproxy.PasswordIsNil()))
+	} else {
+		proxyPredicates = append(proxyPredicates, dbproxy.PasswordEQ(proxy.Password))
+	}
+	client := clientFromContext(ctx, r.client)
+	var tx *dbent.Tx
+	if dbent.TxFromContext(ctx) == nil {
+		var err error
+		tx, err = client.Tx(ctx)
+		if err != nil {
+			return false, err
+		}
+		defer func() { _ = tx.Rollback() }()
+		client = tx.Client()
+	}
+	count, err := client.Account.Update().Where(
+		dbaccount.IDEQ(snapshot.ID), dbaccount.UpdatedAtEQ(snapshot.UpdatedAt),
+		dbaccount.DeletedAtIsNil(),
+		dbaccount.PlatformEQ(service.PlatformOpenAI), dbaccount.TypeEQ(service.AccountTypeOAuth),
+		dbaccount.StatusEQ(service.StatusActive), dbaccount.ParentAccountIDIsNil(),
+		dbaccount.Or(dbaccount.ExpiresAtIsNil(), dbaccount.ExpiresAtGT(now)),
+		dbaccount.SchedulableEQ(snapshot.Schedulable), dbaccount.ProxyIDEQ(*snapshot.ProxyID),
+		dbaccount.HasProxyWith(proxyPredicates...),
+	).SetSchedulable(schedulable).Save(ctx)
+	if err != nil || count == 0 {
+		return false, err
+	}
+	id := snapshot.ID
+	if err := enqueueSchedulerOutbox(ctx, client, service.SchedulerOutboxEventAccountChanged, &id, nil, nil); err != nil {
+		return false, err
+	}
+	if tx != nil {
+		if err := tx.Commit(); err != nil {
+			return false, err
+		}
+		// The scheduling switch and durable notification commit together. Both
+		// recovery and suspension also refresh the cache immediately after commit.
+		r.syncSchedulerAccountSnapshotDetached(ctx, id)
+	}
+	return true, nil
+}
