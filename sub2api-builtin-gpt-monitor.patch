+		Enabled: true, IntervalSeconds: 600, TimeoutSeconds: 45, Concurrency: 2,
+		Model: "gpt-6-astra", ReasoningEffort: "xhigh", Prompt: "custom prompt",
+		ExpectedGeneration: 18, AccountIDs: []int64{2, 4}, RunOnStart: false,
