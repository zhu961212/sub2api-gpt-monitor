+import { useAppStore } from '@/stores'
+import AppLayout from '@/components/layout/AppLayout.vue'
+import Icon from '@/components/icons/Icon.vue'
+import TotpStepUpDialog from '@/components/auth/TotpStepUpDialog.vue'
+import { useStepUp, isStepUpBlocked, isStepUpCancelled, stepUpBlockReason } from '@/composables/useStepUp'
+
+const { t } = useI18n()
+const tr = (key: string, values: Record<string, string | number> = {}) => t(`admin.gptAccountMonitor.${key}`, values)
+const appStore = useAppStore()
+const stepUp = useStepUp()
+const form = reactive<GPTAccountMonitorConfig>({ enabled: false, interval_seconds: 1800, timeout_seconds: 90, concurrency: 3, model: GPT_ACCOUNT_MONITOR_MODEL, reasoning_effort: GPT_ACCOUNT_MONITOR_REASONING_EFFORT, prompt: '', expected_generation: 17, account_ids: [], run_on_start: true })
+const savedConfig = ref<GPTAccountMonitorConfig | null>(null)
+const scope = ref<'all' | 'selected'>('all')
+const status = ref<GPTAccountMonitorStatus>({ enabled: false, running: false, last_run: null, next_run: null, message: '', total_accounts: 0, accounts: [] })
+const loading = ref(true), loaded = ref(false), saving = ref(false), running = ref(false), refreshing = ref(false)
+const loadError = ref(''), statusError = ref(''), accountError = ref('')
+const busy = computed(() => saving.value || running.value)
+const resultKinds = ['normal', 'abnormal', 'error'] as const
+const resultSearch = ref(''), verdictFilter = ref('all')
+const accountSearch = ref(''), accountPage = ref(1), accountPages = ref(1), accountsLoading = ref(false)
+const accountOptions = ref<AccountListItem[]>([])
+const accountNames = reactive<Record<number, string>>({})
+const controllers = new Set<AbortController>()
+let stopped = false, pollTimer: ReturnType<typeof setInterval> | undefined, searchTimer: ReturnType<typeof setTimeout> | undefined
+let accountController: AbortController | undefined
+
+function snapshot(): GPTAccountMonitorConfig {
+  return { ...form, model: GPT_ACCOUNT_MONITOR_MODEL, reasoning_effort: GPT_ACCOUNT_MONITOR_REASONING_EFFORT, prompt: form.prompt.trim(), account_ids: scope.value === 'all' ? [] : [...new Set(form.account_ids)].sort((a, b) => a - b) }
+}
+function configFingerprint(config: GPTAccountMonitorConfig) {
+  return JSON.stringify([config.enabled, config.interval_seconds, config.timeout_seconds, config.concurrency, config.model, config.reasoning_effort, config.prompt, config.expected_generation, [...config.account_ids].sort((a, b) => a - b), config.run_on_start])
+}
+const dirty = computed(() => savedConfig.value !== null && (configFingerprint(snapshot()) !== configFingerprint(savedConfig.value) || scope.value !== (savedConfig.value.account_ids.length ? 'selected' : 'all')))
+function applyConfig(value: GPTAccountMonitorConfig) {
+  const normalized = { ...value, model: GPT_ACCOUNT_MONITOR_MODEL, reasoning_effort: GPT_ACCOUNT_MONITOR_REASONING_EFFORT, account_ids: [...(value.account_ids || [])].sort((a, b) => a - b) }
+  Object.assign(form, normalized, { account_ids: [...normalized.account_ids] })
+  scope.value = normalized.account_ids.length ? 'selected' : 'all'
+  savedConfig.value = JSON.parse(JSON.stringify(normalized)) as GPTAccountMonitorConfig
+}
+function resetForm() { if (savedConfig.value) applyConfig(savedConfig.value) }
+function message(error: unknown): string { return error && typeof error === 'object' && 'message' in error ? String(error.message) : t('common.unknownError') }
+function report(error: unknown) {
+  if (stopped || isStepUpCancelled(error)) return
+  appStore.showError(isStepUpBlocked(error) ? t(stepUpBlockReason(error) === 'STEP_UP_ADMIN_API_KEY_FORBIDDEN' ? 'stepUp.adminApiKeyForbidden' : 'stepUp.notEnabled') : message(error))
+}
+async function request<T>(action: (signal: AbortSignal) => Promise<T>): Promise<T> {
+  const controller = new AbortController()
+  controllers.add(controller)
+  try { return await action(controller.signal) } finally { controllers.delete(controller) }
+}
+async function loadConfig() {
+  if (stopped) return
+  loading.value = true
+  loadError.value = ''
+  try {
+    const value = await request(signal => adminAPI.gptAccountMonitor.getConfig(signal))
+    if (!stopped) { applyConfig(value); loaded.value = true }
+  } catch (error) { if (!stopped) loadError.value = message(error) }
+  finally { loading.value = false }
+}
+async function refreshStatus() {
+  if (stopped || refreshing.value) return
+  refreshing.value = true
+  try {
+    const value = await request(signal => adminAPI.gptAccountMonitor.getStatus(signal))
+    if (!stopped) { status.value = { ...value, accounts: Array.isArray(value.accounts) ? value.accounts : [] }; statusError.value = '' }
+  } catch (error) { if (!stopped) statusError.value = message(error) }
+  finally { refreshing.value = false }
+}
+function validate(config: GPTAccountMonitorConfig) {
+  for (const [value, min, max] of [[config.interval_seconds, 60, 86400], [config.timeout_seconds, 10, 300], [config.concurrency, 1, 10], [config.expected_generation, 1, 99]]) {
+    if (!Number.isInteger(value) || value < min || value > max) throw new Error(tr('invalidConfig'))
+  }
+  if (!config.prompt) throw new Error(tr('invalidConfig'))
+  if (scope.value === 'selected' && !config.account_ids.length) throw new Error(tr('chooseAccounts'))
+}
+async function save() {
+  if (!loaded.value || busy.value || stopped) return
+  saving.value = true
+  try {
+    const config = snapshot()
+    validate(config)
+    const value = await stepUp.run(() => request(signal => adminAPI.gptAccountMonitor.saveConfig(config, signal)))
+    if (!stopped) { applyConfig(value); appStore.showSuccess(tr('saved')); await refreshStatus() }
+  } catch (error) { report(error) }
+  finally { saving.value = false }
+}
+async function runNow() {
+  if (!loaded.value || busy.value || status.value.running || stopped) return
+  if (dirty.value) { appStore.showError(tr('saveFirst')); return }
+  if (!savedConfig.value?.enabled) { appStore.showError(tr('enableFirst')); return }
+  running.value = true
+  try {
+    const result = await stepUp.run(() => request(signal => adminAPI.gptAccountMonitor.run(signal)))
+    if (!stopped) {
+      if (result.queued) appStore.showSuccess(result.message || tr('queued'))
+      else appStore.showInfo(result.message || tr('running'))
+      await refreshStatus()
+    }
+  } catch (error) { report(error) }
+  finally { running.value = false }
+}
+async function loadAccounts() {
+  if (stopped) return
+  accountController?.abort()
+  const controller = new AbortController()
+  accountController = controller
+  controllers.add(controller)
+  accountsLoading.value = true
+  accountError.value = ''
+  try {
+    const result = await adminAPI.accounts.list(accountPage.value, 50, { platform: 'openai', type: 'oauth', status: 'active', lite: 'true', search: accountSearch.value.trim() }, { signal: controller.signal })
+    if (stopped || controller.signal.aborted) return
+    accountOptions.value = result.items.filter(account => account.platform === 'openai' && account.type === 'oauth' && account.status === 'active' && !account.parent_account_id && (!account.expires_at || account.expires_at * 1000 > Date.now()))
+    for (const account of accountOptions.value) accountNames[account.id] = `${account.name} (#${account.id})`
+    accountPages.value = Math.max(1, result.pages || Math.ceil(result.total / 50))
+  } catch (error) { if (!stopped && !controller.signal.aborted) accountError.value = message(error) }
+  finally { controllers.delete(controller); if (accountController === controller) accountsLoading.value = false }
+}
+function toggleAccount(id: number) { form.account_ids = form.account_ids.includes(id) ? form.account_ids.filter(value => value !== id) : [...form.account_ids, id] }
+function changeAccountPage(delta: number) { accountPage.value += delta; void loadAccounts() }
+watch(accountSearch, () => { clearTimeout(searchTimer); searchTimer = setTimeout(() => { accountPage.value = 1; void loadAccounts() }, 250) })
+function verdictKind(verdict: string): typeof resultKinds[number] | 'pending' { return verdict === 'pending' ? 'pending' : verdict === 'normal' || verdict === 'pass' ? 'normal' : verdict === 'abnormal' || verdict === 'fail' ? 'abnormal' : 'error' }
+const counts = computed(() => {
+  const value = { normal: 0, abnormal: 0, error: 0 }
+  for (const account of status.value.accounts) {
+    const kind = verdictKind(account.verdict)
+    if (kind !== 'pending') value[kind]++
+  }
+  return value
+})
+const filteredResults = computed(() => {
+  const search = resultSearch.value.trim().toLowerCase()
+  return status.value.accounts.filter(account => (verdictFilter.value === 'all' || verdictKind(account.verdict) === verdictFilter.value) && (!search || `${account.account_id} ${account.name} ${account.answer || ''} ${account.message}`.toLowerCase().includes(search)))
+})
+function verdictClass(verdict: string) {
+  if (verdictKind(verdict) === 'pending') return 'bg-gray-100 text-gray-600 dark:bg-dark-700 dark:text-gray-300'
+  return verdictKind(verdict) === 'normal' ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-300' : verdictKind(verdict) === 'abnormal' ? 'bg-rose-50 text-rose-700 dark:bg-rose-900/20 dark:text-rose-300' : 'bg-amber-50 text-amber-700 dark:bg-amber-900/20 dark:text-amber-300'
+}
+function dateText(value: string | null) {
+  if (!value || value.startsWith('0001-')) return tr('noTime')
+  const date = new Date(value)
+  return Number.isNaN(date.getTime()) ? '—' : date.toLocaleString()
+}
+function onVisibilityChange() { if (!document.hidden) void refreshStatus() }
+onMounted(() => {
+  void Promise.allSettled([loadConfig(), refreshStatus(), loadAccounts()])
+  pollTimer = setInterval(() => { if (!document.hidden) void refreshStatus() }, 5000)
+  document.addEventListener('visibilitychange', onVisibilityChange)
+})
+onUnmounted(() => {
+  stopped = true
+  clearInterval(pollTimer)
+  clearTimeout(searchTimer)
+  document.removeEventListener('visibilitychange', onVisibilityChange)
+  for (const controller of controllers) controller.abort()
+  controllers.clear()
+  stepUp.onCancel()
+})
+</script>
+
+<style scoped>
+.monitor-label { @apply block text-sm font-medium text-gray-700 dark:text-gray-200; }
+</style>
