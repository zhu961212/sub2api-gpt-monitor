+"""Run deployment-script tests with a fake docker command; no daemon is used."""
+import hashlib
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+
+HERE = Path(__file__).resolve().parent
+OFFICIAL_COMMIT = "01842576b3d5c1e2545b5a99ad555d36e28ed306"
+PATCH_COMMIT = "0184257-gpt-monitor"
+IMAGE_ID = "sha256:" + "0123456789abcdef" * 4
+BASH = shutil.which("bash")
+if not BASH and Path("C:/Program Files/Git/bin/bash.exe").exists():
+    BASH = "C:/Program Files/Git/bin/bash.exe"
+
+
+def shell_path(path):
+    value = Path(path).resolve().as_posix()
+    if os.name == "nt" and len(value) > 2 and value[1] == ":":
+        return "/" + value[0].lower() + value[2:]
+    return value
+
+
+FAKE_DOCKER = r"""#!/bin/sh
+set -eu
+printf '%s|' "$@" >> "$MOCK_DOCKER_LOG"
+printf '\n' >> "$MOCK_DOCKER_LOG"
+if [ "$1" = compose ]; then
+  shift
+  if [ "$1" = version ]; then
+    [ "$MOCK_COMPOSE_OK" = true ] || exit 1
+    printf 'Docker Compose version v2.39.0\n'
+    exit 0
+  fi
+  mode=base
+  while [ "$#" -gt 0 ]; do
+    case "$1" in
+      -f)
+        case "$2" in
+          *docker-compose.gpt-monitor.yml) mode=patch ;;
+          *docker-compose.gpt-monitor.rollback-0.2.16.yml)
+            mode=official
+            selected_image=$(sed -n "s/^    image: '\(sha256:[0-9a-f]*\)'$/\1/p" "$2")
+            ;;
+        esac
+        shift 2
+        ;;
+      ps)
+        printf '%s\n' "$MOCK_CONTAINER_ID"
+        exit 0
+        ;;
+      config) [ "$MOCK_CONFIG_OK" = true ]; exit ;;
+      exec)
+        if [ -f "$MOCK_STATE" ] && [ "$(cat "$MOCK_STATE")" = patch ]; then
+          if [ -n "$MOCK_INSTALLED_VERSION_OUTPUT" ]; then
+            printf '%s\n' "$MOCK_INSTALLED_VERSION_OUTPUT"
+          else
+            printf 'Sub2API 0.2.16 (commit: 0184257-gpt-monitor, built: test)\n'
+          fi
+        else
+          if [ -n "$MOCK_ORIGINAL_VERSION_OUTPUT" ]; then
+            printf '%s\n' "$MOCK_ORIGINAL_VERSION_OUTPUT"
+          else
+            printf 'Sub2API %s (commit: %s, built: test)\n' "$MOCK_VERSION" "$MOCK_COMMIT"
+          fi
+        fi
+        exit 0
+        ;;
+      up)
+        [ "$MOCK_UP_OK" = true ] || exit 1
+        if [ "$mode" = official ]; then
+          printf '%s' "$selected_image" > "$MOCK_RESTORED_IMAGE"
+        fi
+        printf '%s' "$mode" > "$MOCK_STATE"
+        exit 0
+        ;;
+      *) exit 17 ;;
+    esac
+  done
+fi
+if [ "$1" = inspect ]; then
+  printf '%s\n' "$MOCK_IMAGE_ID"
+  exit 0
+fi
+if [ "$1" = image ] && [ "$2" = inspect ]; then
+  [ "$MOCK_IMAGE_EXISTS" = true ] || exit 1
+  printf '%s\n' "$MOCK_PLATFORM"
+  exit 0
+fi
+exit 18
+"""
+
+
+@unittest.skipUnless(BASH, "bash is needed; no Docker daemon is required")
+class DeploymentScriptsTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(prefix="gpt-monitor-tests-")
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name) / "deployment space ' $value"
+        self.root.mkdir()
+        self.bundle = self.root / "gpt-monitor-patch-0.2.16"
+        self.bundle.mkdir()
+        self.fake_bin = self.root / "fake-bin"
+        self.fake_bin.mkdir()
+        (self.root / "docker-compose.yml").write_text("services:\n  custom_api:\n    image: weishaw/sub2api:0.2.15\n", encoding="utf-8")
+        for name in ("apply.sh", "rollback.sh", "README.md"):
+            shutil.copyfile(HERE / name, self.bundle / name)
+        (self.bundle / "UPSTREAM_BASE.txt").write_text(OFFICIAL_COMMIT + "\n", encoding="utf-8")
+        for arch in ("amd64", "arm64"):
+            binary = self.bundle / "bin" / ("linux-" + arch) / "sub2api"
+            binary.parent.mkdir(parents=True)
+            binary.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8", newline="\n")
+            binary.chmod(0o755)
+        docker = self.fake_bin / "docker"
+        docker.write_text(FAKE_DOCKER, encoding="utf-8", newline="\n")
+        docker.chmod(0o755)
+        sleeper = self.fake_bin / "sleep"
+        sleeper.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8", newline="\n")
+        sleeper.chmod(0o755)
+        self.log = self.root / "docker.log"
+        self.env = os.environ.copy()
+        self.env.update({
+            "MOCK_DOCKER_LOG": shell_path(self.log),
+            "MOCK_STATE": shell_path(self.root / "state"),
+            "MOCK_COMPOSE_OK": "true",
+            "MOCK_CONFIG_OK": "true",
+            "MOCK_UP_OK": "true",
+            "MOCK_IMAGE_EXISTS": "true",
+            "MOCK_IMAGE_ID": IMAGE_ID,
+            "MOCK_RESTORED_IMAGE": shell_path(self.root / "restored-image"),
+            "MOCK_VERSION": "0.2.16",
+            "MOCK_COMMIT": OFFICIAL_COMMIT,
+            "MOCK_ORIGINAL_VERSION_OUTPUT": "",
+            "MOCK_INSTALLED_VERSION_OUTPUT": "",
+            "MOCK_PLATFORM": "linux/amd64",
+            "MOCK_CONTAINER_ID": "a" * 64,
+        })
+        self.write_checksums()
+
+    def write_checksums(self):
+        entries = []
+        for path in sorted(self.bundle.rglob("*")):
+            if path.is_file() and path.name != "SHA256SUMS":
+                entries.append(hashlib.sha256(path.read_bytes()).hexdigest() + "  " + path.relative_to(self.bundle).as_posix())
+        (self.bundle / "SHA256SUMS").write_text("\n".join(entries) + "\n", encoding="utf-8", newline="\n")
+
+    def run_script(self, name="apply.sh", service="custom_api"):
+        return subprocess.run(
+            [BASH, "-c", 'export PATH="$1:$PATH"; shift; exec sh "$@"', "mock-launch",
+             shell_path(self.fake_bin), shell_path(self.bundle / name), "docker-compose.yml", service],
+            cwd=self.root, env=self.env, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=15,
+        )
+
+    def calls(self):
+        return self.log.read_text(encoding="utf-8").splitlines() if self.log.exists() else []
+
+    def test_apply_preserves_image_and_service_with_quoted_paths(self):
+        result = self.run_script()
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        override = (self.root / "docker-compose.gpt-monitor.yml").read_text(encoding="utf-8")
+        self.assertIn("'custom_api':", override)
+        self.assertIn(f"image: '{IMAGE_ID}'", override)
+        self.assertIn("linux-amd64/sub2api", override)
+        self.assertIn("deployment space '' $$value", override)
+        self.assertIn("read_only: true", override)
+        self.assertIn("create_host_path: false", override)
+        rollback = (self.root / "docker-compose.gpt-monitor.rollback-0.2.16.yml").read_text(encoding="utf-8")
+        self.assertIn(f"image: '{IMAGE_ID}'", rollback)
+        self.assertNotIn("volumes:", rollback)
+        up = [line for line in self.calls() if "|up|" in line]
+        self.assertEqual(len(up), 1)
+        self.assertIn("|--no-deps|--force-recreate|--pull|never|--no-build|custom_api|", up[0])
+        self.assertNotIn("|down|", "\n".join(self.calls()))
+
+    def test_arm64_uses_actual_image_architecture(self):
+        self.env["MOCK_PLATFORM"] = "linux/arm64"
+        result = self.run_script()
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn("linux-arm64/sub2api", (self.root / "docker-compose.gpt-monitor.yml").read_text(encoding="utf-8"))
+
+    def test_actual_log_prefixed_version_installs_and_verifies(self):
+        original = (
+            "2026-10-13T15:40:32.556+0800 INFO stdlog "
+            f"Sub2API 0.2.16 (commit: {OFFICIAL_COMMIT}, "
+            'built: 2026-10-09T03:28:03Z) {"service":"sub2api"}'
+        )
+        self.env["MOCK_ORIGINAL_VERSION_OUTPUT"] = original
+        self.env["MOCK_INSTALLED_VERSION_OUTPUT"] = original.replace(
+            OFFICIAL_COMMIT, PATCH_COMMIT
+        )
+        result = self.run_script()
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertEqual(sum("|up|" in line for line in self.calls()), 1)
+        self.assertIn("安装完成", result.stdout)
+
+    def test_log_prefixed_other_commit_never_recreates(self):
+        self.env["MOCK_ORIGINAL_VERSION_OUTPUT"] = (
+            "2026-10-13T15:40:32.556+0800 INFO stdlog "
+            "Sub2API 0.2.16 (commit: ab80abc6d1f929a6864c8804fd077b509d21fda2, "
+            'built: 2026-10-09T03:28:03Z) {"service":"sub2api"}'
+        )
+        result = self.run_script()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("当前构建基线不符", result.stderr)
+        self.assertFalse((self.root / "docker-compose.gpt-monitor.yml").exists())
+        self.assertFalse(any("|up|" in line for line in self.calls()))
+
+    def test_wrong_version_and_arch_never_recreate(self):
+        for key, value in (("MOCK_VERSION", "0.2.15"), ("MOCK_PLATFORM", "linux/386")):
+            with self.subTest(key=key):
+                original = self.env[key]
+                self.env[key] = value
+                result = self.run_script()
+                self.env[key] = original
+                self.assertNotEqual(result.returncode, 0)
+                self.assertFalse((self.root / "docker-compose.gpt-monitor.yml").exists())
+        self.assertFalse(any("|up|" in line for line in self.calls()))
+
+    def test_checksum_failure_stops_before_docker(self):
+        with (self.bundle / "bin/linux-amd64/sub2api").open("a", encoding="utf-8") as file:
+            file.write("tampered")
+        result = self.run_script()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(self.calls(), [])
+
+    def test_existing_patch_stops_before_recreate(self):
+        self.env["MOCK_COMMIT"] = PATCH_COMMIT
+        result = self.run_script()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("当前程序已包含此管理页版本", result.stderr)
+        self.assertFalse((self.root / "docker-compose.gpt-monitor.yml").exists())
+        self.assertFalse(any("|up|" in line for line in self.calls()))
+
+    def test_same_version_with_other_commit_never_recreates(self):
+        for commit in (
+            "ab80abc6d1f929a6864c8804fd077b509d21fda2",
+            OFFICIAL_COMMIT[:7],
+            OFFICIAL_COMMIT + "-custom",
+            "unknown",
+            "",
+        ):
+            with self.subTest(commit=commit):
+                self.env["MOCK_COMMIT"] = commit
+                result = self.run_script()
+                self.assertNotEqual(result.returncode, 0)
+                self.assertIn("当前构建基线不符", result.stderr)
+                self.assertFalse((self.root / "docker-compose.gpt-monitor.yml").exists())
+        self.assertFalse(any("|up|" in line for line in self.calls()))
+
+    def test_old_patches_require_official_upgrade(self):
+        for commit in ("ab80abc-gpt-monitor-ui-v1", "ab80abc-gpt-monitor-ui-v2", "f2669c8-gpt-monitor-ui-v3"):
+            with self.subTest(commit=commit):
+                self.env["MOCK_COMMIT"] = commit
+                result = self.run_script()
+                self.assertNotEqual(result.returncode, 0)
+                self.assertIn("当前构建基线不符", result.stderr)
+                self.assertIn("解除旧补丁挂载并升级官方程序", result.stderr)
+                self.assertFalse((self.root / "docker-compose.gpt-monitor.yml").exists())
+        self.assertFalse(any("|up|" in line for line in self.calls()))
+
+    def test_existing_override_is_not_overwritten(self):
+        override = self.root / "docker-compose.gpt-monitor.yml"
+        override.write_text("keep this exact file", encoding="utf-8")
+        result = self.run_script()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(override.read_text(encoding="utf-8"), "keep this exact file")
+        self.assertEqual(self.calls(), [])
+
+    def test_existing_official_image_record_is_not_overwritten(self):
+        rollback = self.root / "docker-compose.gpt-monitor.rollback-0.2.16.yml"
+        rollback.write_text("keep original image record", encoding="utf-8")
+        result = self.run_script()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(rollback.read_text(encoding="utf-8"), "keep original image record")
+        self.assertEqual(self.calls(), [])
+
+    def test_existing_official_upgrade_overlay_is_untouched(self):
+        upgrade = self.root / "docker-compose.official-0.2.16.yml"
+        content = "services:\n  custom_api:\n    image: weishaw/sub2api:0.2.16\n"
+        upgrade.write_text(content, encoding="utf-8")
+        result = self.run_script()
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertEqual(upgrade.read_text(encoding="utf-8"), content)
+
+    def test_invalid_image_id_is_rejected_before_writing_overlays(self):
+        for image_id in ("sha256:123456", "sha256:" + "g" * 64, "weishaw/sub2api:0.2.16"):
+            with self.subTest(image_id=image_id):
+                self.env["MOCK_IMAGE_ID"] = image_id
+                result = self.run_script()
+                self.assertNotEqual(result.returncode, 0)
+                self.assertFalse((self.root / "docker-compose.gpt-monitor.yml").exists())
+                self.assertFalse((self.root / "docker-compose.gpt-monitor.rollback-0.2.16.yml").exists())
+        self.assertFalse(any("|up|" in line for line in self.calls()))
+
+    def test_config_failure_preserves_recovery_file_and_never_recreates(self):
+        self.env["MOCK_CONFIG_OK"] = "false"
+        result = self.run_script()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertTrue((self.root / "docker-compose.gpt-monitor.rollback-0.2.16.yml").exists())
+        self.assertFalse(any("|up|" in line for line in self.calls()))
+
+    def test_multiple_containers_are_rejected(self):
+        self.env["MOCK_CONTAINER_ID"] = "a" * 64 + "\n" + "b" * 64
+        result = self.run_script()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertFalse(any("|up|" in line for line in self.calls()))
+
+    def test_rollback_retains_official_0216_even_when_base_names_0215(self):
+        installed = self.run_script()
+        self.assertEqual(installed.returncode, 0, installed.stdout + installed.stderr)
+        override = self.root / "docker-compose.gpt-monitor.yml"
+        original = override.read_text(encoding="utf-8")
+        self.log.write_text("", encoding="utf-8")
+        result = self.run_script("rollback.sh")
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        calls = "\n".join(self.calls())
+        self.assertNotIn("docker-compose.gpt-monitor.yml", calls)
+        self.assertIn("docker-compose.gpt-monitor.rollback-0.2.16.yml", calls)
+        self.assertNotIn("|down|", calls)
+        self.assertNotIn("|rm|", calls)
+        self.assertNotIn("|volume|", calls)
+        self.assertIn("|up|-d|--no-deps|--force-recreate|--pull|never|--no-build|custom_api|", calls)
+        self.assertEqual((self.root / "restored-image").read_text(encoding="utf-8"), IMAGE_ID)
+        self.assertIn("weishaw/sub2api:0.2.15", (self.root / "docker-compose.yml").read_text(encoding="utf-8"))
+        self.assertEqual(override.read_text(encoding="utf-8"), original)
+        self.assertIn("恢复官方 Sub2API 0.2.16", result.stdout)
+
+    def test_rollback_missing_record_never_uses_old_base_image(self):
+        result = self.run_script("rollback.sh")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("不能仅使用", result.stderr)
+        self.assertEqual(self.calls(), [])
+
+    def test_rollback_rejects_changed_record_and_wrong_service(self):
+        installed = self.run_script()
+        self.assertEqual(installed.returncode, 0, installed.stdout + installed.stderr)
+        rollback = self.root / "docker-compose.gpt-monitor.rollback-0.2.16.yml"
+        original = rollback.read_text(encoding="utf-8")
+        for content, service in ((original + "    volumes: []\n", "custom_api"), (original, "another_api")):
+            with self.subTest(service=service):
+                rollback.write_text(content, encoding="utf-8", newline="\n")
+                self.log.write_text("", encoding="utf-8")
+                result = self.run_script("rollback.sh", service)
+                self.assertNotEqual(result.returncode, 0)
+                self.assertEqual(self.calls(), [])
+
+    def test_rollback_missing_official_image_never_recreates(self):
+        installed = self.run_script()
+        self.assertEqual(installed.returncode, 0, installed.stdout + installed.stderr)
+        self.env["MOCK_IMAGE_EXISTS"] = "false"
+        self.log.write_text("", encoding="utf-8")
+        result = self.run_script("rollback.sh")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("镜像已不在本机", result.stderr)
+        self.assertFalse(any("|up|" in line for line in self.calls()))
+
+    def test_failed_apply_keeps_official_0216_recovery_available(self):
+        self.env["MOCK_UP_OK"] = "false"
+        installed = self.run_script()
+        self.assertNotEqual(installed.returncode, 0)
+        self.assertIn("rollback.sh", installed.stderr)
+        self.assertTrue((self.root / "docker-compose.gpt-monitor.rollback-0.2.16.yml").exists())
+        self.env["MOCK_UP_OK"] = "true"
+        result = self.run_script("rollback.sh")
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertEqual((self.root / "restored-image").read_text(encoding="utf-8"), IMAGE_ID)
+
+    def test_rollback_verifies_full_official_commit_before_reporting_success(self):
+        installed = self.run_script()
+        self.assertEqual(installed.returncode, 0, installed.stdout + installed.stderr)
+        self.env["MOCK_ORIGINAL_VERSION_OUTPUT"] = (
+            "2026-10-13T15:40:32.556+0800 INFO stdlog "
+            "Sub2API 0.2.16 (commit: unexpected, built: test)"
+        )
+        result = self.run_script("rollback.sh")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("未确认官方 0.2.16 版本", result.stderr)
+        self.assertNotIn("已移除巡检程序挂载", result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
