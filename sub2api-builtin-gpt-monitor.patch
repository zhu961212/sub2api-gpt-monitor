+}
+
+func TestGPTMonitorRefreshFailureCannotLeakOrUseStaleToken(t *testing.T) {
+	var logs bytes.Buffer
+	previous := slog.Default()
+	slog.SetDefault(slog.New(slog.NewTextHandler(&logs, nil)))
+	defer slog.SetDefault(previous)
+	account := gptMonitorTestAccount()
+	account.Credentials["expires_at"] = time.Now().Add(time.Minute).Format(time.RFC3339)
+	account.Credentials["refresh_token"] = "private-refresh-token"
+	client := &gptMonitorRefreshClient{err: errors.New("upstream body secret-token secret-proxy password")}
+	repo := &gptMonitorProbeRepo{get: func(context.Context, int64) (*Account, error) { return account, nil }}
+	oauth := &OpenAIOAuthService{proxyRepo: &gptMonitorRefreshProxyRepo{proxy: account.Proxy}, oauthClient: client}
+	provider := NewOpenAITokenProvider(repo, nil, oauth)
+	provider.SetRefreshAPI(NewOAuthRefreshAPI(repo, nil), NewOpenAITokenRefresher(oauth, repo))
+	pinned := gptMonitorPinnedProxy{ID: account.Proxy.ID, URL: account.Proxy.URL(), UpdatedAt: account.Proxy.UpdatedAt}
+	token, err := provider.GetAccessToken(context.WithValue(context.Background(), gptMonitorProxyContextKey{}, pinned), account)
+	if err == nil || token != "" || client.calls != 1 {
+		t.Fatalf("refresh failure reused stale token: calls=%d token=%q err=%v", client.calls, token, err)
+	}
+	if strings.Contains(err.Error(), "secret") || strings.Contains(logs.String(), "secret") || strings.Contains(logs.String(), "password") {
+		t.Fatalf("sensitive failure escaped: %v %s", err, logs.String())
+	}
+	if account.Status != StatusActive || !account.Schedulable {
+		t.Fatal("refresh failure changed account schedule")
+	}
+}
+
+func TestGPTMonitorRefreshRequiresPinnedProxy(t *testing.T) {
+	for _, change := range []string{"none", "missing", "disabled", "changed", "timestamp", "lookup error", "account proxy changed"} {
+		t.Run(change, func(t *testing.T) {
+			a := gptMonitorTestAccount()
+			a.Credentials["refresh_token"] = "refresh"
+			pinned := gptMonitorPinnedProxy{ID: a.Proxy.ID, URL: a.Proxy.URL(), UpdatedAt: a.Proxy.UpdatedAt}
+			p := *a.Proxy
+			repo := &gptMonitorRefreshProxyRepo{proxy: &p}
+			switch change {
+			case "missing":
+				repo.proxy = nil
+			case "disabled":
+				p.Status = StatusDisabled
+			case "changed":
+				p.Port++
+			case "timestamp":
+				p.UpdatedAt = time.Now()
+			case "lookup error":
+				repo.err = errors.New("secret db")
+			case "account proxy changed":
+				other := int64(8)
+				a.ProxyID = &other
+			}
+			client := &gptMonitorRefreshClient{}
+			s := &OpenAIOAuthService{proxyRepo: repo, oauthClient: client}
+			_, err := s.RefreshAccountToken(context.WithValue(context.Background(), gptMonitorProxyContextKey{}, pinned), a)
+			if err == nil {
+				t.Fatal("expected controlled failure")
+			}
+			if change == "none" {
+				if client.calls != 1 || client.proxy != pinned.URL {
+					t.Fatal("refresh did not use pinned proxy")
+				}
+			} else if client.calls != 0 {
+				t.Fatal("refresh called with unavailable or changed proxy")
+			}
+		})
+	}
+}
