+type gptMonitorRefreshProxyRepo struct {
+	ProxyRepository
+	proxy *Proxy
+	err   error
+}
+
+func (r *gptMonitorRefreshProxyRepo) GetByID(context.Context, int64) (*Proxy, error) {
