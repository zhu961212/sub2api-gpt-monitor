--- /dev/null
+++ b/backend/internal/service/gpt_account_monitor_repository.go
@@ -0,0 +1,12 @@
+package service
+
+import "context"
+
+// gptMonitorReadRepository keeps recurring scans and status polling independent
+// of credential, proxy-secret, and account-group hydration. Empty accountIDs
+// means every eligible account. Disabled scheduling must not exclude an account:
+// a subsequent healthy probe needs to be able to recover it.
+type gptMonitorReadRepository interface {
+	ListGPTMonitorCandidates(ctx context.Context, accountIDs []int64, afterID int64, limit int) ([]Account, error)
+	ListGPTMonitorAccounts(ctx context.Context, accountIDs []int64) ([]Account, error)
+}
diff --git a/backend/internal/service/gpt_account_monitor_service.go b/backend/internal/service/gpt_account_monitor_service.go
new file mode 100644
index 0000000..8bffb6c
--- /dev/null
+++ b/backend/internal/service/gpt_account_monitor_service.go
@@ -0,0 +1,520 @@
+package service
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/logger"
+)
+
+// GPTAccountMonitorStore coordinates the built-in worker across server replicas.
+// Failed coordination never falls back to uncoordinated probing or mutations.
+type GPTAccountMonitorStore interface {
+	Acquire(context.Context, string, time.Duration) (bool, error)
+	Renew(context.Context, string, time.Duration) (bool, error)
+	Owns(context.Context, string) (bool, error)
+	Release(context.Context, string) error
+	NextRun(context.Context, string) (time.Time, error)
+	SetNextRun(context.Context, string, time.Time) error
+}
+
+type gptMonitorSchedulingRepository interface {
+	SetGPTMonitorSchedulableIfMatch(context.Context, *Account, bool) (bool, error)
+}
+
+type gptMonitorResultRepository interface {
+	UpdateGPTMonitorResult(context.Context, int64, GPTAccountMonitorResult) error
+}
+
+type gptAccountProbe func(context.Context, int64, string, string) (*Account, string, error)
+
+// GPTAccountMonitorResult is stored under account.extra.gpt_account_monitor.
+// It never contains credentials, proxy URLs, or upstream error bodies.
+type GPTAccountMonitorResult struct {
+	CheckedAt          time.Time `json:"checked_at"`
+	Verdict            string    `json:"verdict"`
+	Answer             string    `json:"answer,omitempty"`
+	Message            string    `json:"message"`
+	Model              string    `json:"model"`
+	ReasoningEffort    string    `json:"reasoning_effort,omitempty"`
+	ExpectedGeneration int       `json:"expected_generation"`
+	Schedulable        bool      `json:"schedulable"`
+	Changed            bool      `json:"changed"`
+}
+
+type GPTAccountMonitorService struct {
+	repo         AccountRepository
+	store        GPTAccountMonitorStore
+	settings     SettingRepository
+	defaults     config.GPTAccountMonitorConfig
+	cfg          config.GPTAccountMonitorConfig
+	probe        gptAccountProbe
+	startOnce    sync.Once
+	stopOnce     sync.Once
+	cycleMu      sync.Mutex
+	mu           sync.Mutex
+	managementMu sync.RWMutex
+	cancel       context.CancelFunc
+	activeCancel context.CancelFunc
+	done         chan struct{}
+	trigger      chan string
+	wake         chan struct{}
+	state        GPTAccountMonitorStatus
+}
+
+func NewGPTAccountMonitorService(repo AccountRepository, gateway *OpenAIGatewayService, store GPTAccountMonitorStore, settings SettingRepository, cfg *config.Config) *GPTAccountMonitorService {
+	s := &GPTAccountMonitorService{repo: repo, store: store, settings: settings, trigger: make(chan string, 1), wake: make(chan struct{}, 1)}
+	if cfg != nil {
+		s.cfg = cloneGPTMonitorConfig(cfg.GPTAccountMonitor)
+		s.defaults = cloneGPTMonitorConfig(s.cfg)
+	}
+	if gateway != nil {
+		s.probe = gateway.ProbeGPTAccount
+	}
+	return s
+}
+
+func (s *GPTAccountMonitorService) Start() {
+	if s == nil || (!s.cfg.Enabled && s.settings == nil) {
+		return
+	}
+	s.startOnce.Do(func() {
+		if s.repo == nil || s.store == nil || s.probe == nil || s.cfg.IntervalSeconds < 60 || s.cfg.TimeoutSeconds < 10 || s.cfg.Concurrency < 1 || s.cfg.Concurrency > 10 {
+			logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] not started: missing dependencies or invalid configuration")
+			return
+		}
+		if _, ok := s.repo.(gptMonitorSchedulingRepository); !ok {
+			logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] not started: atomic scheduling unavailable")
+			return
+		}
+		ctx, cancel := context.WithCancel(context.Background())
+		done := make(chan struct{})
+		s.mu.Lock()
+		s.cancel = cancel
+		s.done = done
+		s.mu.Unlock()
+		logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] management worker started")
+		go func() { defer close(done); s.loop(ctx) }()
+	})
+}
+
+func (s *GPTAccountMonitorService) Stop() {
+	if s == nil {
+		return
+	}
+	s.stopOnce.Do(func() {
+		s.mu.Lock()
+		cancel, done := s.cancel, s.done
+		s.mu.Unlock()
+		if cancel == nil {
+			return
+		}
+		cancel()
+		select {
+		case <-done:
+		case <-time.After(5 * time.Second):
+			logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] shutdown deadline reached")
+		}
+	})
+}
+
+func (s *GPTAccountMonitorService) loop(ctx context.Context) {
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	type completion struct {
+		key   string
+		delay time.Duration
+	}
+	completed := make(chan completion, 1)
+	var active bool
+	var lastKey string
+	var next time.Time
+	var queuedKey string
+	var lastRead time.Time
+	var cfg config.GPTAccountMonitorConfig
+	var readErr error
+	for {
+		if time.Since(lastRead) >= 5*time.Second || lastRead.IsZero() {
+			readCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
+			cfg, readErr = s.GetConfig(readCtx)
+			cancel()
+			lastRead = time.Now()
+			if readErr != nil {
+				s.setMessage("读取巡检配置失败，等待重试")
+			}
+			key := gptMonitorConfigHash(cfg)
+			if readErr == nil && key != lastKey {
+				lastKey = key
+				s.mu.Lock()
+				s.cfg = cfg
+				if s.activeCancel != nil {
+					s.activeCancel()
+				}
+				s.state.Enabled = cfg.Enabled
+				s.mu.Unlock()
+				next = time.Now().Add(time.Duration(cfg.IntervalSeconds) * time.Second)
+				if cfg.RunOnStart {
+					next = time.Now()
+				}
+				if !cfg.Enabled {
+					s.setMessage("自动巡检已关闭")
+				} else {
+					s.setMessage("等待巡检")
+				}
+			}
+		}
+		if !cfg.Enabled || queuedKey != lastKey {
+			queuedKey = ""
+		}
+		if readErr == nil && cfg.Enabled && !active && (queuedKey != "" || !time.Now().Before(next)) {
+			manual := queuedKey != ""
+			queuedKey = ""
+			active = true
+			runCfg := cfg
+			runKey := lastKey
+			runCtx, cancel := context.WithCancel(ctx)
+			s.mu.Lock()
+			s.activeCancel = cancel
+			s.mu.Unlock()
+			go func() {
+				delay := s.runCycleWithConfig(runCtx, runCfg, manual)
+				cancel()
+				completed <- completion{runKey, delay}
+			}()
+		}
+		s.mu.Lock()
+		if cfg.Enabled && !active {
+			n := next
+			s.state.NextRun = &n
+		} else {
+			s.state.NextRun = nil
+		}
+		s.mu.Unlock()
+		select {
+		case <-ctx.Done():
+			s.mu.Lock()
+			if s.activeCancel != nil {
+				s.activeCancel()
+			}
+			s.mu.Unlock()
+			if active {
+				select {
+				case <-completed:
+				case <-time.After(4 * time.Second):
+				}
+			}
+			return
+		case <-ticker.C:
+		case key := <-s.trigger:
+			queuedKey = key
+			lastRead = time.Time{}
+		case <-s.wake:
+			lastRead = time.Time{}
+		case result := <-completed:
+			active = false
+			s.mu.Lock()
+			s.activeCancel = nil
+			s.mu.Unlock()
+			if result.key == lastKey {
+				next = time.Now().Add(result.delay)
+			}
+		}
+	}
+}
+
+func (s *GPTAccountMonitorService) runCycle(parent context.Context) time.Duration {
+	s.mu.Lock()
+	cfg := s.cfg
+	s.mu.Unlock()
+	return s.runCycleWithConfig(parent, cfg, false)
+}
+func (s *GPTAccountMonitorService) runCycleWithConfig(parent context.Context, cfg config.GPTAccountMonitorConfig, manual bool) time.Duration {
+	cfg.NormalizeFixedModel()
+	s.cycleMu.Lock()
+	defer s.cycleMu.Unlock()
+	retry := 30 * time.Second
+	if parent.Err() != nil {
+		return retry
+	}
+	ctx, cancel := context.WithCancel(parent)
+	defer cancel()
+	var random [24]byte
+	if _, err := rand.Read(random[:]); err != nil {
+		return retry
+	}
+	owner := hex.EncodeToString(random[:])
+	leaseCtx, leaseCancel := context.WithTimeout(ctx, 5*time.Second)
+	owned, err := s.store.Acquire(leaseCtx, owner, 180*time.Second)
+	leaseCancel()
+	if err != nil {
+		s.logError("lease acquisition failed")
+		return retry
+	}
+	if !owned {
+		return retry
+	}
+	defer func() {
+		rctx, rcancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer rcancel()
+		_ = s.store.Release(rctx, owner)
+	}()
+	renewDone := make(chan struct{})
+	go func() {
+		defer close(renewDone)
+		ticker := time.NewTicker(45 * time.Second)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				leaseCtx, leaseCancel := context.WithTimeout(ctx, 5*time.Second)
+				ok, e := s.store.Renew(leaseCtx, owner, 180*time.Second)
+				leaseCancel()
+				if e != nil || !ok {
+					s.logError("lease lost; stopping current scan")
+					cancel()
+					return
+				}
+			}
+		}
+	}()
+	defer func() { cancel(); <-renewDone }()
+	configKey := gptMonitorConfigHash(cfg)
+	dueCtx, dueCancel := context.WithTimeout(ctx, 5*time.Second)
+	next, err := s.store.NextRun(dueCtx, configKey)
+	dueCancel()
+	if err != nil {
+		s.logError("shared schedule unavailable")
+		return retry
+	}
+	if !manual && next.After(time.Now()) {
+		return time.Until(next)
+	}
+	started := time.Now().UTC()
+	s.mu.Lock()
+	s.state.Running = true
+	s.state.LastRun = &started
+	s.state.Message = "正在巡检"
+	s.mu.Unlock()
+	defer func() { s.mu.Lock(); s.state.Running = false; s.mu.Unlock() }()
+	jobs := make(chan Account)
+	var wg sync.WaitGroup
+	for i := 0; i < cfg.Concurrency; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for a := range jobs {
+				if ctx.Err() != nil {
+					return
+				}
+				s.checkOne(ctx, owner, &a, cfg)
+			}
+		}()
+	}
+	count := 0
+	err = s.eachCandidate(ctx, cfg.AccountIDs, func(a Account) bool {
+		select {
+		case <-ctx.Done():
+			return false
+		case jobs <- a:
+			count++
+			return true
+		}
+	})
+	if err != nil {
+		cancel()
+	}
+	close(jobs)
+	wg.Wait()
+	if err != nil {
+		s.logError("account listing failed")
+		return retry
+	}
+	if ctx.Err() != nil {
+		return retry
+	}
+	interval := time.Duration(cfg.IntervalSeconds) * time.Second
+	saveCtx, saveCancel := context.WithTimeout(ctx, 5*time.Second)
+	err = s.store.SetNextRun(saveCtx, configKey, time.Now().Add(interval))
+	saveCancel()
+	if err != nil {
+		s.logError("scan completed but shared schedule write failed")
+		return retry
+	}
+	s.setMessage(fmt.Sprintf("本轮巡检完成，共 %d 个账号", count))
+	logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] scan complete: accounts=%d next_run_in=%ds", count, cfg.IntervalSeconds)
+	return interval
+}
+
+// Fetch only a bounded page of account identities. Credentials and the current
+// proxy are loaded by the probe immediately before use, never for the full scan.
+func (s *GPTAccountMonitorService) eachCandidate(ctx context.Context, ids []int64, visit func(Account) bool) error {
+	selected := make(map[int64]bool, len(ids))
+	for _, id := range ids {
+		selected[id] = true
+	}
+	consume := func(accounts []Account) bool {
+		for _, a := range accounts {
+			if ctx.Err() != nil {
+				return false
+			}
+			if gptMonitorEligible(&a) && (len(selected) == 0 || selected[a.ID]) && !visit(a) {
+				return false
+			}
+		}
+		return true
+	}
+	if repo, ok := s.repo.(gptMonitorReadRepository); ok {
+		const pageSize = 200
+		var afterID int64
+		for ctx.Err() == nil {
+			readCtx, cancel := context.WithTimeout(ctx, 30*time.Second)
+			accounts, err := repo.ListGPTMonitorCandidates(readCtx, ids, afterID, pageSize)
+			cancel()
+			if err != nil {
+				return err
+			}
+			if len(accounts) == 0 {
+				return nil
+			}
+			lastID := accounts[len(accounts)-1].ID
+			if lastID <= afterID {
+				return fmt.Errorf("monitor account cursor did not advance")
+			}
+			if !consume(accounts) {
+				return ctx.Err()
+			}
+			afterID = lastID
+			if len(accounts) < pageSize {
+				return nil
+			}
+		}
+		return ctx.Err()
+	}
+	readCtx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	accounts, err := s.repo.ListByPlatform(readCtx, PlatformOpenAI)
+	cancel()
+	if err != nil {
+		return err
+	}
+	consume(accounts)
+	return ctx.Err()
+}
+
+func gptMonitorEligible(a *Account) bool {
+	return a != nil && a.ID > 0 && a.Platform == PlatformOpenAI && a.Type == AccountTypeOAuth && a.Status == StatusActive && !a.IsShadow() && (a.ExpiresAt == nil || a.ExpiresAt.After(time.Now()))
+}
+
+func (s *GPTAccountMonitorService) checkOne(parent context.Context, owner string, listed *Account, cfg config.GPTAccountMonitorConfig) {
+	cfg.NormalizeFixedModel()
+	ctx, cancel := context.WithTimeout(parent, time.Duration(cfg.TimeoutSeconds+10)*time.Second)
+	defer cancel()
+	r := GPTAccountMonitorResult{CheckedAt: time.Now().UTC(), Verdict: "error", Model: cfg.Model, ReasoningEffort: cfg.ReasoningEffort, ExpectedGeneration: cfg.ExpectedGeneration, Schedulable: listed.Schedulable}
+	probeCtx, probeCancel := context.WithTimeout(ctx, time.Duration(cfg.TimeoutSeconds)*time.Second)
+	snapshot, answer, err := s.probe(probeCtx, listed.ID, cfg.Model, cfg.Prompt)
+	probeCancel()
+	if parent.Err() != nil {
+		return
+	}
+	if err != nil {
+		r.Message = "检测失败（网络、认证、代理、模型不可用或响应不完整），调度未改变"
+		s.saveResult(parent, listed.ID, r)
+		return
+	}
+	if !gptMonitorEligible(snapshot) || snapshot.ID != listed.ID {
+		r.Message = "账号不再符合巡检条件，调度未改变"
+		s.saveResult(parent, listed.ID, r)
+		return
+	}
+	r.Schedulable = snapshot.Schedulable
+	r.Answer = gptMonitorTruncate(answer, 2048)
+	pass := GPTAccountAnswerMatches(answer, cfg.ExpectedGeneration)
+	if pass {
+		r.Verdict = "normal"
+		r.Message = "回答符合规则"
+	} else {
+		r.Verdict = "abnormal"
+		r.Message = "回答不符合规则"
+	}
+	if snapshot.Schedulable == pass {
+		s.saveResult(parent, listed.ID, r)
+		return
+	}
+	writeCtx, writeCancel := context.WithTimeout(ctx, 5*time.Second)
+	defer writeCancel()
+	s.managementMu.RLock()
+	defer s.managementMu.RUnlock()
+	current, configErr := s.GetConfig(writeCtx)
+	if configErr != nil || !current.Enabled || gptMonitorConfigHash(current) != gptMonitorConfigHash(cfg) {
+		return
+	}
+	owned, err := s.store.Owns(writeCtx, owner)
+	if err != nil || !owned {
+		r.Verdict = "error"
+		r.Message = "检测租约失效，调度未改变"
+		s.saveResult(parent, listed.ID, r)
+		return
+	}
+	repo, ok := s.repo.(gptMonitorSchedulingRepository)
+	if !ok {
+		r.Verdict = "error"
+		r.Message = "调度更新不可用"
+		s.saveResult(parent, listed.ID, r)
+		return
+	}
+	changed, err := repo.SetGPTMonitorSchedulableIfMatch(writeCtx, snapshot, pass)
+	if err != nil || !changed {
+		r.Verdict = "error"
+		r.Message = "账号或代理在检测期间变化，调度未改变"
+	} else {
+		r.Changed = true
+		r.Schedulable = pass
+		if pass {
+			r.Message += "，已开启调度"
+		} else {
+			r.Message += "，已关闭调度"
+		}
+	}
+	s.saveResult(parent, listed.ID, r)
+}
+
+func (s *GPTAccountMonitorService) saveResult(parent context.Context, id int64, result GPTAccountMonitorResult) {
+	if parent.Err() != nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(parent, 5*time.Second)
+	defer cancel()
+	var err error
+	if repo, ok := s.repo.(gptMonitorResultRepository); ok {
+		err = repo.UpdateGPTMonitorResult(ctx, id, result)
+	} else {
+		err = s.repo.UpdateExtra(ctx, id, map[string]any{"gpt_account_monitor": result})
+	}
+	if err != nil {
+		s.logError(fmt.Sprintf("account=%d result persistence failed", id))
+	}
+	logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] account=%d verdict=%s schedulable=%t changed=%t message=%s", id, result.Verdict, result.Schedulable, result.Changed, result.Message)
+}
+
+func (s *GPTAccountMonitorService) logError(message string) {
+	s.setMessage("巡检暂未完成，请查看服务日志")
+	logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] %s", message)
+}
+func (s *GPTAccountMonitorService) setMessage(message string) {
+	s.mu.Lock()
+	s.state.Message = message
+	s.mu.Unlock()
+}
+func gptMonitorTruncate(text string, maxRunes int) string {
+	r := []rune(text)
+	if len(r) > maxRunes {
+		return string(r[:maxRunes]) + "…"
+	}
+	return text
+}
diff --git a/backend/internal/service/gpt_account_monitor_service_test.go b/backend/internal/service/gpt_account_monitor_service_test.go
new file mode 100644
index 0000000..6404bfc
--- /dev/null
+++ b/backend/internal/service/gpt_account_monitor_service_test.go
@@ -0,0 +1,208 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+type gptMonitorRepoStub struct {
+	AccountRepository
+	mu        sync.Mutex
+	accounts  []Account
+	writes    map[int64]bool
+	results   map[int64]GPTAccountMonitorResult
+	casFail   bool
+	listCalls int
+}
+
+func (r *gptMonitorRepoStub) ListByPlatform(_ context.Context, platform string) ([]Account, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.listCalls++
+	return r.accounts, nil
+}
+func (r *gptMonitorRepoStub) SetGPTMonitorSchedulableIfMatch(_ context.Context, a *Account, value bool) (bool, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.casFail {
+		return false, nil
+	}
+	r.writes[a.ID] = value
+	return true, nil
+}
+func (r *gptMonitorRepoStub) UpdateExtra(_ context.Context, id int64, extra map[string]any) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.results[id] = extra["gpt_account_monitor"].(GPTAccountMonitorResult)
+	return nil
+}
+
+type gptMonitorStoreStub struct {
+	acquired bool
+	owned    bool
+	next     time.Time
+	err      error
+	released bool
+}
+
+func (s *gptMonitorStoreStub) Acquire(context.Context, string, time.Duration) (bool, error) {
+	return s.acquired, s.err
+}
+func (s *gptMonitorStoreStub) Renew(context.Context, string, time.Duration) (bool, error) {
+	return s.owned, s.err
+}
+func (s *gptMonitorStoreStub) Owns(context.Context, string) (bool, error) { return s.owned, s.err }
+func (s *gptMonitorStoreStub) Release(context.Context, string) error      { s.released = true; return nil }
+func (s *gptMonitorStoreStub) NextRun(context.Context, string) (time.Time, error) {
+	return s.next, s.err
+}
+func (s *gptMonitorStoreStub) SetNextRun(_ context.Context, _ string, next time.Time) error {
+	s.next = next
+	return s.err
+}
+func gptMonitorFixture() (*GPTAccountMonitorService, *gptMonitorRepoStub, *gptMonitorStoreStub) {
+	r := &gptMonitorRepoStub{writes: map[int64]bool{}, results: map[int64]GPTAccountMonitorResult{}}
+	for id := int64(1); id <= 6; id++ {
+		r.accounts = append(r.accounts, Account{ID: id, Platform: PlatformOpenAI, Type: AccountTypeOAuth, Status: StatusActive, Schedulable: id%2 == 1})
+	}
+	store := &gptMonitorStoreStub{acquired: true, owned: true}
+	cfg := &config.Config{GPTAccountMonitor: config.GPTAccountMonitorConfig{Enabled: true, IntervalSeconds: 1800, TimeoutSeconds: 10, Concurrency: 3, Model: "gpt-5.4", Prompt: config.DefaultGPTAccountMonitorPrompt, ExpectedGeneration: 17}}
+	return NewGPTAccountMonitorService(r, nil, store, nil, cfg), r, store
+}
+func TestGPTAccountMonitorDisablesAndRecoversOnlyOAuth(t *testing.T) {
+	s, r, store := gptMonitorFixture()
+	r.accounts[3].Type = AccountTypeAPIKey
+	r.accounts[4].Status = StatusDisabled
+	parent := int64(1)
+	r.accounts[5].ParentAccountID = &parent
+	s.probe = func(_ context.Context, id int64, model, prompt string) (*Account, string, error) {
+		require.Equal(t, "gpt-6-astra", model)
+		require.Equal(t, config.DefaultGPTAccountMonitorPrompt, prompt)
+		switch id {
+		case 1:
+			return &r.accounts[0], "iPhone16", nil
+		case 2:
+			return &r.accounts[1], "iPhone17 Pro", nil
+		case 3:
+			return nil, "", errors.New("proxy/token secret must not be persisted")
+		}
+		t.Errorf("ineligible account probed: %d", id)
+		return nil, "", errors.New("unexpected")
+	}
+	interval := s.runCycle(context.Background())
+	require.Equal(t, 30*time.Minute, interval)
+	require.Equal(t, map[int64]bool{1: false, 2: true}, r.writes)
+	require.Len(t, r.results, 3)
+	require.Equal(t, "error", r.results[3].Verdict)
+	require.NotContains(t, r.results[3].Message, "secret")
+	require.True(t, r.results[2].Changed)
+	require.True(t, r.results[2].Schedulable)
+	for _, result := range r.results {
+		require.Equal(t, "gpt-6-astra", result.Model)
+		require.Equal(t, "xhigh", result.ReasoningEffort)
+	}
+	require.True(t, store.released)
+}
+func TestGPTAccountMonitorSharedScheduleAndLease(t *testing.T) {
+	s, r, store := gptMonitorFixture()
+	calls := 0
+	s.cfg.Concurrency = 1
+	s.cfg.AccountIDs = []int64{2}
+	s.probe = func(_ context.Context, id int64, _, _ string) (*Account, string, error) {
+		calls++
+		return &r.accounts[id-1], "iPhone17", nil
+	}
+	store.acquired = false
+	s.runCycle(context.Background())
+	require.Zero(t, calls)
+	store.acquired = true
+	store.next = time.Now().Add(time.Hour)
+	s.runCycle(context.Background())
+	require.Zero(t, calls)
+	store.next = time.Time{}
+	s.runCycle(context.Background())
+	require.Equal(t, 1, calls)
+	require.Len(t, r.writes, 1)
+	s.runCycle(context.Background())
+	require.Equal(t, 1, calls, "another replica/restart must respect next-run time")
+}
+func TestGPTAccountMonitorCASOrLeaseFailureDoesNotClaimRecovery(t *testing.T) {
+	for _, scenario := range []string{"cas", "lease"} {
+		t.Run(scenario, func(t *testing.T) {
+			s, r, store := gptMonitorFixture()
+			s.cfg.AccountIDs = []int64{2}
+			if scenario == "cas" {
+				r.casFail = true
+			} else {
+				store.owned = false
+			}
+			s.probe = func(context.Context, int64, string, string) (*Account, string, error) {
+				return &r.accounts[1], "iPhone17", nil
+			}
+			s.runCycle(context.Background())
+			require.Empty(t, r.writes)
+			require.Equal(t, "error", r.results[2].Verdict)
+			require.False(t, r.results[2].Schedulable)
+			require.False(t, r.results[2].Changed)
+		})
+	}
+}
+func TestGPTAccountMonitorCancellationAndExpiredSelection(t *testing.T) {
+	s, r, _ := gptMonitorFixture()
+	past := time.Now().Add(-time.Hour)
+	for i := range r.accounts {
+		r.accounts[i].ExpiresAt = &past
+	}
+	s.probe = func(context.Context, int64, string, string) (*Account, string, error) {
+		t.Error("expired account probed")
+		return nil, "", errors.New("unexpected")
+	}
+	s.runCycle(context.Background())
+	require.Empty(t, r.results)
+	require.Empty(t, r.writes)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	s.runCycle(ctx)
+	require.Equal(t, 1, r.listCalls)
+}
+func TestGPTAccountMonitorShutdownCancelsProbe(t *testing.T) {
+	s, r, _ := gptMonitorFixture()
+	s.cfg.RunOnStart = true
+	s.cfg.AccountIDs = []int64{2}
+	started := make(chan struct{})
+	exited := make(chan struct{})
+	s.probe = func(ctx context.Context, _ int64, _, _ string) (*Account, string, error) {
+		close(started)
+		<-ctx.Done()
+		close(exited)
+		return nil, "", ctx.Err()
+	}
+	s.Start()
+	select {
+	case <-started:
+	case <-time.After(4 * time.Second):
+		t.Fatal("worker did not start")
+	}
+	s.Stop()
+	select {
+	case <-exited:
+	default:
+		t.Fatal("probe still running")
+	}
+	require.Empty(t, r.writes)
+	require.Empty(t, r.results)
+}
+func TestGPTAccountMonitorDefaultDisabled(t *testing.T) {
+	s, r, _ := gptMonitorFixture()
+	s.cfg.Enabled = false
+	s.Start()
+	s.Stop()
+	require.Nil(t, s.done)
+	require.Zero(t, r.listCalls)
+}
