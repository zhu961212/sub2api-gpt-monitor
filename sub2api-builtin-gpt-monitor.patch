+		account.Proxy.Host = u.Hostname()
+		account.Proxy.Port = port
+		s := &OpenAIGatewayService{accountRepo: &gptMonitorProbeRepo{get: func(context.Context, int64) (*Account, error) { return account, nil }}}
+		_, _, err := s.ProbeGPTAccount(context.Background(), 42, "gpt-5.4", "question")
+		proxy.Close()
+		if err == nil || hits[i].Load() != 1 {
+			t.Fatalf("account proxy %d not used exactly once: %v", i, err)
+		}
+	}
+	if envHits.Load() != 0 || hits[0].Load() != 1 || hits[1].Load() != 1 {
+		t.Fatal("environment or cross-account proxy used")
+	}
+	if _, _, err := newGPTMonitorClient(""); err == nil {
+		t.Fatal("missing proxy accepted")
+	}
+}
+
+func TestGPTMonitorNoRedirectAndSanitizedError(t *testing.T) {
+	client, tr, err := newGPTMonitorClient("http://127.0.0.1:1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tr.CloseIdleConnections()
+	calls := 0
+	client.Transport = gptMonitorTestRoundTripper(func(r *http.Request) (*http.Response, error) {
+		calls++
+		return &http.Response{StatusCode: 307, Header: http.Header{"Location": {"https://example.invalid/leak"}}, Body: io.NopCloser(strings.NewReader("")), Request: r}, nil
+	})
+	if _, err := gptMonitorProbeWithClient(context.Background(), client, gptMonitorTestAccount(), "test-token", "gpt-5.4", "question"); err == nil || calls != 1 {
+		t.Fatalf("redirect followed: %v calls=%d", err, calls)
+	}
+	client.Transport = gptMonitorTestRoundTripper(func(*http.Request) (*http.Response, error) { return nil, errors.New("secret-token secret-proxy") })
+	if _, err := gptMonitorProbeWithClient(context.Background(), client, gptMonitorTestAccount(), "test-token", "gpt-5.4", "question"); err == nil || strings.Contains(err.Error(), "secret") {
+		t.Fatalf("error leaked: %v", err)
+	}
+}
+
+func TestGPTMonitorUnsupportedModelAndUpstreamErrorsNeverFallbackOrChangeSchedule(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		status int
+		body   string
+	}{
+		{"unsupported_model", 400, `{"error":{"code":"model_not_found","message":"SECRET unsupported model"}}`},
+		{"not_found", 404, `{"error":{"code":"model_not_found"}}`},
+		{"rate_limit", 429, `{"error":{"code":"rate_limit_exceeded"}}`},
+		{"server_error", 500, "SECRET upstream body"},
+		{"failed_stream", 200, "data: {\"type\":\"response.failed\",\"response\":{\"error\":{\"code\":\"model_not_found\",\"message\":\"SECRET\"}}}\n\n"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			for _, schedulable := range []bool{true, false} {
+				s, repo, _ := gptMonitorFixture()
+				s.cfg.AccountIDs = []int64{1}
+				s.cfg.Model, s.cfg.ReasoningEffort = "legacy-model", "low"
+				repo.accounts[0].Schedulable = schedulable
+				calls := 0
+				client := &http.Client{Transport: gptMonitorTestRoundTripper(func(r *http.Request) (*http.Response, error) {
+					calls++
+					var payload map[string]any
+					require.NoError(t, json.NewDecoder(r.Body).Decode(&payload))
+					require.Equal(t, "gpt-6-astra", payload["model"])
+					require.Equal(t, map[string]any{"effort": "xhigh"}, payload["reasoning"])
+					return &http.Response{StatusCode: tc.status, Body: io.NopCloser(strings.NewReader(tc.body))}, nil
+				})}
+				s.probe = func(ctx context.Context, _ int64, model, prompt string) (*Account, string, error) {
+					require.Equal(t, "gpt-6-astra", model)
+					answer, err := gptMonitorProbeWithClient(ctx, client, gptMonitorTestAccount(), "test-token", model, prompt)
+					require.Error(t, err)
+					require.NotContains(t, err.Error(), "SECRET")
+					return &repo.accounts[0], answer, err
+				}
+				s.runCycle(context.Background())
+				require.Equal(t, 1, calls, "must never retry with a fallback model")
+				require.Empty(t, repo.writes)
+				result := repo.results[1]
+				require.Equal(t, "error", result.Verdict)
+				require.Equal(t, schedulable, result.Schedulable)
+				require.False(t, result.Changed)
+				require.Empty(t, result.Answer)
+				require.Equal(t, "gpt-6-astra", result.Model)
+				require.Equal(t, "xhigh", result.ReasoningEffort)
+				require.NotContains(t, result.Message, "SECRET")
+			}
+		})
+	}
+}
