+type gptMonitorMutableRepo struct {
+	*gptMonitorRepoStub
+	mutations int
+}
+
+func (r *gptMonitorMutableRepo) SetGPTMonitorSchedulableIfMatch(_ context.Context, snapshot *Account, value bool) (bool, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for i := range r.accounts {
+		if r.accounts[i].ID == snapshot.ID && r.accounts[i].Schedulable == snapshot.Schedulable {
+			r.accounts[i].Schedulable = value
+			r.writes[snapshot.ID] = value
+			r.mutations++
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+func TestGPTAccountMonitorSameAccountSuspendsRechecksAndRecovers(t *testing.T) {
+	s, base, store := gptMonitorFixture()
+	repo := &gptMonitorMutableRepo{gptMonitorRepoStub: base}
+	s.repo = repo
+	s.cfg.AccountIDs = []int64{1}
+	for _, step := range []struct {
+		answer      string
+		err         error
+		schedulable bool
+		verdict     string
+		changed     bool
+		mutations   int
+	}{
+		{"iPhone 16", nil, false, "abnormal", true, 1},
+		{"", errors.New("temporary network failure"), false, "error", false, 1},
+		{"iPhone 17 Pro", nil, true, "normal", true, 2},
+		{"iPhone 17", nil, true, "normal", false, 2},
+	} {
+		s.probe = func(_ context.Context, id int64, _, _ string) (*Account, string, error) {
+			repo.mu.Lock()
+			defer repo.mu.Unlock()
+			snapshot := repo.accounts[0]
+			require.Equal(t, snapshot.ID, id)
+			return &snapshot, step.answer, step.err
+		}
+		store.next = time.Time{}
+		require.Equal(t, 30*time.Minute, s.runCycle(context.Background()))
+		require.Equal(t, step.schedulable, repo.accounts[0].Schedulable)
+		require.Equal(t, step.verdict, repo.results[1].Verdict)
+		require.Equal(t, step.changed, repo.results[1].Changed)
+		require.Equal(t, step.mutations, repo.mutations)
+	}
+}
+
+type gptMonitorPagedRepo struct {
+	*gptMonitorRepoStub
+	cursors      []int64
+	statusReads  int
+	resultWrites int
+	pageErr      error
+}
+
+func (r *gptMonitorPagedRepo) ListByPlatform(context.Context, string) ([]Account, error) {
+	panic("monitor must use lightweight reads")
+}
+
+func (r *gptMonitorPagedRepo) ListGPTMonitorCandidates(_ context.Context, ids []int64, afterID int64, limit int) ([]Account, error) {
+	r.cursors = append(r.cursors, afterID)
+	if r.pageErr != nil {
+		return nil, r.pageErr
+	}
+	var out []Account
+	for _, a := range r.accounts {
+		if a.ID > afterID {
+			out = append(out, a)
+			if len(out) == limit {
+				break
+			}
+		}
+	}
+	return out, nil
+}
+
+func (r *gptMonitorPagedRepo) ListGPTMonitorAccounts(context.Context, []int64) ([]Account, error) {
+	r.statusReads++
+	return r.accounts, nil
+}
+
+func (r *gptMonitorPagedRepo) UpdateGPTMonitorResult(ctx context.Context, id int64, result GPTAccountMonitorResult) error {
+	r.resultWrites++
+	return r.gptMonitorRepoStub.UpdateExtra(ctx, id, map[string]any{"gpt_account_monitor": result})
+}
+
+func TestGPTAccountMonitorUsesBoundedPagesAndLightweightStatus(t *testing.T) {
+	s, base, _ := gptMonitorFixture()
+	base.accounts = nil
+	for id := int64(1); id <= 451; id++ {
+		base.accounts = append(base.accounts, Account{ID: id, Platform: PlatformOpenAI, Type: AccountTypeOAuth, Status: StatusActive, Schedulable: false})
+	}
+	repo := &gptMonitorPagedRepo{gptMonitorRepoStub: base}
+	s.repo = repo
+	var visited []int64
+	err := s.eachCandidate(context.Background(), nil, func(a Account) bool {
+		visited = append(visited, a.ID)
+		return true
+	})
+	require.NoError(t, err)
+	require.Len(t, visited, 451)
+	require.Equal(t, []int64{0, 200, 400}, repo.cursors)
+	status, err := s.Status(context.Background())
+	require.NoError(t, err)
+	require.Equal(t, 451, status.TotalAccounts)
+	require.Len(t, status.Accounts, 200)
+	require.Equal(t, 1, repo.statusReads)
+	s.saveResult(context.Background(), 1, GPTAccountMonitorResult{Verdict: "normal"})
+	require.Equal(t, 1, repo.resultWrites)
+	require.Zero(t, base.listCalls)
+}
+
+func TestGPTAccountMonitorFailedPageDoesNotAdvanceSharedSchedule(t *testing.T) {
+	s, base, store := gptMonitorFixture()
+	repo := &gptMonitorPagedRepo{gptMonitorRepoStub: base, pageErr: errors.New("database unavailable")}
+	s.repo = repo
+	s.probe = func(context.Context, int64, string, string) (*Account, string, error) {
+		t.Error("probe must not run after a failed page")
+		return nil, "", nil
+	}
+	require.Equal(t, 30*time.Second, s.runCycle(context.Background()))
+	require.True(t, store.next.IsZero())
+	require.True(t, store.released)
+	require.Empty(t, base.writes)
+}
