+package admin
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+type gptMonitorHandlerStub struct {
+	cfg    config.GPTAccountMonitorConfig
+	err    error
+	saves  int
+	runs   int
+	queued bool
+}
+
+func (s *gptMonitorHandlerStub) GetConfig(context.Context) (config.GPTAccountMonitorConfig, error) {
+	return s.cfg, s.err
+}
+func (s *gptMonitorHandlerStub) SaveConfig(_ context.Context, cfg config.GPTAccountMonitorConfig) (config.GPTAccountMonitorConfig, error) {
+	s.saves++
+	s.cfg = cfg
+	return s.cfg, s.err
+}
+func (s *gptMonitorHandlerStub) Status(context.Context) (service.GPTAccountMonitorStatus, error) {
+	return service.GPTAccountMonitorStatus{}, s.err
+}
+func (s *gptMonitorHandlerStub) RunNow(context.Context) (bool, error) {
+	s.runs++
+	return s.queued, s.err
+}
+
+func gptMonitorTestConfig() config.GPTAccountMonitorConfig {
+	return config.GPTAccountMonitorConfig{
+		Enabled: true, IntervalSeconds: 1800, TimeoutSeconds: 90, Concurrency: 3,
+		Model: config.GPTAccountMonitorModel, ReasoningEffort: config.GPTAccountMonitorReasoningEffort, Prompt: config.DefaultGPTAccountMonitorPrompt,
+		ExpectedGeneration: 17, AccountIDs: []int64{}, RunOnStart: true,
+	}
+}
+
+func gptMonitorTestRouter(h *GPTAccountMonitorHandler) *gin.Engine {
+	router := gin.New()
+	router.GET("/config", h.GetConfig)
+	router.PUT("/config", h.SaveConfig)
+	router.GET("/status", h.Status)
+	router.POST("/run", h.RunNow)
+	return router
+}
+
+func gptMonitorRequest(router *gin.Engine, method, path, body string) *httptest.ResponseRecorder {
+	w := httptest.NewRecorder()
+	r := httptest.NewRequest(method, path, strings.NewReader(body))
+	r.Header.Set("Content-Type", "application/json")
+	router.ServeHTTP(w, r)
+	return w
+}
+
+func TestGPTMonitorHandlerReadConfigUsesSnakeCaseAndArray(t *testing.T) {
+	s := &gptMonitorHandlerStub{cfg: gptMonitorTestConfig()}
+	s.cfg.AccountIDs = nil
+	w := gptMonitorRequest(gptMonitorTestRouter(&GPTAccountMonitorHandler{monitor: s}), http.MethodGet, "/config", "")
+	require.Equal(t, http.StatusOK, w.Code)
+	var result struct {
+		Code int                        `json:"code"`
+		Data map[string]json.RawMessage `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &result))
+	require.Zero(t, result.Code)
+	require.JSONEq(t, "[]", string(result.Data["account_ids"]))
+	require.Contains(t, result.Data, "interval_seconds")
+	require.JSONEq(t, `"gpt-6-astra"`, string(result.Data["model"]))
+	require.JSONEq(t, `"xhigh"`, string(result.Data["reasoning_effort"]))
+	require.NotContains(t, result.Data, "IntervalSeconds")
+}
+
+func TestGPTMonitorHandlerSaveCompleteDisabledConfig(t *testing.T) {
+	s := &gptMonitorHandlerStub{}
+	cfg := gptMonitorTestConfig()
+	cfg.Enabled, cfg.RunOnStart = false, false
+	cfg.Model, cfg.Prompt = " gpt-5.4 ", " question "
+	cfg.ReasoningEffort = "low"
+	cfg.AccountIDs = []int64{12, 34}
+	body, err := json.Marshal(cfg)
+	require.NoError(t, err)
+	w := gptMonitorRequest(gptMonitorTestRouter(&GPTAccountMonitorHandler{monitor: s}), http.MethodPut, "/config", string(body))
+	require.Equal(t, http.StatusOK, w.Code, w.Body.String())
+	require.Equal(t, 1, s.saves)
+	require.False(t, s.cfg.Enabled)
+	require.False(t, s.cfg.RunOnStart)
+	require.Equal(t, "gpt-6-astra", s.cfg.Model)
+	require.Equal(t, "xhigh", s.cfg.ReasoningEffort)
+	require.Equal(t, "question", s.cfg.Prompt)
+	require.Equal(t, []int64{12, 34}, s.cfg.AccountIDs)
+}
+
+func TestGPTMonitorHandlerRejectsMalformedOrUnsafeConfig(t *testing.T) {
+	body, err := json.Marshal(gptMonitorTestConfig())
+	require.NoError(t, err)
+	valid := string(body)
+	for _, tc := range []struct{ name, body string }{
+		{"empty", ""},
+		{"null", "null"},
+		{"missing", `{"enabled":false}`},
+		{"unknown", strings.TrimSuffix(valid, "}") + `,"unknown":"SECRET"}`},
+		{"trailing", valid + " {}"},
+		{"wrong_type", strings.Replace(valid, `"enabled":true`, `"enabled":"true"`, 1)},
+		{"null_ids", strings.Replace(valid, `"account_ids":[]`, `"account_ids":null`, 1)},
+		{"negative_id", strings.Replace(valid, `"account_ids":[]`, `"account_ids":[-1]`, 1)},
+		{"interval", strings.Replace(valid, `"interval_seconds":1800`, `"interval_seconds":1`, 1)},
+		{"disabled_invalid", strings.Replace(strings.Replace(valid, `"interval_seconds":1800`, `"interval_seconds":1`, 1), `"enabled":true`, `"enabled":false`, 1)},
+		{"oversize", strings.Replace(valid, "gpt-6-astra", strings.Repeat("SECRET", 6000), 1)},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			s := &gptMonitorHandlerStub{}
+			w := gptMonitorRequest(gptMonitorTestRouter(&GPTAccountMonitorHandler{monitor: s}), http.MethodPut, "/config", tc.body)
+			require.Equal(t, http.StatusBadRequest, w.Code, w.Body.String())
+			require.Zero(t, s.saves)
+			require.NotContains(t, w.Body.String(), "SECRET")
+		})
+	}
+}
+
+func TestGPTMonitorHandlerAcceptsLegacyAndOmittedFixedFields(t *testing.T) {
+	for _, fields := range []map[string]any{
+		{"model": "gpt-5.4"},
+		{},
+		{"model": nil, "reasoning_effort": nil},
+		{"model": "another-model", "reasoning_effort": "low"},
+	} {
+		body, err := json.Marshal(gptMonitorTestConfig())
+		require.NoError(t, err)
+		var request map[string]any
+		require.NoError(t, json.Unmarshal(body, &request))
+		delete(request, "model")
+		delete(request, "reasoning_effort")
+		for key, value := range fields {
+			request[key] = value
+		}
+		body, err = json.Marshal(request)
+		require.NoError(t, err)
+		s := &gptMonitorHandlerStub{}
+		w := gptMonitorRequest(gptMonitorTestRouter(&GPTAccountMonitorHandler{monitor: s}), http.MethodPut, "/config", string(body))
+		require.Equal(t, http.StatusOK, w.Code, w.Body.String())
+		require.Equal(t, "gpt-6-astra", s.cfg.Model)
+		require.Equal(t, "xhigh", s.cfg.ReasoningEffort)
+		require.Equal(t, 1, s.saves)
+	}
+}
+
+func TestGPTMonitorHandlerRunAndStatus(t *testing.T) {
+	for _, queued := range []bool{true, false} {
+		s := &gptMonitorHandlerStub{queued: queued}
+		router := gptMonitorTestRouter(&GPTAccountMonitorHandler{monitor: s})
+		w := gptMonitorRequest(router, http.MethodPost, "/run", "{}")
+		require.Equal(t, http.StatusOK, w.Code)
+		var result struct {
+			Data struct {
+				Queued bool `json:"queued"`
+			} `json:"data"`
+		}
+		require.NoError(t, json.Unmarshal(w.Body.Bytes(), &result))
+		require.Equal(t, queued, result.Data.Queued)
+		require.Equal(t, 1, s.runs)
+		w = gptMonitorRequest(router, http.MethodGet, "/status", "")
+		require.Equal(t, http.StatusOK, w.Code)
+	}
+}
+
+func TestGPTMonitorHandlerErrorsDoNotExposeServiceDetails(t *testing.T) {
+	body, err := json.Marshal(gptMonitorTestConfig())
+	require.NoError(t, err)
+	for _, tc := range []struct {
+		method, path string
+		status       int
+	}{
+		{http.MethodGet, "/config", http.StatusInternalServerError},
+		{http.MethodPut, "/config", http.StatusInternalServerError},
+		{http.MethodGet, "/status", http.StatusInternalServerError},
+		{http.MethodPost, "/run", http.StatusServiceUnavailable},
+	} {
+		t.Run(tc.method+tc.path, func(t *testing.T) {
+			s := &gptMonitorHandlerStub{err: errors.New("SECRET credentials and database details")}
+			w := gptMonitorRequest(gptMonitorTestRouter(&GPTAccountMonitorHandler{monitor: s}), tc.method, tc.path, string(body))
+			require.Equal(t, tc.status, w.Code)
+			require.NotContains(t, w.Body.String(), "SECRET")
+		})
+	}
+	w := gptMonitorRequest(gptMonitorTestRouter(NewGPTAccountMonitorHandler(nil)), http.MethodGet, "/status", "")
+	require.Equal(t, http.StatusServiceUnavailable, w.Code)
+}
