+package repository
+
+import (
+	"context"
+	"errors"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"entgo.io/ent/dialect"
+	entsql "entgo.io/ent/dialect/sql"
+	"github.com/DATA-DOG/go-sqlmock"
+	dbent "github.com/Wei-Shaw/sub2api/ent"
+	_ "github.com/Wei-Shaw/sub2api/ent/runtime"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/stretchr/testify/require"
+)
+
+func gptMonitorAccountSnapshot() *service.Account {
+	proxyID := int64(9)
+	return &service.Account{
+		ID: 17, Platform: service.PlatformOpenAI, Type: service.AccountTypeOAuth,
+		Status: service.StatusActive, UpdatedAt: time.Now(), Schedulable: true, ProxyID: &proxyID,
+		Proxy: &service.Proxy{ID: proxyID, Status: service.StatusActive, UpdatedAt: time.Now(), Protocol: "http", Host: "proxy", Port: 3128, Username: "user", Password: "pass"},
+	}
+}
+
+type gptMonitorCacheRecorder struct {
+	service.SchedulerCache
+	accounts []*service.Account
+}
+
+func (r *gptMonitorCacheRecorder) SetAccount(ctx context.Context, account *service.Account) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	r.accounts = append(r.accounts, account)
+	return nil
+}
+
+func TestGPTMonitorSchedulingCAS(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		rows     int64
+		target   bool
+		username string
+		password string
+	}{
+		{name: "stale snapshot", rows: 0, target: false, username: "user", password: "pass"},
+		{name: "suspend", rows: 1, target: false, username: "user", password: "pass"},
+		{name: "recover", rows: 1, target: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var mutationSQL string
+			matcher := sqlmock.QueryMatcherFunc(func(expected, actual string) error {
+				if expected == "scheduling mutation" {
+					mutationSQL = actual
+					return nil
+				}
+				return sqlmock.QueryMatcherRegexp.Match(expected, actual)
+			})
+			db, mock, err := sqlmock.New(sqlmock.QueryMatcherOption(matcher))
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = db.Close() })
+			client := dbent.NewClient(dbent.Driver(entsql.OpenDB(dialect.Postgres, db)))
+			t.Cleanup(func() { _ = client.Close() })
+			cache := &gptMonitorCacheRecorder{}
+			repo := newAccountRepositoryWithSQL(client, db, cache)
+			mock.ExpectBegin()
+			mock.ExpectExec("scheduling mutation").WillReturnResult(sqlmock.NewResult(0, tc.rows))
+			if tc.rows == 1 {
+				mock.ExpectExec(regexp.QuoteMeta("INSERT INTO scheduler_outbox")).WillReturnResult(sqlmock.NewResult(1, 1))
+				mock.ExpectCommit()
+				mock.ExpectQuery(`SELECT .* FROM "accounts"`).WillReturnRows(
+					sqlmock.NewRows([]string{"id", "platform", "type", "status", "schedulable"}).
+						AddRow(17, service.PlatformOpenAI, service.AccountTypeOAuth, service.StatusActive, tc.target))
+				mock.ExpectQuery(`SELECT .* FROM "account_groups"`).WillReturnRows(sqlmock.NewRows([]string{"account_id", "group_id"}))
+			} else {
+				mock.ExpectRollback()
+			}
+			snapshot := gptMonitorAccountSnapshot()
+			snapshot.Schedulable = !tc.target
+			snapshot.Proxy.Username, snapshot.Proxy.Password = tc.username, tc.password
+			changed, err := repo.SetGPTMonitorSchedulableIfMatch(context.Background(), snapshot, tc.target)
+			require.NoError(t, err)
+			require.Equal(t, tc.rows == 1, changed)
+			require.NoError(t, mock.ExpectationsWereMet())
+			require.Len(t, cache.accounts, int(tc.rows), "both suspension and recovery must update the scheduler cache")
+			if tc.rows == 1 {
+				require.Equal(t, tc.target, cache.accounts[0].Schedulable)
+			}
+			_, where, ok := strings.Cut(mutationSQL, " WHERE ")
+			require.True(t, ok)
+			for _, guard := range []string{"updated_at", "platform", "type", "status", "deleted_at", "parent_account_id", "schedulable", "proxy_id", "proxies", "protocol", "host", "port", "username", "password"} {
+				require.Contains(t, where, guard, "scheduling must compare account and proxy identity")
+			}
+			require.GreaterOrEqual(t, strings.Count(where, "expires_at"), 4, "account and proxy expiry are checked at mutation time")
+			if tc.username == "" {
+				require.Contains(t, where, `"username" IS NULL`)
+				require.Contains(t, where, `"password" IS NULL`)
+			}
+			set, _, _ := strings.Cut(mutationSQL, " WHERE ")
+			for _, untouched := range []string{"status", "credentials", "proxy_id", "rate_limit_reset_at", "temp_unschedulable_until", "overload_until", "error_message"} {
+				require.NotContains(t, set, untouched, "monitor must preserve unrelated account state")
+			}
+		})
+	}
+}
+
+func TestGPTMonitorSchedulingRejectsIneligibleSnapshotWithoutSQL(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		edit func(*service.Account) *service.Account
+	}{
+		{"nil", func(*service.Account) *service.Account { return nil }},
+		{"API Key account", func(a *service.Account) *service.Account { a.Type = service.AccountTypeAPIKey; return a }},
+		{"other platform", func(a *service.Account) *service.Account { a.Platform = service.PlatformAnthropic; return a }},
+		{"inactive", func(a *service.Account) *service.Account { a.Status = "disabled"; return a }},
+		{"shadow", func(a *service.Account) *service.Account { id := int64(1); a.ParentAccountID = &id; return a }},
+		{"missing proxy ID", func(a *service.Account) *service.Account { a.ProxyID = nil; return a }},
+		{"missing proxy", func(a *service.Account) *service.Account { a.Proxy = nil; return a }},
+		{"mismatched proxy", func(a *service.Account) *service.Account { a.Proxy.ID++; return a }},
+		{"inactive proxy", func(a *service.Account) *service.Account { a.Proxy.Status = "disabled"; return a }},
+		{"expired proxy", func(a *service.Account) *service.Account {
+			old := time.Now().Add(-time.Second)
+			a.Proxy.ExpiresAt = &old
+			return a
+		}},
+		{"expired account", func(a *service.Account) *service.Account {
+			old := time.Now().Add(-time.Second)
+			a.ExpiresAt = &old
+			a.AutoPauseOnExpired = false
+			return a
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			// Nil storage intentionally panics on any attempt to touch the database.
+			repo := &accountRepository{}
+			for _, target := range []bool{false, true} {
+				changed, err := repo.SetGPTMonitorSchedulableIfMatch(context.Background(), tc.edit(gptMonitorAccountSnapshot()), target)
+				require.NoError(t, err)
+				require.False(t, changed)
+			}
+		})
+	}
+}
+
+func TestGPTMonitorSchedulingDatabaseFailureDoesNotPropagate(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = db.Close() })
+	client := dbent.NewClient(dbent.Driver(entsql.OpenDB(dialect.Postgres, db)))
+	t.Cleanup(func() { _ = client.Close() })
+	repo := newAccountRepositoryWithSQL(client, db, &gptMonitorCacheRecorder{})
+	mock.ExpectBegin()
+	mock.ExpectExec(`UPDATE "accounts"`).WillReturnError(errors.New("database unavailable"))
+	mock.ExpectRollback()
+	changed, err := repo.SetGPTMonitorSchedulableIfMatch(context.Background(), gptMonitorAccountSnapshot(), false)
+	require.Error(t, err)
+	require.False(t, changed)
+	require.NoError(t, mock.ExpectationsWereMet())
+}
+
+func TestGPTMonitorSchedulingRollsBackWhenNotificationFails(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = db.Close() })
+	client := dbent.NewClient(dbent.Driver(entsql.OpenDB(dialect.Postgres, db)))
+	t.Cleanup(func() { _ = client.Close() })
+	cache := &gptMonitorCacheRecorder{}
+	repo := newAccountRepositoryWithSQL(client, db, cache)
+	mock.ExpectBegin()
+	mock.ExpectExec(`UPDATE "accounts"`).WillReturnResult(sqlmock.NewResult(0, 1))
+	mock.ExpectExec(regexp.QuoteMeta("INSERT INTO scheduler_outbox")).WillReturnError(errors.New("outbox unavailable"))
+	mock.ExpectRollback()
+	changed, err := repo.SetGPTMonitorSchedulableIfMatch(context.Background(), gptMonitorAccountSnapshot(), false)
+	require.Error(t, err)
+	require.False(t, changed)
+	require.Empty(t, cache.accounts, "an uncommitted change must never reach the scheduler cache")
+	require.NoError(t, mock.ExpectationsWereMet())
+}
+
+func TestGPTMonitorResultDoesNotRebuildSchedulerOrInvalidateSnapshot(t *testing.T) {
+	for _, count := range []int64{0, 1} {
+		db, mock, err := sqlmock.New()
+		require.NoError(t, err)
+		t.Cleanup(func() { _ = db.Close() })
+		client := dbent.NewClient(dbent.Driver(entsql.OpenDB(dialect.Postgres, db)))
+		t.Cleanup(func() { _ = client.Close() })
+		cache := &gptMonitorCacheRecorder{}
+		repo := newAccountRepositoryWithSQL(client, db, cache)
+		mock.ExpectExec(regexp.QuoteMeta("UPDATE accounts SET extra = COALESCE(extra, '{}'::jsonb) || $1::jsonb WHERE id = $2 AND deleted_at IS NULL")).
+			WithArgs(sqlmock.AnyArg(), int64(17)).WillReturnResult(sqlmock.NewResult(0, count))
+		err = repo.UpdateGPTMonitorResult(context.Background(), 17, service.GPTAccountMonitorResult{Verdict: "normal", Schedulable: true})
+		if count == 0 {
+			require.ErrorIs(t, err, service.ErrAccountNotFound)
+		} else {
+			require.NoError(t, err)
+		}
+		require.Empty(t, cache.accounts)
+		require.NoError(t, mock.ExpectationsWereMet(), "saving observations needs only one write, with no transaction, cache read or outbox")
+	}
+}
