index 0000000..cea0480
--- /dev/null
+++ b/backend/internal/config/gpt_account_monitor_test.go
@@ -0,0 +1,115 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestGPTAccountMonitorDefaults(t *testing.T) {
+	resetViperWithJWTSecret(t)
+	cfg, err := Load()
+	require.NoError(t, err)
+	m := cfg.GPTAccountMonitor
+	require.False(t, m.Enabled)
+	require.Equal(t, 1800, m.IntervalSeconds)
+	require.Equal(t, 90, m.TimeoutSeconds)
+	require.Equal(t, 3, m.Concurrency)
+	require.Equal(t, "gpt-6-astra", m.Model)
+	require.Equal(t, "xhigh", m.ReasoningEffort)
+	require.Equal(t, DefaultGPTAccountMonitorPrompt, m.Prompt)
+	require.Equal(t, 17, m.ExpectedGeneration)
+	require.Empty(t, m.AccountIDs)
+	require.True(t, m.RunOnStart)
+}
+
+func TestGPTAccountMonitorEnvironmentOverrides(t *testing.T) {
+	resetViperWithJWTSecret(t)
+	for key, value := range map[string]string{
+		"GPT_ACCOUNT_MONITOR_ENABLED":             "true",
+		"GPT_ACCOUNT_MONITOR_INTERVAL_SECONDS":    "600",
+		"GPT_ACCOUNT_MONITOR_TIMEOUT_SECONDS":     "45",
+		"GPT_ACCOUNT_MONITOR_CONCURRENCY":         "2",
+		"GPT_ACCOUNT_MONITOR_MODEL":               " custom-model ",
+		"GPT_ACCOUNT_MONITOR_REASONING_EFFORT":    "low",
+		"GPT_ACCOUNT_MONITOR_PROMPT":              " custom prompt ",
+		"GPT_ACCOUNT_MONITOR_EXPECTED_GENERATION": "18",
+		"GPT_ACCOUNT_MONITOR_ACCOUNT_IDS":         "12,34",
+		"GPT_ACCOUNT_MONITOR_RUN_ON_START":        "false",
+	} {
+		t.Setenv(key, value)
+	}
+	cfg, err := Load()
+	require.NoError(t, err)
+	require.Equal(t, GPTAccountMonitorConfig{
+		Enabled: true, IntervalSeconds: 600, TimeoutSeconds: 45, Concurrency: 2,
+		Model: GPTAccountMonitorModel, ReasoningEffort: GPTAccountMonitorReasoningEffort, Prompt: "custom prompt", ExpectedGeneration: 18,
+		AccountIDs: []int64{12, 34}, RunOnStart: false,
+	}, cfg.GPTAccountMonitor)
+}
+
+func TestGPTAccountMonitorYAML(t *testing.T) {
+	resetViperWithJWTSecret(t)
+	file := filepath.Join(t.TempDir(), "config.yaml")
+	require.NoError(t, os.WriteFile(file, []byte("gpt_account_monitor:\n  enabled: true\n  model: legacy-model\n  reasoning_effort: low\n  account_ids: [41, 42]\n  run_on_start: false\n"), 0o600))
+	t.Setenv("CONFIG_FILE", file)
+	cfg, err := Load()
+	require.NoError(t, err)
+	require.True(t, cfg.GPTAccountMonitor.Enabled)
+	require.Equal(t, []int64{41, 42}, cfg.GPTAccountMonitor.AccountIDs)
+	require.False(t, cfg.GPTAccountMonitor.RunOnStart)
+	require.Equal(t, "gpt-6-astra", cfg.GPTAccountMonitor.Model)
+	require.Equal(t, "xhigh", cfg.GPTAccountMonitor.ReasoningEffort)
+}
+
+func TestGPTAccountMonitorValidation(t *testing.T) {
+	valid := GPTAccountMonitorConfig{
+		Enabled: true, IntervalSeconds: 1800, TimeoutSeconds: 90, Concurrency: 3,
+		Model: GPTAccountMonitorModel, ReasoningEffort: GPTAccountMonitorReasoningEffort, Prompt: DefaultGPTAccountMonitorPrompt, ExpectedGeneration: 17,
+	}
+	for _, tc := range []struct {
+		name   string
+		change func(*GPTAccountMonitorConfig)
+	}{
+		{"interval_low", func(c *GPTAccountMonitorConfig) { c.IntervalSeconds = 59 }},
+		{"interval_high", func(c *GPTAccountMonitorConfig) { c.IntervalSeconds = 86401 }},
+		{"timeout_low", func(c *GPTAccountMonitorConfig) { c.TimeoutSeconds = 9 }},
+		{"timeout_high", func(c *GPTAccountMonitorConfig) { c.TimeoutSeconds = 301 }},
+		{"concurrency_low", func(c *GPTAccountMonitorConfig) { c.Concurrency = 0 }},
+		{"concurrency_high", func(c *GPTAccountMonitorConfig) { c.Concurrency = 11 }},
+		{"model_empty", func(c *GPTAccountMonitorConfig) { c.Model = " " }},
+		{"model_override", func(c *GPTAccountMonitorConfig) { c.Model = "gpt-5.4" }},
+		{"effort_empty", func(c *GPTAccountMonitorConfig) { c.ReasoningEffort = "" }},
+		{"effort_override", func(c *GPTAccountMonitorConfig) { c.ReasoningEffort = "low" }},
+		{"prompt_empty", func(c *GPTAccountMonitorConfig) { c.Prompt = " " }},
+		{"generation_low", func(c *GPTAccountMonitorConfig) { c.ExpectedGeneration = 0 }},
+		{"generation_high", func(c *GPTAccountMonitorConfig) { c.ExpectedGeneration = 100 }},
+		{"account_zero", func(c *GPTAccountMonitorConfig) { c.AccountIDs = []int64{0} }},
+		{"account_negative", func(c *GPTAccountMonitorConfig) { c.AccountIDs = []int64{-1} }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := valid
+			tc.change(&cfg)
+			require.ErrorContains(t, cfg.Validate(), "gpt_account_monitor.")
+			cfg.Enabled = false
+			require.Error(t, cfg.Validate(), "disabled settings must still be safe to save from the management page")
+		})
+	}
+	require.NoError(t, valid.Validate())
+	valid.IntervalSeconds, valid.TimeoutSeconds, valid.Concurrency = 60, 10, 1
+	valid.ExpectedGeneration = 1
+	require.NoError(t, valid.Validate())
+	valid.IntervalSeconds, valid.TimeoutSeconds, valid.Concurrency = 86400, 300, 10
+	valid.ExpectedGeneration = 99
+	require.NoError(t, valid.Validate())
+}
+
+func TestGPTAccountMonitorRejectsInvalidEnabledEnvironment(t *testing.T) {
+	resetViperWithJWTSecret(t)
+	t.Setenv("GPT_ACCOUNT_MONITOR_ENABLED", "true")
+	t.Setenv("GPT_ACCOUNT_MONITOR_INTERVAL_SECONDS", "59")
+	_, err := Load()
+	require.ErrorContains(t, err, "gpt_account_monitor.interval_seconds")
+}
diff --git a/backend/internal/handler/admin/gpt_account_monitor_handler.go b/backend/internal/handler/admin/gpt_account_monitor_handler.go
new file mode 100644
index 0000000..6045689
--- /dev/null
+++ b/backend/internal/handler/admin/gpt_account_monitor_handler.go
@@ -0,0 +1,143 @@
+package admin
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+type gptAccountMonitorService interface {
+	GetConfig(context.Context) (config.GPTAccountMonitorConfig, error)
+	SaveConfig(context.Context, config.GPTAccountMonitorConfig) (config.GPTAccountMonitorConfig, error)
+	Status(context.Context) (service.GPTAccountMonitorStatus, error)
+	RunNow(context.Context) (bool, error)
+}
+
+// GPTAccountMonitorHandler is registered only within the existing admin group.
+type GPTAccountMonitorHandler struct {
+	monitor gptAccountMonitorService
+}
+
+func NewGPTAccountMonitorHandler(monitor *service.GPTAccountMonitorService) *GPTAccountMonitorHandler {
+	h := &GPTAccountMonitorHandler{}
+	if monitor != nil {
+		h.monitor = monitor
+	}
+	return h
+}
+
+func (h *GPTAccountMonitorHandler) ready(c *gin.Context) bool {
+	if h == nil || h.monitor == nil {
+		response.Error(c, http.StatusServiceUnavailable, "账号检查服务暂不可用")
+		return false
+	}
+	return true
+}
+
+func (h *GPTAccountMonitorHandler) GetConfig(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	cfg, err := h.monitor.GetConfig(c.Request.Context())
+	if err != nil {
+		response.InternalError(c, "读取账号检查配置失败")
+		return
+	}
+	if cfg.AccountIDs == nil {
+		cfg.AccountIDs = []int64{}
+	}
+	response.Success(c, cfg)
+}
+
+// Mutable fields are required because this endpoint replaces the settings.
+// Model fields are optional compatibility inputs; their values are fixed below.
+// Pointer fields distinguish false/zero values from absent or null.
+type gptAccountMonitorConfigRequest struct {
+	Enabled            *bool    `json:"enabled"`
+	IntervalSeconds    *int     `json:"interval_seconds"`
+	TimeoutSeconds     *int     `json:"timeout_seconds"`
+	Concurrency        *int     `json:"concurrency"`
+	Model              *string  `json:"model"`
+	ReasoningEffort    *string  `json:"reasoning_effort"`
+	Prompt             *string  `json:"prompt"`
+	ExpectedGeneration *int     `json:"expected_generation"`
+	AccountIDs         *[]int64 `json:"account_ids"`
+	RunOnStart         *bool    `json:"run_on_start"`
+}
+
+func (h *GPTAccountMonitorHandler) SaveConfig(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	decoder := json.NewDecoder(http.MaxBytesReader(c.Writer, c.Request.Body, 32*1024))
+	decoder.DisallowUnknownFields()
+	var request gptAccountMonitorConfigRequest
+	if err := decoder.Decode(&request); err != nil {
+		response.BadRequest(c, "配置必须是有效 JSON，且不能包含未知字段或超过 32 KB")
+		return
+	}
+	if err := decoder.Decode(&struct{}{}); err != io.EOF {
+		response.BadRequest(c, "配置只能包含一个 JSON 对象")
+		return
+	}
+	if request.Enabled == nil || request.IntervalSeconds == nil || request.TimeoutSeconds == nil || request.Concurrency == nil || request.Prompt == nil || request.ExpectedGeneration == nil || request.AccountIDs == nil || request.RunOnStart == nil {
+		response.BadRequest(c, "请提交完整的账号检查配置")
+		return
+	}
+	cfg := config.GPTAccountMonitorConfig{
+		Enabled: *request.Enabled, IntervalSeconds: *request.IntervalSeconds,
+		TimeoutSeconds: *request.TimeoutSeconds, Concurrency: *request.Concurrency,
+		Prompt:             strings.TrimSpace(*request.Prompt),
+		ExpectedGeneration: *request.ExpectedGeneration, AccountIDs: *request.AccountIDs,
+		RunOnStart: *request.RunOnStart,
+	}
+	cfg.NormalizeFixedModel()
+	if err := cfg.Validate(); err != nil {
+		response.BadRequest(c, "配置无效：间隔 60–86400 秒、超时 10–300 秒、并发 1–10、代数 1–99；问题不能为空，账号 ID 必须为正整数")
+		return
+	}
+	saved, err := h.monitor.SaveConfig(c.Request.Context(), cfg)
+	if err != nil {
+		response.InternalError(c, "保存账号检查配置失败")
+		return
+	}
+	if saved.AccountIDs == nil {
+		saved.AccountIDs = []int64{}
+	}
+	response.Success(c, saved)
+}
+
+func (h *GPTAccountMonitorHandler) Status(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	status, err := h.monitor.Status(c.Request.Context())
+	if err != nil {
+		response.InternalError(c, "读取账号检查状态失败")
+		return
+	}
+	response.Success(c, status)
+}
+
+func (h *GPTAccountMonitorHandler) RunNow(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	queued, err := h.monitor.RunNow(c.Request.Context())
+	if err != nil {
+		response.Error(c, http.StatusServiceUnavailable, "暂时无法启动检查，请确认配置已启用并稍后重试")
+		return
+	}
+	message := "检查已在运行或已排队"
+	if queued {
+		message = "已提交立即检查任务"
+	}
+	response.Success(c, gin.H{"queued": queued, "message": message})
+}
