new file mode 100644
index 0000000..dd9a1e5
--- /dev/null
+++ b/backend/internal/service/gpt_account_monitor_probe.go
@@ -0,0 +1,328 @@
+package service
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+	"unicode"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+)
+
+// This private context value is honored only by monitor-initiated token refresh.
+// Pin the full proxy identity so refresh cannot silently change egress or go direct.
+type gptMonitorProxyContextKey struct{}
+type gptMonitorPinnedProxy struct {
+	ID        int64
+	URL       string
+	UpdatedAt time.Time
+}
+
+func validateGPTMonitorProxy(proxy *Proxy) error {
+	if proxy == nil || !proxy.IsActive() || proxy.IsExpired(time.Now()) || strings.TrimSpace(proxy.Host) == "" || proxy.Port < 1 || proxy.Port > 65535 {
+		return errors.New("账号必须绑定启用且未过期的代理")
+	}
+	if _, err := validGPTMonitorProxyURL(proxy.URL()); err != nil {
+		return err
+	}
+	return nil
+}
+
+func validateGPTMonitorAccount(account *Account) error {
+	if account == nil || !account.IsActive() || !account.IsOpenAIOAuth() || account.IsShadow() || account.IsOpenAIAgentIdentity() {
+		return errors.New("检测仅支持启用的独立 OpenAI OAuth 账号")
+	}
+	if account.ExpiresAt != nil && !account.ExpiresAt.After(time.Now()) {
+		return errors.New("账号已过期（不改变调度）")
+	}
+	if account.ProxyID == nil || account.Proxy == nil || account.Proxy.ID != *account.ProxyID {
+		return errors.New("账号未绑定有效代理（不改变调度）")
+	}
+	return validateGPTMonitorProxy(account.Proxy)
+}
+
+// ProbeGPTAccount uses the account's own OAuth credentials and pinned proxy.
+// The returned snapshot was reread after token refresh and is suitable for the
+// caller's conditional scheduling update. Errors never count as a bad answer.
+func (s *OpenAIGatewayService) ProbeGPTAccount(ctx context.Context, accountID int64, _ string, prompt string) (*Account, string, error) {
+	if s == nil || s.accountRepo == nil || accountID <= 0 {
+		return nil, "", errors.New("账号检测服务不可用")
+	}
+	if strings.TrimSpace(prompt) == "" || len(prompt) > 8192 {
+		return nil, "", errors.New("检测问题无效")
+	}
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Minute)
+	defer cancel()
+	account, token, err := s.resolveGPTMonitorIdentity(ctx, accountID)
+	if err != nil {
+		return nil, "", err
+	}
+	client, transport, err := newGPTMonitorClient(account.Proxy.URL())
+	if err != nil {
+		return account, "", err
+	}
+	defer transport.CloseIdleConnections()
+	answer, err := gptMonitorProbeWithClient(ctx, client, account, token, config.GPTAccountMonitorModel, prompt)
+	return account, answer, err
+}
+
+func (s *OpenAIGatewayService) resolveGPTMonitorIdentity(ctx context.Context, accountID int64) (*Account, string, error) {
+	account, err := s.accountRepo.GetByID(ctx, accountID)
+	if err != nil {
+		return nil, "", errors.New("读取账号失败（不改变调度）")
+	}
+	if err := validateGPTMonitorAccount(account); err != nil {
+		return nil, "", err
+	}
+	if account.ID != accountID {
+		return nil, "", errors.New("账号已变化，请重新检测")
+	}
+	// The regular provider disables irrecoverably expired credentials. A monitor
+	// must leave scheduling alone when token acquisition cannot be completed.
+	if expires := account.GetCredentialAsTime("expires_at"); expires != nil && !expires.After(time.Now()) && strings.TrimSpace(account.GetOpenAIRefreshToken()) == "" && !account.IsOpenAIPersonalAccessToken() {
+		return nil, "", errors.New("访问令牌已过期且无法刷新（不改变调度）")
+	}
+	pinned := gptMonitorPinnedProxy{ID: account.Proxy.ID, URL: account.Proxy.URL(), UpdatedAt: account.Proxy.UpdatedAt}
+	ctx = context.WithValue(ctx, gptMonitorProxyContextKey{}, pinned)
+	token, _, err := s.GetAccessToken(ctx, account)
+	if err != nil || strings.TrimSpace(token) == "" {
+		return nil, "", errors.New("获取账号访问令牌失败（不改变调度）")
+	}
+	account, err = s.accountRepo.GetByID(ctx, accountID)
+	if err != nil {
+		return nil, "", errors.New("重新读取账号失败（不改变调度）")
+	}
+	if err := validateGPTMonitorAccount(account); err != nil {
+		return nil, "", err
+	}
+	if account.ID != accountID || account.Proxy.ID != pinned.ID || account.Proxy.URL() != pinned.URL || !account.Proxy.UpdatedAt.Equal(pinned.UpdatedAt) {
+		return nil, "", errors.New("账号代理已变化，请重新检测")
+	}
+	if token != account.GetOpenAIAccessToken() {
+		return nil, "", errors.New("账号凭据已变化，请重新检测")
+	}
+	return account, token, nil
+}
+
+// Keep the generation in one contiguous capture. Removing punctuation or
+// whitespace from the whole answer would turn "iPhone 1.7" into "iPhone 17".
+var gptMonitorAnswerPattern = regexp.MustCompile(`^(?:(?:(?:我知道的|据我所知)?\s*(?:最新的?|苹果最新的?)?\s*(?:苹果手机|手机|型号)\s*(?:是|为)?|(?:最新的?|苹果最新的?)\s*(?:是|为)?)\s*[:：]?\s*)?[*_\x60"'“‘]*(?:苹果(?:公司)?(?:的)?\s*|apple\s*)?(?:iphone|苹果)\s*([1-9][0-9]?)(?:\s*(?:pro(?:\s*max)?|plus|e))?(?:\s*系列)?$`)
+
+// GPTAccountAnswerMatches accepts only a short, affirmative model name.
+// Merely mentioning 17 (e.g. "not iPhone 17" or "16; maybe 17") must not pass.
+func GPTAccountAnswerMatches(answer string, generation int) bool {
+	if len(answer) > 512 || generation < 1 || generation > 99 {
+		return false
+	}
+	answer = strings.ToLower(strings.TrimSpace(answer))
+	answer = strings.Map(func(r rune) rune {
+		if r >= '０' && r <= '９' {
+			return r - '０' + '0'
+		}
+		if unicode.IsSpace(r) {
+			return ' '
+		}
+		return r
+	}, answer)
+	answer = strings.Trim(answer, " *`_\"'“”‘’。.!！,，:：")
+	match := gptMonitorAnswerPattern.FindStringSubmatch(answer)
+	return len(match) == 2 && match[1] == strconv.Itoa(generation)
+}
+
+func validGPTMonitorProxyURL(raw string) (*url.URL, error) {
+	u, err := url.Parse(raw)
+	if err != nil || u.Hostname() == "" || u.Fragment != "" || u.RawQuery != "" || (u.Path != "" && u.Path != "/") {
+		return nil, errors.New("账号代理地址无效")
+	}
+	switch u.Scheme {
+	case "http", "https", "socks5", "socks5h":
+	default:
+		return nil, errors.New("账号代理协议不受支持")
+	}
+	return u, nil
+}
+
+func newGPTMonitorClient(proxyURL string) (*http.Client, *http.Transport, error) {
+	proxy, err := validGPTMonitorProxyURL(proxyURL)
+	if err != nil {
+		return nil, nil, err
+	}
+	// Never inherit HTTP_PROXY / HTTPS_PROXY or silently retry directly.
+	transport := &http.Transport{Proxy: http.ProxyURL(proxy),
+		DialContext:       (&net.Dialer{Timeout: 30 * time.Second, KeepAlive: 30 * time.Second}).DialContext,
+		ForceAttemptHTTP2: true, MaxIdleConns: 1, MaxIdleConnsPerHost: 1,
+		IdleConnTimeout: 30 * time.Second, TLSHandshakeTimeout: 15 * time.Second,
+		ResponseHeaderTimeout: 90 * time.Second, ExpectContinueTimeout: time.Second,
+	}
+	client := &http.Client{Transport: transport, Timeout: 5 * time.Minute, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	return client, transport, nil
+}
+
+func gptMonitorProbeWithClient(ctx context.Context, client *http.Client, account *Account, token, _ string, prompt string) (string, error) {
+	// Fixed independently of saved settings, account mappings and routing aliases.
+	// An unavailable model/effort is a probe error; never retry with another model.
+	payload := map[string]any{
+		"model": config.GPTAccountMonitorModel, "reasoning": map[string]any{"effort": config.GPTAccountMonitorReasoningEffort},
+		"instructions": "Answer the user's question from your existing knowledge only. Do not browse, search, call tools, or guess. Respond with only the phone model you know.",
+		"input":        []any{map[string]any{"role": "user", "content": []any{map[string]any{"type": "input_text", "text": prompt}}}},
+		"stream":       true, "store": false, "tools": []any{}, "tool_choice": "none",
+	}
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return "", errors.New("无法构造检测请求")
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, chatgptCodexURL, bytes.NewReader(body))
+	if err != nil {
+		return "", errors.New("无法构造检测请求")
+	}
+	setOpenAIChatGPTAccountHeaders(req.Header, account)
+	applyOpenAICodexProbeHeaders(req.Header)
+	if ua := strings.TrimSpace(account.GetOpenAIUserAgent()); ua != "" {
+		req.Header.Set("User-Agent", ua)
+	}
+	enforceCodexIdentityHeadersWithUA(req.Header, account.GetOpenAIUserAgent())
+	account.ApplyHeaderOverrides(req.Header)
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "text/event-stream")
+	req.Header.Set("OpenAI-Beta", "responses=experimental")
+	resp, err := client.Do(req)
+	if err != nil {
+		return "", errors.New("上游连接失败或超时（不改变调度）")
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("上游 HTTP %d（不改变调度）", resp.StatusCode)
+	}
+	return readGPTMonitorResponse(resp.Body)
+}
+
+// Only response.completed with completed status and assistant output_text counts.
+// Deltas, reasoning, tool calls, truncated streams and [DONE] alone cannot pass.
+func readGPTMonitorResponse(body io.Reader) (string, error) {
+	limited := &io.LimitedReader{R: body, N: 2*1024*1024 + 1}
+	reader := bufio.NewScanner(limited)
+	reader.Buffer(make([]byte, 4096), 256*1024)
+	var data []string
+	var deltaBytes int
+	sawTool := false
+	consume := func() (string, bool, error) {
+		if limited.N <= 0 {
+			return "", false, errors.New("上游响应超过大小限制")
+		}
+		if len(data) == 0 {
+			return "", false, nil
+		}
+		raw := strings.Join(data, "\n")
+		data = nil
+		if raw == "[DONE]" {
+			return "", false, errors.New("响应缺少完整结束事件")
+		}
+		var event struct {
+			Type  string `json:"type"`
+			Delta string `json:"delta"`
+			Item  struct {
+				Type string `json:"type"`
+			} `json:"item"`
+			Response struct {
+				Status string `json:"status"`
+				Output []struct {
+					Type    string `json:"type"`
+					Role    string `json:"role"`
+					Content []struct {
+						Type string `json:"type"`
+						Text string `json:"text"`
+					} `json:"content"`
+				} `json:"output"`
+			} `json:"response"`
+		}
+		if err := json.Unmarshal([]byte(raw), &event); err != nil {
+			return "", false, errors.New("上游返回无效事件")
+		}
+		if isGPTMonitorToolEvent(event.Type) || isGPTMonitorToolEvent(event.Item.Type) || strings.HasSuffix(event.Item.Type, "_call") {
+			sawTool = true
+		}
+		switch event.Type {
+		case "error", "response.failed", "response.incomplete":
+			return "", false, errors.New("上游响应失败或未完成")
+		case "response.output_text.delta":
+			deltaBytes += len(event.Delta)
+			if deltaBytes > 32768 {
+				return "", false, errors.New("回答超过长度限制")
+			}
+		case "response.completed":
+			if event.Response.Status != "completed" {
+				return "", false, errors.New("上游响应状态未完成")
+			}
+			var output strings.Builder
+			for _, item := range event.Response.Output {
+				if isGPTMonitorToolEvent(item.Type) || strings.HasSuffix(item.Type, "_call") {
+					sawTool = true
+				}
+				if item.Type != "message" || item.Role != "assistant" {
+					continue
+				}
+				for _, part := range item.Content {
+					if part.Type == "refusal" {
+						return "", false, errors.New("上游拒绝回答")
+					}
+					if part.Type == "output_text" {
+						output.WriteString(part.Text)
+					}
+				}
+			}
+			if sawTool {
+				return "", false, errors.New("检测响应包含工具调用，已忽略")
+			}
+			answer := strings.TrimSpace(output.String())
+			if answer == "" {
+				return "", false, errors.New("上游没有返回最终文本")
+			}
+			if len(answer) > 32768 {
+				return "", false, errors.New("回答超过长度限制")
+			}
+			return answer, true, nil
+		}
+		return "", false, nil
+	}
+	for reader.Scan() {
+		line := strings.TrimSuffix(reader.Text(), "\r")
+		if line == "" {
+			answer, done, err := consume()
+			if err != nil || done {
+				return answer, err
+			}
+			continue
+		}
+		if strings.HasPrefix(line, "data:") {
+			data = append(data, strings.TrimPrefix(strings.TrimPrefix(line, "data:"), " "))
+		}
+	}
+	if reader.Err() != nil {
+		return "", errors.New("读取上游响应失败")
+	}
+	if answer, done, err := consume(); err != nil || done {
+		return answer, err
+	}
+	return "", errors.New("上游响应中断，未收到完整回答")
+}
+
+func isGPTMonitorToolEvent(eventType string) bool {
+	for _, kind := range []string{"web_search", "file_search", "function_call", "computer_call", "code_interpreter", "image_generation", "mcp_", "tool_call", "custom_tool"} {
+		if strings.Contains(eventType, kind) {
+			return true
+		}
+	}
+	return false
+}
