@@ -0,0 +1,96 @@
+package service
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestGPTMonitorClassifyOnlyDefiniteGeneration(t *testing.T) {
+	for _, answer := range []string{"iPhone 17", "苹果17", "苹果 iPhone １７ Pro Max", "最新型号是 iPhone 17。", "iPhone 17、iPhone 17 Pro 和 iPhone 17 Pro Max", "iPhone17Air", "Apple 17"} {
+		verdict, err := ClassifyGPTAccountAnswer(answer, 17)
+		require.NoError(t, err, answer)
+		require.Equal(t, "normal", verdict, answer)
+	}
+	for _, answer := range []string{"iPhone 16", "最新苹果手机是 iPhone 18 Pro", "苹果15"} {
+		verdict, err := ClassifyGPTAccountAnswer(answer, 17)
+		require.NoError(t, err, answer)
+		require.Equal(t, "abnormal", verdict, answer)
+	}
+	for _, answer := range []string{"", "17", "iPhone 1.7", "iPhone 017", "iPhone 1 7", "iPhone 1**7", "iPhone170", "iPhone17banana", "可能是 iPhone 17", "不是 iPhone 17", "我不知道 iPhone 17", "iPhone 17?", "iPhone 16 或 iPhone 17", "iPhone 17 or 18", "iPhone 17/18", "iPhone 17 未发布", "I think iPhone17", "Not iPhone17", "Maybe iPhone17"} {
+		verdict, err := ClassifyGPTAccountAnswer(answer, 17)
+		require.Error(t, err, answer)
+		require.Equal(t, "error", verdict, answer)
+	}
+	verdict, err := ClassifyGPTAccountAnswer("iPhone 18", 18)
+	require.NoError(t, err)
+	require.Equal(t, "normal", verdict)
+}
+
+func TestGPTMonitorConfirmationRequiresTwoConsistentAutomaticSamples(t *testing.T) {
+	now := time.Date(2026, 10, 13, 10, 0, 0, 0, time.UTC)
+	current := GPTAccountMonitorResult{Verdict: "abnormal", Model: "gpt-6-astra", ReasoningEffort: "xhigh", ExpectedGeneration: 17, Schedulable: true}
+	first, apply := gptMonitorConfirmResult(current, GPTAccountMonitorResult{}, "config-a", now)
+	require.False(t, apply)
+	require.True(t, first.Schedulable)
+	require.Equal(t, "abnormal", first.PendingVerdict)
+	require.Equal(t, 1, first.Consecutive)
+	require.Equal(t, now, *first.PendingCheckedAt)
+	require.Equal(t, now.Add(5*time.Minute), *first.NextCheckAt)
+	second, apply := gptMonitorConfirmResult(current, first, "config-a", now.Add(5*time.Minute))
+	require.True(t, apply)
+	require.Equal(t, 2, second.Consecutive)
+	require.Empty(t, second.PendingVerdict)
+	require.Nil(t, second.PendingCheckedAt)
+	require.Nil(t, second.NextCheckAt)
+	first.Schedulable = false
+	current.Schedulable = false
+	current.Verdict = "normal"
+	recovery, apply := gptMonitorConfirmResult(current, first, "config-a", now.Add(5*time.Minute))
+	require.False(t, apply)
+	require.Equal(t, "normal", recovery.PendingVerdict)
+	_, apply = gptMonitorConfirmResult(current, recovery, "config-a", now.Add(10*time.Minute))
+	require.True(t, apply)
+}
+
+func TestGPTMonitorConfirmationInvalidatesChangedSettingsErrorsAndWindow(t *testing.T) {
+	now := time.Date(2026, 10, 13, 10, 0, 0, 0, time.UTC)
+	current := GPTAccountMonitorResult{Verdict: "abnormal", Model: "gpt-6-astra", ReasoningEffort: "xhigh", ExpectedGeneration: 17, Schedulable: true}
+	previous, _ := gptMonitorConfirmResult(current, GPTAccountMonitorResult{}, "config-a", now)
+	for name, mutate := range map[string]func(*GPTAccountMonitorResult){
+		"config":     func(r *GPTAccountMonitorResult) { r.ConfigKey = "config-b" },
+		"model":      func(r *GPTAccountMonitorResult) { r.Model = "other" },
+		"effort":     func(r *GPTAccountMonitorResult) { r.ReasoningEffort = "low" },
+		"generation": func(r *GPTAccountMonitorResult) { r.ExpectedGeneration = 18 },
+		"pending":    func(r *GPTAccountMonitorResult) { r.PendingVerdict = "normal" },
+		"no_sample":  func(r *GPTAccountMonitorResult) { r.PendingCheckedAt = nil },
+		"count":      func(r *GPTAccountMonitorResult) { r.Consecutive = 2 },
+	} {
+		t.Run(name, func(t *testing.T) {
+			old := previous
+			mutate(&old)
+			result, apply := gptMonitorConfirmResult(current, old, "config-a", now.Add(5*time.Minute))
+			require.False(t, apply)
+			require.Equal(t, 1, result.Consecutive)
+		})
+	}
+	for _, age := range []time.Duration{4 * time.Minute, 5*time.Minute - time.Nanosecond, 10*time.Minute + time.Nanosecond, 11 * time.Minute, -time.Minute} {
+		_, apply := gptMonitorConfirmResult(current, previous, "config-a", now.Add(age))
+		require.False(t, apply)
+	}
+	_, apply := gptMonitorConfirmResult(current, previous, "config-a", now.Add(10*time.Minute))
+	require.True(t, apply)
+	current.Verdict = "error"
+	failed, apply := gptMonitorConfirmResult(current, previous, "config-a", now.Add(5*time.Minute))
+	require.False(t, apply)
+	require.Empty(t, failed.PendingVerdict)
+	require.Zero(t, failed.Consecutive)
+	require.Nil(t, failed.PendingCheckedAt)
+	require.Equal(t, now.Add(10*time.Minute), *failed.NextCheckAt)
+	current.Verdict = "normal"
+	unchanged, apply := gptMonitorConfirmResult(current, previous, "config-a", now.Add(5*time.Minute))
+	require.False(t, apply)
+	require.Zero(t, unchanged.Consecutive)
+	require.Nil(t, unchanged.NextCheckAt)
+}
