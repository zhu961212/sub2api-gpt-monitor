+}
+function configFingerprint(config: GPTAccountRecoveryConfig) {
+  return JSON.stringify([config.enabled, config.interval_seconds, config.timeout_seconds, config.max_attempts, config.transport, config.gateway, config.ticket_length, config.ticket_ttl_seconds, config.cookie_ttl_seconds, config.share_route_cookies, [...config.share_route_donor_account_ids].sort((a, b) => a - b), config.proxy_session_mode, config.proxy_session_ttl_seconds, [...config.account_ids].sort((a, b) => a - b), config.run_on_start])
+}
+const dirty = computed(() => savedConfig.value !== null && (configFingerprint(snapshot()) !== configFingerprint(savedConfig.value) || scope.value !== (savedConfig.value.account_ids.length ? 'selected' : 'all')))
+function applyConfig(value: GPTAccountRecoveryConfig | GPTAccountRecoveryConfigResponse) {
+  if ('proxy_override_configured' in value) proxyOverrideConfigured.value = value.proxy_override_configured === true
+  const normalized: GPTAccountRecoveryConfig = {
+    enabled: value.enabled, interval_seconds: value.interval_seconds, timeout_seconds: value.timeout_seconds, max_attempts: value.max_attempts, transport: value.transport || 'sse',
+    model: GPT_ACCOUNT_RECOVERY_MODEL, gateway: value.gateway, ticket_length: value.ticket_length, ticket_ttl_seconds: value.ticket_ttl_seconds, cookie_ttl_seconds: value.cookie_ttl_seconds,
+    share_route_cookies: value.share_route_cookies === true,
+    share_route_donor_account_ids: [...(value.share_route_donor_account_ids || [])].sort((a, b) => a - b),
