+func TestGPTMonitorAccountProxyIsolationNoFallback(t *testing.T) {
+	var hits [2]atomic.Int32
+	var envHits atomic.Int32
+	envProxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { envHits.Add(1); w.WriteHeader(502) }))
+	defer envProxy.Close()
+	t.Setenv("HTTPS_PROXY", envProxy.URL)
+	t.Setenv("HTTP_PROXY", envProxy.URL)
+	t.Setenv("NO_PROXY", "*")
+	for i := 0; i < 2; i++ {
+		index := i
+		proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			hits[index].Add(1)
+			if r.Method != http.MethodConnect || r.Host != "chatgpt.com:443" {
+				t.Errorf("wrong proxy request: %s %s", r.Method, r.Host)
+			}
+			w.WriteHeader(502)
+		}))
+		u, _ := url.Parse(proxy.URL)
+		port, _ := strconv.Atoi(u.Port())
+		account := gptMonitorTestAccount()
+		account.Proxy.Host = u.Hostname()
+		account.Proxy.Port = port
+		s := &OpenAIGatewayService{accountRepo: &gptMonitorProbeRepo{get: func(context.Context, int64) (*Account, error) { return account, nil }}}
+		_, _, err := s.ProbeGPTAccount(context.Background(), 42, "gpt-5.4", "question")
+		proxy.Close()
+		if err == nil || hits[i].Load() != 1 {
+			t.Fatalf("account proxy %d not used exactly once: %v", i, err)
+		}
+	}
+	if envHits.Load() != 0 || hits[0].Load() != 1 || hits[1].Load() != 1 {
+		t.Fatal("environment or cross-account proxy used")
