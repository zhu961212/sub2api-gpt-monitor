@@ -0,0 +1,193 @@
+package admin
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+type gptAccountMonitorService interface {
+	GetConfig(context.Context) (config.GPTAccountMonitorConfig, error)
+	SaveConfig(context.Context, config.GPTAccountMonitorConfig) (config.GPTAccountMonitorConfig, error)
+	Status(context.Context) (service.GPTAccountMonitorStatus, error)
+	RunNow(context.Context) (bool, error)
+	RunAccount(context.Context, int64) (bool, error)
+	AccountResult(context.Context, int64) (service.GPTAccountMonitorStatusAccount, error)
+}
+
+// GPTAccountMonitorHandler is registered only within the existing admin group.
+type GPTAccountMonitorHandler struct {
+	monitor gptAccountMonitorService
+}
+
+func NewGPTAccountMonitorHandler(monitor *service.GPTAccountMonitorService) *GPTAccountMonitorHandler {
+	h := &GPTAccountMonitorHandler{}
+	if monitor != nil {
+		h.monitor = monitor
+	}
+	return h
+}
+
+func (h *GPTAccountMonitorHandler) ready(c *gin.Context) bool {
+	if h == nil || h.monitor == nil {
+		response.Error(c, http.StatusServiceUnavailable, "账号检查服务暂不可用")
+		return false
+	}
+	return true
+}
+
+func (h *GPTAccountMonitorHandler) GetConfig(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	cfg, err := h.monitor.GetConfig(c.Request.Context())
+	if err != nil {
+		response.InternalError(c, "读取账号检查配置失败")
+		return
+	}
+	if cfg.AccountIDs == nil {
+		cfg.AccountIDs = []int64{}
+	}
+	response.Success(c, cfg)
+}
+
+// Mutable fields are required because this endpoint replaces the settings.
+// Model fields are optional compatibility inputs; their values are fixed below.
+// Pointer fields distinguish false/zero values from absent or null.
+type gptAccountMonitorConfigRequest struct {
+	Enabled            *bool    `json:"enabled"`
+	IntervalSeconds    *int     `json:"interval_seconds"`
+	TimeoutSeconds     *int     `json:"timeout_seconds"`
+	Concurrency        *int     `json:"concurrency"`
+	Model              *string  `json:"model"`
+	ReasoningEffort    *string  `json:"reasoning_effort"`
+	Prompt             *string  `json:"prompt"`
+	ExpectedGeneration *int     `json:"expected_generation"`
+	AccountIDs         *[]int64 `json:"account_ids"`
+	RunOnStart         *bool    `json:"run_on_start"`
+}
+
+func (h *GPTAccountMonitorHandler) SaveConfig(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	decoder := json.NewDecoder(http.MaxBytesReader(c.Writer, c.Request.Body, 32*1024))
+	decoder.DisallowUnknownFields()
+	var request gptAccountMonitorConfigRequest
+	if err := decoder.Decode(&request); err != nil {
+		response.BadRequest(c, "配置必须是有效 JSON，且不能包含未知字段或超过 32 KB")
+		return
+	}
+	if err := decoder.Decode(&struct{}{}); err != io.EOF {
+		response.BadRequest(c, "配置只能包含一个 JSON 对象")
+		return
+	}
+	if request.Enabled == nil || request.IntervalSeconds == nil || request.TimeoutSeconds == nil || request.Concurrency == nil || request.Prompt == nil || request.ExpectedGeneration == nil || request.AccountIDs == nil || request.RunOnStart == nil {
+		response.BadRequest(c, "请提交完整的账号检查配置")
+		return
+	}
+	cfg := config.GPTAccountMonitorConfig{
+		Enabled: *request.Enabled, IntervalSeconds: *request.IntervalSeconds,
+		TimeoutSeconds: *request.TimeoutSeconds, Concurrency: *request.Concurrency,
+		Prompt:             strings.TrimSpace(*request.Prompt),
+		ExpectedGeneration: *request.ExpectedGeneration, AccountIDs: *request.AccountIDs,
+		RunOnStart: *request.RunOnStart,
+	}
+	cfg.NormalizeFixedModel()
+	if err := cfg.Validate(); err != nil {
+		response.BadRequest(c, "配置无效：间隔 60–86400 秒、超时 10–300 秒、并发 1–10、代数 1–99；问题不能为空，账号 ID 必须为正整数")
+		return
+	}
+	saved, err := h.monitor.SaveConfig(c.Request.Context(), cfg)
+	if err != nil {
+		response.InternalError(c, "保存账号检查配置失败")
+		return
+	}
+	if saved.AccountIDs == nil {
+		saved.AccountIDs = []int64{}
+	}
+	response.Success(c, saved)
+}
+
+func (h *GPTAccountMonitorHandler) Status(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	status, err := h.monitor.Status(c.Request.Context())
+	if err != nil {
+		response.InternalError(c, "读取账号检查状态失败")
+		return
+	}
+	response.Success(c, status)
+}
+
+func (h *GPTAccountMonitorHandler) RunNow(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	queued, err := h.monitor.RunNow(c.Request.Context())
+	if err != nil {
+		response.Error(c, http.StatusServiceUnavailable, "暂时无法启动检查，请确认配置已启用并稍后重试")
+		return
+	}
+	message := "检查已在运行或已排队"
+	if queued {
+		message = "已提交立即检查任务"
+	}
+	response.Success(c, gin.H{"queued": queued, "message": message})
+}
+
+func (h *GPTAccountMonitorHandler) RunAccount(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	accountID, err := strconv.ParseInt(c.Param("id"), 10, 64)
+	if err != nil || accountID <= 0 {
+		response.BadRequest(c, "账号 ID 必须是有效的正整数")
+		return
+	}
+	queued, err := h.monitor.RunAccount(c.Request.Context(), accountID)
+	if err != nil {
+		if infraerrors.Code(err) < http.StatusInternalServerError {
+			response.ErrorFrom(c, err)
+		} else {
+			response.Error(c, http.StatusServiceUnavailable, "暂时无法启动账号检查，请稍后重试")
+		}
+		return
+	}
+	message := "检查已在运行或已排队"
+	if queued {
+		message = "已提交账号检查任务"
+	}
+	response.Success(c, gin.H{"queued": queued, "message": message})
+}
+
+func (h *GPTAccountMonitorHandler) AccountResult(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	accountID, err := strconv.ParseInt(c.Param("id"), 10, 64)
+	if err != nil || accountID <= 0 {
+		response.BadRequest(c, "账号 ID 必须是有效的正整数")
+		return
+	}
+	result, err := h.monitor.AccountResult(c.Request.Context(), accountID)
+	if err != nil {
+		if infraerrors.Code(err) < http.StatusInternalServerError {
+			response.ErrorFrom(c, err)
+		} else {
+			response.Error(c, http.StatusServiceUnavailable, "暂时无法读取账号检查结果，请稍后重试")
+		}
+		return
+	}
+	response.Success(c, result)
+}
