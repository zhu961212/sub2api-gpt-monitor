+
+var (
+	gptMonitorGeneration      = regexp.MustCompile(`(?i)(?:^|[^a-z0-9])(?:苹果(?:手机)?|iphone|apple)[[:space:]　_-]*([0-9]+)`)
+	gptMonitorUncertainty     = regexp.MustCompile(`(?i)(?:^|[^a-z])(?:may|might|maybe|perhaps|probably|possibly|guess|unsure|uncertain|rumor|rumour|not)(?:$|[^a-z])`)
+	gptMonitorSplitGeneration = regexp.MustCompile("^[[:space:]_*`.．/／-]*[0-9]")
+	gptMonitorBareAlternative = regexp.MustCompile(`(?:[/／]|(?:^|[^a-z])or(?:$|[^a-z])|或) *[0-9]+`)
+)
+
+// ClassifyGPTAccountAnswer requires one definite generation. Uncertainty,
+// negation and conflicting models are inconclusive and preserve scheduling.
+func ClassifyGPTAccountAnswer(answer string, expectedGeneration int) (string, error) {
+	ambiguous := func() (string, error) {
+		return "error", gptMonitorError("ambiguous_answer", "回答未明确唯一的 iPhone 代数，调度未改变")
+	}
+	if len(answer) > 512 || expectedGeneration < 1 || expectedGeneration > 99 {
+		return ambiguous()
+	}
+	answer = strings.ToLower(strings.TrimSpace(answer))
+	answer = strings.Map(func(r rune) rune {
+		if r >= '０' && r <= '９' {
+			return r - '０' + '0'
+		}
+		if unicode.IsSpace(r) {
+			return ' '
+		}
+		return r
+	}, answer)
+	if strings.ContainsAny(answer, "?？") || gptMonitorUncertainty.MatchString(answer) {
+		return ambiguous()
+	}
+	for _, marker := range []string{
+		"不确定", "无法确定", "不能确定", "不清楚", "不知道", "不保证", "可能", "也许", "或许", "大概", "应该", "我猜", "猜测", "推测", "传闻", "传言", "未确认", "没确认", "不是", "并非", "尚未", "未发布", "没发布",
+		"i don't know", "i do not know", "cannot confirm", "can't confirm", "could be", "i think",
+	} {
+		if strings.Contains(answer, marker) {
+			return ambiguous()
+		}
+	}
+	matches := gptMonitorGeneration.FindAllStringSubmatchIndex(answer, -1)
+	if len(matches) == 0 {
+		return ambiguous()
+	}
+	generation := 0
+	for _, match := range matches {
+		text := answer[match[2]:match[3]]
+		value, err := strconv.Atoi(text)
+		if err != nil || value <= 0 || value > 99 || strconv.Itoa(value) != text {
+			return ambiguous()
+		}
+		// Never turn decimal, split or marked-up digits into another generation.
+		tail := answer[match[3]:]
+		if gptMonitorSplitGeneration.MatchString(tail) {
+			return ambiguous()
+		}
+		if len(tail) > 0 && tail[0] >= 'a' && tail[0] <= 'z' {
+			allowed := false
+			for _, suffix := range []string{"pro", "plus", "air", "max", "e"} {
+				if strings.HasPrefix(tail, suffix) && (len(tail) == len(suffix) || tail[len(suffix)] < 'a' || tail[len(suffix)] > 'z') {
+					allowed = true
+					break
+				}
+			}
+			if !allowed {
+				return ambiguous()
+			}
+		}
+		if generation != 0 && generation != value {
+			return ambiguous()
+		}
+		generation = value
+	}
+	// A second bare generation in "iPhone 17 or 18" is also ambiguous.
+	if gptMonitorBareAlternative.MatchString(answer) {
+		return ambiguous()
+	}
+	if generation == expectedGeneration {
+		return "normal", nil
+	}
+	return "abnormal", nil
+}
+
+// gptMonitorConfirmResult applies a scheduling change only after two automatic
+// samples agree within the five to ten minute confirmation window.
+func gptMonitorConfirmResult(current GPTAccountMonitorResult, previous GPTAccountMonitorResult, configKey string, now time.Time) (GPTAccountMonitorResult, bool) {
+	current.ConfigKey = configKey
+	current.PendingVerdict, current.Consecutive = "", 0
+	current.PendingCheckedAt, current.NextCheckAt = nil, nil
+	if current.Verdict != "normal" && current.Verdict != "abnormal" {
+		next := now.Add(5 * time.Minute)
+		current.NextCheckAt = &next
+		return current, false
+	}
+	desired := current.Verdict == "normal"
+	if current.Schedulable == desired {
+		return current, false
+	}
+	consistent := configKey != "" && previous.ConfigKey == configKey && previous.Model == current.Model && previous.ReasoningEffort == current.ReasoningEffort && previous.ExpectedGeneration == current.ExpectedGeneration && previous.PendingVerdict == current.Verdict && previous.Consecutive == 1 && previous.PendingCheckedAt != nil
+	if consistent {
+		age := now.Sub(*previous.PendingCheckedAt)
+		consistent = age >= 5*time.Minute && age <= 10*time.Minute
+	}
+	if consistent {
+		current.Consecutive = 2
+		return current, true
+	}
+	current.PendingVerdict, current.Consecutive = current.Verdict, 1
+	checked := now
+	next := now.Add(5 * time.Minute)
+	current.PendingCheckedAt, current.NextCheckAt = &checked, &next
+	return current, false
+}
