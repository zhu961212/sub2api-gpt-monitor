+func gptRecoveryMintTestState(issued time.Time, blocks int) string {
+	raw := make([]byte, 57+16*blocks)
+	raw[0] = 0x80
+	binary.BigEndian.PutUint64(raw[1:9], uint64(issued.Unix()))
+	return base64.URLEncoding.EncodeToString(raw)
+}
