+	require.NotContains(t, string(raw), ticket.CFLB)
+	require.NotContains(t, string(raw), ticket.OAILB)
+	require.NotContains(t, string(raw), ticket.TurnState)
+	a.Credentials["access_token"] = "rotated-token"
