+func TestGPTMonitorSchedulingGuardsChangedStableIdentity(t *testing.T) {
+	for _, key := range []string{"chatgpt_account_id", "chatgpt_user_id", "auth_mode", "openai_auth_mode", "chatgpt_account_is_fedramp"} {
+		t.Run(key, func(t *testing.T) {
+			snapshot := gptMonitorAccountSnapshot()
+			original := captureGPTMonitorSchedulingMutation(t, snapshot)
+			before := gptMonitorBoundPredicateValue(t, original, `jsonb_build_object\([^)]*\) = \$(\d+)::jsonb`)
+			if key == "chatgpt_account_is_fedramp" {
+				snapshot.Credentials[key] = false
+			} else {
+				snapshot.Credentials[key] = "another-identity"
+			}
+			changed := captureGPTMonitorSchedulingMutation(t, snapshot)
+			after := gptMonitorBoundPredicateValue(t, changed, `jsonb_build_object\([^)]*\) = \$(\d+)::jsonb`)
+			require.NotEqual(t, before, after, "the SQL equality must prevent an answer applying to a different account identity")
+			require.Contains(t, changed.query, `"credentials" -> '`+key+`'`)
+		})
+	}
+}
