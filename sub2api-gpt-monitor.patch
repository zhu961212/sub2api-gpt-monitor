+
+func TestGPTMonitorFallbackTransportIgnoresEnvironmentProxy(t *testing.T) {
+	var environmentHits atomic.Int32
+	environmentProxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		environmentHits.Add(1)
+		w.WriteHeader(http.StatusBadGateway)
+	}))
+	defer environmentProxy.Close()
+	t.Setenv("HTTPS_PROXY", environmentProxy.URL)
+	t.Setenv("HTTP_PROXY", environmentProxy.URL)
+	t.Setenv("NO_PROXY", "*")
+	var accountHits atomic.Int32
+	accountProxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		accountHits.Add(1)
+		require.Equal(t, http.MethodConnect, req.Method)
+		require.Equal(t, "chatgpt.com:443", req.Host)
+		w.WriteHeader(http.StatusBadGateway)
+	}))
+	defer accountProxy.Close()
+	parsedProxy, err := url.Parse(accountProxy.URL)
+	require.NoError(t, err)
+	port, err := strconv.Atoi(parsedProxy.Port())
+	require.NoError(t, err)
