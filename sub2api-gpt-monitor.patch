+
+const SettingKeyGPTAccountRecoveryConfig = "gpt_account_recovery_config"
+
+// Secret material lives only in Redis with the routing lease, never account.extra.
+type GPTAccountRecoveryTicket struct {
+	TurnState       string    `json:"turn_state"`
+	CFLB            string    `json:"cflb"`
+	OAILB           string    `json:"oailb"`
+	Model           string    `json:"model"`
+	Gateway         string    `json:"gateway"`
