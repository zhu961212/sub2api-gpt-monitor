+		name    string
+		err     error
+		code    string
+		status  int
+		message string
+	}{
+		{"missing proxy", gptMonitorError("proxy_missing", "账号未绑定有效代理，请先绑定代理"), "proxy_missing", 0, "绑定代理"},
