+func TestGPTAccountMonitorRoutesRequireStepUpForMutations(t *testing.T) {
+	router := gin.New()
+	stepUpCalls := 0
+	h := &handler.Handlers{Admin: &handler.AdminHandlers{GPTAccountMonitor: admin.NewGPTAccountMonitorHandler(nil)}}
+	registerGPTAccountMonitorRoutes(router.Group("/admin"), h, func(c *gin.Context) {
+		stepUpCalls++
+		c.AbortWithStatus(http.StatusForbidden)
+	})
+	for _, tc := range []struct {
+		method, path string
+		status       int
+		stepUp       bool
+	}{
+		{http.MethodGet, "/config", http.StatusServiceUnavailable, false},
+		{http.MethodGet, "/status", http.StatusServiceUnavailable, false},
+		{http.MethodGet, "/accounts/42/result", http.StatusServiceUnavailable, false},
+		{http.MethodPut, "/config", http.StatusForbidden, true},
+		{http.MethodPost, "/run", http.StatusForbidden, true},
+		{http.MethodPost, "/accounts/42/run", http.StatusForbidden, true},
+	} {
+		t.Run(tc.method+tc.path, func(t *testing.T) {
+			before := stepUpCalls
+			w := httptest.NewRecorder()
+			router.ServeHTTP(w, httptest.NewRequest(tc.method, "/admin/gpt-account-monitor"+tc.path, strings.NewReader("{}")))
+			require.Equal(t, tc.status, w.Code, w.Body.String())
+			if tc.stepUp {
+				require.Equal(t, before+1, stepUpCalls)
+			} else {
+				require.Equal(t, before, stepUpCalls)
+			}
+		})
+	}
+}
