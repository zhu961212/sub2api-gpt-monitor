+func TestGPTAccountMonitorSingleTestStartsFreshConfirmationAndKeepsScopeAndAutomaticSchedule(t *testing.T) {
+	for _, failed := range []bool{false, true} {
+		t.Run(map[bool]string{false: "completed", true: "identity acquisition fails"}[failed], func(t *testing.T) {
+			s, base, store := gptMonitorFixture()
+			s.cfg.Enabled = false
+			s.cfg.AccountIDs = []int64{1}
+			account := gptMonitorTestAccount()
+			account.ID = 2
+			pendingAt, due := time.Now().UTC().Add(-time.Minute), time.Now().UTC().Add(4*time.Minute)
+			previous := GPTAccountMonitorResult{ConfigKey: "previous automatic configuration", PendingVerdict: "abnormal", Consecutive: 1, PendingCheckedAt: &pendingAt, NextCheckAt: &due}
+			account.Extra = map[string]any{"gpt_account_monitor": previous, "private": "SECRET"}
+			base.accounts = []Account{*account}
+			s.repo = &gptMonitorSingleRepo{base}
+			store.next = time.Now().Add(time.Hour)
+			originalNext := store.next
+			s.probe = func(_ context.Context, id int64, model, prompt string) (*Account, string, error) {
+				require.EqualValues(t, 2, id)
+				require.Equal(t, "gpt-6-astra", model)
+				if failed {
+					return nil, "", errors.New("SECRET error")
+				}
+				return base.snapshot(id), "iPhone 16", nil
+			}
+			_, started := s.runMonitorRequest(context.Background(), s.cfg, gptMonitorRequest{ConfigKey: gptMonitorConfigHash(s.cfg), AccountID: 2}, true)
+			require.True(t, started)
+			require.Empty(t, base.writes)
+			require.True(t, base.accounts[0].Schedulable)
+			require.Equal(t, []int64{1}, s.cfg.AccountIDs)
+			require.Equal(t, originalNext, store.next)
+			result := base.results[2]
+			require.Equal(t, gptMonitorConfigHash(s.cfg), result.ConfigKey)
+			require.Equal(t, 1, result.ManualAttempts)
+			require.WithinDuration(t, time.Now().UTC().Add(5*time.Minute), *result.NextCheckAt, time.Second)
+			if failed {
+				require.False(t, result.ManualRequested)
+				require.Empty(t, result.PendingVerdict)
+				require.Zero(t, result.Consecutive)
+			} else {
+				require.True(t, result.ManualRequested)
+				require.Equal(t, "abnormal", result.PendingVerdict)
+				require.NotEqual(t, previous.PendingCheckedAt, result.PendingCheckedAt)
+				require.Equal(t, 1, result.Consecutive)
