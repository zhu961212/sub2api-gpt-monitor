@@ -0,0 +1,33 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+)
+
+// UpdateGPTMonitorResult saves display-only observations without rebuilding
+// scheduler buckets or loading a credential-bearing account snapshot. Leaving
+// updated_at unchanged also prevents observations from invalidating an in-flight
+// scheduling CAS; actual scheduling changes still update it and the outbox.
+func (r *accountRepository) UpdateGPTMonitorResult(ctx context.Context, id int64, result service.GPTAccountMonitorResult) error {
+	payload, err := json.Marshal(map[string]any{"gpt_account_monitor": result})
+	if err != nil {
+		return err
+	}
+	res, err := clientFromContext(ctx, r.client).ExecContext(ctx,
+		"UPDATE accounts SET extra = COALESCE(extra, '{}'::jsonb) || $1::jsonb WHERE id = $2 AND deleted_at IS NULL",
+		string(payload), id)
+	if err != nil {
+		return err
+	}
+	affected, err := res.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if affected == 0 {
+		return service.ErrAccountNotFound
+	}
+	return nil
+}
diff --git a/backend/internal/repository/account_repo_gpt_monitor_test.go b/backend/internal/repository/account_repo_gpt_monitor_test.go
