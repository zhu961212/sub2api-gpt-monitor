+)
+
+func TestGPTMonitorUpstreamHTTP2FallbackLogsNoProxySecrets(t *testing.T) {
+	var output bytes.Buffer
+	previous := slog.Default()
+	slog.SetDefault(slog.New(slog.NewJSONHandler(&output, nil)))
+	t.Cleanup(func() { slog.SetDefault(previous) })
+	cfg := &config.Config{Gateway: config.GatewayConfig{OpenAIHTTP2: config.GatewayOpenAIHTTP2Config{
+		Enabled: true, AllowProxyFallbackToHTTP1: true, FallbackErrorThreshold: 1,
+	}}}
+	upstream := &httpUpstreamService{cfg: cfg}
+	proxyKey, _, err := normalizeProxyURL("http://private-monitor-user:private-monitor-password@private-monitor-host.invalid:3210")
+	require.NoError(t, err)
+	upstream.recordOpenAIHTTP2Failure(service.HTTPUpstreamProfileOpenAI, upstreamProtocolModeOpenAIH2, proxyKey, errors.New("http2: protocol error private-upstream-detail"))
+	require.True(t, upstream.isOpenAIHTTP2FallbackActive(proxyKey), "redacting logs must preserve proxy fallback behavior")
+	var record map[string]any
+	require.NoError(t, json.Unmarshal(output.Bytes(), &record))
+	require.Equal(t, "openai_http2_proxy_fallback_activated", record["msg"])
+	require.Regexp(t, `^[0-9a-f]{24}$`, record["proxy_hash"])
+	require.NotEmpty(t, record["fallback_until"])
+	require.NotContains(t, record, "proxy")
+	for _, secret := range []string{proxyKey, "private-monitor-user", "private-monitor-password", "private-monitor-host.invalid", ":3210", "private-upstream-detail"} {
+		require.NotContains(t, output.String(), secret)
+	}
+}
