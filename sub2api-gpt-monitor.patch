+package service
+
+import "context"
+
+// gptMonitorReadRepository keeps recurring scans and status polling independent
+// of credential, proxy-secret, and account-group hydration. Empty accountIDs
+// means every eligible account. Disabled scheduling must not exclude an account:
+// a subsequent healthy probe needs to be able to recover it.
+type gptMonitorReadRepository interface {
+	ListGPTMonitorCandidates(ctx context.Context, accountIDs []int64, afterID int64, limit int) ([]Account, error)
+	ListGPTMonitorAccounts(ctx context.Context, accountIDs []int64) ([]Account, error)
+}
+
+type gptMonitorPollingRepository interface {
+	ListGPTMonitorPollingCandidates(ctx context.Context, accountIDs []int64, afterID int64, limit int) ([]Account, error)
+}
+
+type gptMonitorDueRepository interface {
+	ListGPTMonitorDueCandidates(ctx context.Context, accountIDs []int64, configKey string, limit int) ([]Account, error)
+}
+
+type gptMonitorManualRepository interface {
+	ListGPTMonitorManualConfirmations(ctx context.Context, configKey string, limit int) ([]Account, error)
+}
diff --git a/backend/internal/service/gpt_account_monitor_response.go b/backend/internal/service/gpt_account_monitor_response.go
new file mode 100644
index 0000000000000000000000000000000000000000..74c3f085f09ded4f435d1e5826d9056099f4fd3c
--- /dev/null
+++ b/backend/internal/service/gpt_account_monitor_response.go
@@ -0,0 +1,383 @@
+package service
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"io"
+	"sort"
+	"strings"
+)
+
+const gptMonitorAnswerByteLimit = 32768
+
+type gptMonitorResponseContent struct {
+	Type string `json:"type"`
+	Text string `json:"text"`
+}
+
+type gptMonitorResponseItem struct {
+	ID      string          `json:"id"`
+	Type    string          `json:"type"`
+	Role    string          `json:"role"`
+	Status  string          `json:"status"`
+	Error   json.RawMessage `json:"error"`
+	Content json.RawMessage `json:"content"`
+}
+
+type gptMonitorResponseEvent struct {
+	Type         string          `json:"type"`
+	Delta        string          `json:"delta"`
+	Text         string          `json:"text"`
+	ItemID       string          `json:"item_id"`
+	OutputIndex  *int            `json:"output_index"`
+	ContentIndex *int            `json:"content_index"`
+	Code         string          `json:"code"`
+	Message      string          `json:"message"`
+	Error        json.RawMessage `json:"error"`
+	Item         json.RawMessage `json:"item"`
+	Part         json.RawMessage `json:"part"`
+	Response     struct {
+		Status string          `json:"status"`
+		Error  json.RawMessage `json:"error"`
+		Output json.RawMessage `json:"output"`
+	} `json:"response"`
+}
+
+type gptMonitorCompletedItem struct {
+	id    string
+	item  gptMonitorResponseItem
+	text  string
+	parts map[int]string
+	done  bool
+}
+
+func gptMonitorResponseError(raw json.RawMessage) error {
+	if len(raw) == 0 || strings.TrimSpace(string(raw)) == "null" {
+		return nil
+	}
+	var detail struct {
+		Code    string `json:"code"`
+		Type    string `json:"type"`
+		Message string `json:"message"`
+	}
+	_ = json.Unmarshal(raw, &detail)
+	return gptMonitorUpstreamError(detail.Code, detail.Type, detail.Message)
+}
+
+func gptMonitorItemText(item gptMonitorResponseItem, requireCompleted bool) (string, error) {
+	if err := gptMonitorResponseError(item.Error); err != nil {
+		return "", err
+	}
+	if isGPTMonitorToolEvent(item.Type) || strings.HasSuffix(item.Type, "_call") {
+		return "", gptMonitorError("unexpected_tool_call", "检测响应包含工具调用，已忽略")
+	}
+	if item.Type != "message" {
+		return "", nil
+	}
+	if item.Status != "" && item.Status != "completed" || requireCompleted && item.Status != "completed" {
+		return "", gptMonitorError("incomplete_response", "上游输出消息未完成")
+	}
+	if len(item.Content) == 0 {
+		return "", nil
+	}
+	var parts []json.RawMessage
+	if string(item.Content) == "null" || json.Unmarshal(item.Content, &parts) != nil {
+		return "", gptMonitorError("invalid_response", "上游返回无效消息内容")
+	}
+	texts := make([]string, 0, len(parts))
+	bytes := 0
+	for _, raw := range parts {
+		var part gptMonitorResponseContent
+		if string(raw) == "null" || json.Unmarshal(raw, &part) != nil || part.Type == "" {
+			return "", gptMonitorError("invalid_response", "上游返回无效消息内容")
+		}
+		if part.Type == "refusal" {
+			return "", gptMonitorError("response_refused", "上游拒绝回答")
+		}
+		if part.Type == "output_text" && item.Role == "assistant" {
+			bytes += len(part.Text)
+			if bytes > gptMonitorAnswerByteLimit {
+				return "", gptMonitorError("response_too_large", "回答超过长度限制")
+			}
+			texts = append(texts, part.Text)
+		}
+	}
+	return strings.Join(texts, "\n"), nil
+}
+
+// Only a successful response terminal authorizes an answer. Sparse terminals
+// can use completed text or messages whose assistant identity was declared;
+// deltas, drafts, reasoning and tool output never become account verdicts.
+func readGPTMonitorResponse(body io.Reader) (string, error) {
+	limited := &io.LimitedReader{R: body, N: 2*1024*1024 + 1}
+	scanner := bufio.NewScanner(limited)
+	scanner.Buffer(make([]byte, 4096), 256*1024)
+	var data []string
+	var name string
+	var eventBytes, deltaBytes int
+	items := make(map[int]*gptMonitorCompletedItem)
+	byID := make(map[string]int)
+	invalid := func() error { return gptMonitorError("invalid_response", "上游返回无效或矛盾事件") }
+	tooLarge := func() error { return gptMonitorError("response_too_large", "上游响应超过大小限制") }
+	consume := func() (string, bool, error) {
+		if limited.N <= 0 {
+			return "", false, tooLarge()
+		}
+		eventName := name
+		name, eventBytes = "", 0
+		if len(data) == 0 {
+			return "", false, nil
+		}
+		raw := strings.Join(data, "\n")
+		data = nil
+		if raw == "[DONE]" {
+			return "", false, gptMonitorError("incomplete_response", "响应缺少完整结束事件")
+		}
+		var event gptMonitorResponseEvent
+		if json.Unmarshal([]byte(raw), &event) != nil {
+			return "", false, invalid()
+		}
+		kind := event.Type
+		if eventName != "" && eventName != "message" {
+			if kind != "" && kind != eventName {
+				return "", false, invalid()
+			}
+			kind = eventName
+		}
+		if kind == "" {
+			return "", false, invalid()
+		}
+		if err := gptMonitorResponseError(event.Error); err != nil {
+			return "", false, err
+		}
+		if err := gptMonitorResponseError(event.Response.Error); err != nil {
+			return "", false, err
+		}
+		if event.Response.Status == "failed" || event.Response.Status == "incomplete" || event.Response.Status == "cancelled" {
+			return "", false, gptMonitorError("incomplete_response", "上游响应未完成")
+		}
+		if isGPTMonitorToolEvent(kind) {
+			return "", false, gptMonitorError("unexpected_tool_call", "检测响应包含工具调用，已忽略")
+		}
+		if strings.Contains(kind, "refusal") {
+			return "", false, gptMonitorError("response_refused", "上游拒绝回答")
+		}
+		if len(event.Part) > 0 {
+			var part gptMonitorResponseContent
+			if string(event.Part) == "null" || json.Unmarshal(event.Part, &part) != nil || part.Type == "" {
+				return "", false, invalid()
+			}
+			if part.Type == "refusal" {
+				return "", false, gptMonitorError("response_refused", "上游拒绝回答")
+			}
+		}
+		var item gptMonitorResponseItem
+		if len(event.Item) > 0 {
+			if string(event.Item) == "null" || json.Unmarshal(event.Item, &item) != nil {
+				return "", false, invalid()
+			}
+			if err := gptMonitorResponseError(item.Error); err != nil {
+				return "", false, err
+			}
+			if isGPTMonitorToolEvent(item.Type) || strings.HasSuffix(item.Type, "_call") {
+				return "", false, gptMonitorError("unexpected_tool_call", "检测响应包含工具调用，已忽略")
+			}
+		}
+		switch kind {
+		case "error", "response.failed":
+			return "", false, gptMonitorUpstreamError(event.Code, "", event.Message)
+		case "response.incomplete", "response.cancelled":
+			return "", false, gptMonitorError("incomplete_response", "上游响应未完成")
+		case "response.output_text.delta":
+			deltaBytes += len(event.Delta)
+			if deltaBytes > gptMonitorAnswerByteLimit {
+				return "", false, tooLarge()
+			}
+		case "response.output_item.added", "response.output_item.done":
+			if item.Type == "" {
+				return "", false, invalid()
+			}
+			if item.ID != "" {
+				if oldIndex, exists := byID[item.ID]; exists && (event.OutputIndex == nil || oldIndex != *event.OutputIndex) {
+					return "", false, invalid()
+				}
+			}
+			if event.OutputIndex != nil {
+				if old := items[*event.OutputIndex]; old != nil && (old.id != item.ID || old.item.Type != item.Type || old.item.Role != item.Role) {
+					return "", false, invalid()
+				}
+			}
+			if item.Status == "failed" || item.Status == "incomplete" || item.Status == "cancelled" {
+				return "", false, gptMonitorError("incomplete_response", "上游输出消息未完成")
+			}
+			if item.Type != "message" || item.Role != "assistant" {
+				_, err := gptMonitorItemText(item, false)
+				return "", false, err
+			}
+			if event.OutputIndex == nil || *event.OutputIndex < 0 || item.ID == "" {
+				return "", false, invalid()
+			}
+			index := *event.OutputIndex
+			if oldIndex, exists := byID[item.ID]; exists && oldIndex != index {
+				return "", false, invalid()
+			}
+			saved, exists := items[index]
+			if exists && saved.id != item.ID {
+				return "", false, invalid()
+			}
+			if !exists {
+				saved = &gptMonitorCompletedItem{id: item.ID, parts: make(map[int]string)}
+				items[index] = saved
+				byID[item.ID] = index
+			}
+			if kind == "response.output_item.added" {
+				// Draft text is deliberately not retained; refusal still blocks.
+				validation := item
+				validation.Status = ""
+				if _, err := gptMonitorItemText(validation, false); err != nil {
+					return "", false, err
+				}
+				if saved.done {
+					return "", false, invalid()
+				}
+				saved.item = item
+				return "", false, nil
+			}
+			text, err := gptMonitorItemText(item, true)
+			if err != nil {
+				return "", false, err
+			}
+			if saved.done && saved.text != text {
+				return "", false, invalid()
+			}
+			saved.item, saved.text, saved.done = item, text, true
+		case "response.output_text.done":
+			if event.OutputIndex == nil || *event.OutputIndex < 0 || event.ContentIndex == nil || *event.ContentIndex < 0 || event.ItemID == "" {
+				return "", false, invalid()
+			}
+			saved := items[*event.OutputIndex]
+			if saved == nil || saved.id != event.ItemID {
+				return "", false, invalid()
+			}
+			if previous, exists := saved.parts[*event.ContentIndex]; exists && previous != event.Text {
+				return "", false, invalid()
+			}
+			saved.parts[*event.ContentIndex] = event.Text
+		case "response.completed", "response.done":
+			if event.Response.Status != "completed" {
+				return "", false, gptMonitorError("incomplete_response", "上游响应状态未完成")
+			}
+			var terminal []json.RawMessage
+			if len(event.Response.Output) > 0 && string(event.Response.Output) != "null" {
+				if json.Unmarshal(event.Response.Output, &terminal) != nil {
+					return "", false, invalid()
+				}
+			}
+			texts := make([]string, 0, len(terminal))
+			for _, raw := range terminal {
+				var item gptMonitorResponseItem
+				if string(raw) == "null" || json.Unmarshal(raw, &item) != nil || item.Type == "" {
+					return "", false, invalid()
+				}
+				text, err := gptMonitorItemText(item, false)
+				if err != nil {
+					return "", false, err
+				}
+				if strings.TrimSpace(text) != "" {
+					texts = append(texts, text)
+				}
+			}
+			if len(texts) == 0 {
+				indices := make([]int, 0, len(items))
+				for index := range items {
+					indices = append(indices, index)
+				}
+				sort.Ints(indices)
+				for _, index := range indices {
+					saved := items[index]
+					text := saved.text
+					if !saved.done || text == "" {
+						parts := make([]int, 0, len(saved.parts))
+						for part := range saved.parts {
+							parts = append(parts, part)
+						}
+						sort.Ints(parts)
+						completed := make([]string, 0, len(parts))
+						for _, part := range parts {
+							completed = append(completed, saved.parts[part])
+						}
+						text = strings.Join(completed, "\n")
+					}
+					if strings.TrimSpace(text) != "" {
+						texts = append(texts, text)
+					}
+				}
+			}
+			answer := strings.TrimSpace(strings.Join(texts, "\n"))
+			if answer == "" {
+				return "", false, gptMonitorError("empty_response", "上游没有返回最终文本")
+			}
+			if len(answer) > gptMonitorAnswerByteLimit {
+				return "", false, tooLarge()
+			}
+			return answer, true, nil
+		}
+		// Bound retained completed text even when a malicious stream never sends
+		// its terminal. Replayed identical events do not consume the bound twice.
+		retained := 0
+		for _, saved := range items {
+			partBytes := 0
+			for _, text := range saved.parts {
+				partBytes += len(text)
+			}
+			retained += max(len(saved.text), partBytes)
+		}
+		if retained > gptMonitorAnswerByteLimit {
+			return "", false, tooLarge()
+		}
+		return "", false, nil
+	}
+	for scanner.Scan() {
+		if limited.N <= 0 {
+			return "", tooLarge()
+		}
+		line := strings.TrimSuffix(scanner.Text(), "\r")
+		if line == "" {
+			answer, done, err := consume()
+			if err != nil || done {
+				return answer, err
+			}
+			continue
+		}
+		if strings.HasPrefix(line, "data:") {
+			value := strings.TrimPrefix(strings.TrimPrefix(line, "data:"), " ")
+			eventBytes += len(value) + 1
+			if eventBytes > 256*1024 {
+				return "", tooLarge()
+			}
+			data = append(data, value)
+		} else if strings.HasPrefix(line, "event:") {
+			name = strings.TrimPrefix(strings.TrimPrefix(line, "event:"), " ")
+		}
+	}
+	if scanner.Err() != nil {
+		if errors.Is(scanner.Err(), bufio.ErrTooLong) {
+			return "", tooLarge()
+		}
+		return "", gptMonitorError("stream_read_failed", "读取上游响应失败，连接可能已中断")
+	}
+	if answer, done, err := consume(); err != nil || done {
+		return answer, err
+	}
+	return "", gptMonitorError("incomplete_response", "上游响应中断，未收到完整回答")
+}
+
+func isGPTMonitorToolEvent(eventType string) bool {
+	for _, kind := range []string{"web_search", "file_search", "function_call", "computer_call", "code_interpreter", "image_generation", "mcp_", "tool_call", "custom_tool"} {
+		if strings.Contains(eventType, kind) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/backend/internal/service/gpt_account_monitor_response_test.go b/backend/internal/service/gpt_account_monitor_response_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..9f322e87cfbbabd8aee8325f2c875a50da2fef26
--- /dev/null
+++ b/backend/internal/service/gpt_account_monitor_response_test.go
@@ -0,0 +1,152 @@
+package service
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func gptMonitorResponseFrame(payload any) string {
+	raw, _ := json.Marshal(payload)
+	return "data: " + string(raw) + "\n\n"
+}
+
+func gptMonitorSparseTerminal() string {
+	return gptMonitorResponseFrame(map[string]any{"type": "response.completed", "response": map[string]any{"status": "completed", "output": []any{}}})
+}
+
+func gptMonitorOutputItem(index int, kind, id, status, text string) string {
+	return gptMonitorResponseFrame(map[string]any{"type": kind, "output_index": index, "item": map[string]any{"type": "message", "id": id, "role": "assistant", "status": status, "content": []any{map[string]any{"type": "output_text", "text": text}}}})
+}
+
+func TestGPTMonitorResponseSparseCompletedAssistantOutput(t *testing.T) {
+	item := gptMonitorOutputItem(0, "response.output_item.done", "msg_1", "completed", "iPhone 17")
+	added := gptMonitorOutputItem(0, "response.output_item.added", "msg_1", "in_progress", "draft iPhone 16")
+	text := gptMonitorResponseFrame(map[string]any{"type": "response.output_text.done", "item_id": "msg_1", "output_index": 0, "content_index": 0, "text": "iPhone 17"})
+	for name, prefix := range map[string]string{"item_done": item, "text_done": added + text, "both": added + text + item, "replay": item + item} {
+		t.Run(name, func(t *testing.T) {
+			for _, terminal := range []string{gptMonitorSparseTerminal(), strings.Replace(gptMonitorSparseTerminal(), "response.completed", "response.done", 1)} {
+				answer, err := readGPTMonitorResponse(strings.NewReader(prefix + terminal))
+				require.NoError(t, err)
+				require.Equal(t, "iPhone 17", answer)
+			}
+		})
+	}
+	answer, err := readGPTMonitorResponse(strings.NewReader(item + gptMonitorCompleted("iPhone 16")))
+	require.NoError(t, err)
+	require.Equal(t, "iPhone 16", answer, "explicit final answer remains authoritative")
+	answer, err = readGPTMonitorResponse(strings.NewReader(item + strings.TrimSpace(gptMonitorSparseTerminal())))
+	require.NoError(t, err)
+	require.Equal(t, "iPhone 17", answer)
+}
+
+func TestGPTMonitorResponseNamedEventsAndConflicts(t *testing.T) {
+	terminal := strings.TrimPrefix(gptMonitorCompleted("iPhone 17"), "data: ")
+	terminal = strings.Replace(terminal, `"type":"response.completed",`, "", 1)
+	answer, err := readGPTMonitorResponse(strings.NewReader("event: response.completed\ndata: " + terminal))
+	require.NoError(t, err)
+	require.Equal(t, "iPhone 17", answer)
+	for _, name := range []string{"error", "response.failed", "response.output_item.done"} {
+		_, err := readGPTMonitorResponse(strings.NewReader("event: " + name + "\n" + gptMonitorCompleted("iPhone 17")))
+		require.Error(t, err)
+	}
+	answer, err = readGPTMonitorResponse(strings.NewReader("event: message\n" + gptMonitorCompleted("iPhone 17")))
+	require.NoError(t, err)
+	require.Equal(t, "iPhone 17", answer)
+}
+
+func TestGPTMonitorResponseNeverPromotesUntrustedSparseText(t *testing.T) {
+	valid := gptMonitorOutputItem(0, "response.output_item.done", "msg_1", "completed", "iPhone 17")
+	for name, prefix := range map[string]string{
+		"draft":             gptMonitorOutputItem(0, "response.output_item.added", "msg_1", "in_progress", "iPhone 17"),
+		"delta":             gptMonitorResponseFrame(map[string]any{"type": "response.output_text.delta", "delta": "iPhone 17"}),
+		"orphan_text_done":  gptMonitorResponseFrame(map[string]any{"type": "response.output_text.done", "item_id": "msg_1", "output_index": 0, "content_index": 0, "text": "iPhone 17"}),
+		"unfinished_item":   gptMonitorOutputItem(0, "response.output_item.done", "msg_1", "in_progress", "iPhone 17"),
+		"missing_status":    gptMonitorOutputItem(0, "response.output_item.done", "msg_1", "", "iPhone 17"),
+		"conflicting_text":  valid + gptMonitorOutputItem(0, "response.output_item.done", "msg_1", "completed", "iPhone 16"),
+		"conflicting_id":    valid + gptMonitorOutputItem(0, "response.output_item.done", "msg_2", "completed", "iPhone 17"),
+		"conflicting_index": valid + gptMonitorOutputItem(1, "response.output_item.done", "msg_1", "completed", "iPhone 17"),
+		"conflicting_role":  valid + gptMonitorResponseFrame(map[string]any{"type": "response.output_item.done", "output_index": 0, "item": map[string]any{"type": "message", "id": "msg_1", "role": "user", "status": "completed", "content": []any{}}}),
+		"conflicting_kind":  valid + gptMonitorResponseFrame(map[string]any{"type": "response.output_item.done", "output_index": 0, "item": map[string]any{"type": "reasoning", "id": "msg_1", "status": "completed"}}),
+	} {
+		t.Run(name, func(t *testing.T) {
+			answer, err := readGPTMonitorResponse(strings.NewReader(prefix + gptMonitorSparseTerminal()))
+			require.Error(t, err)
+			require.Empty(t, answer)
+		})
+	}
+	for _, tail := range []string{"", "data: [DONE]\n\n", gptMonitorResponseFrame(map[string]any{"type": "response.failed"}), gptMonitorResponseFrame(map[string]any{"type": "response.cancelled"})} {
+		answer, err := readGPTMonitorResponse(strings.NewReader(valid + tail))
+		require.Error(t, err)
+		require.Empty(t, answer)
+	}
+}
+
+func TestGPTMonitorResponseFailedRefusedAndToolStreams(t *testing.T) {
+	for name, frame := range map[string]string{
+		"envelope_error":             gptMonitorResponseFrame(map[string]any{"type": "response.completed", "error": map[string]any{"code": "server_error", "message": "SECRET"}, "response": map[string]any{"status": "completed", "output": []any{}}}),
+		"response_error":             gptMonitorResponseFrame(map[string]any{"type": "response.completed", "response": map[string]any{"status": "completed", "error": map[string]any{"code": "model_not_found", "message": "SECRET"}, "output": []any{}}}),
+		"empty_error_object":         gptMonitorResponseFrame(map[string]any{"type": "response.completed", "error": map[string]any{}, "response": map[string]any{"status": "completed", "output": []any{}}}),
+		"item_error":                 gptMonitorResponseFrame(map[string]any{"type": "response.output_item.done", "output_index": 1, "item": map[string]any{"type": "message", "role": "assistant", "id": "failed", "status": "completed", "error": map[string]any{"code": "server_error"}}}),
+		"tool_item":                  gptMonitorResponseFrame(map[string]any{"type": "response.output_item.added", "item": map[string]any{"type": "web_search_call"}}),
+		"tool_event":                 gptMonitorResponseFrame(map[string]any{"type": "response.function_call_arguments.done"}),
+		"refusal_delta":              gptMonitorResponseFrame(map[string]any{"type": "response.refusal.delta", "delta": "SECRET"}),
+		"refusal_done":               gptMonitorResponseFrame(map[string]any{"type": "response.refusal.done", "refusal": "SECRET"}),
+		"refusal_part":               gptMonitorResponseFrame(map[string]any{"type": "response.content_part.added", "part": map[string]any{"type": "refusal", "refusal": "SECRET"}}),
+		"failed_nonterminal":         gptMonitorResponseFrame(map[string]any{"type": "response.created", "response": map[string]any{"status": "failed"}}),
+		"cancelled_nonterminal":      gptMonitorResponseFrame(map[string]any{"type": "response.in_progress", "response": map[string]any{"status": "cancelled"}}),
+		"terminal_refusal":           gptMonitorResponseFrame(map[string]any{"type": "response.completed", "response": map[string]any{"status": "completed", "output": []any{map[string]any{"type": "message", "role": "assistant", "content": []any{map[string]any{"type": "refusal", "refusal": "SECRET"}}}}}}),
+		"invalid_terminal_item":      gptMonitorResponseFrame(map[string]any{"type": "response.completed", "response": map[string]any{"status": "completed", "output": []any{map[string]any{"type": "message", "role": "assistant", "status": "incomplete", "content": []any{}}}}}),
+		"malformed_terminal_content": gptMonitorResponseFrame(map[string]any{"type": "response.completed", "response": map[string]any{"status": "completed", "output": []any{map[string]any{"type": "message", "role": "assistant", "content": nil}}}}),
+	} {
+		t.Run(name, func(t *testing.T) {
+			prefix := gptMonitorOutputItem(0, "response.output_item.done", "valid", "completed", "iPhone 17")
+			answer, err := readGPTMonitorResponse(strings.NewReader(prefix + frame + gptMonitorCompleted("iPhone 17")))
+			require.Error(t, err)
+			require.Empty(t, answer)
+			require.NotContains(t, err.Error(), "SECRET")
+		})
+	}
+}
+
+type gptMonitorTerminalReader struct {
+	input    string
+	tailRead bool
+}
+
+func (r *gptMonitorTerminalReader) Read(p []byte) (int, error) {
+	if r.input == "" {
+		r.tailRead = true
+		return 0, errors.New("unexpected read beyond terminal")
+	}
+	n := copy(p, r.input)
+	r.input = r.input[n:]
+	return n, nil
+}
+
+func TestGPTMonitorResponseStopsAtCompleteTerminalAndBoundsBodies(t *testing.T) {
+	reader := &gptMonitorTerminalReader{input: gptMonitorOutputItem(0, "response.output_item.done", "valid", "completed", "iPhone 17") + gptMonitorSparseTerminal()}
+	answer, err := readGPTMonitorResponse(reader)
+	require.NoError(t, err)
+	require.Equal(t, "iPhone 17", answer)
+	require.False(t, reader.tailRead)
+	for name, input := range map[string]string{
+		"comment_only":      strings.Repeat(": comment\n", 250000),
+		"multiline_event":   strings.Repeat("data: "+strings.Repeat(" ", 4096)+"\n", 65) + "\n",
+		"long_line":         strings.Repeat("x", 300000),
+		"completed_message": gptMonitorOutputItem(0, "response.output_item.done", "valid", "completed", strings.Repeat("x", 32769)) + gptMonitorSparseTerminal(),
+	} {
+		t.Run(name, func(t *testing.T) {
+			_, err := readGPTMonitorResponse(strings.NewReader(input))
+			code, _, _ := gptMonitorErrorDetails(err)
+			require.Equal(t, "response_too_large", code)
+		})
+	}
+	_, err = readGPTMonitorResponse(io.MultiReader(strings.NewReader("data: {"), &gptMonitorTerminalReader{}))
+	code, _, _ := gptMonitorErrorDetails(err)
+	require.Equal(t, "stream_read_failed", code)
+}
