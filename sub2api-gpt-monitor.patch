+import { apiClient } from '../client'
+
+export const GPT_ACCOUNT_MONITOR_MODEL = 'gpt-6-astra'
+export const GPT_ACCOUNT_MONITOR_REASONING_EFFORT = 'xhigh'
+
+export interface GPTAccountMonitorConfig {
+  enabled: boolean
+  interval_seconds: number
+  timeout_seconds: number
+  concurrency: number
+  readonly model: string
+  readonly reasoning_effort?: string
+  prompt: string
+  expected_generation: number
+  account_ids: number[]
+  run_on_start: boolean
+}
+
+export type GPTAccountMonitorConfigInput = Omit<GPTAccountMonitorConfig, 'model' | 'reasoning_effort'> &
+  Partial<Pick<GPTAccountMonitorConfig, 'model' | 'reasoning_effort'>>
+
+export interface GPTAccountMonitorResult {
+  account_id: number
+  name: string
+  proxy_name?: string
+  checked_at: string | null
+  verdict: string
+  answer?: string
+  message: string
+  model: string
+  reasoning_effort?: string
+  expected_generation: number
+  schedulable: boolean
+  changed: boolean
+  error_code?: string
+  http_status?: number
+  duration_ms?: number
+  pending_verdict?: string
+  consecutive?: number
+  next_check_at?: string | null
+  manual_requested?: boolean
+  manual_running?: boolean
+  manual_attempts?: number
+}
+
+export interface GPTAccountMonitorStatus {
+  enabled: boolean
+  running: boolean
+  queued?: boolean
+  last_run: string | null
+  next_run: string | null
+  message: string
+  total_accounts: number
+  accounts: GPTAccountMonitorResult[]
+}
+
+const base = '/admin/gpt-account-monitor'
+export interface GPTAccountMonitorRunResult { queued: boolean; message: string }
+export async function getConfig(signal?: AbortSignal): Promise<GPTAccountMonitorConfig> {
+  return (await apiClient.get<GPTAccountMonitorConfig>(`${base}/config`, { signal })).data
+}
+export async function saveConfig(config: GPTAccountMonitorConfigInput, signal?: AbortSignal): Promise<GPTAccountMonitorConfig> {
+  return (await apiClient.put<GPTAccountMonitorConfig>(`${base}/config`, config, { signal })).data
+}
+export async function getStatus(signal?: AbortSignal): Promise<GPTAccountMonitorStatus> {
+  return (await apiClient.get<GPTAccountMonitorStatus>(`${base}/status`, { signal })).data
+}
+export async function run(signal?: AbortSignal): Promise<GPTAccountMonitorRunResult> {
+  return (await apiClient.post<GPTAccountMonitorRunResult>(`${base}/run`, undefined, { signal })).data
+}
+export async function runAccount(accountID: number, signal?: AbortSignal): Promise<GPTAccountMonitorRunResult> {
+  return (await apiClient.post<GPTAccountMonitorRunResult>(`${base}/accounts/${accountID}/run`, undefined, { signal })).data
+}
+export async function getAccountResult(accountID: number, signal?: AbortSignal): Promise<GPTAccountMonitorResult> {
+  return (await apiClient.get<GPTAccountMonitorResult>(`${base}/accounts/${accountID}/result`, { signal })).data
+}
+export default { getConfig, saveConfig, getStatus, run, runAccount, getAccountResult }
