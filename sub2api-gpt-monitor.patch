+
+type gptRecoveryConfigRaceSettings struct {
+	SettingRepository
+	mu      sync.Mutex
+	raw     string
+	started chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (r *gptRecoveryConfigRaceSettings) GetValue(context.Context, string) (string, error) {
+	r.mu.Lock()
+	raw := r.raw
+	r.mu.Unlock()
+	r.once.Do(func() { close(r.started); <-r.release })
+	return raw, nil
+}
+func (r *gptRecoveryConfigRaceSettings) Set(_ context.Context, _ string, raw string) error {
+	r.mu.Lock()
+	r.raw = raw
+	r.mu.Unlock()
+	return nil
+}
+
+func TestGPTRecoveryConfigOldReadCannotReplaceSavedProxyMode(t *testing.T) {
+	c := config.DefaultGPTAccountRecoveryConfig()
+	raw, err := json.Marshal(c)
+	require.NoError(t, err)
+	settings := &gptRecoveryConfigRaceSettings{raw: string(raw), started: make(chan struct{}), release: make(chan struct{})}
+	gateway := &OpenAIGatewayService{}
+	s := NewGPTAccountRecoveryService(nil, gateway, nil, settings, nil)
+	finished := make(chan error, 1)
+	go func() { _, err := s.GetConfig(context.Background()); finished <- err }()
+	select {
+	case <-settings.started:
+	case <-time.After(3 * time.Second):
+		t.Fatal("settings read did not start")
+	}
+	c.ProxySessionMode = "kookeey"
+	_, err = s.SaveConfig(context.Background(), c)
+	require.NoError(t, err)
+	close(settings.release)
+	select {
+	case err := <-finished:
+		require.NoError(t, err)
+	case <-time.After(3 * time.Second):
+		t.Fatal("settings read did not finish")
+	}
+	require.Equal(t, "kookeey", gateway.gptRecoveryProxyConfigSnapshot().ProxySessionMode)
+}
