+package service
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+type gptRecoveryProtectionRepo struct {
+	AccountRepository
+	account       *Account
+	getErr        error
+	setErrorCalls int
+}
+
+func (r *gptRecoveryProtectionRepo) GetByID(context.Context, int64) (*Account, error) {
+	return r.account, r.getErr
+}
+func (r *gptRecoveryProtectionRepo) SetError(context.Context, int64, string) error {
+	r.setErrorCalls++
+	return nil
+}
+
+type gptRecoveryExpiryRaceCache struct {
+	OpenAITokenCache
+	account *Account
+	probe   bool
+	pinned  bool
+}
+
+func (c *gptRecoveryExpiryRaceCache) GetAccessToken(ctx context.Context, _ string) (string, error) {
+	c.probe = isGPTRecoveryProbe(ctx)
+	_, c.pinned = ctx.Value(gptRecoveryProxyContextKey{}).(gptRecoveryPinnedProxy)
+	// The token was valid at preflight but expires during a cache lookup.
+	c.account.Credentials["expires_at"] = time.Now().Add(-time.Minute).Format(time.RFC3339)
+	return "", nil
+}
+
+type gptRecoveryProtectionBlocker struct{ calls int }
+
+func (b *gptRecoveryProtectionBlocker) BlockAccountScheduling(*Account, time.Time, string) { b.calls++ }
+func (*gptRecoveryProtectionBlocker) ClearAccountSchedulingBlock(int64)                    {}
+
+func TestGPTRecoveryOverrideTokenExpiryRaceKeepsAccountScheduling(t *testing.T) {
+	t.Setenv(gptRecoveryProxyURLEnv, "http://user:secret-US@gate.example:1000")
+	account := gptRecoveryMintTestAccount()
+	account.Schedulable = true
+	account.Credentials["expires_at"] = time.Now().Add(time.Minute).Format(time.RFC3339)
+	repo := &gptRecoveryProtectionRepo{account: account}
+	cache := &gptRecoveryExpiryRaceCache{account: account}
+	provider := NewOpenAITokenProvider(repo, cache, nil)
+	blocker := &gptRecoveryProtectionBlocker{}
+	provider.SetAccountRuntimeBlocker(blocker)
+	s := &OpenAIGatewayService{accountRepo: repo, openAITokenProvider: provider}
+	_, _, err := s.resolveGPTRecoveryIdentity(context.Background(), account.ID)
+	require.Error(t, err)
+	code, _, _ := gptRecoveryErrorDetails(err)
+	require.Equal(t, "token_acquisition_failed", code)
+	require.True(t, cache.probe)
+	require.False(t, cache.pinned, "the probe marker must not invent an account refresh proxy")
+	require.Zero(t, repo.setErrorCalls)
+	require.Zero(t, blocker.calls)
+	require.True(t, account.Schedulable)
+}
+
+type gptRecoveryProtectionRefreshExecutor struct{ OAuthRefreshExecutor }
+
+func (*gptRecoveryProtectionRefreshExecutor) CacheKey(account *Account) string {
+	return OpenAITokenCacheKey(account)
+}
+
+func TestGPTRecoveryProbeRefreshFailureIsSanitizedWithoutBoundProxy(t *testing.T) {
+	account := gptRecoveryMintTestAccount()
+	account.Credentials["expires_at"] = time.Now().Add(time.Minute).Format(time.RFC3339)
+	account.Credentials["refresh_token"] = "refresh-token"
+	repo := &gptRecoveryProtectionRepo{getErr: errors.New("SECRET proxy password")}
+	provider := NewOpenAITokenProvider(repo, nil, nil)
+	provider.SetRefreshAPI(NewOAuthRefreshAPI(repo, nil), &gptRecoveryProtectionRefreshExecutor{})
+	ctx := context.WithValue(context.Background(), gptRecoveryProbeContextKey{}, true)
+	token, err := provider.GetAccessToken(ctx, account)
+	require.Error(t, err)
+	require.Empty(t, token)
+	require.EqualError(t, err, "monitor OAuth refresh failed")
+	require.NotContains(t, err.Error(), "SECRET")
+	require.Zero(t, repo.setErrorCalls)
+	require.Equal(t, int64(1), provider.SnapshotRuntimeMetrics().RefreshFailure)
+}
