+func TestGPTRecoveryRoutingWSPoolKeepsRouteAndRechecksDelayedDials(t *testing.T) {
+	s, account, store := recoveryRoutingFixture()
+	account.Concurrency = 2
+	identity := s.gptRecoveryRoutingIdentityKey(account)
+	store.tickets[identity] = recoveryRoutingTicket("cf-pool-first", "oa-pool-first")
+	s.cfg.Gateway.OpenAIWS.MaxConnsPerAccount = 2
+	s.cfg.Gateway.OpenAIWS.MinIdlePerAccount = 0
+	s.cfg.Gateway.OpenAIWS.MaxIdlePerAccount = 2
+	pool := newOpenAIWSConnPool(s.cfg)
+	defer pool.Close()
+	dialer := &recoveryRoutingCaptureWSDialer{}
+	pool.setClientDialerForTest(dialer)
+	request := func(state string) openAIWSAcquireRequest {
+		headers := recoveryRoutingHeaders(account)
+		if state != "" {
+			headers.Set(openAIWSTurnStateHeader, state)
+		}
+		s.applyGPTRecoveryRouting(context.Background(), account, headers, account.Proxy.URL())
+		return openAIWSAcquireRequest{Account: account, WSURL: "wss://chatgpt.com/backend-api/codex/responses", Headers: headers, ProxyURL: account.Proxy.URL(),
+			HeadersFactory: func(ctx context.Context, headers http.Header) (http.Header, error) {
+				return s.refreshGPTRecoveryWSHeaders(ctx, account, headers), nil
+			},
+			OnHandshake: s.gptRecoveryWSHandshakeObserver(context.Background(), account, headers)}
+	}
+	first, err := pool.Acquire(context.Background(), request(""))
+	require.NoError(t, err)
+	firstID := first.ConnID()
+	first.Release()
+	require.Len(t, dialer.headers, 1)
+	require.Equal(t, "__cflb=cf-pool-first; __oailb=oa-pool-first", dialer.headers[0].Get("Cookie"))
+	store.tickets[identity] = recoveryRoutingTicket("cf-pool-second", "oa-pool-second")
+	second, err := pool.Acquire(context.Background(), request(""))
+	require.NoError(t, err)
+	require.False(t, second.Reused())
+	require.NotEqual(t, firstID, second.ConnID())
+	second.Release()
+	// The observer saw the same synthetic state on both handshakes. Use a
+	// specifically recorded real first-turn binding to assert route isolation.
+	firstTicket := recoveryRoutingTicket("cf-pool-first", "oa-pool-first")
+	firstTicket.TurnState = "first-pool-turn"
+	store.tickets[gptRecoveryTurnRoutingKey(identity, "first-pool-turn")] = firstTicket
+	continuation, err := pool.Acquire(context.Background(), request("first-pool-turn"))
+	require.NoError(t, err)
+	require.True(t, continuation.Reused())
+	require.Equal(t, firstID, continuation.ConnID())
+	continuation.Release()
+	delayed := request("")
+	delayed.ForceNewConn = true
+	store.tickets[identity].CookieExpiresAt = time.Now().Add(-time.Second)
+	expired, err := pool.Acquire(context.Background(), delayed)
+	require.NoError(t, err)
+	expired.Release()
+	require.Empty(t, dialer.headers[len(dialer.headers)-1].Get("Cookie"))
+}
