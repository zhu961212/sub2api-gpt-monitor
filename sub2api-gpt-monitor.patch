+package repository
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/lib/pq"
+)
+
+// ListGPTMonitorPollingCandidates reads only identities and their next planned
+// check. A damaged or missing plan leaves the account immediately eligible; it
+// never prevents other accounts in the bounded page from being examined.
+func (r *accountRepository) ListGPTMonitorPollingCandidates(ctx context.Context, accountIDs []int64, afterID int64, limit int) ([]service.Account, error) {
+	if limit <= 0 {
+		return []service.Account{}, nil
+	}
+	if r == nil || r.sql == nil {
+		return nil, errors.New("GPT account monitor repository unavailable")
+	}
+	query := `SELECT ` + gptMonitorAccountColumnsSQL + `,
+		a.extra #>> '{gpt_account_monitor,config_key}',
+		a.extra #>> '{gpt_account_monitor,next_check_at}'
+		FROM accounts AS a
+		WHERE ` + gptMonitorEligibleSQL + ` AND a.id > $1`
+	args := []any{afterID, limit}
+	if len(accountIDs) > 0 {
+		query += ` AND a.id = ANY($3)`
+		args = append(args, pq.Array(accountIDs))
+	}
+	query += ` ORDER BY a.id ASC LIMIT $2`
+	rows, err := r.sql.QueryContext(ctx, query, args...)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = rows.Close() }()
+	accounts := make([]service.Account, 0)
+	for rows.Next() {
+		var account service.Account
+		var configKey, nextCheckAt sql.NullString
+		if err := rows.Scan(&account.ID, &account.Platform, &account.Type, &account.Status, &account.Schedulable, &account.ExpiresAt, &account.ParentAccountID, &configKey, &nextCheckAt); err != nil {
+			return nil, err
+		}
+		if nextCheckAt.Valid {
+			if planned, err := time.Parse(time.RFC3339Nano, nextCheckAt.String); err == nil && !planned.IsZero() {
+				account.Extra = map[string]any{"gpt_account_monitor": map[string]any{
+					"config_key": configKey.String, "next_check_at": planned.Format(time.RFC3339Nano),
+				}}
+			}
+		}
+		accounts = append(accounts, account)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return accounts, nil
+}
+
+// ListGPTMonitorDueCandidates prioritizes the oldest scheduled check while
+// keeping newly added, changed and damaged plans eligible now. Already overdue
+// checks retain priority, so a large new-account directory cannot postpone a
+// pending confirmation indefinitely. Only monitor data is projected.
+func (r *accountRepository) ListGPTMonitorDueCandidates(ctx context.Context, accountIDs []int64, configKey string, limit int) ([]service.Account, error) {
+	if limit <= 0 {
+		return []service.Account{}, nil
+	}
+	if r == nil || r.sql == nil {
+		return nil, errors.New("GPT account monitor repository unavailable")
+	}
+	query := `SELECT ` + gptMonitorAccountColumnsSQL + `,
+		a.extra -> 'gpt_account_monitor'
+		FROM accounts AS a
+		WHERE ` + gptMonitorEligibleSQL + `
+		AND NOT (COALESCE(a.extra -> 'gpt_account_monitor' ->> 'manual_requested', 'false') = 'true'
+			AND COALESCE(a.extra #>> '{gpt_account_monitor,config_key}', '') = $1)`
+	args := []any{configKey, limit}
+	if len(accountIDs) > 0 {
+		query += ` AND a.id = ANY($3)`
+		args = append(args, pq.Array(accountIDs))
+	}
+	query += gptMonitorNextCheckOrderSQL
+	rows, err := r.sql.QueryContext(ctx, query, args...)
+	if err != nil {
+		return nil, err
+	}
+	return readGPTMonitorPlannedAccounts(rows)
+}
+
+// Manual confirmations remain independent of the configured automatic scope.
+// The saved config identity cancels stale requests after settings are changed.
+func (r *accountRepository) ListGPTMonitorManualConfirmations(ctx context.Context, configKey string, limit int) ([]service.Account, error) {
+	if limit <= 0 {
+		return []service.Account{}, nil
+	}
+	if r == nil || r.sql == nil {
+		return nil, errors.New("GPT account monitor repository unavailable")
+	}
+	query := `SELECT ` + gptMonitorAccountColumnsSQL + `,
+		a.extra -> 'gpt_account_monitor'
+		FROM accounts AS a
+		WHERE ` + gptMonitorEligibleSQL + `
+		AND a.extra #>> '{gpt_account_monitor,config_key}' = $1
+		AND a.extra -> 'gpt_account_monitor' ->> 'manual_requested' = 'true'` + gptMonitorNextCheckOrderSQL
+	rows, err := r.sql.QueryContext(ctx, query, configKey, limit)
+	if err != nil {
+		return nil, err
+	}
+	return readGPTMonitorPlannedAccounts(rows)
+}
+
+const gptMonitorNextCheckOrderSQL = ` ORDER BY CASE
+		WHEN a.extra #>> '{gpt_account_monitor,config_key}' = $1
+			AND (a.extra #>> '{gpt_account_monitor,next_check_unix}') ~ '^[0-9]{1,12}$'
+		THEN (a.extra #>> '{gpt_account_monitor,next_check_unix}')::bigint
+		ELSE EXTRACT(EPOCH FROM CURRENT_TIMESTAMP)::bigint END ASC, a.id ASC LIMIT $2`
+
+func readGPTMonitorPlannedAccounts(rows *sql.Rows) ([]service.Account, error) {
+	defer func() { _ = rows.Close() }()
+	accounts := make([]service.Account, 0)
+	for rows.Next() {
+		var account service.Account
+		var rawMonitor []byte
+		if err := rows.Scan(&account.ID, &account.Platform, &account.Type, &account.Status, &account.Schedulable, &account.ExpiresAt, &account.ParentAccountID, &rawMonitor); err != nil {
+			return nil, err
+		}
+		if len(rawMonitor) > 0 {
+			var monitor any
+			if err := json.Unmarshal(rawMonitor, &monitor); err != nil {
+				return nil, fmt.Errorf("decode GPT account monitor polling result: %w", err)
+			}
+			account.Extra = map[string]any{"gpt_account_monitor": monitor}
+		}
+		accounts = append(accounts, account)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return accounts, nil
+}
