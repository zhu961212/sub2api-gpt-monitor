+		{"non-expiring payload", func(r *service.GPTAccountRecoverySharedRoute) string { raw, _ := json.Marshal(r); return string(raw) }, 0},
+		{"mismatched identity", func(r *service.GPTAccountRecoverySharedRoute) string {
+			r.CFLB = "different-cookie"
+			raw, _ := json.Marshal(r)
