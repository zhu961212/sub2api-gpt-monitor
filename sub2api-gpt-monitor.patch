+	s.setGPTRecoveryProxyConfig(cfg)
+	s.cfg.Gateway.OpenAIWS.MaxConnsPerAccount, s.cfg.Gateway.OpenAIWS.MaxIdlePerAccount = 1, 1
+	pool := newOpenAIWSConnPool(s.cfg)
+	defer pool.Close()
+	pool.setClientDialerForTest(&recoveryMetadataBusinessDialer{})
+	identity := s.gptRecoveryRoutingIdentityKey(account)
+	original := recoveryProxyObserverTicket("aaaaaaaa")
+	require.NoError(t, store.SaveTicket(context.Background(), identity, original, time.Hour))
+	request := openAIWSAcquireRequest{Account: account, WSURL: "wss://chatgpt.com/backend-api/codex/responses", Headers: recoveryRoutingHeaders(account), ProxyURL: account.Proxy.URL(),
+		RouteFactory: func(ctx context.Context, headers http.Header, proxy string) (http.Header, string, error) {
+			return s.refreshGPTRecoveryWSRoute(ctx, account, headers, proxy)
+		},
+		HandshakeObserverFactory: func(ctx context.Context, headers http.Header, proxy string) func(context.Context, http.Header, http.Header) {
+			return s.gptRecoveryWSHandshakeObserver(ctx, account, headers, proxy)
+		},
+	}
+	firstCtx, cancelFirst := context.WithCancel(context.Background())
+	first, err := pool.Acquire(firstCtx, request)
+	require.NoError(t, err)
