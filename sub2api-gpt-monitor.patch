diff --git a/backend/internal/service/gpt_account_recovery_shared.go b/backend/internal/service/gpt_account_recovery_shared.go
new file mode 100644
index 0000000000000000000000000000000000000000..78c72c56542b4768666c88e0e9692ae0f775ab47
--- /dev/null
+++ b/backend/internal/service/gpt_account_recovery_shared.go
@@ -0,0 +1,177 @@
+package service
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+)
+
+const GPTAccountRecoverySharedRouteLimit = 8
+
+// A shared candidate contains routing data only. Account authorization, account
+// IDs, proxy credentials and turn-state are deliberately absent from this type.
+type GPTAccountRecoverySharedRoute struct {
+	CFLB            string    `json:"cflb"`
+	OAILB           string    `json:"oailb"`
+	Gateway         string    `json:"gateway"`
+	CookieExpiresAt time.Time `json:"cookie_expires_at"`
+	ProxyScope      string    `json:"proxy_scope"`
+	ProxySession    string    `json:"proxy_session,omitempty"`
+	ProxyExpiresAt  time.Time `json:"proxy_expires_at,omitempty"`
+}
+
+// This optional interface keeps the account/turn cache contract unchanged.
+type GPTAccountRecoverySharedRouteStore interface {
+	LoadSharedRoutes(context.Context, string, int) ([]GPTAccountRecoverySharedRoute, error)
+	SaveSharedRoute(context.Context, string, *GPTAccountRecoverySharedRoute, time.Duration) error
+}
+
+func gptRecoverySharedPoolScope(cfg config.GPTAccountRecoveryConfig) string {
+	cfg = cloneGPTRecoveryConfig(cfg)
+	raw, _ := json.Marshal(struct {
+		Version   string  `json:"version"`
+		Donors    []int64 `json:"donors"`
+		Transport string  `json:"transport"`
+		Model     string  `json:"model"`
+		Gateway   string  `json:"gateway"`
+	}{"shared-route-v1", cfg.ShareRouteDonorAccountIDs, cfg.Transport, cfg.Model, cfg.Gateway})
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:])
+}
+
+func gptRecoverySharedDonorAllowed(cfg config.GPTAccountRecoveryConfig, accountID int64) bool {
+	if len(cfg.ShareRouteDonorAccountIDs) == 0 {
+		return true
+	}
+	for _, id := range cfg.ShareRouteDonorAccountIDs {
+		if id == accountID {
+			return true
+		}
+	}
+	return false
+}
+
+func validGPTRecoverySharedRoute(route *GPTAccountRecoverySharedRoute, now time.Time) bool {
+	if route == nil || !route.CookieExpiresAt.After(now) || !validGPTRecoveryRoutingCookie(route.CFLB) || !validGPTRecoveryRoutingCookie(route.OAILB) ||
+		route.Gateway == "" || gptRecoveryCookieGateway(route.CFLB, route.OAILB) != route.Gateway || len(route.ProxyScope) != 64 {
+		return false
+	}
+	if _, err := hex.DecodeString(route.ProxyScope); err != nil {
+		return false
+	}
+	if route.ProxySession == "" {
+		return route.ProxyExpiresAt.IsZero()
+	}
+	return gptRecoveryProxySessionPattern.MatchString(route.ProxySession) && route.ProxyExpiresAt.After(now)
+}
+
+// Convert a candidate to a cookie-only mint seed. It can only be verified by
+// sending the borrower's own OAuth identity through the borrower's own proxy.
+func (s *OpenAIGatewayService) gptRecoverySharedRouteSeed(account *Account, route *GPTAccountRecoverySharedRoute, cfg config.GPTAccountRecoveryConfig, now time.Time) (*GPTAccountRecoveryTicket, error) {
+	cfg.Normalize()
+	if !validGPTRecoverySharedRoute(route, now) || (cfg.Gateway != "any" && route.Gateway != cfg.Gateway) {
+		return nil, nil
+	}
+	seed := &GPTAccountRecoveryTicket{CFLB: route.CFLB, OAILB: route.OAILB, Gateway: route.Gateway, CookieExpiresAt: route.CookieExpiresAt, Model: config.GPTAccountRecoveryModel}
+	if cfg.ProxySessionMode == config.GPTRecoveryProxySessionNone {
+		return seed, nil
+	}
+	seed.ProxySessionMode = cfg.ProxySessionMode
+	if route.ProxyScope == s.gptRecoveryProxyIdentityDigest(account) && route.ProxySession != "" &&
+		(cfg.ProxySessionMode != config.GPTRecoveryProxySessionKookeey || len(route.ProxySession) == 8) {
+		seed.ProxySession, seed.ProxyExpiresAt = route.ProxySession, route.ProxyExpiresAt
+	} else {
+		var err error
+		seed.ProxySession, err = newGPTRecoveryProxySession(cfg.ProxySessionMode)
+		if err != nil {
+			return nil, err
+		}
+		seed.ProxyExpiresAt = now.Add(time.Duration(cfg.ProxySessionTTLSeconds) * time.Second)
+	}
+	if seed.ProxyExpiresAt.Before(seed.CookieExpiresAt) {
+		seed.CookieExpiresAt = seed.ProxyExpiresAt
+	}
+	// Constructing this URL validates the recipient's authentication format.
+	// It never uses the candidate's source proxy or its credentials.
+	base, err := s.gptRecoveryBaseProxyURL(account)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := gptRecoverySessionProxyURL(base, cfg.ProxySessionMode, seed.ProxySession, cfg.ProxySessionTTLSeconds); err != nil {
+		return nil, err
+	}
+	return seed, nil
+}
+
+func (s *OpenAIGatewayService) loadGPTRecoverySharedSeed(ctx context.Context, account *Account, cfg config.GPTAccountRecoveryConfig) (*GPTAccountRecoveryTicket, error) {
+	if s == nil || !cfg.ShareRouteCookies {
+		return nil, nil
+	}
+	store, ok := s.gptRecoveryStore.(GPTAccountRecoverySharedRouteStore)
+	if !ok {
+		return nil, nil
+	}
+	readCtx, cancel := context.WithTimeout(ctx, gptRecoveryRoutingCacheTimeout)
+	defer cancel()
+	routes, err := store.LoadSharedRoutes(readCtx, gptRecoverySharedPoolScope(cfg), GPTAccountRecoverySharedRouteLimit)
+	if err != nil {
+		// A missing optional pool never blocks the account's own mint path.
+		return nil, nil
+	}
+	for i := 0; i < len(routes) && i < GPTAccountRecoverySharedRouteLimit; i++ {
+		seed, err := s.gptRecoverySharedRouteSeed(account, &routes[i], cfg, time.Now())
+		if err != nil || seed != nil {
+			return seed, err
+		}
+	}
+	return nil, nil
+}
+
+func (s *OpenAIGatewayService) publishGPTRecoverySharedRoute(ctx context.Context, account *Account, ticket *GPTAccountRecoveryTicket, cfg config.GPTAccountRecoveryConfig) {
+	if s == nil || account == nil || account.ID <= 0 || !cfg.ShareRouteCookies || !validGPTRecoveryRoutingTicket(ticket, time.Now()) {
+		return
+	}
+	if !gptRecoverySharedDonorAllowed(cfg, account.ID) {
+		return
+	}
+	store, ok := s.gptRecoveryStore.(GPTAccountRecoverySharedRouteStore)
+	if !ok {
+		return
+	}
+	if _, err := s.gptRecoveryTicketProxyURL(account, ticket); err != nil {
+		return
+	}
+	route := &GPTAccountRecoverySharedRoute{CFLB: ticket.CFLB, OAILB: ticket.OAILB, Gateway: ticket.Gateway,
+		CookieExpiresAt: ticket.CookieExpiresAt, ProxyScope: s.gptRecoveryProxyIdentityDigest(account),
+		ProxySession: ticket.ProxySession, ProxyExpiresAt: ticket.ProxyExpiresAt}
+	now := time.Now()
+	if route.ProxySession != "" && route.ProxyExpiresAt.Before(route.CookieExpiresAt) {
+		route.CookieExpiresAt = route.ProxyExpiresAt
+	}
+	if !validGPTRecoverySharedRoute(route, now) {
+		return
+	}
+	ttl := route.CookieExpiresAt.Sub(now)
+	if ttl > 2*time.Hour {
+		ttl = 2 * time.Hour
+	}
+	writeCtx, cancel := context.WithTimeout(ctx, gptRecoveryRoutingCacheTimeout)
+	defer cancel()
+	// Publishing is best-effort after the account's isolated ticket was saved.
+	_ = store.SaveSharedRoute(writeCtx, gptRecoverySharedPoolScope(cfg), route, ttl)
+}
+
+func gptRecoverySharedRouteCompatibilityError(err error) bool {
+	code, _, _ := gptRecoveryErrorDetails(err)
+	switch code {
+	case "model_mismatch", "gateway_mismatch", "missing_cookie_pair", "invalid_cookie_pair", "cookie_expired", "missing_cookie_expiry",
+		"missing_ticket", "invalid_ticket", "ticket_expired", "ticket_length_mismatch", "missing_created_event", "invalid_content_type", "invalid_response", "incomplete_response":
+		return true
+	default:
+		return false
+	}
+}
