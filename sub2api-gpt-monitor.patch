+
+func TestGPTMonitorSharedTransportFailureNeverSwitchesProxy(t *testing.T) {
+	for _, fallbackMode := range []string{FallbackModeDirect, FallbackModeProxy} {
+		t.Run(fallbackMode, func(t *testing.T) {
+			account := gptMonitorTestAccount()
