+	return nil
+}
+func (c *gptRecoveryMintWSConn) ReadMessage(context.Context) ([]byte, error) {
+	if c.reads >= len(c.messages) {
+		return nil, io.EOF
+	}
+	message := c.messages[c.reads]
+	c.reads++
+	return message, nil
+}
+func (*gptRecoveryMintWSConn) Ping(context.Context) error { return nil }
+func (c *gptRecoveryMintWSConn) Close() error             { c.closed = true; return nil }
+
+type gptRecoveryMintWSDialer struct {
+	conn     *gptRecoveryMintWSConn
+	response http.Header
+	status   int
+	err      error
+	request  http.Header
+	proxy    string
+	url      string
+}
+
+func (d *gptRecoveryMintWSDialer) Dial(_ context.Context, wsURL string, headers http.Header, proxy string) (openAIWSClientConn, int, http.Header, error) {
+	d.request, d.proxy, d.url = headers.Clone(), proxy, wsURL
+	if d.conn == nil {
+		return nil, d.status, d.response, d.err
+	}
+	return d.conn, d.status, d.response, d.err
+}
+
+func gptRecoveryMintWSMetadata(state string) []byte {
+	raw, _ := json.Marshal(map[string]any{"type": "codex.response.metadata", "headers": map[string]string{"x-codex-turn-state": state}})
+	return raw
+}
+
+func gptRecoveryMintWSCreated(model string) []byte {
+	raw, _ := json.Marshal(map[string]any{"type": "response.created", "response": map[string]string{"id": "resp_ws_mint", "model": model}})
+	return raw
+}
+
+func TestGPTRecoveryMintWebsocketUsesMetadataAndHandshakePair(t *testing.T) {
+	for _, metadataFirst := range []bool{true, false} {
+		now := time.Now()
+		state := gptRecoveryMintTestState(now, 33)
+		messages := [][]byte{gptRecoveryMintWSMetadata(state), gptRecoveryMintWSCreated(config.GPTAccountRecoveryModel), []byte(`{"type":"response.output_text.delta","delta":"DO_NOT_READ"}`)}
+		if !metadataFirst {
+			messages[0], messages[1] = messages[1], messages[0]
+		}
+		conn := &gptRecoveryMintWSConn{messages: messages}
+		responseHeaders := gptRecoveryMintTestResponse(now).Header
+		responseHeaders.Del("X-Codex-Turn-State")
+		dialer := &gptRecoveryMintWSDialer{conn: conn, status: 101, response: responseHeaders}
+		do := func(req *http.Request) (*http.Response, error) {
+			return gptRecoveryMintWSResponse(req, "http://user:secret-US-a1b2c3d4@gate.example:1000", dialer)
+		}
+		c := config.DefaultGPTAccountRecoveryConfig()
+		c.Transport = "websocket"
+		ticket, err := gptRecoveryMintWithDo(context.Background(), do, gptRecoveryMintTestAccount(), "token", "", c, nil)
+		require.NoError(t, err)
+		require.Equal(t, state, ticket.TurnState)
+		require.Equal(t, "unified-88", ticket.Gateway)
+		require.Equal(t, "wss://chatgpt.com/backend-api/codex/responses", dialer.url)
+		require.Contains(t, dialer.proxy, "a1b2c3d4")
+		require.Equal(t, openAIWSBetaV2Value, dialer.request.Get("OpenAI-Beta"))
+		require.Empty(t, dialer.request.Get("X-Codex-Turn-State"))
+		require.Equal(t, "response.create", conn.written["type"])
+		require.NotContains(t, conn.written, "stream")
+		require.NotContains(t, conn.written, "client_metadata")
+		require.Equal(t, 2, conn.reads)
+		require.True(t, conn.closed)
+	}
+}
+
+func TestGPTRecoveryMintWebsocketRejectsInvalidEvidence(t *testing.T) {
+	now := time.Now()
+	state := gptRecoveryMintTestState(now, 33)
+	for _, tc := range []struct {
+		name          string
+		messages      [][]byte
+		mismatchState bool
+		expected      string
+	}{
+		{"wrong model", [][]byte{gptRecoveryMintWSMetadata(state), gptRecoveryMintWSCreated("another-model")}, false, "model_mismatch"},
+		{"missing response id", [][]byte{[]byte(`{"type":"response.created","response":{"model":"gpt-6-astra"}}`)}, false, "invalid_response"},
+		{"conflicting state", [][]byte{gptRecoveryMintWSMetadata(state)}, true, "invalid_ticket"},
+		{"error event", [][]byte{[]byte(`{"type":"error","error":{"code":"invalid_token"}}`)}, false, "unauthorized"},
+		{"oversized event", [][]byte{[]byte(strings.Repeat("X", gptRecoveryMintScanLimit+1))}, false, "response_too_large"},
+		{"loose metadata model is not evidence", [][]byte{[]byte(`{"type":"codex.response.metadata","model":"gpt-6-astra"}`)}, false, "missing_created_event"},
+		{"metadata response missing id", [][]byte{[]byte(`{"type":"codex.response.metadata","response":{"model":"gpt-6-astra"}}`)}, false, "invalid_response"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			conn := &gptRecoveryMintWSConn{messages: tc.messages}
+			headers := gptRecoveryMintTestResponse(now).Header
+			if tc.mismatchState {
+				headers.Set("X-Codex-Turn-State", "different-state")
+			} else {
+				headers.Del("X-Codex-Turn-State")
+			}
+			dialer := &gptRecoveryMintWSDialer{conn: conn, status: 101, response: headers}
+			do := func(req *http.Request) (*http.Response, error) {
+				return gptRecoveryMintWSResponse(req, "http://proxy.example:1000", dialer)
+			}
+			c := config.DefaultGPTAccountRecoveryConfig()
+			c.MaxAttempts = 1
+			_, err := gptRecoveryMintWithDo(context.Background(), do, gptRecoveryMintTestAccount(), "token", "", c, nil)
+			require.Error(t, err)
+			code, _, _ := gptRecoveryErrorDetails(err)
+			require.Equal(t, tc.expected, code)
+			require.True(t, conn.closed)
+		})
+	}
+}
+
+func TestGPTRecoveryMintWebsocketSanitizesHandshakeFailure(t *testing.T) {
+	dialer := &gptRecoveryMintWSDialer{status: http.StatusProxyAuthRequired, err: errors.New("secret proxy password")}
+	req, err := http.NewRequestWithContext(context.Background(), http.MethodPost, chatgptCodexURL, strings.NewReader(`{"model":"gpt-6-astra"}`))
+	require.NoError(t, err)
+	_, err = gptRecoveryMintWSResponse(req, "http://user:secret@proxy.example:1000", dialer)
+	require.Error(t, err)
+	code, _, _ := gptRecoveryErrorDetails(err)
+	require.Equal(t, "proxy_auth_required", code)
+	require.NotContains(t, err.Error(), "secret")
+}
+
+func TestGPTRecoveryMintWebsocketAcceptsCompleteMetadataEnvelope(t *testing.T) {
+	now := time.Now()
+	state := gptRecoveryMintTestState(now, 33)
+	message, err := json.Marshal(map[string]any{"type": "codex.response.metadata",
+		"headers":  map[string]string{"x-codex-turn-state": state},
+		"response": map[string]string{"id": "resp_metadata", "model": config.GPTAccountRecoveryModel}})
+	require.NoError(t, err)
+	conn := &gptRecoveryMintWSConn{messages: [][]byte{message}}
+	headers := gptRecoveryMintTestResponse(now).Header
+	headers.Del("X-Codex-Turn-State")
+	dialer := &gptRecoveryMintWSDialer{conn: conn, status: 101, response: headers}
+	do := func(req *http.Request) (*http.Response, error) {
+		return gptRecoveryMintWSResponse(req, "http://proxy.example:1000", dialer)
+	}
+	c := config.DefaultGPTAccountRecoveryConfig()
+	c.MaxAttempts = 1
+	ticket, err := gptRecoveryMintWithDo(context.Background(), do, gptRecoveryMintTestAccount(), "token", "", c, nil)
+	require.NoError(t, err)
+	require.Equal(t, state, ticket.TurnState)
+	require.Equal(t, config.GPTAccountRecoveryModel, ticket.Model)
+	require.Equal(t, 1, conn.reads)
+	require.True(t, conn.closed)
+}
diff --git a/backend/internal/service/gpt_account_recovery_proxy.go b/backend/internal/service/gpt_account_recovery_proxy.go
new file mode 100644
index 0000000000000000000000000000000000000000..7f33752182305ff92f7f0df8b63feb91b88f4310
--- /dev/null
+++ b/backend/internal/service/gpt_account_recovery_proxy.go
@@ -0,0 +1,201 @@
+package service
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"net/url"
+	"os"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+)
+
+const gptRecoveryProxyURLEnv = "GPT_ACCOUNT_RECOVERY_PROXY_URL"
+
+type gptRecoveryRequestProxyContextKey struct{}
+
+func gptRecoveryProxyOverrideConfigured() bool {
+	raw, present := os.LookupEnv(gptRecoveryProxyURLEnv)
+	return present && strings.TrimSpace(raw) != ""
+}
+
+func withGPTRecoveryRequestProxy(ctx context.Context, proxyURL string) context.Context {
+	return context.WithValue(ctx, gptRecoveryRequestProxyContextKey{}, proxyURL)
+}
+
+var (
+	gptRecoveryProxySessionPattern = regexp.MustCompile(`^[A-Za-z0-9]{1,32}$`)
+	gptRecoveryProxyUsernameSID    = regexp.MustCompile(`(-sid-)[^-]+`)
+	gptRecoveryKookeeyPassword     = regexp.MustCompile(`^.+-([A-Z]{2}(?:_[A-Za-z0-9]+)*|global)$`)
+)
+
+// The administrator supplies the secret URL through the process environment.
+// Neither the settings API nor the ticket cache contains proxy credentials.
+func (s *OpenAIGatewayService) gptRecoveryBaseProxyURL(account *Account) (string, error) {
+	return gptRecoveryBaseProxyURL(account)
+}
+
+func gptRecoveryBaseProxyURL(account *Account) (string, error) {
+	if raw, present := os.LookupEnv(gptRecoveryProxyURLEnv); present {
+		raw = strings.TrimSpace(raw)
+		if raw == "" {
+			return "", gptRecoveryError("proxy_invalid", "恢复代理环境配置无效")
+		}
+		if _, err := parseGPTRecoveryBaseProxyURL(raw); err != nil {
+			return "", err
+		}
+		return raw, nil
+	}
+	if account == nil || account.ProxyID == nil || account.Proxy == nil || account.Proxy.ID != *account.ProxyID {
+		return "", gptRecoveryError("proxy_missing", "账号未绑定有效代理，请先绑定代理或配置恢复代理")
+	}
+	if err := validateGPTRecoveryProxy(account.Proxy); err != nil {
+		return "", err
+	}
+	return account.Proxy.URL(), nil
+}
+
+func parseGPTRecoveryBaseProxyURL(raw string) (*url.URL, error) {
+	u, err := validGPTRecoveryProxyURL(strings.ReplaceAll(raw, "{session}", "recoveryvalidation"))
+	if err != nil {
+		return nil, err
+	}
+	// A session may modify proxy authentication only, never its destination.
+	if strings.Contains(raw, "{session}") && (strings.Contains(u.Host, "recoveryvalidation") || strings.Contains(u.Path, "recoveryvalidation")) {
+		return nil, gptRecoveryError("proxy_invalid", "代理会话模板只能用于认证信息")
+	}
+	return u, nil
+}
+
+func (s *OpenAIGatewayService) setGPTRecoveryProxyConfig(c config.GPTAccountRecoveryConfig) {
+	if s == nil {
+		return
+	}
+	c = cloneGPTRecoveryConfig(c)
+	s.gptRecoveryProxyConfig.Store(&c)
+}
+
+func (s *OpenAIGatewayService) gptRecoveryProxyConfigSnapshot() config.GPTAccountRecoveryConfig {
+	if s != nil {
+		if c := s.gptRecoveryProxyConfig.Load(); c != nil {
+			return cloneGPTRecoveryConfig(*c)
+		}
+		if s.cfg != nil {
+			c := s.cfg.GPTAccountRecovery
+			c.Normalize()
+			return c
+		}
+	}
+	return config.DefaultGPTAccountRecoveryConfig()
+}
+
+func (s *OpenAIGatewayService) gptRecoveryProxyIdentityDigest(account *Account) string {
+	base, err := s.gptRecoveryBaseProxyURL(account)
+	if err != nil {
+		base = "invalid-recovery-proxy"
+	}
+	c := s.gptRecoveryProxyConfigSnapshot()
+	sum := sha256.Sum256([]byte(base + "\x00" + c.ProxySessionMode + "\x00" + strconv.Itoa(c.ProxySessionTTLSeconds) + "\x00" + c.Transport))
+	return hex.EncodeToString(sum[:])
+}
+
+func newGPTRecoveryProxySession(mode string) (string, error) {
+	length := 12
+	if mode == config.GPTRecoveryProxySessionKookeey {
+		length = 4
+	}
+	raw := make([]byte, length)
+	if _, err := rand.Read(raw); err != nil {
+		return "", gptRecoveryError("proxy_session_unavailable", "无法生成恢复代理会话")
+	}
+	return hex.EncodeToString(raw), nil
+}
+
+// Rebuild authentication from the current private base URL and a non-secret
+// session token. Never include the URL in a returned error.
+func gptRecoverySessionProxyURL(base, mode, session string, ttlSeconds int) (string, error) {
+	if mode == "" {
+		mode = config.GPTRecoveryProxySessionNone
+	}
+	if mode == config.GPTRecoveryProxySessionNone {
+		if session != "" || strings.Contains(base, "{session}") {
+			return "", gptRecoveryError("proxy_session_invalid", "恢复代理会话与当前模式不一致")
+		}
+		if _, err := validGPTRecoveryProxyURL(base); err != nil {
+			return "", err
+		}
+		return base, nil
+	}
+	if !gptRecoveryProxySessionPattern.MatchString(session) || ttlSeconds < 60 || ttlSeconds > 3600 {
+		return "", gptRecoveryError("proxy_session_invalid", "恢复代理会话参数无效")
+	}
+	if mode == config.GPTRecoveryProxySessionTemplate {
+		if !strings.Contains(base, "{session}") {
+			return "", gptRecoveryError("proxy_session_invalid", "恢复代理模板缺少会话占位符")
+		}
+		if _, err := parseGPTRecoveryBaseProxyURL(base); err != nil {
+			return "", err
+		}
+		raw := strings.ReplaceAll(base, "{session}", session)
+		if _, err := validGPTRecoveryProxyURL(raw); err != nil {
+			return "", err
+		}
+		return raw, nil
+	}
+	u, err := validGPTRecoveryProxyURL(base)
+	if err != nil {
+		return "", err
+	}
+	if u.User == nil {
+		return "", gptRecoveryError("proxy_session_invalid", "恢复代理会话模式需要代理认证")
+	}
+	username := u.User.Username()
+	password, hasPassword := u.User.Password()
+	switch mode {
+	case config.GPTRecoveryProxySessionUsernameSID:
+		if !gptRecoveryProxyUsernameSID.MatchString(username) {
+			return "", gptRecoveryError("proxy_session_invalid", "代理用户名缺少 sid 会话字段")
+		}
+		username = gptRecoveryProxyUsernameSID.ReplaceAllString(username, "${1}"+session)
+	case config.GPTRecoveryProxySessionKookeey:
+		// Kookeey's documented sticky session is an eight-character suffix
+		// after the password's geographic selector. No rotation interval is
+		// appended: the application bounds this sticky lease itself.
+		if !hasPassword || len(session) != 8 || !gptRecoveryKookeeyPassword.MatchString(password) {
+			return "", gptRecoveryError("proxy_session_invalid", "Kookeey 密码需以国家或地区字段结尾，且不能预置会话或轮换间隔")
+		}
+		password += "-" + session
+	default:
+		return "", gptRecoveryError("proxy_session_invalid", "恢复代理会话模式无效")
+	}
+	if hasPassword {
+		u.User = url.UserPassword(username, password)
+	} else {
+		u.User = url.User(username)
+	}
+	return u.String(), nil
+}
+
+func (s *OpenAIGatewayService) gptRecoveryTicketProxyURL(account *Account, ticket *GPTAccountRecoveryTicket) (string, error) {
+	base, err := s.gptRecoveryBaseProxyURL(account)
+	if err != nil {
+		return "", err
+	}
+	if ticket == nil {
+		return "", gptRecoveryError("proxy_session_invalid", "恢复代理票据无效")
+	}
+	c := s.gptRecoveryProxyConfigSnapshot()
+	mode := ticket.ProxySessionMode
+	if mode == "" {
+		mode = config.GPTRecoveryProxySessionNone
+	}
+	if mode != c.ProxySessionMode || (mode != config.GPTRecoveryProxySessionNone && !ticket.ProxyExpiresAt.After(time.Now())) {
+		return "", gptRecoveryError("proxy_session_expired", "恢复代理会话已过期或配置已变化")
+	}
+	return gptRecoverySessionProxyURL(base, mode, ticket.ProxySession, c.ProxySessionTTLSeconds)
+}
