+	accounts, err := repo.ListGPTMonitorManualConfirmations(context.Background(), "config-key", 1)
+	require.Error(t, err)
+	require.Nil(t, accounts)
+}
+
+func TestListGPTMonitorManualConfirmationsPropagatesDatabaseFailure(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = db.Close() })
+	repo := newAccountRepositoryWithSQL(nil, db, nil)
+	failure := errors.New("database unavailable")
+	mock.ExpectQuery("SELECT").WithArgs("config-key", 1).WillReturnError(failure)
+	accounts, err := repo.ListGPTMonitorManualConfirmations(context.Background(), "config-key", 1)
+	require.ErrorIs(t, err, failure)
