+func TestGPTAccountMonitorEquivalentConfigKeepsRunningAndQueuedScan(t *testing.T) {
+	s, _, _ := gptMonitorFixture()
+	s.settings = &gptMonitorSettingsStub{}
+	s.cfg.AccountIDs = []int64{7, 2, 7}
+	s.defaults = cloneGPTMonitorConfig(s.cfg)
+	s.cancel = func() {}
+	probeCtx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	s.activeCancel = cancel
+	next := time.Now().Add(time.Hour)
+	s.state.Running = true
+	s.state.NextRun = &next
+	s.state.Message = "正在巡检"
+	s.trigger <- gptMonitorRequest{ConfigKey: gptMonitorConfigHash(s.cfg)}
+
+	cfg := cloneGPTMonitorConfig(s.cfg)
+	cfg.AccountIDs = []int64{2, 7}
+	cfg.Prompt = "  " + cfg.Prompt + " \n"
+	cfg.Model, cfg.ReasoningEffort = "legacy-model", "low"
+	saved, err := s.SaveConfig(context.Background(), cfg)
+
+	require.NoError(t, err)
+	require.NoError(t, probeCtx.Err(), "saving equivalent settings must not abort a live upstream request")
+	require.True(t, s.state.Running)
+	require.Equal(t, &next, s.state.NextRun)
+	require.Equal(t, "正在巡检", s.state.Message)
+	require.Len(t, s.trigger, 1, "keep an already queued manual scan")
+	require.Empty(t, s.wake)
+	require.Equal(t, []int64{2, 7}, saved.AccountIDs)
+	loaded, err := s.GetConfig(context.Background())
+	require.NoError(t, err)
+	require.Equal(t, saved, loaded, "still persist normalized settings")
+}
