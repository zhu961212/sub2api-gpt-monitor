+func TestGPTAccountRecoveryReadinessUsesCurrentIdentityAndKeepsSecretsPrivate(t *testing.T) {
+	s, a, repo, store := recoveryServiceFixture()
+	future := time.Now().Add(time.Hour)
+	a.Extra = map[string]any{"gpt_account_recovery": GPTAccountRecoveryResult{Verdict: "ready", CookieExpiresAt: &future, ExpiresAt: &future}}
+	key := s.gateway.gptRecoveryRoutingIdentityKey(a)
