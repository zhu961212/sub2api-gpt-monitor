+func TestGPTMonitorTokenExpiringDuringCacheWaitDoesNotDisable(t *testing.T) {
+	account := gptMonitorTestAccount()
+	// The account is valid at the probe's first eligibility check. Cache I/O
+	// delays token selection until after its expiry; no provider writes may run.
+	expires := time.Now().Add(30 * time.Millisecond)
+	account.Credentials["expires_at"] = expires.Format(time.RFC3339Nano)
+	cache := &gptMonitorProbeCache{wait: func() { <-time.After(time.Until(expires) + 5*time.Millisecond) }}
+	repo := &gptMonitorProbeRepo{get: func(context.Context, int64) (*Account, error) { return account, nil }}
+	provider := &OpenAITokenProvider{accountRepo: repo, tokenCache: cache}
+	s := &OpenAIGatewayService{accountRepo: repo, openAITokenProvider: provider}
+	// This repo implements no SetError: the old path panics if it disables.
+	if _, _, err := s.resolveGPTMonitorIdentity(context.Background(), 42); err == nil {
+		t.Fatal("expired token accepted")
+	}
+	if cache.calls != 1 || account.Status != StatusActive || !account.Schedulable {
+		t.Fatal("cache boundary skipped or account changed")
+	}
