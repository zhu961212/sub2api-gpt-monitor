@@ -0,0 +1,134 @@
+package service
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+func dynamicRecoveryTicket(session string) *GPTAccountRecoveryTicket {
+	ticket := recoveryRoutingTicket("dynamic-cflb", "dynamic-oailb")
+	ticket.ProxySession, ticket.ProxySessionMode = session, "kookeey"
+	ticket.ProxyExpiresAt = time.Now().Add(5 * time.Minute)
+	ticket.CookieExpiresAt = ticket.ProxyExpiresAt
+	return ticket
+}
+
+func TestGPTRecoveryDynamicHTTPPinsSuccessfulProxyAndTurn(t *testing.T) {
+	t.Setenv(gptRecoveryProxyURLEnv, "http://fixture:private-US@proxy.example:1000")
+	s, account, store := recoveryRoutingFixture()
+	cfg := config.DefaultGPTAccountRecoveryConfig()
+	cfg.ProxySessionMode = "kookeey"
+	s.setGPTRecoveryProxyConfig(cfg)
+	identity := s.gptRecoveryRoutingIdentityKey(account)
+	store.tickets[identity] = dynamicRecoveryTicket("1234abcd")
+	response := http.Header{}
+	response.Set(openAICodexTurnStateHeader, "real-business-turn")
+	recorder := &httpUpstreamRecorder{resp: &http.Response{StatusCode: http.StatusOK, Header: response}}
+	s.httpUpstream = recorder
+	request := func(turn string) *http.Request {
+		r := httptest.NewRequest(http.MethodPost, chatgptCodexURL, nil)
+		r.Header = recoveryRoutingHeaders(account)
+		if turn != "" {
+			r.Header.Set(openAICodexTurnStateHeader, turn)
+		}
+		return r
+	}
+	_, err := s.doOpenAIUpstream(request(""), account.Proxy.URL(), account)
+	require.NoError(t, err)
+	require.Equal(t, "http://fixture:private-US-1234abcd@proxy.example:1000", recorder.lastProxyURL)
+	require.Empty(t, recorder.lastReq.Header.Get(openAICodexTurnStateHeader))
+	require.Equal(t, "__cflb=dynamic-cflb; __oailb=dynamic-oailb", recorder.lastReq.Header.Get("Cookie"))
+	require.Equal(t, "1234abcd", store.tickets[gptRecoveryTurnRoutingKey(identity, "real-business-turn")].ProxySession)
+	store.tickets[identity] = dynamicRecoveryTicket("5678efab")
+	_, err = s.doOpenAIUpstream(request("real-business-turn"), account.Proxy.URL(), account)
+	require.NoError(t, err)
+	require.Contains(t, recorder.lastProxyURL, "-1234abcd@")
+	_, err = s.doOpenAIUpstream(request(""), account.Proxy.URL(), account)
+	require.NoError(t, err)
+	require.Contains(t, recorder.lastProxyURL, "-5678efab@")
+}
+
+type dynamicRecoveryWSDialer struct {
+	proxies []string
+	headers []http.Header
+}
+
+func (d *dynamicRecoveryWSDialer) Dial(_ context.Context, _ string, headers http.Header, proxy string) (openAIWSClientConn, int, http.Header, error) {
+	d.proxies = append(d.proxies, proxy)
+	d.headers = append(d.headers, headers.Clone())
+	return &openAIWSFakeConn{}, http.StatusSwitchingProtocols, http.Header{}, nil
+}
+
+func TestGPTRecoveryDynamicWSRefreshesProxyAndPairTogether(t *testing.T) {
+	t.Setenv(gptRecoveryProxyURLEnv, "http://fixture:private-US@proxy.example:1000")
+	s, account, store := recoveryRoutingFixture()
+	cfg := config.DefaultGPTAccountRecoveryConfig()
+	cfg.ProxySessionMode = "kookeey"
+	s.setGPTRecoveryProxyConfig(cfg)
+	s.cfg.Gateway.OpenAIWS.MaxConnsPerAccount = 3
+	s.cfg.Gateway.OpenAIWS.MaxIdlePerAccount = 3
+	pool := newOpenAIWSConnPool(s.cfg)
+	defer pool.Close()
+	dialer := &dynamicRecoveryWSDialer{}
+	pool.setClientDialerForTest(dialer)
+	identity := s.gptRecoveryRoutingIdentityKey(account)
+	store.tickets[identity] = dynamicRecoveryTicket("1234abcd")
+	req := openAIWSAcquireRequest{Account: account, WSURL: "wss://chatgpt.com/backend-api/codex/responses",
+		Headers: recoveryRoutingHeaders(account), ProxyURL: account.Proxy.URL(),
+		RouteFactory: func(ctx context.Context, headers http.Header, proxy string) (http.Header, string, error) {
+			return s.refreshGPTRecoveryWSRoute(ctx, account, headers, proxy)
+		},
+	}
+	first, err := pool.Acquire(context.Background(), req)
+	require.NoError(t, err)
+	firstID := first.ConnID()
+	first.Release()
+	// Reusing the exact cookies must still select a different connection when
+	// the recovered residential proxy session has changed.
+	store.tickets[identity] = dynamicRecoveryTicket("5678efab")
+	second, err := pool.Acquire(context.Background(), req)
+	require.NoError(t, err)
+	require.False(t, second.Reused())
+	second.Release()
+	require.Len(t, dialer.proxies, 2)
+	require.Contains(t, dialer.proxies[0], "-1234abcd@")
+	require.Contains(t, dialer.proxies[1], "-5678efab@")
+	require.Equal(t, dialer.headers[0].Get("Cookie"), dialer.headers[1].Get("Cookie"))
+	continued := req
+	continued.PreferredConnID, continued.ForcePreferredConn = firstID, true
+	third, err := pool.Acquire(context.Background(), continued)
+	require.NoError(t, err)
+	require.True(t, third.Reused())
+	require.Equal(t, firstID, third.ConnID())
+	third.Release()
+	require.Len(t, dialer.proxies, 2)
+}
+
+func TestGPTRecoveryDynamicWSExpiryRemovesBothRouteAndSession(t *testing.T) {
+	t.Setenv(gptRecoveryProxyURLEnv, "http://fixture:private-US@proxy.example:1000")
+	s, account, store := recoveryRoutingFixture()
+	cfg := config.DefaultGPTAccountRecoveryConfig()
+	cfg.ProxySessionMode = "kookeey"
+	s.setGPTRecoveryProxyConfig(cfg)
+	identity := s.gptRecoveryRoutingIdentityKey(account)
+	store.tickets[identity] = dynamicRecoveryTicket("1234abcd")
+	headers, pinned, err := s.refreshGPTRecoveryWSRoute(context.Background(), account, recoveryRoutingHeaders(account), account.Proxy.URL())
+	require.NoError(t, err)
+	require.Contains(t, pinned, "-1234abcd@")
+	store.tickets[identity].ProxyExpiresAt = time.Now().Add(-time.Second)
+	headers, fallback, err := s.refreshGPTRecoveryWSRoute(context.Background(), account, headers, pinned)
+	require.NoError(t, err)
+	require.Empty(t, headers.Get("Cookie"))
+	require.Equal(t, account.Proxy.URL(), fallback)
+	headers.Set("Cookie", "unrelated=kept")
+	_, fallback, err = s.refreshGPTRecoveryWSRoute(context.Background(), account, headers, "http://custom.example:8080")
+	require.NoError(t, err)
+	require.Equal(t, "http://custom.example:8080", fallback)
+	require.Equal(t, "unrelated=kept", headers.Get("Cookie"))
+}
diff --git a/backend/internal/service/openai_recovery_proxy_observer_test.go b/backend/internal/service/openai_recovery_proxy_observer_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..dddd7419252819b55a1d03cd4866a8c22eacf12e
--- /dev/null
+++ b/backend/internal/service/openai_recovery_proxy_observer_test.go
@@ -0,0 +1,111 @@
+package service
+
+import (
+	"context"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+type recoveryProxyObserverDialer struct {
+	headers []http.Header
+	proxies []string
+	onDial  func()
+}
+
+func (d *recoveryProxyObserverDialer) Dial(_ context.Context, _ string, headers http.Header, proxy string) (openAIWSClientConn, int, http.Header, error) {
+	d.headers = append(d.headers, headers.Clone())
+	d.proxies = append(d.proxies, proxy)
+	if d.onDial != nil {
+		d.onDial()
+	}
+	response := make(http.Header)
+	response.Set(openAIWSTurnStateHeader, "actual-session-turn")
+	return &openAIWSFakeConn{}, http.StatusSwitchingProtocols, response, nil
+}
+
+func recoveryProxyObserverTicket(session string) *GPTAccountRecoveryTicket {
+	ticket := recoveryRoutingTicket("cf-shared-pair", "oa-shared-pair")
+	ticket.ProxySessionMode = config.GPTRecoveryProxySessionKookeey
+	ticket.ProxySession = session
+	ticket.ProxyExpiresAt = time.Now().Add(10 * time.Minute)
+	return ticket
+}
+
+func TestGPTRecoveryWSObserverUsesActualDialSession(t *testing.T) {
+	for _, initialTicket := range []bool{false, true} {
+		name := "ticket_appears_before_dial"
+		if initialTicket {
+			name = "same_cookie_pair_changes_proxy_session"
+		}
+		t.Run(name, func(t *testing.T) {
+			t.Setenv(gptRecoveryProxyURLEnv, "http://fixture-user:fixture-password-US@proxy.example:1000")
+			s, account, store := recoveryRoutingFixture()
+			cfg := config.DefaultGPTAccountRecoveryConfig()
+			cfg.ProxySessionMode = config.GPTRecoveryProxySessionKookeey
+			s.setGPTRecoveryProxyConfig(cfg)
+			s.cfg.Gateway.OpenAIWS.MaxConnsPerAccount = 1
+			s.cfg.Gateway.OpenAIWS.MinIdlePerAccount = 0
+			s.cfg.Gateway.OpenAIWS.MaxIdlePerAccount = 1
+			pool := newOpenAIWSConnPool(s.cfg)
+			defer pool.Close()
+			ctx := context.Background()
+			identity := s.gptRecoveryRoutingIdentityKey(account)
+			if initialTicket {
+				require.NoError(t, store.SaveTicket(ctx, identity, recoveryProxyObserverTicket("aaaaaaaa"), time.Hour))
+			}
+			headers := recoveryRoutingHeaders(account)
+			s.applyGPTRecoveryRouting(ctx, account, headers, account.Proxy.URL())
+			capturedObserver := s.gptRecoveryWSHandshakeObserver(ctx, account, headers)
+			if initialTicket {
+				require.NotNil(t, capturedObserver)
+			} else {
+				require.Nil(t, capturedObserver)
+			}
+			actualTicket := recoveryProxyObserverTicket("bbbbbbbb")
+			wantProxy, err := s.gptRecoveryTicketProxyURL(account, actualTicket)
+			require.NoError(t, err)
+			dialer := &recoveryProxyObserverDialer{onDial: func() {
+				// A recovery completed while the handshake was in flight. The
+				// observer must retain the route chosen before the actual dial.
+				require.NoError(t, store.SaveTicket(ctx, identity, recoveryProxyObserverTicket("cccccccc"), time.Hour))
+			}}
+			pool.setClientDialerForTest(dialer)
+			routeCalls := 0
+			lease, err := pool.Acquire(ctx, openAIWSAcquireRequest{
+				Account: account, WSURL: "wss://chatgpt.com/backend-api/codex/responses", Headers: headers, ProxyURL: account.Proxy.URL(),
+				OnHandshake: capturedObserver,
+				RouteFactory: func(factoryCtx context.Context, headers http.Header, proxy string) (http.Header, string, error) {
+					routeCalls++
+					if routeCalls == 2 {
+						// This happens after compatibility selection and before the
+						// real dial, while the original observer still points to A/nil.
+						require.NoError(t, store.SaveTicket(factoryCtx, identity, actualTicket, time.Hour))
+					}
+					return s.refreshGPTRecoveryWSRoute(factoryCtx, account, headers, proxy)
+				},
+				HandshakeObserverFactory: func(factoryCtx context.Context, headers http.Header, proxy string) func(context.Context, http.Header, http.Header) {
+					return s.gptRecoveryWSHandshakeObserver(factoryCtx, account, headers, proxy)
+				},
+			})
+			require.NoError(t, err)
+			defer lease.Release()
+			require.Equal(t, 2, routeCalls)
+			require.Equal(t, []string{wantProxy}, dialer.proxies)
+			require.Equal(t, "__cflb=cf-shared-pair; __oailb=oa-shared-pair", dialer.headers[0].Get("Cookie"))
+			bound, err := store.LoadTicket(ctx, gptRecoveryTurnRoutingKey(identity, "actual-session-turn"))
+			require.NoError(t, err)
+			require.NotNil(t, bound, "a newly acquired route must record its real handshake turn-state")
+			require.Equal(t, actualTicket.ProxySession, bound.ProxySession, "identical cookies must not bind the turn to an older or newer proxy session")
+			require.Equal(t, "actual-session-turn", bound.TurnState)
+			continuation := recoveryRoutingHeaders(account)
+			continuation.Set(openAIWSTurnStateHeader, "actual-session-turn")
+			_, continuationProxy, err := s.refreshGPTRecoveryWSRoute(ctx, account, continuation, account.Proxy.URL())
+			require.NoError(t, err)
+			require.Equal(t, wantProxy, continuationProxy, "a reconnect must use the session of its actual handshake")
+		})
+	}
+}
