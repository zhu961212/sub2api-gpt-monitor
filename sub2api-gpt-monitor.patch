+
+  it('reads an individual account result independently from configured scope', async () => {
+    const signal = new AbortController().signal
+    const result = { account_id: 42, checked_at: null, verdict: 'pending' }
+    get.mockResolvedValue({ data: result })
+    expect(await getAccountResult(42, signal)).toEqual(result)
+    expect(get).toHaveBeenCalledWith('/admin/gpt-account-monitor/accounts/42/result', { signal })
+    expect(post).not.toHaveBeenCalled()
+  })
+})
