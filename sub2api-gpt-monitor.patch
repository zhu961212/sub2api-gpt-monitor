+			s.cfg.Gateway.OpenAIWS.MaxIdlePerAccount = 2
+			pool := newOpenAIWSConnPool(s.cfg)
+			defer pool.Close()
+			dialer := &recoveryRoutingCaptureWSDialer{}
+			pool.setClientDialerForTest(dialer)
+			identity := s.gptRecoveryRoutingIdentityKey(account)
+			store.tickets[identity] = recoveryRoutingTicket("cf-original", "oa-original")
+			headers := recoveryRoutingHeaders(account)
+			headers.Set("X-Codex-Installation-Id", "installation-stable")
+			headers.Set("Thread-Id", "thread-stable")
+			s.applyGPTRecoveryRouting(context.Background(), account, headers, account.Proxy.URL())
+			request := openAIWSAcquireRequest{Account: account, WSURL: "wss://chatgpt.com/backend-api/codex/responses", Headers: headers, ProxyURL: account.Proxy.URL()}
+			first, err := pool.Acquire(context.Background(), request)
+			require.NoError(t, err)
+			connectionID := first.ConnID()
+			first.Release()
+			for _, cookie := range []string{"", "__cflb=cf-new-global; __oailb=oa-new-global"} {
+				continuation := request
+				continuation.Headers = headers.Clone()
+				continuation.Headers.Del("Cookie")
+				if cookie != "" {
+					continuation.Headers.Set("Cookie", cookie)
+				}
+				if forcePreferred {
+					continuation.Headers.Set(openAIWSTurnStateHeader, "real-existing-turn")
+				}
+				continuation.PreferredConnID = connectionID
+				continuation.ForcePreferredConn = forcePreferred
+				lease, err := pool.Acquire(context.Background(), continuation)
+				require.NoError(t, err)
+				require.True(t, lease.Reused())
+				require.Equal(t, connectionID, lease.ConnID())
+				lease.ApplyRecoveryRoutingHeaders(continuation.Headers)
+				require.Equal(t, "__cflb=cf-original; __oailb=oa-original", continuation.Headers.Get("Cookie"))
+				lease.Release()
+			}
+			require.Len(t, dialer.headers, 1, "a new global ticket must not redial an existing continuation")
+			// Cookie affinity is the only relaxed field. Existing beta and stable
+			// device/thread identity guards must still reject an incompatible lease.
+			for _, name := range []string{"X-Codex-Beta-Features", "X-Codex-Installation-Id", "Thread-Id"} {
+				changed := request
+				changed.Headers = headers.Clone()
+				changed.Headers.Set(name, "different")
+				changed.Headers.Set(openAIWSTurnStateHeader, "real-existing-turn")
+				changed.PreferredConnID = connectionID
+				changed.ForcePreferredConn = true
+				_, err := pool.Acquire(context.Background(), changed)
+				require.ErrorIs(t, err, errOpenAIWSPreferredConnUnavailable)
+			}
+		})
+	}
+}
