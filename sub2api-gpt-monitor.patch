+				} else {
+					runRecoveryMetadataWSClient(t, s, account, state)
+				}
+				bound, err := store.LoadTicket(context.Background(), gptRecoveryTurnRoutingKey(identity, fmt.Sprintf("business-turn-%d", turn)))
+				require.NoError(t, err)
+				require.NotNil(t, bound, "metadata state must be remembered even with an empty 101 header")
+				require.Equal(t, original.ProxySession, bound.ProxySession)
+			}
+			headers, proxies := dialer.snapshot()
+			require.Equal(t, []string{wantProxy, wantProxy}, proxies)
+			require.Empty(t, headers[0].Get(openAIWSTurnStateHeader), "probe state must never enter a fresh conversation")
+			require.Equal(t, "business-turn-1", headers[1].Get(openAIWSTurnStateHeader))
+			require.Equal(t, headers[0].Get("Cookie"), headers[1].Get("Cookie"))
+		})
+	}
+}
+
+func runRecoveryMetadataWSClient(t *testing.T, s *OpenAIGatewayService, account *Account, turnState string) {
+	t.Helper()
+	serverErr := make(chan error, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := coderws.Accept(w, r, nil)
+		if err != nil {
+			serverErr <- err
+			return
+		}
+		defer conn.CloseNow()
+		c, _ := gin.CreateTestContext(httptest.NewRecorder())
+		c.Request = r
+		readCtx, cancelRead := context.WithTimeout(r.Context(), 3*time.Second)
+		_, first, err := conn.Read(readCtx)
+		cancelRead()
+		if err != nil {
+			serverErr <- err
+			return
+		}
+		serverErr <- s.ProxyResponsesWebSocketFromClient(r.Context(), c, conn, account, account.GetOpenAIAccessToken(), first, nil)
+	}))
+	defer server.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	headers := make(http.Header)
+	if turnState != "" {
+		headers.Set(openAIWSTurnStateHeader, turnState)
+	}
+	client, _, err := coderws.Dial(ctx, "ws"+strings.TrimPrefix(server.URL, "http"), &coderws.DialOptions{HTTPHeader: headers})
+	require.NoError(t, err)
+	defer client.CloseNow()
+	request, _ := json.Marshal(map[string]any{"type": "response.create", "model": "gpt-6-astra", "input": "hi"})
+	require.NoError(t, client.Write(ctx, coderws.MessageText, request))
+	_, metadata, err := client.Read(ctx)
+	require.NoError(t, err)
+	require.Equal(t, "codex.response.metadata", gjson.GetBytes(metadata, "type").String())
+	_, completed, err := client.Read(ctx)
+	require.NoError(t, err)
+	require.Equal(t, "response.completed", gjson.GetBytes(completed, "type").String())
+	_ = client.Close(coderws.StatusNormalClosure, "done")
+	select {
+	case err := <-serverErr:
+		if err != nil {
+			require.True(t, isOpenAIWSClientDisconnectError(err), "unexpected business WS error: %v", err)
+		}
+	case <-ctx.Done():
+		t.Fatal("business WS did not finish after the client closed")
+	}
+}
