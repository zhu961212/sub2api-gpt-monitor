+	a.Extra["gpt_account_recovery"] = GPTAccountRecoveryResult{Verdict: "error", Message: "latest probe failed"}
+	require.NoError(t, store.SaveTicket(context.Background(), s.gateway.gptRecoveryRoutingIdentityKey(a), ticket, time.Hour))
+	result, err = s.AccountResult(context.Background(), a.ID)
