+package service
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestGPTAccountRecoveryAutomaticCacheReusesActualShortLease(t *testing.T) {
+	s, a, repo, store := recoveryServiceFixture()
+	ticket := recoveryRoutingTicket("cached-cflb", "cached-oailb")
+	ticket.CookieExpiresAt = time.Now().Add(time.Minute)
+	ticket.ConfigKey = gptRecoveryConfigKey(s.defaults)
+	require.NoError(t, store.SaveTicket(context.Background(), s.gateway.gptRecoveryRoutingIdentityKey(a), ticket, time.Minute))
+	upstream := &recoveryServiceHTTPUpstream{err: errors.New("an automatic cached run must not issue HTTP")}
+	s.gateway.httpUpstream = upstream
+	attempted := s.recoverAccount(context.Background(), s.defaults, a.ID, "worker-owner", 0, true)
+	require.False(t, attempted)
+	require.Zero(t, upstream.calls)
+	require.Zero(t, repo.resultWrites)
+	s.mu.Lock()
+	deadline := s.refreshDeadline
+	s.mu.Unlock()
+	require.False(t, deadline.IsZero())
+	require.False(t, deadline.After(ticket.CookieExpiresAt.Add(-30*time.Second)), "refresh follows the shortest actual upstream lease")
+}
+
+func TestGPTAccountRecoveryCookieTTLChangeRequiresNewMint(t *testing.T) {
+	s, a, repo, store := recoveryServiceFixture()
+	oldConfig := s.defaults
+	ticket := recoveryRoutingTicket("cached-cflb", "cached-oailb")
+	ticket.CookieExpiresAt = time.Now().Add(time.Hour)
+	ticket.ConfigKey = gptRecoveryConfigKey(oldConfig)
+	require.NoError(t, store.SaveTicket(context.Background(), s.gateway.gptRecoveryRoutingIdentityKey(a), ticket, time.Hour))
+	s.defaults.CookieTTLSeconds = 300
+	require.NotEqual(t, gptRecoveryConfigKey(oldConfig), gptRecoveryConfigKey(s.defaults))
+	upstream := &recoveryServiceHTTPUpstream{response: recoveryServiceProtocolResponse()}
+	s.gateway.httpUpstream = upstream
+	attempted := s.recoverAccount(context.Background(), s.defaults, a.ID, "worker-owner", 0, true)
+	require.True(t, attempted)
+	require.Equal(t, 1, upstream.calls)
+	require.Equal(t, 1, repo.resultWrites)
+	fresh, err := store.LoadTicket(context.Background(), s.gateway.gptRecoveryRoutingIdentityKey(a))
+	require.NoError(t, err)
+	require.Equal(t, gptRecoveryConfigKey(s.defaults), fresh.ConfigKey)
+	require.WithinDuration(t, time.Now().Add(300*time.Second), fresh.CookieExpiresAt, 2*time.Second)
+}
