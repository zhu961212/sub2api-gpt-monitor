+func TestGPTRecoveryHandlerExposesOnlyProxyOverridePresence(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, test := range []struct {
+		name, value string
+		want        bool
+	}{
+		{"empty", "", false},
+		{"whitespace", " \t ", false},
+		{"configured", "http://fixture-user:PRIVATE_PROXY_FIXTURE@proxy.example:1000", true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			t.Setenv("GPT_ACCOUNT_RECOVERY_PROXY_URL", test.value)
+			stub := &recoveryHandlerStub{cfg: config.DefaultGPTAccountRecoveryConfig()}
+			h := &GPTAccountRecoveryHandler{monitor: stub}
+			router := gin.New()
+			router.GET("/config", h.GetConfig)
+			router.PUT("/config", h.SaveConfig)
+			raw, err := json.Marshal(stub.cfg)
+			require.NoError(t, err)
+			for _, method := range []string{http.MethodGet, http.MethodPut} {
+				w := httptest.NewRecorder()
+				router.ServeHTTP(w, httptest.NewRequest(method, "/config", strings.NewReader(string(raw))))
+				require.Equal(t, http.StatusOK, w.Code)
+				var envelope struct {
+					Data gptAccountRecoveryConfigResponse `json:"data"`
+				}
+				require.NoError(t, json.Unmarshal(w.Body.Bytes(), &envelope))
+				require.Equal(t, test.want, envelope.Data.ProxyOverrideConfigured)
+				require.NotContains(t, w.Body.String(), "PRIVATE_PROXY_FIXTURE")
+				require.NotContains(t, w.Body.String(), "proxy.example")
+				require.NotContains(t, w.Body.String(), "proxy_url")
+			}
