+package service
+
+import "encoding/json"
+
+func gptMonitorSavedResult(account *Account) GPTAccountMonitorResult {
+	var result GPTAccountMonitorResult
+	if account == nil {
+		return result
+	}
+	if raw, ok := account.Extra["gpt_account_monitor"]; ok {
+		data, err := json.Marshal(raw)
+		if err == nil {
+			_ = json.Unmarshal(data, &result)
+		}
+	}
+	return result
+}
diff --git a/backend/internal/service/gpt_account_monitor_service.go b/backend/internal/service/gpt_account_monitor_service.go
new file mode 100644
index 0000000000000000000000000000000000000000..ef8be69a769681fb13b3221d3f187c0bf9dec9da
--- /dev/null
+++ b/backend/internal/service/gpt_account_monitor_service.go
@@ -0,0 +1,769 @@
+package service
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/logger"
+)
+
+// GPTAccountMonitorStore coordinates the built-in worker across server replicas.
+// Failed coordination never falls back to uncoordinated probing or mutations.
+type GPTAccountMonitorStore interface {
+	Acquire(context.Context, string, time.Duration) (bool, error)
+	Renew(context.Context, string, time.Duration) (bool, error)
+	Owns(context.Context, string) (bool, error)
+	Release(context.Context, string) error
+	NextRun(context.Context, string) (time.Time, error)
+	SetNextRun(context.Context, string, time.Time) error
+}
+
+type gptMonitorSchedulingRepository interface {
+	SetGPTMonitorSchedulableIfMatch(context.Context, *Account, bool) (bool, error)
+}
+
+type gptMonitorResultRepository interface {
+	UpdateGPTMonitorResult(context.Context, int64, GPTAccountMonitorResult) error
+}
+
+type gptAccountProbe func(context.Context, int64, string, string) (*Account, string, error)
+
+// GPTAccountMonitorResult is stored under account.extra.gpt_account_monitor.
+// It never contains credentials, proxy URLs, or upstream error bodies.
+type GPTAccountMonitorResult struct {
+	CheckedAt          time.Time  `json:"checked_at"`
+	Verdict            string     `json:"verdict"`
+	Answer             string     `json:"answer,omitempty"`
+	Message            string     `json:"message"`
+	Model              string     `json:"model"`
+	ReasoningEffort    string     `json:"reasoning_effort,omitempty"`
+	ExpectedGeneration int        `json:"expected_generation"`
+	Schedulable        bool       `json:"schedulable"`
+	Changed            bool       `json:"changed"`
+	ErrorCode          string     `json:"error_code,omitempty"`
+	HTTPStatus         int        `json:"http_status,omitempty"`
+	DurationMS         int64      `json:"duration_ms,omitempty"`
+	ConfigKey          string     `json:"config_key,omitempty"`
+	PendingVerdict     string     `json:"pending_verdict,omitempty"`
+	PendingCheckedAt   *time.Time `json:"pending_checked_at,omitempty"`
+	Consecutive        int        `json:"consecutive,omitempty"`
+	NextCheckAt        *time.Time `json:"next_check_at,omitempty"`
+	NextCheckUnix      int64      `json:"next_check_unix,omitempty"`
+	ManualRequested    bool       `json:"manual_requested,omitempty"`
+	ManualRunning      bool       `json:"manual_running,omitempty"`
+	ManualAttempts     int        `json:"manual_attempts,omitempty"`
+}
+
+type gptMonitorRequest struct {
+	ConfigKey    string
+	AccountID    int64
+	Confirmation bool
+}
+
+type GPTAccountMonitorService struct {
+	repo         AccountRepository
+	store        GPTAccountMonitorStore
+	settings     SettingRepository
+	defaults     config.GPTAccountMonitorConfig
+	cfg          config.GPTAccountMonitorConfig
+	probe        gptAccountProbe
+	startOnce    sync.Once
+	stopOnce     sync.Once
+	cycleMu      sync.Mutex
+	mu           sync.Mutex
+	managementMu sync.RWMutex
+	cancel       context.CancelFunc
+	activeCancel context.CancelFunc
+	done         chan struct{}
+	trigger      chan gptMonitorRequest
+	wake         chan struct{}
+	state        GPTAccountMonitorStatus
+	probeGap     time.Duration
+}
+
+func NewGPTAccountMonitorService(repo AccountRepository, gateway *OpenAIGatewayService, store GPTAccountMonitorStore, settings SettingRepository, cfg *config.Config) *GPTAccountMonitorService {
+	s := &GPTAccountMonitorService{repo: repo, store: store, settings: settings, trigger: make(chan gptMonitorRequest, 1), wake: make(chan struct{}, 1), probeGap: 5 * time.Second}
+	if cfg != nil {
+		s.cfg = cloneGPTMonitorConfig(cfg.GPTAccountMonitor)
+		s.defaults = cloneGPTMonitorConfig(s.cfg)
+	}
+	if gateway != nil {
+		s.probe = gateway.ProbeGPTAccount
+	}
+	return s
+}
+
+func (s *GPTAccountMonitorService) Start() {
+	if s == nil || (!s.cfg.Enabled && s.settings == nil) {
+		return
+	}
+	s.startOnce.Do(func() {
+		if s.repo == nil || s.store == nil || s.probe == nil || s.cfg.IntervalSeconds < 60 || s.cfg.TimeoutSeconds < 10 || s.cfg.Concurrency < 1 || s.cfg.Concurrency > 10 {
+			logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] not started: missing dependencies or invalid configuration")
+			return
+		}
+		if _, ok := s.repo.(gptMonitorSchedulingRepository); !ok {
+			logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] not started: atomic scheduling unavailable")
+			return
+		}
+		ctx, cancel := context.WithCancel(context.Background())
+		done := make(chan struct{})
+		s.mu.Lock()
+		s.cancel = cancel
+		s.done = done
+		s.mu.Unlock()
+		logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] management worker started")
+		go func() { defer close(done); s.loop(ctx) }()
+	})
+}
+
+func (s *GPTAccountMonitorService) Stop() {
+	if s == nil {
+		return
+	}
+	s.stopOnce.Do(func() {
+		s.mu.Lock()
+		cancel, done := s.cancel, s.done
+		s.cancel = nil
+		s.state.Queued = false
+		s.mu.Unlock()
+		if cancel == nil {
+			return
+		}
+		cancel()
+		select {
+		case <-done:
+		case <-time.After(5 * time.Second):
+			logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] shutdown deadline reached")
+		}
+	})
+}
+
+func (s *GPTAccountMonitorService) loop(ctx context.Context) {
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	type completion struct {
+		request gptMonitorRequest
+		delay   time.Duration
+		retry   bool
+		manual  bool
+	}
+	completed := make(chan completion, 1)
+	var active bool
+	var lastKey string
+	var next time.Time
+	var queued *gptMonitorRequest
+	var queuedAt time.Time
+	var lastRead time.Time
+	var lastManualRead time.Time
+	var cfg config.GPTAccountMonitorConfig
+	var readErr error
+	for {
+		s.managementMu.RLock()
+		if time.Since(lastRead) >= 5*time.Second || lastRead.IsZero() {
+			readCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
+			var loaded config.GPTAccountMonitorConfig
+			loaded, readErr = s.GetConfig(readCtx)
+			cancel()
+			if readErr == nil {
+				cfg = loaded
+			}
+			lastRead = time.Now()
+			if readErr != nil {
+				s.setMessage("读取巡检配置失败，等待重试")
+			}
+			key := gptMonitorConfigHash(cfg)
+			if readErr == nil && key != lastKey {
+				lastKey = key
+				s.mu.Lock()
+				s.cfg = cfg
+				if s.activeCancel != nil {
+					s.activeCancel()
+				}
+				s.state.Enabled = cfg.Enabled
+				s.mu.Unlock()
+				next = time.Now().Add(time.Duration(cfg.IntervalSeconds) * time.Second)
+				if cfg.RunOnStart {
+					next = time.Now()
+				}
+				if !cfg.Enabled {
+					s.setMessage("自动巡检已关闭")
+				} else {
+					s.setMessage("等待巡检")
+				}
+			}
+		}
+		if readErr == nil && queued != nil && (queued.ConfigKey != lastKey || (!cfg.Enabled && queued.AccountID == 0)) {
+			queued = nil
+			s.mu.Lock()
+			s.state.Queued = false
+			s.mu.Unlock()
+		}
+		if readErr == nil && !active && queued == nil && (lastManualRead.IsZero() || time.Since(lastManualRead) >= 5*time.Second) {
+			if repo, ok := s.repo.(gptMonitorManualRepository); ok {
+				readCtx, readCancel := context.WithTimeout(ctx, 5*time.Second)
+				accounts, err := repo.ListGPTMonitorManualConfirmations(readCtx, lastKey, 1)
+				readCancel()
+				lastManualRead = time.Now()
+				if err == nil && len(accounts) > 0 {
+					previous := gptMonitorSavedResult(&accounts[0])
+					if previous.NextCheckAt == nil || !previous.NextCheckAt.After(time.Now()) {
+						queued = &gptMonitorRequest{ConfigKey: lastKey, AccountID: accounts[0].ID, Confirmation: true}
+						queuedAt = time.Now()
+					}
+				}
+			}
+		}
+		manualDue := queued != nil && !time.Now().Before(queuedAt)
+		if readErr == nil && !active && (manualDue || (queued == nil && cfg.Enabled && !time.Now().Before(next))) {
+			manual := queued != nil
+			request := gptMonitorRequest{ConfigKey: lastKey}
+			if manual {
+				request = *queued
+			}
+			queued = nil
+			active = true
+			runCfg := cfg
+			runCtx, cancel := context.WithCancel(ctx)
+			s.mu.Lock()
+			s.activeCancel = cancel
+			s.mu.Unlock()
+			go func() {
+				delay, started := s.runMonitorRequest(runCtx, runCfg, request, manual)
+				retry := manual && !started && runCtx.Err() == nil
+				cancel()
+				completed <- completion{request: request, delay: delay, retry: retry, manual: manual}
+			}()
+		}
+		s.mu.Lock()
+		if cfg.Enabled && !active {
+			n := next
+			s.state.NextRun = &n
+		} else {
+			s.state.NextRun = nil
+		}
+		s.mu.Unlock()
+		s.managementMu.RUnlock()
+		select {
+		case <-ctx.Done():
+			s.mu.Lock()
+			if s.activeCancel != nil {
+				s.activeCancel()
+			}
+			s.mu.Unlock()
+			if active {
+				select {
+				case <-completed:
+				case <-time.After(4 * time.Second):
+				}
+			}
+			return
+		case <-ticker.C:
+		case request := <-s.trigger:
+			queued = &request
+			queuedAt = time.Now()
+			lastRead = time.Time{}
+		case <-s.wake:
+			lastRead = time.Time{}
+			lastManualRead = time.Time{}
+		case result := <-completed:
+			lastManualRead = time.Time{}
+			active = false
+			s.mu.Lock()
+			s.activeCancel = nil
+			s.state.Queued = false
+			s.mu.Unlock()
+			if result.request.ConfigKey == lastKey {
+				if result.retry {
+					request := result.request
+					queued = &request
+					queuedAt = time.Now().Add(result.delay)
+					s.mu.Lock()
+					s.state.Queued = true
+					s.state.Message = "等待巡检执行权，稍后重试"
+					s.mu.Unlock()
+				} else if !result.manual {
+					next = time.Now().Add(result.delay)
+				}
+			}
+		}
+	}
+}
+
+func (s *GPTAccountMonitorService) runMonitorRequest(parent context.Context, cfg config.GPTAccountMonitorConfig, request gptMonitorRequest, manual bool) (delay time.Duration, started bool) {
+	cfg.NormalizeFixedModel()
+	cfg.Concurrency = 1
+	s.cycleMu.Lock()
+	defer s.cycleMu.Unlock()
+	retry := 30 * time.Second
+	if parent.Err() != nil {
+		return retry, false
+	}
+	ctx, cancel := context.WithCancel(parent)
+	defer cancel()
+	var random [24]byte
+	if _, err := rand.Read(random[:]); err != nil {
+		return retry, false
+	}
+	owner := hex.EncodeToString(random[:])
+	leaseCtx, leaseCancel := context.WithTimeout(ctx, 5*time.Second)
+	owned, err := s.store.Acquire(leaseCtx, owner, 180*time.Second)
+	leaseCancel()
+	if err != nil {
+		s.logError("lease acquisition failed")
+		return retry, false
+	}
+	if !owned {
+		return retry, false
+	}
+	defer func() {
+		rctx, rcancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer rcancel()
+		_ = s.store.Release(rctx, owner)
+	}()
+	renewDone := make(chan struct{})
+	go func() {
+		defer close(renewDone)
+		ticker := time.NewTicker(45 * time.Second)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				leaseCtx, leaseCancel := context.WithTimeout(ctx, 5*time.Second)
+				ok, e := s.store.Renew(leaseCtx, owner, 180*time.Second)
+				leaseCancel()
+				if e != nil || !ok {
+					s.logError("lease lost; stopping current scan")
+					cancel()
+					return
+				}
+			}
+		}
+	}()
+	defer func() { cancel(); <-renewDone }()
+	configKey := gptMonitorConfigHash(cfg)
+	current, configErr := s.GetConfig(ctx)
+	if configErr != nil || gptMonitorConfigHash(current) != configKey || (request.AccountID == 0 && !current.Enabled) {
+		return retry, false
+	}
+	if request.AccountID == 0 {
+		dueCtx, dueCancel := context.WithTimeout(ctx, 5*time.Second)
+		next, scheduleErr := s.store.NextRun(dueCtx, configKey)
+		dueCancel()
+		if scheduleErr != nil {
+			s.logError("shared schedule unavailable")
+			return retry, false
+		}
+		if !manual && next.After(time.Now()) {
+			return time.Until(next), false
+		}
+	}
+	started = true
+	startedAt := time.Now().UTC()
+	s.mu.Lock()
+	s.state.Running = true
+	s.state.LastRun = &startedAt
+	s.state.Queued = false
+	s.state.Message = "正在巡检"
+	s.mu.Unlock()
+	defer func() { s.mu.Lock(); s.state.Running = false; s.mu.Unlock() }()
+	count := 0
+	ids := cfg.AccountIDs
+	if request.AccountID > 0 {
+		ids = []int64{request.AccountID}
+	}
+	interval := time.Duration(cfg.IntervalSeconds) * time.Second
+	var nextRun time.Time
+	visit := func(a Account) bool {
+		if manual {
+			readCtx, readCancel := context.WithTimeout(ctx, 5*time.Second)
+			current, readErr := s.repo.GetByID(readCtx, a.ID)
+			readCancel()
+			if readErr != nil || current == nil || current.ID != a.ID {
+				cancel()
+				return false
+			}
+			a = *current
+		}
+		previous := gptMonitorSavedResult(&a)
+		if request.AccountID == 0 && !manual && previous.ConfigKey == configKey && previous.NextCheckAt != nil && previous.NextCheckAt.After(time.Now()) {
+			if nextRun.IsZero() || previous.NextCheckAt.Before(nextRun) {
+				nextRun = *previous.NextCheckAt
+			}
+			return true
+		}
+		if count > 0 && s.probeGap > 0 {
+			timer := time.NewTimer(s.probeGap)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return false
+			case <-timer.C:
+			}
+		}
+		var next *time.Time
+		if request.AccountID > 0 {
+			next = s.checkOne(ctx, owner, &a, cfg, false, request)
+		} else {
+			next = s.checkOne(ctx, owner, &a, cfg, !manual)
+		}
+		if next != nil && (nextRun.IsZero() || next.Before(nextRun)) {
+			nextRun = *next
+		}
+		count++
+		return ctx.Err() == nil
+	}
+	if dueRepo, ok := s.repo.(gptMonitorDueRepository); ok && request.AccountID == 0 && !manual {
+		readCtx, readCancel := context.WithTimeout(ctx, 5*time.Second)
+		accounts, readErr := dueRepo.ListGPTMonitorDueCandidates(readCtx, ids, configKey, 1)
+		readCancel()
+		err = readErr
+		if err == nil && len(accounts) > 0 {
+			visit(accounts[0])
+		}
+		// Revisit the earliest due account after the fixed inter-account gap. A
+		// small idle poll also discovers newly added accounts without a full scan.
+		if count > 0 {
+			nextRun = time.Now().Add(s.probeGap)
+		} else {
+			poll := time.Now().Add(30 * time.Second)
+			if nextRun.IsZero() || poll.Before(nextRun) {
+				nextRun = poll
+			}
+		}
+	} else {
+		err = s.eachPollingCandidate(ctx, ids, request.AccountID == 0, visit)
+	}
+	if err != nil {
+		cancel()
+	}
+	if err != nil {
+		s.logError("account listing failed")
+		return retry, true
+	}
+	if ctx.Err() != nil {
+		return retry, true
+	}
+	if request.AccountID > 0 {
+		s.setMessage(fmt.Sprintf("账号 #%d 智商检测结果已保存，待确认结果将自动复测", request.AccountID))
+		return 0, true
+	}
+	if manual {
+		s.setMessage(fmt.Sprintf("顺序测试完成，共 %d 个账号，调度未改变", count))
+		return 0, true
+	}
+	if nextRun.IsZero() {
+		nextRun = time.Now().Add(interval)
+	}
+	saveCtx, saveCancel := context.WithTimeout(ctx, 5*time.Second)
+	err = s.store.SetNextRun(saveCtx, configKey, nextRun)
+	saveCancel()
+	if err != nil {
+		s.logError("scan completed but shared schedule write failed")
+		return retry, true
+	}
+	s.setMessage(fmt.Sprintf("本轮巡检完成，共 %d 个账号", count))
+	logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] scan complete: accounts=%d next_run_in=%ds", count, cfg.IntervalSeconds)
+	delay = time.Until(nextRun)
+	if delay < time.Second {
+		delay = time.Second
+	}
+	return delay, true
+}
+
+// Fetch only a bounded page of account identities. Credentials and the current
+// proxy are loaded by the probe immediately before use, never for the full scan.
+func (s *GPTAccountMonitorService) eachPollingCandidate(ctx context.Context, ids []int64, polling bool, visit func(Account) bool) error {
+	selected := make(map[int64]bool, len(ids))
+	for _, id := range ids {
+		selected[id] = true
+	}
+	consume := func(accounts []Account) bool {
+		for _, a := range accounts {
+			if ctx.Err() != nil {
+				return false
+			}
+			if gptMonitorEligible(&a) && (len(selected) == 0 || selected[a.ID]) && !visit(a) {
+				return false
+			}
+		}
+		return true
+	}
+	if repo, ok := s.repo.(gptMonitorReadRepository); ok {
+		list := repo.ListGPTMonitorCandidates
+		if polling {
+			if scheduler, ok := s.repo.(gptMonitorPollingRepository); ok {
+				list = scheduler.ListGPTMonitorPollingCandidates
+			}
+		}
+		const pageSize = 200
+		var afterID int64
+		for ctx.Err() == nil {
+			readCtx, cancel := context.WithTimeout(ctx, 30*time.Second)
+			accounts, err := list(readCtx, ids, afterID, pageSize)
+			cancel()
+			if err != nil {
+				return err
+			}
+			if len(accounts) == 0 {
+				return nil
+			}
+			lastID := accounts[len(accounts)-1].ID
+			if lastID <= afterID {
+				return fmt.Errorf("monitor account cursor did not advance")
+			}
+			if !consume(accounts) {
+				return ctx.Err()
+			}
+			afterID = lastID
+			if len(accounts) < pageSize {
+				return nil
+			}
+		}
+		return ctx.Err()
+	}
+	readCtx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	accounts, err := s.repo.ListByPlatform(readCtx, PlatformOpenAI)
+	cancel()
+	if err != nil {
+		return err
+	}
+	consume(accounts)
+	return ctx.Err()
+}
+
+func gptMonitorEligible(a *Account) bool {
+	return a != nil && a.ID > 0 && a.Platform == PlatformOpenAI && a.Type == AccountTypeOAuth && a.Status == StatusActive && !a.IsShadow() && (a.ExpiresAt == nil || a.ExpiresAt.After(time.Now()))
+}
+
+func (s *GPTAccountMonitorService) checkOne(parent context.Context, owner string, listed *Account, cfg config.GPTAccountMonitorConfig, automatic bool, single ...gptMonitorRequest) (next *time.Time) {
+	cfg.NormalizeFixedModel()
+	ctx, cancel := context.WithTimeout(parent, time.Duration(cfg.TimeoutSeconds+10)*time.Second)
+	defer cancel()
+	r := GPTAccountMonitorResult{CheckedAt: time.Now().UTC(), Verdict: "error", Model: cfg.Model, ReasoningEffort: cfg.ReasoningEffort, ExpectedGeneration: cfg.ExpectedGeneration, Schedulable: listed.Schedulable}
+	r.ConfigKey = gptMonitorConfigHash(cfg)
+	previous := gptMonitorSavedResult(listed)
+	manualSingle := len(single) > 0 && single[0].AccountID > 0
+	followup := manualSingle && single[0].Confirmation
+	if manualSingle {
+		r.ManualAttempts = 1
+		if followup {
+			r.ManualAttempts = 2
+		}
+	}
+	// Automatic checks and explicit single-account requests form independent
+	// confirmation pairs. A read-only bulk test preserves the existing plan.
+	finish := func() {
+		if automatic || manualSingle {
+			if r.NextCheckAt == nil {
+				due := time.Now().UTC().Add(time.Duration(cfg.IntervalSeconds) * time.Second)
+				r.NextCheckAt = &due
+			}
+		} else {
+			r.ConfigKey, r.PendingVerdict, r.PendingCheckedAt = previous.ConfigKey, previous.PendingVerdict, previous.PendingCheckedAt
+			r.Consecutive, r.NextCheckAt = previous.Consecutive, previous.NextCheckAt
+			r.ManualRequested, r.ManualRunning, r.ManualAttempts = previous.ManualRequested, previous.ManualRunning, previous.ManualAttempts
+		}
+		if manualSingle && r.ManualAttempts == 1 && r.PendingVerdict != "" && r.Verdict != "error" {
+			r.ManualRequested = true
+		}
+		if r.NextCheckAt != nil {
+			r.NextCheckUnix = r.NextCheckAt.Unix()
+		}
+		next = r.NextCheckAt
+		s.saveResult(parent, listed.ID, r)
+	}
+	if followup {
+		if !previous.ManualRequested || previous.ConfigKey != r.ConfigKey || previous.ManualAttempts != 1 {
+			return nil
+		}
+		if previous.PendingCheckedAt == nil || time.Since(*previous.PendingCheckedAt) > 10*time.Minute {
+			r.ErrorCode, r.Message = "confirmation_expired", "复测确认窗口已过期，请重新发起智商测试，调度未改变"
+			r, _ = gptMonitorConfirmResult(r, GPTAccountMonitorResult{}, r.ConfigKey, time.Now().UTC())
+			finish()
+			return next
+		}
+		if time.Since(*previous.PendingCheckedAt) < 5*time.Minute {
+			return previous.NextCheckAt
+		}
+		// Consume the second attempt durably before sending it. A restart cannot
+		// automatically replay a request whose outcome may have been lost.
+		consumed := previous
+		consumed.ManualRequested, consumed.ManualRunning, consumed.ManualAttempts = false, true, 2
+		due := time.Now().UTC().Add(time.Duration(cfg.TimeoutSeconds+30) * time.Second)
+		consumed.NextCheckAt, consumed.NextCheckUnix = &due, due.Unix()
+		if !s.saveResult(parent, listed.ID, consumed) {
+			return nil
+		}
+	}
+	probeCtx, probeCancel := context.WithTimeout(ctx, time.Duration(cfg.TimeoutSeconds)*time.Second)
+	snapshot, answer, err := s.probe(probeCtx, listed.ID, cfg.Model, cfg.Prompt)
+	probeContextErr := probeCtx.Err()
+	r.DurationMS = time.Since(r.CheckedAt).Milliseconds()
+	probeCancel()
+	if parent.Err() != nil {
+		return nil
+	}
+	if snapshot != nil && snapshot.ID == listed.ID {
+		if !followup {
+			previous = gptMonitorSavedResult(snapshot)
+		}
+		r.Schedulable = snapshot.Schedulable
+	}
+	if manualSingle && !followup || automatic && previous.ManualAttempts > 0 {
+		previous = GPTAccountMonitorResult{}
+	}
+	if err != nil {
+		_, _, receivedStatus := gptMonitorErrorDetails(err)
+		if probeContextErr != nil && receivedStatus == 0 {
+			err = gptMonitorTransportError(probeContextErr)
+		}
+		var detail string
+		r.ErrorCode, detail, r.HTTPStatus = gptMonitorErrorDetails(err)
+		if r.HTTPStatus != 0 && r.ErrorCode != "http_error" {
+			detail += fmt.Sprintf("（HTTP %d）", r.HTTPStatus)
+		}
+		if r.ErrorCode == "timeout" {
+			detail += fmt.Sprintf("（本次检测超时上限 %d 秒）", cfg.TimeoutSeconds)
+		}
+		r.Message = "检测失败：" + detail + "，调度未改变"
+		if snapshot != nil && snapshot.ID == listed.ID {
+			r.Schedulable = snapshot.Schedulable
+		}
+		if automatic || manualSingle {
+			r, _ = gptMonitorConfirmResult(r, previous, r.ConfigKey, time.Now().UTC())
+		}
+		finish()
+		return next
+	}
+	if !gptMonitorEligible(snapshot) || snapshot.ID != listed.ID {
+		r.Message = "账号不再符合巡检条件，调度未改变"
+		if automatic || manualSingle {
+			r, _ = gptMonitorConfirmResult(r, previous, r.ConfigKey, time.Now().UTC())
+		}
+		finish()
+		return next
+	}
+	r.Schedulable = snapshot.Schedulable
+	r.Answer = gptMonitorTruncate(answer, 2048)
+	r.Verdict, err = ClassifyGPTAccountAnswer(answer, cfg.ExpectedGeneration)
+	if err != nil {
+		r.ErrorCode = "ambiguous_answer"
+		r.Message = "回答含糊、否定或型号冲突，无法确认，调度未改变"
+	} else if r.Verdict == "normal" {
+		r.Message = "回答符合规则"
+	} else {
+		r.Message = "回答不符合规则"
+	}
+	if !automatic && !manualSingle {
+		r.Message += "；批量观察仅查看结果，调度未改变"
+		finish()
+		return next
+	}
+	var apply bool
+	r, apply = gptMonitorConfirmResult(r, previous, r.ConfigKey, time.Now().UTC())
+	if followup && !apply && (r.PendingVerdict != "" || previous.PendingVerdict != r.Verdict) {
+		r.Verdict, r.ErrorCode = "error", "confirmation_inconsistent"
+		r.Message = "两次有效结果不一致或确认窗口失效，调度未改变，请重新测试"
+		r, _ = gptMonitorConfirmResult(r, GPTAccountMonitorResult{}, r.ConfigKey, time.Now().UTC())
+	}
+	if !apply {
+		if r.PendingVerdict != "" {
+			r.Message += "，等待第二次有效结果确认，约 5 分钟后复测，调度未改变"
+		}
+		finish()
+		return next
+	}
+	pass := r.Verdict == "normal"
+	writeCtx, writeCancel := context.WithTimeout(ctx, 5*time.Second)
+	defer writeCancel()
+	s.managementMu.RLock()
+	defer s.managementMu.RUnlock()
+	current, configErr := s.GetConfig(writeCtx)
+	if configErr != nil || (!current.Enabled && !manualSingle) || gptMonitorConfigHash(current) != gptMonitorConfigHash(cfg) {
+		return nil
+	}
+	owned, err := s.store.Owns(writeCtx, owner)
+	if err != nil || !owned {
+		r.Verdict = "error"
+		r.Message = "检测租约失效，调度未改变"
+		r, _ = gptMonitorConfirmResult(r, previous, r.ConfigKey, time.Now().UTC())
+		finish()
+		return next
+	}
+	repo, ok := s.repo.(gptMonitorSchedulingRepository)
+	if !ok {
+		r.Verdict = "error"
+		r.Message = "调度更新不可用"
+		r, _ = gptMonitorConfirmResult(r, previous, r.ConfigKey, time.Now().UTC())
+		finish()
+		return next
+	}
+	changed, err := repo.SetGPTMonitorSchedulableIfMatch(writeCtx, snapshot, pass)
+	if err != nil {
+		r.Verdict = "error"
+		r.ErrorCode = "scheduling_write_failed"
+		r.Message = "调度更新失败，请检查数据库连接和服务日志"
+	} else if !changed {
+		r.Verdict = "error"
+		r.ErrorCode = "snapshot_changed"
+		r.Message = "账号或代理在检测期间变化，调度未改变"
+	} else {
+		r.Changed = true
+		r.Schedulable = pass
+		if pass {
+			r.Message += "，已开启调度"
+		} else {
+			r.Message += "，已关闭调度"
+		}
+	}
+	if r.Verdict == "error" {
+		r, _ = gptMonitorConfirmResult(r, previous, r.ConfigKey, time.Now().UTC())
+	}
+	finish()
+	return next
+}
+
+func (s *GPTAccountMonitorService) saveResult(parent context.Context, id int64, result GPTAccountMonitorResult) bool {
+	if parent.Err() != nil {
+		return false
+	}
+	ctx, cancel := context.WithTimeout(parent, 5*time.Second)
+	defer cancel()
+	var err error
+	if repo, ok := s.repo.(gptMonitorResultRepository); ok {
+		err = repo.UpdateGPTMonitorResult(ctx, id, result)
+	} else {
+		err = s.repo.UpdateExtra(ctx, id, map[string]any{"gpt_account_monitor": result})
+	}
+	if err != nil {
+		s.logError(fmt.Sprintf("account=%d result persistence failed", id))
+		return false
+	}
+	logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] account=%d verdict=%s schedulable=%t changed=%t error_code=%s http_status=%d duration_ms=%d message=%s", id, result.Verdict, result.Schedulable, result.Changed, result.ErrorCode, result.HTTPStatus, result.DurationMS, result.Message)
+	return true
+}
+
+func (s *GPTAccountMonitorService) logError(message string) {
+	s.setMessage("巡检暂未完成，请查看服务日志")
+	logger.LegacyPrintf("service.gpt_account_monitor", "[GPTAccountMonitor] %s", message)
+}
+func (s *GPTAccountMonitorService) setMessage(message string) {
+	s.mu.Lock()
+	s.state.Message = message
+	s.mu.Unlock()
+}
+func gptMonitorTruncate(text string, maxRunes int) string {
+	r := []rune(text)
+	if len(r) > maxRunes {
+		return string(r[:maxRunes]) + "…"
+	}
+	return text
+}
