@@ -0,0 +1,59 @@
+package repository
+
+import (
+	"bytes"
+	"errors"
+	"log/slog"
+	"net/http"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/tlsfingerprint"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/stretchr/testify/require"
+)
+
+// Exercise real debug log sites, including a transport error containing proxy
+// credentials, without opening any network connection.
+func TestHTTPUpstreamRecoveryProxyDebugLogsDoNotExposeCredentials(t *testing.T) {
+	var output bytes.Buffer
+	previous := slog.Default()
+	slog.SetDefault(slog.New(slog.NewJSONHandler(&output, &slog.HandlerOptions{Level: slog.LevelDebug})))
+	t.Cleanup(func() { slog.SetDefault(previous) })
+
+	const proxy = "http://recovery-log-user:recovery-log-password-US-a1b2c3d4@proxy-log.invalid:1000"
+	const accountID = int64(2127)
+	svc := NewHTTPUpstream(nil).(*httpUpstreamService)
+	profile := &tlsfingerprint.Profile{Name: "log regression"}
+	entry, err := svc.getClientEntryWithTLS(proxy, accountID, 1, profile, service.HTTPUpstreamProfileDefault, false, true)
+	require.NoError(t, err)
+	reused, err := svc.getClientEntryWithTLS(proxy, accountID, 1, profile, service.HTTPUpstreamProfileDefault, false, true)
+	require.NoError(t, err)
+	require.Same(t, entry, reused)
+	updated, err := svc.getClientEntryWithTLS(proxy, accountID, 2, profile, service.HTTPUpstreamProfileDefault, false, true)
+	require.NoError(t, err)
+	require.NotSame(t, entry, updated)
+	updated.client.Transport = roundTripFunc(func(*http.Request) (*http.Response, error) {
+		return nil, errors.New("proxy transport failed with authentication " + proxy)
+	})
+	req, err := http.NewRequestWithContext(t.Context(), http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", nil)
+	require.NoError(t, err)
+	_, err = svc.DoWithTLS(req, proxy, accountID, 2, profile)
+	require.Error(t, err)
+	_, err = svc.DoWithTLS(req, "http://recovery-log-user:recovery-log-password@proxy-log.invalid:invalid", accountID, 2, profile)
+	require.Error(t, err)
+
+	logs := output.String()
+	for _, secret := range []string{proxy, "recovery-log-user", "recovery-log-password", "a1b2c3d4", "proxy-log.invalid"} {
+		require.NotContains(t, logs, secret)
+	}
+	for _, event := range []string{
+		"tls_fingerprint_enabled", "tls_fingerprint_creating_new_client",
+		"tls_fingerprint_reusing_client", "tls_fingerprint_evicting_stale_client",
+		"tls_fingerprint_request_failed", "tls_fingerprint_acquire_client_failed",
+	} {
+		require.Contains(t, logs, event)
+	}
+	require.Contains(t, logs, `"proxy_hash":"`+upstreamPrivateLogDigest(proxy)+`"`)
+	require.Contains(t, logs, `"cache_hash":`)
+	require.Contains(t, logs, `"error_hash":`)
+}
