+package service
+
+import (
+	"context"
+	"net/http"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+)
+
+func (s *GPTAccountMonitorService) runCycle(parent context.Context) time.Duration {
+	s.mu.Lock()
+	cfg := s.cfg
+	s.mu.Unlock()
+	return s.runCycleWithConfig(parent, cfg, false)
+}
+
+func (s *GPTAccountMonitorService) runCycleWithConfig(parent context.Context, cfg config.GPTAccountMonitorConfig, manual bool) time.Duration {
+	delay, _ := s.runMonitorRequest(parent, cfg, gptMonitorRequest{ConfigKey: gptMonitorConfigHash(cfg)}, manual)
+	return delay
+}
+
+func (s *GPTAccountMonitorService) eachCandidate(ctx context.Context, ids []int64, visit func(Account) bool) error {
+	return s.eachPollingCandidate(ctx, ids, false, visit)
+}
+
+func gptMonitorProbeWithClient(ctx context.Context, client *http.Client, account *Account, token, _ string, prompt string) (string, error) {
+	return gptMonitorProbeWithDo(ctx, client.Do, account, token, prompt)
+}
diff --git a/backend/internal/service/gpt_account_monitor_management.go b/backend/internal/service/gpt_account_monitor_management.go
new file mode 100644
index 0000000000000000000000000000000000000000..99bee081fbf4880d92f1b5d8fd6ff57e9b25c2c9
--- /dev/null
+++ b/backend/internal/service/gpt_account_monitor_management.go
@@ -0,0 +1,324 @@
+package service
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+)
+
+const SettingKeyGPTAccountMonitorConfig = "gpt_account_monitor_config"
+
+type GPTAccountMonitorStatus struct {
+	Enabled       bool                             `json:"enabled"`
+	Running       bool                             `json:"running"`
+	Queued        bool                             `json:"queued"`
+	LastRun       *time.Time                       `json:"last_run"`
+	NextRun       *time.Time                       `json:"next_run"`
+	Message       string                           `json:"message"`
+	TotalAccounts int                              `json:"total_accounts"`
+	Accounts      []GPTAccountMonitorStatusAccount `json:"accounts"`
+}
+type GPTAccountMonitorStatusAccount struct {
+	AccountID int64  `json:"account_id"`
+	Name      string `json:"name"`
+	ProxyName string `json:"proxy_name"`
+	GPTAccountMonitorResult
+}
+
+func cloneGPTMonitorConfig(cfg config.GPTAccountMonitorConfig) config.GPTAccountMonitorConfig {
+	cfg.NormalizeFixedModel()
+	if cfg.Concurrency >= 1 && cfg.Concurrency <= 10 {
+		cfg.Concurrency = 1
+	}
+	cfg.AccountIDs = append([]int64{}, cfg.AccountIDs...)
+	return cfg
+}
+func gptMonitorConfigHash(cfg config.GPTAccountMonitorConfig) string {
+	cfg = cloneGPTMonitorConfig(cfg)
+	cfg.Prompt = strings.TrimSpace(cfg.Prompt)
+	sort.Slice(cfg.AccountIDs, func(i, j int) bool { return cfg.AccountIDs[i] < cfg.AccountIDs[j] })
+	ids := cfg.AccountIDs[:0]
+	for _, id := range cfg.AccountIDs {
+		if len(ids) == 0 || ids[len(ids)-1] != id {
+			ids = append(ids, id)
+		}
+	}
+	cfg.AccountIDs = ids
+	raw, _ := json.Marshal(cfg)
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:])
+}
+
+func (s *GPTAccountMonitorService) GetConfig(ctx context.Context) (config.GPTAccountMonitorConfig, error) {
+	if s.settings == nil {
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		return cloneGPTMonitorConfig(s.cfg), nil
+	}
+	raw, err := s.settings.GetValue(ctx, SettingKeyGPTAccountMonitorConfig)
+	if errors.Is(err, ErrSettingNotFound) {
+		return cloneGPTMonitorConfig(s.defaults), nil
+	}
+	if err != nil {
+		return config.GPTAccountMonitorConfig{}, err
+	}
+	cfg := cloneGPTMonitorConfig(s.defaults)
+	if json.Unmarshal([]byte(raw), &cfg) != nil {
+		return cfg, errors.New("invalid saved GPT account monitor config")
+	}
+	cfg.NormalizeFixedModel()
+	if err := cfg.Validate(); err != nil {
+		return cfg, err
+	}
+	return cloneGPTMonitorConfig(cfg), nil
+}
+
+func (s *GPTAccountMonitorService) SaveConfig(ctx context.Context, cfg config.GPTAccountMonitorConfig) (config.GPTAccountMonitorConfig, error) {
+	cfg.NormalizeFixedModel()
+	cfg.Prompt = strings.TrimSpace(cfg.Prompt)
+	if err := cfg.Validate(); err != nil {
+		return cfg, infraerrors.BadRequest("INVALID_MONITOR_CONFIG", err.Error())
+	}
+	if len(cfg.Prompt) > 8192 || len(cfg.AccountIDs) > 10000 {
+		return cfg, infraerrors.BadRequest("INVALID_MONITOR_CONFIG", "问题或账号数量超出限制")
+	}
+	cfg = cloneGPTMonitorConfig(cfg)
+	sort.Slice(cfg.AccountIDs, func(i, j int) bool { return cfg.AccountIDs[i] < cfg.AccountIDs[j] })
+	ids := make([]int64, 0, len(cfg.AccountIDs))
+	for _, id := range cfg.AccountIDs {
+		if len(ids) == 0 || ids[len(ids)-1] != id {
+			ids = append(ids, id)
+		}
+	}
+	cfg.AccountIDs = ids
+	if s.settings == nil {
+		return cfg, errors.New("monitor settings repository unavailable")
+	}
+	raw, err := json.Marshal(cfg)
+	if err != nil {
+		return cfg, err
+	}
+	s.managementMu.Lock()
+	defer s.managementMu.Unlock()
+	if err := s.settings.Set(ctx, SettingKeyGPTAccountMonitorConfig, string(raw)); err != nil {
+		return cfg, err
+	}
+	s.mu.Lock()
+	changed := gptMonitorConfigHash(s.cfg) != gptMonitorConfigHash(cfg)
+	if changed && s.activeCancel != nil {
+		s.activeCancel()
+	}
+	s.cfg = cloneGPTMonitorConfig(cfg)
+	s.state.Enabled = cfg.Enabled
+	if changed {
+		s.state.Queued = false
+		// A queued request belongs to the settings that were saved when it was
+		// submitted. Changing those settings must not replay it with new ones.
+		select {
+		case <-s.trigger:
+		default:
+		}
+	}
+	if !cfg.Enabled && changed {
+		s.state.Message = "自动巡检已关闭"
+		s.state.NextRun = nil
+		select {
+		case <-s.trigger:
+		default:
+		}
+	}
+	s.mu.Unlock()
+	if changed {
+		select {
+		case s.wake <- struct{}{}:
+		default:
+		}
+	}
+	return cfg, nil
+}
+
+func (s *GPTAccountMonitorService) RunNow(ctx context.Context) (bool, error) {
+	// Keep reading the saved configuration and enqueueing its snapshot atomic
+	// with local saves, just like conditional scheduling writes.
+	s.managementMu.RLock()
+	defer s.managementMu.RUnlock()
+	cfg, err := s.GetConfig(ctx)
+	if err != nil {
+		return false, err
+	}
+	if !cfg.Enabled {
+		return false, infraerrors.BadRequest("GPT_MONITOR_DISABLED", "请先启用并保存巡检配置")
+	}
+	if repo, ok := s.repo.(gptMonitorManualRepository); ok {
+		pending, err := repo.ListGPTMonitorManualConfirmations(ctx, gptMonitorConfigHash(cfg), 1)
+		if err != nil {
+			return false, err
+		}
+		if len(pending) > 0 {
+			return false, nil
+		}
+	}
+	return s.queueRequest(gptMonitorRequest{ConfigKey: gptMonitorConfigHash(cfg)})
+}
+
+// RunAccount authorizes a bounded two-sample account check and scheduling
+// decision, without replacing the configured scope or enabling automatic scans.
+func (s *GPTAccountMonitorService) RunAccount(ctx context.Context, accountID int64) (bool, error) {
+	s.managementMu.RLock()
+	defer s.managementMu.RUnlock()
+	if accountID <= 0 {
+		return false, infraerrors.BadRequest("INVALID_ACCOUNT_ID", "账号 ID 必须为正整数")
+	}
+	if s.repo == nil {
+		return false, errors.New("monitor account repository unavailable")
+	}
+	cfg, err := s.GetConfig(ctx)
+	if err != nil {
+		return false, err
+	}
+	account, err := s.repo.GetByID(ctx, accountID)
+	if err != nil {
+		return false, err
+	}
+	if account == nil || account.ID != accountID || validateGPTMonitorAccount(account) != nil {
+		return false, infraerrors.BadRequest("GPT_MONITOR_ACCOUNT_INELIGIBLE", "请选择启用、未过期且绑定有效代理的独立 OpenAI OAuth 账号")
+	}
+	previous := gptMonitorSavedResult(account)
+	if previous.ConfigKey == gptMonitorConfigHash(cfg) && (previous.ManualRequested || (previous.ManualRunning && previous.NextCheckAt != nil && previous.NextCheckAt.After(time.Now()))) {
+		return false, nil
+	}
+	return s.queueRequest(gptMonitorRequest{ConfigKey: gptMonitorConfigHash(cfg), AccountID: accountID})
+}
+
+func (s *GPTAccountMonitorService) AccountResult(ctx context.Context, accountID int64) (GPTAccountMonitorStatusAccount, error) {
+	if accountID <= 0 {
+		return GPTAccountMonitorStatusAccount{}, infraerrors.BadRequest("INVALID_ACCOUNT_ID", "账号 ID 必须为正整数")
+	}
+	if s.repo == nil {
+		return GPTAccountMonitorStatusAccount{}, errors.New("monitor account repository unavailable")
+	}
+	account, err := s.repo.GetByID(ctx, accountID)
+	if err != nil {
+		return GPTAccountMonitorStatusAccount{}, err
+	}
+	if !gptMonitorEligible(account) || account.ID != accountID {
+		return GPTAccountMonitorStatusAccount{}, infraerrors.BadRequest("GPT_MONITOR_ACCOUNT_INELIGIBLE", "请选择有效的独立 OpenAI OAuth 账号")
+	}
+	cfg, err := s.GetConfig(ctx)
+	if err != nil {
+		return GPTAccountMonitorStatusAccount{}, err
+	}
+	return gptMonitorVisibleStatusRow(account, gptMonitorConfigHash(cfg)), nil
+}
+
+func gptMonitorVisibleStatusRow(account *Account, configKey string) GPTAccountMonitorStatusAccount {
+	row := gptMonitorStatusRow(account)
+	if (row.ManualRequested || row.ManualRunning) && row.ConfigKey != configKey {
+		row.ManualRequested, row.ManualRunning = false, false
+		row.PendingVerdict, row.PendingCheckedAt, row.Consecutive = "", nil, 0
+		row.Verdict, row.ErrorCode, row.Message = "error", "manual_config_changed", "巡检配置已变化，本次智商测试已取消，请重新测试"
+	} else if row.ManualRunning && row.NextCheckAt != nil && time.Now().After(*row.NextCheckAt) {
+		// An attempt was consumed before its request. If the process stopped or
+		// its final write failed, show an inconclusive outcome without replaying
+		// the request or mutating state from a read-only endpoint.
+		row.ManualRunning = false
+		row.PendingVerdict, row.PendingCheckedAt, row.Consecutive = "", nil, 0
+		row.Verdict, row.ErrorCode, row.Message = "error", "manual_result_unconfirmed", "本次复测结果未能确认，请查看当前调度状态或重新测试"
+	}
+	return row
+}
+
+func gptMonitorStatusRow(account *Account) GPTAccountMonitorStatusAccount {
+	result := gptMonitorSavedResult(account)
+	if result.Verdict == "" {
+		result.Verdict, result.Message = "pending", "尚未检查"
+	}
+	result.Schedulable = account.Schedulable
+	row := GPTAccountMonitorStatusAccount{AccountID: account.ID, Name: account.Name, GPTAccountMonitorResult: result}
+	if account.Proxy != nil {
+		row.ProxyName = account.Proxy.Name
+	}
+	return row
+}
+
+func (s *GPTAccountMonitorService) queueRequest(request gptMonitorRequest) (bool, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.cancel == nil {
+		return false, errors.New("monitor worker unavailable")
+	}
+	if s.state.Running || s.state.Queued || s.activeCancel != nil {
+		return false, nil
+	}
+	select {
+	case s.trigger <- request:
+		s.state.Queued = true
+		s.state.Message = "已排队，等待开始巡检"
+		return true, nil
+	default:
+		return false, nil
+	}
+}
+
+func (s *GPTAccountMonitorService) Status(ctx context.Context) (GPTAccountMonitorStatus, error) {
+	cfg, err := s.GetConfig(ctx)
+	if err != nil {
+		return GPTAccountMonitorStatus{}, err
+	}
+	s.mu.Lock()
+	out := s.state
+	s.mu.Unlock()
+	out.Enabled = cfg.Enabled
+	out.Accounts = make([]GPTAccountMonitorStatusAccount, 0)
+	var accounts []Account
+	if repo, ok := s.repo.(gptMonitorReadRepository); ok {
+		accounts, err = repo.ListGPTMonitorAccounts(ctx, cfg.AccountIDs)
+	} else {
+		accounts, err = s.repo.ListByPlatform(ctx, PlatformOpenAI)
+	}
+	if err != nil {
+		return out, err
+	}
+	selected := map[int64]bool{}
+	for _, id := range cfg.AccountIDs {
+		selected[id] = true
+	}
+	for _, a := range accounts {
+		if !gptMonitorEligible(&a) || (len(selected) > 0 && !selected[a.ID]) {
+			continue
+		}
+		row := gptMonitorVisibleStatusRow(&a, gptMonitorConfigHash(cfg))
+		if out.LastRun == nil || row.CheckedAt.After(*out.LastRun) {
+			t := row.CheckedAt
+			if !t.IsZero() {
+				out.LastRun = &t
+			}
+		}
+		out.Accounts = append(out.Accounts, row)
+	}
+	out.TotalAccounts = len(out.Accounts)
+	sort.Slice(out.Accounts, func(i, j int) bool {
+		if out.Accounts[i].CheckedAt.Equal(out.Accounts[j].CheckedAt) {
+			return out.Accounts[i].AccountID < out.Accounts[j].AccountID
+		}
+		return out.Accounts[i].CheckedAt.After(out.Accounts[j].CheckedAt)
+	})
+	if len(out.Accounts) > 200 {
+		out.Accounts = out.Accounts[:200]
+	}
+	if !cfg.Enabled {
+		out.NextRun = nil
+		if !out.Running && !out.Queued {
+			out.Message = "自动巡检已关闭"
+		}
+	}
+	return out, nil
+}
