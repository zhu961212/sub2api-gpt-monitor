@@ -0,0 +1,115 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestGPTAccountMonitorDefaults(t *testing.T) {
+	resetViperWithJWTSecret(t)
+	cfg, err := Load()
+	require.NoError(t, err)
+	m := cfg.GPTAccountMonitor
+	require.False(t, m.Enabled)
+	require.Equal(t, 1800, m.IntervalSeconds)
+	require.Equal(t, 90, m.TimeoutSeconds)
+	require.Equal(t, 1, m.Concurrency)
+	require.Equal(t, "gpt-6-astra", m.Model)
+	require.Equal(t, "xhigh", m.ReasoningEffort)
+	require.Equal(t, DefaultGPTAccountMonitorPrompt, m.Prompt)
+	require.Equal(t, 17, m.ExpectedGeneration)
+	require.Empty(t, m.AccountIDs)
+	require.True(t, m.RunOnStart)
+}
+
+func TestGPTAccountMonitorEnvironmentOverrides(t *testing.T) {
+	resetViperWithJWTSecret(t)
+	for key, value := range map[string]string{
+		"GPT_ACCOUNT_MONITOR_ENABLED":             "true",
+		"GPT_ACCOUNT_MONITOR_INTERVAL_SECONDS":    "600",
+		"GPT_ACCOUNT_MONITOR_TIMEOUT_SECONDS":     "45",
+		"GPT_ACCOUNT_MONITOR_CONCURRENCY":         "2",
+		"GPT_ACCOUNT_MONITOR_MODEL":               " custom-model ",
+		"GPT_ACCOUNT_MONITOR_REASONING_EFFORT":    "low",
+		"GPT_ACCOUNT_MONITOR_PROMPT":              " custom prompt ",
+		"GPT_ACCOUNT_MONITOR_EXPECTED_GENERATION": "18",
+		"GPT_ACCOUNT_MONITOR_ACCOUNT_IDS":         "12,34",
+		"GPT_ACCOUNT_MONITOR_RUN_ON_START":        "false",
+	} {
+		t.Setenv(key, value)
+	}
+	cfg, err := Load()
+	require.NoError(t, err)
+	require.Equal(t, GPTAccountMonitorConfig{
+		Enabled: true, IntervalSeconds: 600, TimeoutSeconds: 45, Concurrency: 2,
+		Model: GPTAccountMonitorModel, ReasoningEffort: GPTAccountMonitorReasoningEffort, Prompt: "custom prompt", ExpectedGeneration: 18,
+		AccountIDs: []int64{12, 34}, RunOnStart: false,
+	}, cfg.GPTAccountMonitor)
+}
+
+func TestGPTAccountMonitorYAML(t *testing.T) {
+	resetViperWithJWTSecret(t)
+	file := filepath.Join(t.TempDir(), "config.yaml")
+	require.NoError(t, os.WriteFile(file, []byte("gpt_account_monitor:\n  enabled: true\n  model: legacy-model\n  reasoning_effort: low\n  account_ids: [41, 42]\n  run_on_start: false\n"), 0o600))
+	t.Setenv("CONFIG_FILE", file)
+	cfg, err := Load()
+	require.NoError(t, err)
+	require.True(t, cfg.GPTAccountMonitor.Enabled)
+	require.Equal(t, []int64{41, 42}, cfg.GPTAccountMonitor.AccountIDs)
+	require.False(t, cfg.GPTAccountMonitor.RunOnStart)
+	require.Equal(t, "gpt-6-astra", cfg.GPTAccountMonitor.Model)
+	require.Equal(t, "xhigh", cfg.GPTAccountMonitor.ReasoningEffort)
+}
+
+func TestGPTAccountMonitorValidation(t *testing.T) {
+	valid := GPTAccountMonitorConfig{
+		Enabled: true, IntervalSeconds: 1800, TimeoutSeconds: 90, Concurrency: 3,
+		Model: GPTAccountMonitorModel, ReasoningEffort: GPTAccountMonitorReasoningEffort, Prompt: DefaultGPTAccountMonitorPrompt, ExpectedGeneration: 17,
+	}
+	for _, tc := range []struct {
+		name   string
+		change func(*GPTAccountMonitorConfig)
+	}{
+		{"interval_low", func(c *GPTAccountMonitorConfig) { c.IntervalSeconds = 59 }},
+		{"interval_high", func(c *GPTAccountMonitorConfig) { c.IntervalSeconds = 86401 }},
+		{"timeout_low", func(c *GPTAccountMonitorConfig) { c.TimeoutSeconds = 9 }},
+		{"timeout_high", func(c *GPTAccountMonitorConfig) { c.TimeoutSeconds = 301 }},
+		{"concurrency_low", func(c *GPTAccountMonitorConfig) { c.Concurrency = 0 }},
+		{"concurrency_high", func(c *GPTAccountMonitorConfig) { c.Concurrency = 11 }},
+		{"model_empty", func(c *GPTAccountMonitorConfig) { c.Model = " " }},
+		{"model_override", func(c *GPTAccountMonitorConfig) { c.Model = "gpt-5.4" }},
+		{"effort_empty", func(c *GPTAccountMonitorConfig) { c.ReasoningEffort = "" }},
+		{"effort_override", func(c *GPTAccountMonitorConfig) { c.ReasoningEffort = "low" }},
+		{"prompt_empty", func(c *GPTAccountMonitorConfig) { c.Prompt = " " }},
+		{"generation_low", func(c *GPTAccountMonitorConfig) { c.ExpectedGeneration = 0 }},
+		{"generation_high", func(c *GPTAccountMonitorConfig) { c.ExpectedGeneration = 100 }},
+		{"account_zero", func(c *GPTAccountMonitorConfig) { c.AccountIDs = []int64{0} }},
+		{"account_negative", func(c *GPTAccountMonitorConfig) { c.AccountIDs = []int64{-1} }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := valid
+			tc.change(&cfg)
+			require.ErrorContains(t, cfg.Validate(), "gpt_account_monitor.")
+			cfg.Enabled = false
+			require.Error(t, cfg.Validate(), "disabled settings must still be safe to save from the management page")
+		})
+	}
+	require.NoError(t, valid.Validate())
+	valid.IntervalSeconds, valid.TimeoutSeconds, valid.Concurrency = 60, 10, 1
+	valid.ExpectedGeneration = 1
+	require.NoError(t, valid.Validate())
+	valid.IntervalSeconds, valid.TimeoutSeconds, valid.Concurrency = 86400, 300, 10
+	valid.ExpectedGeneration = 99
+	require.NoError(t, valid.Validate())
+}
+
+func TestGPTAccountMonitorRejectsInvalidEnabledEnvironment(t *testing.T) {
+	resetViperWithJWTSecret(t)
+	t.Setenv("GPT_ACCOUNT_MONITOR_ENABLED", "true")
+	t.Setenv("GPT_ACCOUNT_MONITOR_INTERVAL_SECONDS", "59")
+	_, err := Load()
+	require.ErrorContains(t, err, "gpt_account_monitor.interval_seconds")
+}
