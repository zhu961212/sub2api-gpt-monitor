+	probeCtx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	s.activeCancel = cancel
+	s.trigger <- gptMonitorRequest{ConfigKey: gptMonitorConfigHash(s.cfg)}
+	cfg := cloneGPTMonitorConfig(s.cfg)
+	cfg.ExpectedGeneration++
+
+	_, err := s.SaveConfig(context.Background(), cfg)
+
+	require.NoError(t, err)
+	require.ErrorIs(t, probeCtx.Err(), context.Canceled)
+	require.Empty(t, s.trigger, "old manual intent must not run against changed rules")
+	require.Len(t, s.wake, 1)
+}
