+				repo.accounts[0].Schedulable = enabled
+				s.probe = func(context.Context, int64, string, string) (*Account, string, error) { return nil, "", tc.err }
+				s.runCycle(context.Background())
+				result := repo.results[1]
+				require.Equal(t, "error", result.Verdict)
+				require.Equal(t, tc.code, result.ErrorCode)
+				require.Equal(t, tc.status, result.HTTPStatus)
+				require.Contains(t, result.Message, tc.message)
+				require.NotContains(t, result.Message, "SECRET")
+				require.Contains(t, result.Message, "调度未改变")
+				require.Equal(t, enabled, result.Schedulable)
+				require.False(t, result.Changed)
+				require.Empty(t, repo.writes)
+			}
+		})
+	}
+}
