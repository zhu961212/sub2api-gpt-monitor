+func sharedRecoveryStoreFixture(t *testing.T) (*gptAccountRecoveryStore, *miniredis.Miniredis, *redis.Client, string) {
+	t.Helper()
+	mini := miniredis.RunT(t)
+	client := redis.NewClient(&redis.Options{Addr: mini.Addr()})
+	t.Cleanup(func() { _ = client.Close() })
+	store := NewGPTAccountRecoveryStore(client).(*gptAccountRecoveryStore)
+	return store, mini, client, strings.Repeat("a", 64)
+}
+
+func sharedRecoveryRoute(suffix string) *service.GPTAccountRecoverySharedRoute {
+	return &service.GPTAccountRecoverySharedRoute{
+		CFLB: "cf-unified-88-" + suffix, OAILB: "oa-unified-88-" + suffix, Gateway: "unified-88",
+		CookieExpiresAt: time.Now().Add(time.Hour), ProxyScope: strings.Repeat("b", 64),
+	}
+}
+
+func TestGPTRecoverySharedStoreScopesAndPersistsRoutingFieldsOnly(t *testing.T) {
+	store, mini, client, scope := sharedRecoveryStoreFixture(t)
+	ctx := context.Background()
+	route := sharedRecoveryRoute("shared-cookies")
+	route.ProxySession, route.ProxyExpiresAt = "a1b2c3d4", time.Now().Add(5*time.Minute)
+	require.NoError(t, store.SaveSharedRoute(ctx, scope, route, time.Hour))
+	found, err := store.LoadSharedRoutes(ctx, scope, 8)
+	require.NoError(t, err)
+	require.Len(t, found, 1)
+	require.Equal(t, route.CFLB, found[0].CFLB)
+	require.Equal(t, route.ProxyScope, found[0].ProxyScope)
+	require.Equal(t, route.ProxySession, found[0].ProxySession)
+	require.WithinDuration(t, route.ProxyExpiresAt, found[0].CookieExpiresAt, time.Millisecond)
+	other, err := store.LoadSharedRoutes(ctx, strings.Repeat("c", 64), 8)
+	require.NoError(t, err)
+	require.Empty(t, other, "changing donor/protocol scope must not borrow prior candidates")
+
+	index, prefix, err := gptRecoverySharedRouteKeys(scope)
+	require.NoError(t, err)
+	keys := mini.Keys()
+	require.Len(t, keys, 2)
+	for _, key := range keys {
+		require.NotContains(t, key, route.CFLB)
+		require.NotContains(t, key, route.OAILB)
+		require.NotContains(t, key, route.ProxySession)
+	}
+	raw, err := client.Get(ctx, prefix+gptRecoverySharedRouteID(route)).Result()
+	require.NoError(t, err)
+	var fields map[string]any
+	require.NoError(t, json.Unmarshal([]byte(raw), &fields))
+	require.ElementsMatch(t, []string{"cflb", "oailb", "gateway", "cookie_expires_at", "proxy_scope", "proxy_session", "proxy_expires_at"}, mapStringKeys(fields))
+	for _, secretField := range []string{"turn_state", "access_token", "refresh_token", "account_id", "chatgpt_account_id", "proxy_url", "authorization", "password"} {
+		require.NotContains(t, raw, secretField)
+	}
+	require.Equal(t, int64(1), client.ZCard(ctx, index).Val())
+	require.LessOrEqual(t, mini.TTL(prefix+gptRecoverySharedRouteID(route)), 5*time.Minute)
+}
+
+func mapStringKeys(values map[string]any) []string {
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		keys = append(keys, key)
+	}
+	return keys
+}
+
+func TestGPTRecoverySharedStoreTTLCapAndExpiryDoNotTouchOwnTicket(t *testing.T) {
+	store, mini, client, scope := sharedRecoveryStoreFixture(t)
+	ctx := context.Background()
+	ownKey := strings.Repeat("d", 64)
+	own := &service.GPTAccountRecoveryTicket{TurnState: "own-private-turn", CFLB: "own-cflb", OAILB: "own-oailb", CookieExpiresAt: time.Now().Add(time.Hour)}
+	require.NoError(t, store.SaveTicket(ctx, ownKey, own, time.Hour))
+	long := sharedRecoveryRoute("long-lived")
+	long.CookieExpiresAt = time.Now().Add(8 * time.Hour)
+	require.NoError(t, store.SaveSharedRoute(ctx, scope, long, 8*time.Hour))
+	_, prefix, err := gptRecoverySharedRouteKeys(scope)
+	require.NoError(t, err)
+	longKey := prefix + gptRecoverySharedRouteID(long)
+	require.InDelta(t, 2*time.Hour, mini.TTL(longKey), float64(time.Second))
+	short := sharedRecoveryRoute("short-lived")
+	short.CookieExpiresAt = time.Now().Add(time.Hour)
+	short.ProxySession, short.ProxyExpiresAt = "abcd1234", time.Now().Add(20*time.Second)
+	require.NoError(t, store.SaveSharedRoute(ctx, scope, short, time.Hour))
+	require.LessOrEqual(t, mini.TTL(prefix+gptRecoverySharedRouteID(short)), 20*time.Second)
+	mini.FastForward(21 * time.Second)
+	found, err := store.LoadSharedRoutes(ctx, scope, 8)
+	require.NoError(t, err)
+	require.Len(t, found, 1)
+	require.Equal(t, long.CFLB, found[0].CFLB)
+	require.True(t, found[0].CookieExpiresAt.Before(time.Now().Add(2*time.Hour+time.Second)))
+	persisted, err := store.LoadTicket(ctx, ownKey)
+	require.NoError(t, err)
+	require.NotNil(t, persisted)
+	require.Equal(t, own.TurnState, persisted.TurnState)
+	mini.FastForward(2 * time.Hour)
+	found, err = store.LoadSharedRoutes(ctx, scope, 8)
+	require.NoError(t, err)
+	require.Empty(t, found)
+	require.Zero(t, client.Exists(ctx, longKey).Val())
+}
+
+func TestGPTRecoverySharedStoreAtomicLimitAndRenewal(t *testing.T) {
+	store, mini, client, scope := sharedRecoveryStoreFixture(t)
+	ctx := context.Background()
+	const count = 24
+	errors := make(chan error, count)
+	var workers sync.WaitGroup
+	workers.Add(count)
+	for i := 0; i < count; i++ {
+		go func(i int) {
+			defer workers.Done()
+			route := sharedRecoveryRoute(fmt.Sprintf("candidate-%02d", i))
+			route.CookieExpiresAt = time.Now().Add(time.Duration(i+1) * time.Minute)
+			errors <- store.SaveSharedRoute(ctx, scope, route, time.Hour)
+		}(i)
+	}
+	workers.Wait()
+	close(errors)
+	for err := range errors {
+		require.NoError(t, err)
+	}
+	index, _, err := gptRecoverySharedRouteKeys(scope)
+	require.NoError(t, err)
+	require.Equal(t, int64(service.GPTAccountRecoverySharedRouteLimit), client.ZCard(ctx, index).Val())
+	require.Len(t, mini.Keys(), service.GPTAccountRecoverySharedRouteLimit+1, "evicted values must be deleted together with their index entries")
+	found, err := store.LoadSharedRoutes(ctx, scope, 100)
+	require.NoError(t, err)
+	require.Len(t, found, service.GPTAccountRecoverySharedRouteLimit)
+	for _, route := range found {
+		require.True(t, route.CookieExpiresAt.After(time.Now().Add(16*time.Minute)))
+	}
+	renewed := found[0]
+	renewed.CookieExpiresAt = time.Now().Add(30 * time.Minute)
+	require.NoError(t, store.SaveSharedRoute(ctx, scope, &renewed, time.Hour))
+	require.Equal(t, int64(service.GPTAccountRecoverySharedRouteLimit), client.ZCard(ctx, index).Val(), "renewing the same route must not consume another slot")
+	limited, err := store.LoadSharedRoutes(ctx, scope, 2)
+	require.NoError(t, err)
+	require.Len(t, limited, 2)
+	empty, err := store.LoadSharedRoutes(ctx, scope, 0)
+	require.NoError(t, err)
+	require.Empty(t, empty)
+}
+
+func TestGPTRecoverySharedStoreRejectsMalformedCandidates(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		mutate func(*service.GPTAccountRecoverySharedRoute)
+	}{
+		{"missing cookie", func(r *service.GPTAccountRecoverySharedRoute) { r.CFLB = "" }},
+		{"cookie delimiter", func(r *service.GPTAccountRecoverySharedRoute) { r.CFLB = "cf; login=private" }},
+		{"oversized cookie", func(r *service.GPTAccountRecoverySharedRoute) { r.OAILB = strings.Repeat("a", 4097) }},
+		{"expired cookie", func(r *service.GPTAccountRecoverySharedRoute) { r.CookieExpiresAt = time.Now().Add(-time.Second) }},
+		{"invalid gateway", func(r *service.GPTAccountRecoverySharedRoute) { r.Gateway = "https://private.invalid" }},
+		{"raw proxy scope", func(r *service.GPTAccountRecoverySharedRoute) { r.ProxyScope = "http://user:password@proxy.invalid" }},
+		{"session without lease", func(r *service.GPTAccountRecoverySharedRoute) { r.ProxySession = "abcd1234" }},
+		{"lease without session", func(r *service.GPTAccountRecoverySharedRoute) { r.ProxyExpiresAt = time.Now().Add(time.Minute) }},
+		{"invalid session", func(r *service.GPTAccountRecoverySharedRoute) {
+			r.ProxySession = "private-password-US-abc"
+			r.ProxyExpiresAt = time.Now().Add(time.Minute)
+		}},
