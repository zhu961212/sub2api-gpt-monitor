+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+)
+
+func recoveryBusinessMetadata(state any) []byte {
+	raw, _ := json.Marshal(map[string]any{"type": "codex.response.metadata", "headers": map[string]any{"x-codex-turn-state": state}})
+	return raw
+}
+
+func TestGPTRecoveryWSMetadataTurnStateValidation(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		message []byte
+		want    string
+	}{
+		{"metadata only", recoveryBusinessMetadata("real-turn"), "real-turn"},
+		{"malformed JSON", []byte("{bad"), ""},
+		{"numeric state", recoveryBusinessMetadata(17), ""},
+		{"empty state", recoveryBusinessMetadata(""), ""},
+		{"control byte", recoveryBusinessMetadata("bad\r\nstate"), ""},
+		{"oversized state", recoveryBusinessMetadata(strings.Repeat("a", 16385)), ""},
+		{"case insensitive header", []byte("{\"type\":\"codex.response.metadata\",\"headers\":{\"X-Codex-Turn-State\":\"real-turn\"}}"), "real-turn"},
+		{"conflicting states", []byte("{\"type\":\"codex.response.metadata\",\"headers\":{\"x-codex-turn-state\":\"a\",\"X-Codex-Turn-State\":\"b\"}}"), ""},
+		{"unrelated event", []byte("{\"type\":\"response.completed\",\"headers\":{\"x-codex-turn-state\":\"not-metadata\"}}"), ""},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			eventType, _, _ := parseOpenAIWSEventEnvelope(test.message)
+			require.Equal(t, test.want, gptRecoveryWSMetadataTurnState(test.message, eventType))
+		})
+	}
+}
+
+type recoveryMetadataBusinessDialer struct {
+	mu      sync.Mutex
+	headers []http.Header
+	proxies []string
+	onDial  func()
+}
+
+func (d *recoveryMetadataBusinessDialer) Dial(_ context.Context, _ string, headers http.Header, proxy string) (openAIWSClientConn, int, http.Header, error) {
+	d.mu.Lock()
+	d.headers = append(d.headers, headers.Clone())
+	d.proxies = append(d.proxies, proxy)
+	turn := len(d.headers)
+	d.mu.Unlock()
+	if d.onDial != nil {
+		d.onDial()
+	}
+	completed, _ := json.Marshal(map[string]any{"type": "response.completed", "response": map[string]any{
+		"id": fmt.Sprintf("resp_metadata_%d", turn), "model": "gpt-6-astra", "status": "completed", "output": []any{}, "usage": map[string]int{"input_tokens": 1, "output_tokens": 1},
+	}})
+	return &openAIWSCaptureConn{events: [][]byte{recoveryBusinessMetadata(fmt.Sprintf("business-turn-%d", turn)), completed}}, http.StatusSwitchingProtocols, http.Header{}, nil
+}
+
+func (d *recoveryMetadataBusinessDialer) snapshot() ([]http.Header, []string) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	headers := make([]http.Header, len(d.headers))
+	for i := range d.headers {
+		headers[i] = d.headers[i].Clone()
+	}
+	return headers, append([]string(nil), d.proxies...)
+}
+
+type recoveryMetadataContextStore struct{ *recoveryRoutingTestStore }
+
+func (s *recoveryMetadataContextStore) SaveTicket(ctx context.Context, key string, ticket *GPTAccountRecoveryTicket, ttl time.Duration) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return s.recoveryRoutingTestStore.SaveTicket(ctx, key, ticket, ttl)
+}
+
+func TestGPTRecoveryWSMetadataPooledTurnsUseCurrentContextAndOriginalSession(t *testing.T) {
+	t.Setenv(gptRecoveryProxyURLEnv, "http://fixture-user:fixture-password-US@proxy.example:1000")
+	s, account, store := recoveryRoutingFixture()
