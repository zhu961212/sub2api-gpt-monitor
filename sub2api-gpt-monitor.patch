index 0000000000000000000000000000000000000000..6475e12de84747fd5c5add1d6a043d80a7c5ff8d
--- /dev/null
+++ b/backend/internal/repository/account_repo_gpt_monitor_test.go
@@ -0,0 +1,394 @@
+package repository
+
+import (
+	"context"
+	"errors"
+	"regexp"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"entgo.io/ent/dialect"
+	entsql "entgo.io/ent/dialect/sql"
+	"github.com/DATA-DOG/go-sqlmock"
+	dbent "github.com/Wei-Shaw/sub2api/ent"
+	_ "github.com/Wei-Shaw/sub2api/ent/runtime"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/stretchr/testify/require"
+)
+
+func gptMonitorAccountSnapshot() *service.Account {
+	proxyID := int64(9)
+	return &service.Account{
+		ID: 17, Platform: service.PlatformOpenAI, Type: service.AccountTypeOAuth,
+		Status: service.StatusActive, UpdatedAt: time.Now(), Schedulable: true, ProxyID: &proxyID,
+		Credentials: map[string]any{
+			"access_token": "monitor-test-access", "refresh_token": "monitor-test-refresh",
+			"auth_mode": "oauth", "chatgpt_account_id": "monitor-test-account", "chatgpt_user_id": "monitor-test-user",
+			"chatgpt_account_is_fedramp": true, "user_agent": "monitor-test-agent",
+			"header_override_enabled": true, "header_overrides": map[string]any{"x-test": "original"},
+		},
+		Proxy: &service.Proxy{ID: proxyID, Status: service.StatusActive, UpdatedAt: time.Now(), Protocol: "http", Host: "proxy", Port: 3128, Username: "user", Password: "pass"},
+	}
+}
+
+type gptMonitorCacheRecorder struct {
+	service.SchedulerCache
+	accounts []*service.Account
+}
+
+func (r *gptMonitorCacheRecorder) SetAccount(ctx context.Context, account *service.Account) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	r.accounts = append(r.accounts, account)
+	return nil
+}
+
+func TestGPTMonitorSchedulingCAS(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		rows     int64
+		target   bool
+		username string
+		password string
+	}{
+		{name: "stale snapshot", rows: 0, target: false, username: "user", password: "pass"},
+		{name: "suspend", rows: 1, target: false, username: "user", password: "pass"},
+		{name: "recover", rows: 1, target: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var mutationSQL string
+			matcher := sqlmock.QueryMatcherFunc(func(expected, actual string) error {
+				if expected == "scheduling mutation" {
+					mutationSQL = actual
+					return nil
+				}
+				return sqlmock.QueryMatcherRegexp.Match(expected, actual)
+			})
+			db, mock, err := sqlmock.New(sqlmock.QueryMatcherOption(matcher))
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = db.Close() })
+			client := dbent.NewClient(dbent.Driver(entsql.OpenDB(dialect.Postgres, db)))
+			t.Cleanup(func() { _ = client.Close() })
+			cache := &gptMonitorCacheRecorder{}
+			repo := newAccountRepositoryWithSQL(client, db, cache)
+			mock.ExpectBegin()
+			mock.ExpectExec("scheduling mutation").WillReturnResult(sqlmock.NewResult(0, tc.rows))
+			if tc.rows == 1 {
+				mock.ExpectExec(regexp.QuoteMeta("INSERT INTO scheduler_outbox")).WillReturnResult(sqlmock.NewResult(1, 1))
+				mock.ExpectCommit()
+				mock.ExpectQuery(`SELECT .* FROM "accounts"`).WillReturnRows(
+					sqlmock.NewRows([]string{"id", "platform", "type", "status", "schedulable"}).
+						AddRow(17, service.PlatformOpenAI, service.AccountTypeOAuth, service.StatusActive, tc.target))
+				mock.ExpectQuery(`SELECT .* FROM "account_groups"`).WillReturnRows(sqlmock.NewRows([]string{"account_id", "group_id"}))
+			} else {
+				mock.ExpectRollback()
+			}
+			snapshot := gptMonitorAccountSnapshot()
+			snapshot.Schedulable = !tc.target
+			snapshot.Proxy.Username, snapshot.Proxy.Password = tc.username, tc.password
+			changed, err := repo.SetGPTMonitorSchedulableIfMatch(context.Background(), snapshot, tc.target)
+			require.NoError(t, err)
+			require.Equal(t, tc.rows == 1, changed)
+			require.NoError(t, mock.ExpectationsWereMet())
+			require.Len(t, cache.accounts, int(tc.rows), "both suspension and recovery must update the scheduler cache")
+			if tc.rows == 1 {
+				require.Equal(t, tc.target, cache.accounts[0].Schedulable)
+			}
+			_, where, ok := strings.Cut(mutationSQL, " WHERE ")
+			require.True(t, ok)
+			for _, guard := range []string{"credentials", "platform", "type", "status", "deleted_at", "parent_account_id", "schedulable", "proxy_id", "proxies", "protocol", "host", "port", "username", "password"} {
+				require.Contains(t, where, guard, "scheduling must compare account and proxy identity")
+			}
+			require.GreaterOrEqual(t, strings.Count(where, "expires_at"), 4, "account and proxy expiry are checked at mutation time")
+			if tc.username == "" {
+				require.Contains(t, where, `"username" IS NULL`)
+				require.Contains(t, where, `"password" IS NULL`)
+			}
+			set, _, _ := strings.Cut(mutationSQL, " WHERE ")
+			for _, untouched := range []string{"status", "credentials", "proxy_id", "rate_limit_reset_at", "temp_unschedulable_until", "overload_until", "error_message"} {
+				require.NotContains(t, set, untouched, "monitor must preserve unrelated account state")
+			}
+		})
+	}
+}
+
+// Capture at the driver boundary so tests verify the values actually bound to
+// the atomic mutation, including the stable account identity tuple.
+type gptMonitorMutationCapture struct {
+	query string
+	args  []any
+}
+
+type gptMonitorCaptureDriver struct {
+	dialect.Driver
+	capture *gptMonitorMutationCapture
+}
+
+func (d *gptMonitorCaptureDriver) Tx(ctx context.Context) (dialect.Tx, error) {
+	tx, err := d.Driver.Tx(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return &gptMonitorCaptureTx{Tx: tx.(*entsql.Tx), capture: d.capture}, nil
+}
+
+type gptMonitorCaptureTx struct {
+	*entsql.Tx
+	capture *gptMonitorMutationCapture
+}
+
+func (tx *gptMonitorCaptureTx) Exec(ctx context.Context, query string, args, result any) error {
+	if strings.HasPrefix(query, `UPDATE "accounts"`) {
+		tx.capture.query = query
+		tx.capture.args = append([]any(nil), args.([]any)...)
+	}
+	return tx.Tx.Exec(ctx, query, args, result)
+}
+
+func captureGPTMonitorSchedulingMutation(t *testing.T, snapshot *service.Account) gptMonitorMutationCapture {
+	t.Helper()
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = db.Close() })
+	capture := gptMonitorMutationCapture{}
+	driver := &gptMonitorCaptureDriver{Driver: entsql.OpenDB(dialect.Postgres, db), capture: &capture}
+	client := dbent.NewClient(dbent.Driver(driver))
+	t.Cleanup(func() { _ = client.Close() })
+	repo := newAccountRepositoryWithSQL(client, db, nil)
+	mock.ExpectBegin()
+	mock.ExpectExec(`UPDATE "accounts"`).WillReturnResult(sqlmock.NewResult(0, 1))
+	mock.ExpectExec(regexp.QuoteMeta("INSERT INTO scheduler_outbox")).WillReturnResult(sqlmock.NewResult(1, 1))
+	mock.ExpectCommit()
+	changed, err := repo.SetGPTMonitorSchedulableIfMatch(context.Background(), snapshot, !snapshot.Schedulable)
+	require.NoError(t, err)
+	require.True(t, changed)
+	require.NoError(t, mock.ExpectationsWereMet())
+	require.NotEmpty(t, capture.query)
+	return capture
+}
+
+func gptMonitorBoundPredicateValue(t *testing.T, capture gptMonitorMutationCapture, pattern string) any {
+	t.Helper()
+	_, where, ok := strings.Cut(capture.query, " WHERE ")
+	require.True(t, ok)
+	match := regexp.MustCompile(pattern).FindStringSubmatch(where)
+	require.Len(t, match, 2, "mutation must atomically guard this snapshot field: %s", where)
+	index, err := strconv.Atoi(match[1])
+	require.NoError(t, err)
+	require.Positive(t, index)
+	require.LessOrEqual(t, index, len(capture.args))
+	return capture.args[index-1]
+}
+
+func TestGPTMonitorSchedulingAllowsTokenRotationAndTelemetry(t *testing.T) {
+	const expectedIdentity = `{"auth_mode":"oauth","openai_auth_mode":null,"chatgpt_account_id":"monitor-test-account","chatgpt_user_id":"monitor-test-user","chatgpt_account_is_fedramp":true}`
+	for _, tc := range []struct {
+		name string
+		edit func(*service.Account)
+	}{
+		{"original snapshot", func(*service.Account) {}},
+		{"normal token rotation", func(a *service.Account) {
+			a.Credentials["access_token"] = "rotated-access"
+			a.Credentials["refresh_token"] = "rotated-refresh"
+			a.Credentials["id_token"] = "rotated-id-token"
+			a.Credentials["expires_at"] = time.Now().Add(time.Hour).Format(time.RFC3339)
+			a.Credentials["plan_type"] = "team"
+			a.Credentials["user_agent"] = "updated-client"
+			a.Credentials["header_overrides"] = map[string]any{"x-test": "updated"}
+		}},
+		{"concurrent usage observation", func(a *service.Account) {
+			used := a.UpdatedAt.Add(time.Minute)
+			a.UpdatedAt, a.LastUsedAt = used, &used
+			a.Extra = map[string]any{
+				"codex_primary_used_percent": 41, "codex_usage_updated_at": used.Format(time.RFC3339),
+				"gpt_account_monitor": map[string]any{"verdict": "normal"},
+			}
+		}},
+		{"proxy rename or observation", func(a *service.Account) {
+			a.Proxy.Name = "renamed proxy"
+			a.Proxy.UpdatedAt = a.Proxy.UpdatedAt.Add(time.Minute)
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			snapshot := gptMonitorAccountSnapshot()
+			tc.edit(snapshot)
+			capture := captureGPTMonitorSchedulingMutation(t, snapshot)
+			bound := gptMonitorBoundPredicateValue(t, capture, `jsonb_build_object\([^)]*\) = \$(\d+)::jsonb`)
+			require.JSONEq(t, expectedIdentity, bound.(string), "token rotation must preserve the exact same stable identity guard")
+			_, where, _ := strings.Cut(capture.query, " WHERE ")
+			accountWhere, _, ok := strings.Cut(where, "SELECT")
+			require.True(t, ok, "the proxy identity must still be checked in the same SQL statement")
+			require.NotContains(t, where, "updated_at", "account and proxy observations must not invalidate a completed answer")
+			require.NotContains(t, accountWhere, `"extra"`, "usage observations do not change the probe request")
+			require.NotContains(t, accountWhere, "last_used_at")
+			for _, secret := range []string{"monitor-test-access", "monitor-test-refresh", "monitor-test-account", "rotated-access", "rotated-refresh"} {
+				require.NotContains(t, capture.query, secret, "credentials must remain bound values, never SQL text")
+			}
+			for _, rotating := range []string{"access_token", "refresh_token", "id_token", "user_agent", "header_overrides", "plan_type"} {
+				require.NotContains(t, where, "'"+rotating+"'", "normal token refresh and client metadata changes must not block scheduling")
+				require.NotContains(t, bound.(string), rotating)
+			}
+		})
+	}
+}
