@@ -0,0 +1,40 @@
+package routes
+
+import (
+	"github.com/Wei-Shaw/sub2api/internal/handler"
+	"github.com/Wei-Shaw/sub2api/internal/handler/admin"
+	"github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestGPTRecoveryRoutesStepUpAndLegacyRemoval(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	r := gin.New()
+	h := &handler.Handlers{Admin: &handler.AdminHandlers{GPTAccountRecovery: admin.NewGPTAccountRecoveryHandler(nil)}}
+	calls := 0
+	guard := middleware.StepUpAuthMiddleware(func(c *gin.Context) { calls++; c.AbortWithStatus(http.StatusUnauthorized) })
+	registerGPTAccountRecoveryRoutes(r.Group("/admin"), h, guard)
+	for _, item := range []struct {
+		method, path string
+		guard        bool
+	}{{http.MethodGet, "/config", false}, {http.MethodPut, "/config", true}, {http.MethodGet, "/status", false}, {http.MethodPost, "/run", true}, {http.MethodPost, "/accounts/7/run", true}, {http.MethodGet, "/accounts/7/result", false}} {
+		before := calls
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, httptest.NewRequest(item.method, "/admin/gpt-account-recovery"+item.path, strings.NewReader(`{}`)))
+		if item.guard {
+			require.Equal(t, http.StatusUnauthorized, w.Code)
+			require.Equal(t, before+1, calls)
+		} else {
+			require.Equal(t, http.StatusServiceUnavailable, w.Code)
+			require.Equal(t, before, calls)
+		}
+	}
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/admin/gpt-account-monitor/config", nil))
+	require.Equal(t, http.StatusNotFound, w.Code)
+}
diff --git a/backend/internal/service/gpt_account_recovery_errors.go b/backend/internal/service/gpt_account_recovery_errors.go
new file mode 100644
index 0000000000000000000000000000000000000000..0038e8410b1abc6bd136cfa63820f95fdc79483b
--- /dev/null
+++ b/backend/internal/service/gpt_account_recovery_errors.go
@@ -0,0 +1,201 @@
+package service
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// All fields are safe to persist and display. Never put upstream messages,
+// transport error strings, URLs or credentials into this error.
+type gptRecoveryProbeError struct {
+	Code       string
+	Message    string
+	HTTPStatus int
+}
+
+func (e *gptRecoveryProbeError) Error() string {
+	if e == nil {
+		return "取票失败，原因未知"
+	}
+	return e.Message
+}
+
+// Callers must use a stable code and a trusted, static message. Untrusted errors
+// must go through the transport, HTTP or upstream classifiers below.
+func gptRecoveryError(code, message string) error {
+	return &gptRecoveryProbeError{Code: code, Message: message}
+}
+
+func gptRecoveryErrorDetails(err error) (code, message string, httpStatus int) {
+	if err == nil {
+		return "", "", 0
+	}
+	var probeErr *gptRecoveryProbeError
+	if errors.As(err, &probeErr) && probeErr != nil {
+		return probeErr.Code, probeErr.Message, probeErr.HTTPStatus
+	}
+	return "unknown_error", "取票失败，原因未知", 0
+}
+
+func gptRecoveryTransportError(err error) error {
+	var probeErr *gptRecoveryProbeError
+	if errors.As(err, &probeErr) && probeErr != nil {
+		return probeErr
+	}
+	if errors.Is(err, context.Canceled) {
+		return gptRecoveryError("canceled", "取票已取消")
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		return gptRecoveryError("timeout", "连接或读取上游超时，请检查账号代理")
+	}
+	var networkErr net.Error
+	if errors.As(err, &networkErr) && networkErr.Timeout() {
+		return gptRecoveryError("timeout", "连接或读取上游超时，请检查账号代理")
+	}
+	var dnsErr *net.DNSError
+	if errors.As(err, &dnsErr) {
+		return gptRecoveryError("dns_error", "域名解析失败，请检查账号代理及 DNS")
+	}
+	var certificateErr *tls.CertificateVerificationError
+	var unknownAuthorityErr x509.UnknownAuthorityError
+	var hostnameErr x509.HostnameError
+	var invalidCertificateErr x509.CertificateInvalidError
+	var recordErr tls.RecordHeaderError
+	if errors.As(err, &certificateErr) || errors.As(err, &unknownAuthorityErr) ||
+		errors.As(err, &hostnameErr) || errors.As(err, &invalidCertificateErr) || errors.As(err, &recordErr) {
+		return gptRecoveryError("tls_error", "TLS 握手或证书验证失败，请检查账号代理")
+	}
+	// Some standard-library CONNECT and TLS failures do not expose a typed
+	// error. Recognize their fixed phrases, but never return the original text.
+	var detail string
+	if err != nil {
+		detail = strings.ToLower(err.Error())
+	}
+	if strings.Contains(detail, "proxy authentication required") ||
+		strings.Contains(detail, "socks authentication failed") ||
+		strings.Contains(detail, "no acceptable authentication methods") ||
+		strings.Contains(detail, "username/password authentication failed") {
+		return gptRecoveryError("proxy_auth_required", "代理认证失败，请检查代理用户名和密码")
+	}
+	if strings.Contains(detail, "tls:") || strings.Contains(detail, "tls handshake") ||
+		strings.Contains(detail, "x509:") || strings.Contains(detail, "http response to https client") {
+		return gptRecoveryError("tls_error", "TLS 握手或证书验证失败，请检查账号代理")
+	}
+	var operationErr *net.OpError
+	if errors.As(err, &operationErr) && (strings.Contains(operationErr.Op, "proxyconnect") || strings.Contains(operationErr.Op, "socks connect")) {
+		return gptRecoveryError("proxy_connection_failed", "代理连接或隧道建立失败，请检查账号代理")
+	}
+	if strings.Contains(detail, "proxyconnect") || strings.Contains(detail, "socks connect") {
+		return gptRecoveryError("proxy_connection_failed", "代理连接或隧道建立失败，请检查账号代理")
+	}
+	return gptRecoveryError("network_error", "上游网络连接失败，请检查账号代理")
+}
+
+const gptRecoveryHTTPErrorBodyLimit = 64 * 1024
+
+func gptRecoveryHTTPError(status int, body io.Reader) error {
+	var code, errorType, message string
+	if body != nil {
+		// Error pages can be arbitrarily large or contain credentials. Read only
+		// enough to classify a small JSON error; never preserve the raw body.
+		raw, err := io.ReadAll(io.LimitReader(body, gptRecoveryHTTPErrorBodyLimit))
+		if err == nil {
+			var envelope struct {
+				Code    string          `json:"code"`
+				Type    string          `json:"type"`
+				Message string          `json:"message"`
+				Error   json.RawMessage `json:"error"`
+			}
+			if json.Unmarshal(raw, &envelope) == nil {
+				code, errorType, message = envelope.Code, envelope.Type, envelope.Message
+				var nested struct {
+					Code    string `json:"code"`
+					Type    string `json:"type"`
+					Message string `json:"message"`
+				}
+				if json.Unmarshal(envelope.Error, &nested) == nil {
+					code, errorType, message = nested.Code, nested.Type, nested.Message
+				} else {
+					var errorMessage string
+					if json.Unmarshal(envelope.Error, &errorMessage) == nil {
+						message = errorMessage
+					}
+				}
+			}
+		}
+	}
+	classified, known := classifyGPTRecoveryUpstreamError(code, errorType, message)
+	// HTTP authentication, permission and server failures are authoritative;
+	// do not let a conflicting error body disguise the failure category.
+	switch {
+	case status == http.StatusProxyAuthRequired:
+		classified = &gptRecoveryProbeError{Code: "proxy_auth_required", Message: "代理认证失败，请检查代理用户名和密码"}
+	case status == http.StatusUnauthorized:
+		classified = &gptRecoveryProbeError{Code: "unauthorized", Message: "账号认证失败，访问令牌无效或已过期"}
+	case status == http.StatusForbidden:
+		classified = &gptRecoveryProbeError{Code: "forbidden", Message: "上游拒绝访问，请检查账号权限或代理出口"}
+	case status == http.StatusTooManyRequests:
+		if !known || classified.Code != "quota_exceeded" {
+			classified = &gptRecoveryProbeError{Code: "rate_limited", Message: "上游请求频率受限，请稍后重试"}
+		}
+	case status >= 500 && status <= 599:
+		classified = &gptRecoveryProbeError{Code: "upstream_error", Message: "上游服务暂时异常，请稍后重试"}
+	case !known:
+		classified = &gptRecoveryProbeError{Code: "http_error", Message: fmt.Sprintf("上游返回 HTTP %d，取票失败", status)}
+	}
+	classified.HTTPStatus = status
+	return classified
+}
+
+func gptRecoveryUpstreamError(code, errorType, message string) error {
+	if classified, known := classifyGPTRecoveryUpstreamError(code, errorType, message); known {
+		return classified
+	}
+	return gptRecoveryError("upstream_error", "上游响应失败，未完成取票")
+}
+
+func classifyGPTRecoveryUpstreamError(code, errorType, message string) (*gptRecoveryProbeError, bool) {
+	for _, value := range []string{strings.ToLower(strings.TrimSpace(code)), strings.ToLower(strings.TrimSpace(errorType))} {
+		switch value {
+		case "model_not_found", "model_not_available", "model_not_supported", "unsupported_model", "invalid_model", "unknown_model", "model_access_denied":
+			return &gptRecoveryProbeError{Code: "model_unavailable", Message: "当前账号无法使用指定取票模型，请检查模型权限"}, true
+		case "unsupported_reasoning", "unsupported_reasoning_effort", "reasoning_effort_not_supported", "invalid_reasoning_effort":
+			return &gptRecoveryProbeError{Code: "reasoning_unsupported", Message: "指定取票模型不支持当前推理强度"}, true
+		case "invalid_api_key", "invalid_token", "token_expired", "authentication_error", "unauthorized":
+			return &gptRecoveryProbeError{Code: "unauthorized", Message: "账号认证失败，访问令牌无效或已过期"}, true
+		case "permission_error", "permission_denied", "forbidden", "account_deactivated", "account_suspended":
+			return &gptRecoveryProbeError{Code: "forbidden", Message: "上游拒绝访问，请检查账号权限或代理出口"}, true
+		case "insufficient_quota", "quota_exceeded", "billing_hard_limit_reached", "usage_limit_reached", "credits_exhausted":
+			return &gptRecoveryProbeError{Code: "quota_exceeded", Message: "账号可用额度不足或使用额度已耗尽"}, true
+		case "rate_limit_exceeded", "rate_limit_error", "too_many_requests":
+			return &gptRecoveryProbeError{Code: "rate_limited", Message: "上游请求频率受限，请稍后重试"}, true
+		case "server_error", "internal_error", "internal_server_error", "overloaded_error":
+			return &gptRecoveryProbeError{Code: "upstream_error", Message: "上游服务暂时异常，请稍后重试"}, true
+		}
+	}
+	// The model and reasoning APIs sometimes use only invalid_request_error or
+	// unsupported_value. Inspect narrowly recognized phrases, never echo them.
+	detail := strings.ToLower(message)
+	unsupported := false
+	for _, phrase := range []string{"not supported", "does not support", "unsupported", "not available", "unavailable", "not found", "does not exist", "do not have access", "don't have access"} {
+		if strings.Contains(detail, phrase) {
+			unsupported = true
+			break
+		}
+	}
+	if unsupported && (strings.Contains(detail, "reasoning") || strings.Contains(detail, "effort") || strings.Contains(detail, "xhigh")) {
+		return &gptRecoveryProbeError{Code: "reasoning_unsupported", Message: "指定取票模型不支持当前推理强度"}, true
+	}
+	if (unsupported && strings.Contains(detail, "model")) || strings.Contains(detail, "unknown model") {
+		return &gptRecoveryProbeError{Code: "model_unavailable", Message: "当前账号无法使用指定取票模型，请检查模型权限"}, true
+	}
+	return nil, false
+}
diff --git a/backend/internal/service/gpt_account_recovery_identity.go b/backend/internal/service/gpt_account_recovery_identity.go
new file mode 100644
index 0000000000000000000000000000000000000000..c658625ea05dbd747eb2e6e88ae9f59e94383c6d
--- /dev/null
+++ b/backend/internal/service/gpt_account_recovery_identity.go
@@ -0,0 +1,127 @@
+package service
+
+import (
+	"context"
+	"net"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+)
+
+// This private context value is honored only by recovery-initiated token refresh.
+// Pin the full proxy identity so refresh cannot silently change egress or go direct.
+type gptRecoveryProxyContextKey struct{}
+type gptRecoveryPinnedProxy struct {
+	ID  int64
+	URL string
+}
+
+func validateGPTRecoveryProxy(proxy *Proxy) error {
+	if proxy == nil || !proxy.IsActive() || proxy.IsExpired(time.Now()) || strings.TrimSpace(proxy.Host) == "" || proxy.Port < 1 || proxy.Port > 65535 {
+		return gptRecoveryError("proxy_unavailable", "账号必须绑定启用且未过期的代理")
+	}
+	if _, err := validGPTRecoveryProxyURL(proxy.URL()); err != nil {
+		return err
+	}
+	return nil
+}
+
+func validateGPTRecoveryAccount(account *Account) error {
+	if account == nil || !account.IsActive() || !account.IsOpenAIOAuth() || account.IsShadow() || account.IsOpenAIAgentIdentity() {
+		return gptRecoveryError("account_ineligible", "取票仅支持启用的独立 OpenAI OAuth 账号")
+	}
+	if account.ExpiresAt != nil && !account.ExpiresAt.After(time.Now()) {
+		return gptRecoveryError("account_expired", "账号已过期")
+	}
+	if account.ProxyID == nil || account.Proxy == nil || account.Proxy.ID != *account.ProxyID {
+		return gptRecoveryError("proxy_missing", "账号未绑定有效代理，请先绑定代理")
+	}
+	return validateGPTRecoveryProxy(account.Proxy)
+}
+
+func (s *OpenAIGatewayService) resolveGPTRecoveryIdentity(ctx context.Context, accountID int64) (*Account, string, error) {
+	account, err := s.accountRepo.GetByID(ctx, accountID)
+	if err != nil {
+		return nil, "", gptRecoveryError("account_read_failed", "读取账号失败")
+	}
+	if exhausted, _ := gptRecoveryExhaustedQuota(account, time.Now()); exhausted && account.ID == accountID {
+		return account, "", gptRecoveryError("quota_exhausted", gptRecoveryQuotaExhaustedMessage)
+	}
+	if err := validateGPTRecoveryAccount(account); err != nil {
+		return nil, "", err
+	}
+	if account.ID != accountID {
+		return nil, "", gptRecoveryError("identity_changed", "账号已变化，请重新取票")
+	}
+	// The regular provider disables irrecoverably expired credentials. A recovery
+	// must leave scheduling alone when token acquisition cannot be completed.
+	if expires := account.GetCredentialAsTime("expires_at"); expires != nil && !expires.After(time.Now()) && strings.TrimSpace(account.GetOpenAIRefreshToken()) == "" && !account.IsOpenAIPersonalAccessToken() {
+		return nil, "", gptRecoveryError("token_expired", "访问令牌已过期且无法刷新，请重新授权账号")
+	}
+	pinned := gptRecoveryPinnedProxy{ID: account.Proxy.ID, URL: account.Proxy.URL()}
+	ctx = context.WithValue(ctx, gptRecoveryProxyContextKey{}, pinned)
+	token, _, err := s.GetAccessToken(ctx, account)
+	if err != nil || strings.TrimSpace(token) == "" {
+		if ctx.Err() != nil {
+			return nil, "", gptRecoveryTransportError(ctx.Err())
+		}
+		return nil, "", gptRecoveryError("token_acquisition_failed", "获取或刷新账号访问令牌失败，请检查授权和代理")
+	}
+	account, err = s.accountRepo.GetByID(ctx, accountID)
+	if err != nil {
+		return nil, "", gptRecoveryError("account_read_failed", "重新读取账号失败")
+	}
+	if exhausted, _ := gptRecoveryExhaustedQuota(account, time.Now()); exhausted && account.ID == accountID {
+		return account, "", gptRecoveryError("quota_exhausted", gptRecoveryQuotaExhaustedMessage)
+	}
+	if err := validateGPTRecoveryAccount(account); err != nil {
+		return nil, "", err
+	}
+	if account.ID != accountID || account.Proxy.ID != pinned.ID || account.Proxy.URL() != pinned.URL {
+		return nil, "", gptRecoveryError("proxy_changed", "账号代理已变化，请重新取票")
+	}
+	if token != account.GetOpenAIAccessToken() {
+		// The provider is cache-first. A normal refresh can leave that cached
+		// value behind the database snapshot; use the current persisted token
+		// with the current account headers rather than declaring a recovery failure.
+		token = strings.TrimSpace(account.GetOpenAIAccessToken())
+		if token == "" {
+			return nil, "", gptRecoveryError("token_acquisition_failed", "账号缺少访问令牌，请重新授权账号")
+		}
+		if expires := account.GetCredentialAsTime("expires_at"); !account.IsOpenAIPersonalAccessToken() && expires != nil && !expires.After(time.Now()) {
+			return nil, "", gptRecoveryError("token_expired", "最新访问令牌已过期，请重新取票或重新授权账号")
+		}
+	}
+	return account, token, nil
+}
+
+func validGPTRecoveryProxyURL(raw string) (*url.URL, error) {
+	u, err := url.Parse(raw)
+	if err != nil || u.Hostname() == "" || u.Fragment != "" || u.RawQuery != "" || (u.Path != "" && u.Path != "/") {
+		return nil, gptRecoveryError("proxy_invalid", "账号代理地址无效")
+	}
+	switch u.Scheme {
+	case "http", "https", "socks5", "socks5h":
+	default:
+		return nil, gptRecoveryError("proxy_invalid", "账号代理协议不受支持")
+	}
+	return u, nil
+}
+
+func newGPTRecoveryClient(proxyURL string) (*http.Client, *http.Transport, error) {
+	proxy, err := validGPTRecoveryProxyURL(proxyURL)
+	if err != nil {
+		return nil, nil, err
+	}
+	// Never inherit HTTP_PROXY / HTTPS_PROXY or silently retry directly.
+	transport := &http.Transport{Proxy: http.ProxyURL(proxy),
+		DialContext:       (&net.Dialer{Timeout: 30 * time.Second, KeepAlive: 30 * time.Second}).DialContext,
+		ForceAttemptHTTP2: true, MaxIdleConns: 1, MaxIdleConnsPerHost: 1,
+		IdleConnTimeout: 30 * time.Second, TLSHandshakeTimeout: 15 * time.Second,
+		// The request context owns the configured recovery deadline, including headers.
+		ResponseHeaderTimeout: 0, ExpectContinueTimeout: time.Second,
+	}
+	client := &http.Client{Transport: transport, Timeout: 5 * time.Minute, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	return client, transport, nil
+}
diff --git a/backend/internal/service/gpt_account_recovery_mint.go b/backend/internal/service/gpt_account_recovery_mint.go
new file mode 100644
index 0000000000000000000000000000000000000000..9a7a25ac3631bfba61ceca86deee5f7f29de4ea4
--- /dev/null
+++ b/backend/internal/service/gpt_account_recovery_mint.go
@@ -0,0 +1,410 @@
+package service
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/json"
+	"io"
+	"mime"
+	"net/http"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/google/uuid"
+)
+
+const gptRecoveryMintScanLimit = 64 * 1024
+
+var gptRecoveryGatewayName = regexp.MustCompile("unified[-_.]?([0-9]{1,6})(?:[^0-9]|$)")
+
+// The turn-state belongs to this mint turn only. Do not inject it into
+// unrelated business turns; use the routing Cookie pair for those turns.
+func (s *OpenAIGatewayService) MintGPTAccountRecovery(ctx context.Context, accountID int64, cfg config.GPTAccountRecoveryConfig) (*Account, *GPTAccountRecoveryTicket, error) {
+	cfg.Normalize()
+	if err := cfg.Validate(); err != nil {
+		return nil, nil, gptRecoveryError("invalid_config", "智商恢复配置无效")
+	}
+	if s == nil || s.accountRepo == nil || accountID <= 0 {
+		return nil, nil, gptRecoveryError("service_unavailable", "账号恢复服务不可用")
+	}
+	ctx, cancel := context.WithTimeout(ctx, time.Duration(cfg.TimeoutSeconds)*time.Second)
+	defer cancel()
+	account, token, err := s.resolveGPTRecoveryIdentity(ctx, accountID)
+	if err != nil {
+		return account, nil, err
+	}
+	var seed *GPTAccountRecoveryTicket
+	if s.gptRecoveryStore != nil {
+		seed, _ = s.gptRecoveryStore.LoadTicket(ctx, s.gptRecoveryRoutingIdentityKey(account))
+	}
+	ticket, err := gptRecoveryMintWithDo(ctx, func(req *http.Request) (*http.Response, error) {
+		return s.doGPTRecoveryRequest(req, account)
+	}, account, token, s.codexIdentityOverrideUA(account), cfg, seed)
+	return account, ticket, err
+}
+
+func gptRecoveryMintWithDo(ctx context.Context, do func(*http.Request) (*http.Response, error), account *Account, token, overrideUA string, cfg config.GPTAccountRecoveryConfig, seed *GPTAccountRecoveryTicket) (*GPTAccountRecoveryTicket, error) {
+	cfg.Normalize()
+	if err := cfg.Validate(); err != nil || do == nil || account == nil || strings.TrimSpace(token) == "" {
+		return nil, gptRecoveryError("invalid_request", "无法构造账号恢复请求")
+	}
+	ctx, cancel := context.WithTimeout(ctx, time.Duration(cfg.TimeoutSeconds)*time.Second)
+	defer cancel()
+	if !gptRecoverySeedUsable(seed, cfg, time.Now()) {
+		seed = nil
+	}
+	var last error
+	for attempt := 1; attempt <= cfg.MaxAttempts; attempt++ {
+		if ctx.Err() != nil {
+			return nil, gptRecoveryTransportError(ctx.Err())
+		}
+		ticket, err := gptRecoveryMintAttempt(ctx, do, account, token, overrideUA, cfg, seed)
+		if err == nil {
+			ticket.Attempts = attempt
+			return ticket, nil
+		}
+		last = err
+		code, _, status := gptRecoveryErrorDetails(err)
+		if status == http.StatusUnauthorized || status == http.StatusForbidden || code == "unauthorized" || code == "forbidden" {
+			return nil, err
+		}
+		// A rejected seed must not pin all retries to the same route.
+		seed = nil
+		if attempt < cfg.MaxAttempts {
+			timer := time.NewTimer(time.Second)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return nil, gptRecoveryTransportError(ctx.Err())
+			case <-timer.C:
+			}
+		}
+	}
+	if last == nil {
+		last = gptRecoveryError("mint_exhausted", "已达到取票尝试上限")
+	}
+	return nil, last
+}
+
+func gptRecoveryMintAttempt(ctx context.Context, do func(*http.Request) (*http.Response, error), account *Account, token, overrideUA string, cfg config.GPTAccountRecoveryConfig, seed *GPTAccountRecoveryTicket) (*GPTAccountRecoveryTicket, error) {
+	payload := map[string]any{
+		"model": config.GPTAccountRecoveryModel, "instructions": "", "stream": true, "store": false,
+		"input":     []any{map[string]any{"type": "message", "role": "user", "content": []any{map[string]any{"type": "input_text", "text": "ping"}}}},
+		"reasoning": map[string]any{"effort": "low"}, "tool_choice": "auto", "parallel_tool_calls": false,
+	}
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return nil, gptRecoveryError("invalid_request", "无法构造账号恢复请求")
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, chatgptCodexURL, bytes.NewReader(body))
+	if err != nil {
+		return nil, gptRecoveryError("invalid_request", "无法构造账号恢复请求")
+	}
+	req.Host = "chatgpt.com"
+	canonical := resolveCodexOutboundIdentity(overrideUA)
+	account.ApplyHeaderOverrides(req.Header)
+	req.Header.Set("Originator", canonical.originator)
+	req.Header.Set("User-Agent", canonical.userAgent)
+	req.Header.Set("Version", canonical.version)
+	enforceCodexIdentityHeadersWithUA(req.Header, overrideUA)
+	setOpenAIChatGPTAccountHeaders(req.Header, account)
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "text/event-stream")
+	req.Header.Set("Accept-Encoding", "identity")
+	req.Header.Set("Session-Id", uuid.NewString())
+	req.Header.Del("X-Codex-Turn-State")
+	req.Header.Del("Cookie")
+	if seed != nil {
+		req.Header.Set("Cookie", "__cflb="+seed.CFLB+"; __oailb="+seed.OAILB)
+	}
+	resp, err := do(req)
+	if err != nil {
+		return nil, gptRecoveryTransportError(err)
+	}
+	if resp == nil || resp.Body == nil {
+		return nil, gptRecoveryError("invalid_response", "上游返回无效响应")
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, gptRecoveryHTTPError(resp.StatusCode, resp.Body)
+	}
+	if value := resp.Header.Get("Content-Type"); value != "" {
+		mediaType, _, parseErr := mime.ParseMediaType(value)
+		if parseErr != nil || (mediaType != "text/event-stream" && mediaType != "application/octet-stream") {
+			return nil, gptRecoveryError("invalid_content_type", "上游未返回有效事件流")
+		}
+	}
+	model, err := readGPTRecoveryCreatedModel(resp.Body)
+	if err != nil {
+		if ctx.Err() != nil {
+			return nil, gptRecoveryTransportError(ctx.Err())
+		}
+		return nil, err
+	}
+	if model != config.GPTAccountRecoveryModel {
+		return nil, gptRecoveryError("model_mismatch", "上游声明模型与恢复模型不一致，已拒收票据")
+	}
+	ticket, err := parseGPTRecoveryMintHeaders(resp, cfg, seed, time.Now())
+	if err != nil {
+		return nil, err
+	}
+	ticket.Model = model
+	return ticket, nil
+}
+
+// Only a complete response.created event identifies the upstream model.
+// Stop before reading generated output, with a bounded scan window.
+func readGPTRecoveryCreatedModel(body io.Reader) (string, error) {
+	limited := &io.LimitedReader{R: body, N: gptRecoveryMintScanLimit + 1}
+	scanner := bufio.NewScanner(limited)
+	scanner.Buffer(make([]byte, 1024), gptRecoveryMintScanLimit+1)
+	var name string
+	var data []string
+	first := true
+	for scanner.Scan() {
+		line := scanner.Text()
+		if first {
+			line = strings.TrimPrefix(line, "\uFEFF")
+			first = false
+		}
+		if limited.N <= 0 {
+			return "", gptRecoveryError("response_too_large", "上游取票事件超过大小限制")
+		}
+		if line == "" {
+			if len(data) == 0 {
+				name = ""
+				continue
+			}
+			text := strings.Join(data, "\n")
+			eventName := name
+			name, data = "", nil
+			if text == "[DONE]" {
+				return "", gptRecoveryError("missing_created_event", "上游缺少完整模型声明事件")
+			}
+			var event struct {
+				Type     string          `json:"type"`
+				Code     string          `json:"code"`
+				Message  string          `json:"message"`
+				Status   int             `json:"status"`
+				Error    json.RawMessage `json:"error"`
+				Response struct {
+					ID     string          `json:"id"`
+					Model  string          `json:"model"`
+					Status string          `json:"status"`
+					Error  json.RawMessage `json:"error"`
+				} `json:"response"`
+			}
+			if json.Unmarshal([]byte(text), &event) != nil || event.Type == "" || (eventName != "" && eventName != event.Type) {
+				return "", gptRecoveryError("invalid_response", "上游返回无效或矛盾事件")
+			}
+			if len(event.Error) > 0 && string(event.Error) != "null" {
+				return "", gptRecoverySSEError(event.Error, event.Status)
+			}
+			if len(event.Response.Error) > 0 && string(event.Response.Error) != "null" {
+				return "", gptRecoverySSEError(event.Response.Error, event.Status)
+			}
+			switch event.Type {
+			case "error", "response.failed":
+				raw, _ := json.Marshal(map[string]any{"code": event.Code, "message": event.Message})
+				return "", gptRecoverySSEError(raw, event.Status)
+			case "response.incomplete", "response.cancelled":
+				return "", gptRecoveryError("incomplete_response", "上游取票请求未完成")
+			case "response.created":
+				if strings.TrimSpace(event.Response.ID) == "" || strings.TrimSpace(event.Response.Model) == "" || event.Response.Status == "failed" || event.Response.Status == "cancelled" || event.Response.Status == "incomplete" {
+					return "", gptRecoveryError("invalid_response", "上游模型声明事件无效")
+				}
+				return event.Response.Model, nil
+			}
+			continue
+		}
+		if strings.HasPrefix(line, ":") {
+			continue
+		}
+		field, value, _ := strings.Cut(line, ":")
+		value = strings.TrimPrefix(value, " ")
+		switch field {
+		case "event":
+			name = value
+		case "data":
+			data = append(data, value)
+		}
+	}
+	if scanner.Err() != nil || limited.N <= 0 {
+		return "", gptRecoveryError("invalid_response", "上游取票事件无法完整读取")
+	}
+	return "", gptRecoveryError("missing_created_event", "上游缺少完整模型声明事件")
+}
+
+func gptRecoverySSEError(raw json.RawMessage, eventStatus int) error {
+	var detail struct {
+		Code    string `json:"code"`
+		Type    string `json:"type"`
+		Message string `json:"message"`
+		Status  int    `json:"status"`
+	}
+	_ = json.Unmarshal(raw, &detail)
+	if eventStatus == http.StatusUnauthorized || eventStatus == http.StatusForbidden {
+		return gptRecoveryHTTPError(eventStatus, nil)
+	}
+	if detail.Status == http.StatusUnauthorized || detail.Status == http.StatusForbidden {
+		return gptRecoveryHTTPError(detail.Status, nil)
+	}
+	return gptRecoveryUpstreamError(detail.Code, detail.Type, detail.Message)
+}
+
+func parseGPTRecoveryMintHeaders(resp *http.Response, cfg config.GPTAccountRecoveryConfig, seed *GPTAccountRecoveryTicket, now time.Time) (*GPTAccountRecoveryTicket, error) {
+	states := resp.Header.Values("X-Codex-Turn-State")
+	if len(states) != 1 || states[0] == "" || len(states[0]) > 8192 {
+		return nil, gptRecoveryError("missing_ticket", "上游未签发有效状态票据")
+	}
+	state := states[0]
+	if cfg.TicketLength > 0 && len(state) != cfg.TicketLength {
+		return nil, gptRecoveryError("ticket_length_mismatch", "上游票据格式长度与配置不一致")
+	}
+	issued, ok := gptRecoveryFernetIssuedAt(state)
+	if !ok || issued.After(now.Add(time.Minute)) {
+		return nil, gptRecoveryError("invalid_ticket", "上游票据签发时间无效")
+	}
+	expires := issued.Add(time.Duration(cfg.TicketTTLSeconds) * time.Second)
+	if !expires.After(now) {
+		return nil, gptRecoveryError("ticket_expired", "上游签发票据已过期")
+	}
+	values := make(map[string]*http.Cookie)
+	for _, line := range resp.Header.Values("Set-Cookie") {
+		parsed, err := http.ParseSetCookie(line)
+		if err != nil {
+			name, _, _ := strings.Cut(line, "=")
+			if strings.TrimSpace(name) == "__cflb" || strings.TrimSpace(name) == "__oailb" {
+				return nil, gptRecoveryError("invalid_cookie_pair", "上游路由 Cookie 声明无效")
+			}
+			continue
+		}
+		name := parsed.Name
+		if name != "__cflb" && name != "__oailb" {
+			continue
+		}
+		if _, duplicate := values[name]; duplicate {
+			return nil, gptRecoveryError("invalid_cookie_pair", "上游路由 Cookie 存在重复声明")
+		}
+		if !validGPTRecoveryRoutingCookie(parsed.Value) || parsed.MaxAge < 0 || (!parsed.Expires.IsZero() && !parsed.Expires.After(now)) {
+			return nil, gptRecoveryError("invalid_cookie_pair", "上游路由 Cookie 已失效")
+		}
+		values[name] = parsed
+	}
+	ticket := &GPTAccountRecoveryTicket{TurnState: state, IssuedAt: issued, ExpiresAt: expires}
+	if len(values) == 0 && gptRecoverySeedUsable(seed, cfg, now) {
+		ticket.CFLB, ticket.OAILB, ticket.Gateway, ticket.CookieExpiresAt = seed.CFLB, seed.OAILB, seed.Gateway, seed.CookieExpiresAt
+	} else {
+		// Never merge half-pairs from different responses or the cached seed.
+		if len(values) != 2 {
+			return nil, gptRecoveryError("missing_cookie_pair", "上游未签发完整路由 Cookie 对")
+		}
+		ticket.CFLB, ticket.OAILB = values["__cflb"].Value, values["__oailb"].Value
+		ticket.Gateway = gptRecoveryCookieGateway(ticket.CFLB, ticket.OAILB)
+		cookieExpires := now.Add(time.Duration(cfg.CookieTTLSeconds) * time.Second)
+		declared := false
+		if exp, ok := gptRecoveryCookieJWTExpiry(ticket.OAILB); ok {
+			if exp.Before(cookieExpires) {
+				cookieExpires = exp
+			}
+			declared = true
+		}
+		// Respect every upstream lease. JWT expiry is an additional cap, not
+		// permission to extend either Cookie's HTTP declaration.
+		for _, cookie := range values {
+			if cookie.MaxAge > 0 {
+				cap := now.Add(time.Duration(cookie.MaxAge) * time.Second)
+				if cap.Before(cookieExpires) {
+					cookieExpires = cap
+				}
+				declared = true
+			}
+			if !cookie.Expires.IsZero() {
+				if cookie.Expires.Before(cookieExpires) {
+					cookieExpires = cookie.Expires
+				}
+				declared = true
+			}
+		}
+		if !declared {
+			return nil, gptRecoveryError("missing_cookie_expiry", "上游路由 Cookie 缺少有效期声明")
+		}
+		ticket.CookieExpiresAt = cookieExpires
+	}
+	if !ticket.CookieExpiresAt.After(now) {
+		return nil, gptRecoveryError("cookie_expired", "上游路由 Cookie 已过期")
+	}
+	if ticket.Gateway == "" || (cfg.Gateway != "any" && ticket.Gateway != cfg.Gateway) {
+		return nil, gptRecoveryError("gateway_mismatch", "上游路由网关与目标网关不一致或无法识别")
+	}
+	return ticket, nil
+}
+
+func gptRecoverySeedUsable(seed *GPTAccountRecoveryTicket, cfg config.GPTAccountRecoveryConfig, now time.Time) bool {
+	if seed == nil || seed.Model != config.GPTAccountRecoveryModel || !seed.CookieExpiresAt.After(now) || !validGPTRecoveryRoutingCookie(seed.CFLB) || !validGPTRecoveryRoutingCookie(seed.OAILB) {
+		return false
+	}
+	gateway := gptRecoveryCookieGateway(seed.CFLB, seed.OAILB)
+	if gateway == "" || gateway != seed.Gateway || (cfg.Gateway != "any" && gateway != cfg.Gateway) {
+		return false
+	}
+	if exp, ok := gptRecoveryCookieJWTExpiry(seed.OAILB); ok && !exp.After(now) {
+		return false
+	}
+	return true
+}
+
+func gptRecoveryFernetIssuedAt(state string) (time.Time, bool) {
+	raw, err := base64.RawURLEncoding.DecodeString(strings.TrimRight(state, "="))
+	if err != nil || len(raw) < 73 || raw[0] != 0x80 || (len(raw)-57)%16 != 0 {
+		return time.Time{}, false
+	}
+	sec := binary.BigEndian.Uint64(raw[1:9])
+	if sec == 0 || sec > 253402300799 {
+		return time.Time{}, false
+	}
+	return time.Unix(int64(sec), 0).UTC(), true
+}
+
+func gptRecoveryCookieJWTPayload(value string) []byte {
+	parts := strings.Split(value, ".")
+	if len(parts) != 3 {
+		return nil
+	}
+	raw, err := base64.RawURLEncoding.DecodeString(strings.TrimRight(parts[1], "="))
+	if err != nil {
+		return nil
+	}
+	return raw
+}
+
+// Read the expiry declared by the trusted upstream. This is not a signature
+// verifier and does not make client-supplied cookies trustworthy.
+func gptRecoveryCookieJWTExpiry(value string) (time.Time, bool) {
+	var claims struct {
+		Exp json.Number `json:"exp"`
+	}
+	if json.Unmarshal(gptRecoveryCookieJWTPayload(value), &claims) != nil {
+		return time.Time{}, false
+	}
+	sec, err := claims.Exp.Int64()
+	if err != nil || sec <= 0 || sec > 253402300799 {
+		return time.Time{}, false
+	}
+	return time.Unix(sec, 0).UTC(), true
+}
+
+func gptRecoveryCookieGateway(cflb, oailb string) string {
+	for _, value := range []string{string(gptRecoveryCookieJWTPayload(oailb)), oailb, cflb} {
+		if match := gptRecoveryGatewayName.FindStringSubmatch(strings.ToLower(value)); len(match) == 2 {
+			return "unified-" + match[1]
+		}
+	}
+	return ""
+}
