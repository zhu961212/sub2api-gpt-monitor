+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/tlsfingerprint"
+	"github.com/stretchr/testify/require"
+)
+
+type gptRecoverySharedTestStore struct {
+	*recoveryRoutingTestStore
+	routes           map[string][]GPTAccountRecoverySharedRoute
+	loadCalls        int
+	saveCalls        int
+	saveErr          error
+	lastTTL          time.Duration
+	beforeSharedSave func()
+	afterOwnSave     func()
+	ownsOverride     func(string) bool
+}
+
+func (s *gptRecoverySharedTestStore) SaveTicket(ctx context.Context, key string, ticket *GPTAccountRecoveryTicket, ttl time.Duration) error {
+	err := s.recoveryRoutingTestStore.SaveTicket(ctx, key, ticket, ttl)
+	if err == nil && s.afterOwnSave != nil {
+		s.afterOwnSave()
+	}
+	return err
+}
+func (s *gptRecoverySharedTestStore) Owns(_ context.Context, owner string) (bool, error) {
+	if s.ownsOverride != nil {
+		return s.ownsOverride(owner), nil
+	}
+	return true, nil
+}
+
+func (s *gptRecoverySharedTestStore) LoadSharedRoutes(_ context.Context, scope string, limit int) ([]GPTAccountRecoverySharedRoute, error) {
+	s.loadCalls++
+	routes := s.routes[scope]
+	if len(routes) > limit {
+		routes = routes[:limit]
+	}
+	return append([]GPTAccountRecoverySharedRoute{}, routes...), nil
+}
+func (s *gptRecoverySharedTestStore) SaveSharedRoute(_ context.Context, scope string, route *GPTAccountRecoverySharedRoute, ttl time.Duration) error {
+	s.saveCalls++
+	s.lastTTL = ttl
+	if s.beforeSharedSave != nil {
+		s.beforeSharedSave()
+	}
+	if s.saveErr != nil {
+		return s.saveErr
+	}
+	s.routes[scope] = append(s.routes[scope], *route)
+	return nil
+}
+
+type gptRecoverySharedCaptureUpstream struct {
+	HTTPUpstream
+	headers  []http.Header
+	proxies  []string
+	response func(*http.Request) *http.Response
+}
+
+func (u *gptRecoverySharedCaptureUpstream) Do(req *http.Request, proxy string, _ int64, _ int) (*http.Response, error) {
+	u.headers = append(u.headers, req.Header.Clone())
+	u.proxies = append(u.proxies, proxy)
+	return u.response(req), nil
+}
+func (u *gptRecoverySharedCaptureUpstream) DoWithTLS(req *http.Request, proxy string, id int64, concurrency int, _ *tlsfingerprint.Profile) (*http.Response, error) {
+	return u.Do(req, proxy, id, concurrency)
+}
+
+func gptRecoverySharedFixture() (*OpenAIGatewayService, *Account, *gptRecoverySharedTestStore, config.GPTAccountRecoveryConfig) {
+	s, account, own := recoveryRoutingFixture()
+	cfg := config.DefaultGPTAccountRecoveryConfig()
+	cfg.ShareRouteCookies, cfg.MaxAttempts = true, 1
+	cfg.ShareRouteDonorAccountIDs = []int64{17}
