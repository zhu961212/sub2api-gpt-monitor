+func TestGPTRecoveryRoutingWSIngressHeadersFollowActualFactoryOnReconnect(t *testing.T) {
+	for _, expire := range []bool{false, true} {
+		t.Run(fmt.Sprintf("expired_%t", expire), func(t *testing.T) {
+			s, account, store := recoveryRoutingFixture()
+			s.cfg.Gateway.OpenAIWS.MaxConnsPerAccount = 1
+			s.cfg.Gateway.OpenAIWS.MaxIdlePerAccount = 1
+			pool := newOpenAIWSConnPool(s.cfg)
+			defer pool.Close()
+			dialer := &recoveryRoutingCaptureWSDialer{}
+			pool.setClientDialerForTest(dialer)
+			identity := s.gptRecoveryRoutingIdentityKey(account)
+			store.tickets[identity] = recoveryRoutingTicket("cf-captured", "oa-captured")
+			headers := recoveryRoutingHeaders(account)
+			s.applyGPTRecoveryRouting(context.Background(), account, headers, account.Proxy.URL())
+			base := openAIWSAcquireRequest{Account: account, WSURL: "wss://chatgpt.com/backend-api/codex/responses", Headers: headers, ProxyURL: account.Proxy.URL(),
+				HeadersFactory: func(ctx context.Context, headers http.Header) (http.Header, error) {
+					return s.refreshGPTRecoveryWSHeaders(ctx, account, headers), nil
+				},
+				OnHandshake: s.gptRecoveryWSHandshakeObserver(context.Background(), account, headers)}
+			want := "__cflb=cf-at-dial; __oailb=oa-at-dial"
+			if expire {
+				store.tickets[identity].CookieExpiresAt = time.Now().Add(-time.Second)
+				want = ""
+			} else {
+				store.tickets[identity] = recoveryRoutingTicket("cf-at-dial", "oa-at-dial")
+			}
+			first, err := pool.Acquire(context.Background(), base)
+			require.NoError(t, err)
+			connectionID := first.ConnID()
+			first.ApplyRecoveryRoutingHeaders(base.Headers)
+			require.Equal(t, want, base.Headers.Get("Cookie"))
+			require.Equal(t, want, dialer.headers[0].Get("Cookie"))
+			base.Headers.Set(openAIWSTurnStateHeader, first.HandshakeHeader(openAIWSTurnStateHeader))
+			first.Release()
+			base.PreferredConnID = connectionID
+			base.ForcePreferredConn = true
+			next, err := pool.Acquire(context.Background(), base)
+			require.NoError(t, err)
+			require.True(t, next.Reused())
+			require.Equal(t, connectionID, next.ConnID())
+			next.Release()
+			require.Len(t, dialer.headers, 1, "a successful reconnect must remain compatible with the next ingress turn")
+		})
+	}
+}
