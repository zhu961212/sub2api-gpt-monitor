+func gptRecoveryMintTestCreated(model string) string {
+	raw, _ := json.Marshal(map[string]any{"type": "response.created", "response": map[string]string{"id": "resp_test", "model": model}})
+	return "event: response.created\ndata: " + string(raw) + "\n\n"
