diff --git a/backend/internal/repository/account_repo_gpt_recovery.go b/backend/internal/repository/account_repo_gpt_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..99394fc7919efe909ae8aed4ddb4563f64487a39
--- /dev/null
+++ b/backend/internal/repository/account_repo_gpt_recovery.go
@@ -0,0 +1,114 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/lib/pq"
+)
+
+// Keep the candidate and status projections aligned with gptRecoveryEligible.
+// schedulable is deliberately not a predicate: paused accounts need rechecks.
+const gptRecoveryEligibleSQL = `
+	a.deleted_at IS NULL
+	AND a.id > 0
+	AND a.platform = 'openai'
+	AND a.type = 'oauth'
+	AND a.status = 'active'
+	AND a.parent_account_id IS NULL
+	AND (a.expires_at IS NULL OR a.expires_at > CURRENT_TIMESTAMP)
+`
+
+const gptRecoveryAccountColumnsSQL = `
+	a.id, a.platform, a.type, a.status, a.schedulable,
+	a.expires_at, a.parent_account_id
+`
+
+// ListGPTRecoveryCandidates uses a bounded keyset page without hydrating secrets
+// or relationships. A probe loads the full account only when its worker is ready.
+func (r *accountRepository) ListGPTRecoveryCandidates(ctx context.Context, accountIDs []int64, afterID int64, limit int) ([]service.Account, error) {
+	if limit <= 0 {
+		return []service.Account{}, nil
+	}
+	if r == nil || r.sql == nil {
+		return nil, errors.New("GPT account monitor repository unavailable")
+	}
+	query := `SELECT ` + gptRecoveryAccountColumnsSQL + `
+		FROM accounts AS a
+		WHERE ` + gptRecoveryEligibleSQL + ` AND a.id > $1`
+	args := []any{afterID, limit}
+	if len(accountIDs) > 0 {
+		query += ` AND a.id = ANY($3)`
+		args = append(args, pq.Array(accountIDs))
+	}
+	query += ` ORDER BY a.id ASC LIMIT $2`
+	rows, err := r.sql.QueryContext(ctx, query, args...)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = rows.Close() }()
+	accounts := make([]service.Account, 0)
+	for rows.Next() {
+		var account service.Account
+		if err := rows.Scan(&account.ID, &account.Platform, &account.Type, &account.Status, &account.Schedulable, &account.ExpiresAt, &account.ParentAccountID); err != nil {
+			return nil, err
+		}
+		accounts = append(accounts, account)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return accounts, nil
+}
+
+// ListGPTRecoveryAccounts returns the display fields and only the monitor's JSON
+// result. The service sorts the complete result to retain the latest 200 checks.
+func (r *accountRepository) ListGPTRecoveryAccounts(ctx context.Context, accountIDs []int64) ([]service.Account, error) {
+	if r == nil || r.sql == nil {
+		return nil, errors.New("GPT account monitor repository unavailable")
+	}
+	query := `SELECT ` + gptRecoveryAccountColumnsSQL + `,
+		a.name, p.name, a.extra -> 'gpt_account_recovery'
+		FROM accounts AS a
+		LEFT JOIN proxies AS p ON p.id = a.proxy_id AND p.deleted_at IS NULL
+		WHERE ` + gptRecoveryEligibleSQL
+	var args []any
+	if len(accountIDs) > 0 {
+		query += ` AND a.id = ANY($1)`
+		args = append(args, pq.Array(accountIDs))
+	}
+	query += ` ORDER BY a.id ASC`
+	rows, err := r.sql.QueryContext(ctx, query, args...)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = rows.Close() }()
+	accounts := make([]service.Account, 0)
+	for rows.Next() {
+		var account service.Account
+		var proxyName sql.NullString
+		var rawMonitor []byte
+		if err := rows.Scan(&account.ID, &account.Platform, &account.Type, &account.Status, &account.Schedulable, &account.ExpiresAt, &account.ParentAccountID, &account.Name, &proxyName, &rawMonitor); err != nil {
+			return nil, err
+		}
+		if proxyName.Valid {
+			account.Proxy = &service.Proxy{Name: proxyName.String}
+		}
+		if len(rawMonitor) > 0 {
+			var monitor any
+			if err := json.Unmarshal(rawMonitor, &monitor); err != nil {
+				return nil, fmt.Errorf("decode GPT account monitor result: %w", err)
+			}
+			account.Extra = map[string]any{"gpt_account_recovery": monitor}
+		}
+		accounts = append(accounts, account)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return accounts, nil
+}
