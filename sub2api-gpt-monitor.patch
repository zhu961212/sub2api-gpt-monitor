+type gptMonitorRepoStub struct {
+	AccountRepository
+	mu        sync.Mutex
+	accounts  []Account
+	writes    map[int64]bool
+	results   map[int64]GPTAccountMonitorResult
+	casFail   bool
+	casErr    error
+	listCalls int
+}
+
+func (r *gptMonitorRepoStub) ListByPlatform(_ context.Context, platform string) ([]Account, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.listCalls++
+	accounts := make([]Account, len(r.accounts))
+	for i, account := range r.accounts {
+		accounts[i] = gptMonitorCloneStubAccount(account)
+	}
+	return accounts, nil
+}
+func gptMonitorCloneStubAccount(account Account) Account {
+	account.Extra = maps.Clone(account.Extra)
+	account.Credentials = maps.Clone(account.Credentials)
+	if account.Proxy != nil {
+		proxy := *account.Proxy
+		account.Proxy = &proxy
+	}
+	return account
+}
+func (r *gptMonitorRepoStub) snapshot(id int64) *Account {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for _, account := range r.accounts {
+		if account.ID == id {
+			snapshot := gptMonitorCloneStubAccount(account)
+			return &snapshot
+		}
+	}
+	return nil
+}
+
+func (r *gptMonitorRepoStub) GetByID(_ context.Context, id int64) (*Account, error) {
+	if account := r.snapshot(id); account != nil {
+		return account, nil
+	}
+	return nil, ErrAccountNotFound
+}
+func (r *gptMonitorRepoStub) SetGPTMonitorSchedulableIfMatch(_ context.Context, a *Account, value bool) (bool, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.casErr != nil {
+		return false, r.casErr
+	}
+	if r.casFail {
+		return false, nil
+	}
+	r.writes[a.ID] = value
+	for i := range r.accounts {
+		if r.accounts[i].ID == a.ID {
+			r.accounts[i].Schedulable = value
+		}
+	}
+	return true, nil
+}
+func (r *gptMonitorRepoStub) UpdateExtra(_ context.Context, id int64, extra map[string]any) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.results[id] = extra["gpt_account_monitor"].(GPTAccountMonitorResult)
+	for i := range r.accounts {
+		if r.accounts[i].ID == id {
+			if r.accounts[i].Extra == nil {
+				r.accounts[i].Extra = make(map[string]any)
+			}
+			for key, value := range extra {
+				r.accounts[i].Extra[key] = value
+			}
+		}
+	}
+	return nil
+}
+
+// Advance an explicitly asserted first sample without waiting for a real timer.
+func gptMonitorAgeConfirmation(r *gptMonitorRepoStub, id int64) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for i := range r.accounts {
+		if r.accounts[i].ID != id {
+			continue
+		}
+		previous := gptMonitorSavedResult(&r.accounts[i])
+		checked, due := time.Now().UTC().Add(-6*time.Minute), time.Now().UTC().Add(-time.Second)
+		previous.PendingCheckedAt, previous.NextCheckAt = &checked, &due
+		r.accounts[i].Extra = map[string]any{"gpt_account_monitor": previous}
+		r.results[id] = previous
+	}
+}
+
+func gptMonitorForceDue(r *gptMonitorRepoStub, id int64) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for i := range r.accounts {
+		if r.accounts[i].ID == id {
+			previous := gptMonitorSavedResult(&r.accounts[i])
+			due := time.Now().UTC().Add(-time.Second)
+			previous.NextCheckAt = &due
+			r.accounts[i].Extra = map[string]any{"gpt_account_monitor": previous}
+			r.results[id] = previous
+		}
+	}
+}
+
+// CAS tests isolate the write boundary using one previous valid sample.
+func gptMonitorSeedConfirmation(s *GPTAccountMonitorService, r *gptMonitorRepoStub, id int64, verdict string) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	checked, due := time.Now().UTC().Add(-6*time.Minute), time.Now().UTC().Add(-time.Second)
+	for i := range r.accounts {
+		if r.accounts[i].ID == id {
+			r.accounts[i].Extra = map[string]any{"gpt_account_monitor": GPTAccountMonitorResult{
+				ConfigKey: gptMonitorConfigHash(s.cfg), PendingVerdict: verdict, Consecutive: 1, PendingCheckedAt: &checked, NextCheckAt: &due,
+				Model: s.cfg.Model, ReasoningEffort: s.cfg.ReasoningEffort, ExpectedGeneration: s.cfg.ExpectedGeneration,
+			}}
+		}
+	}
+}
+
+type gptMonitorStoreStub struct {
+	acquired bool
+	owned    bool
+	next     time.Time
+	err      error
+	released bool
+}
+
+func (s *gptMonitorStoreStub) Acquire(context.Context, string, time.Duration) (bool, error) {
+	return s.acquired, s.err
+}
+func (s *gptMonitorStoreStub) Renew(context.Context, string, time.Duration) (bool, error) {
+	return s.owned, s.err
+}
+func (s *gptMonitorStoreStub) Owns(context.Context, string) (bool, error) { return s.owned, s.err }
+func (s *gptMonitorStoreStub) Release(context.Context, string) error      { s.released = true; return nil }
+func (s *gptMonitorStoreStub) NextRun(context.Context, string) (time.Time, error) {
+	return s.next, s.err
+}
+func (s *gptMonitorStoreStub) SetNextRun(_ context.Context, _ string, next time.Time) error {
+	s.next = next
+	return s.err
+}
+func gptMonitorFixture() (*GPTAccountMonitorService, *gptMonitorRepoStub, *gptMonitorStoreStub) {
+	r := &gptMonitorRepoStub{writes: map[int64]bool{}, results: map[int64]GPTAccountMonitorResult{}}
+	for id := int64(1); id <= 6; id++ {
