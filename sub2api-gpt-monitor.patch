+		{"invalid donor ID", "share_route_donor_account_ids", []int64{0}},
+		{"negative donor ID", "share_route_donor_account_ids", []int64{-7}},
+		{"session TTL too short", "proxy_session_ttl_seconds", 59},
+		{"session TTL too long", "proxy_session_ttl_seconds", 3601},
+		{"proxy URL input", "proxy_url", "http://fixture-user:PRIVATE_PROXY_FIXTURE@proxy.example:1000"},
+		{"proxy override URL input", "proxy_override_url", "http://fixture-user:PRIVATE_PROXY_FIXTURE@proxy.example:1000"},
+		{"read-only proxy status input", "proxy_override_configured", true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			stub := &recoveryHandlerStub{cfg: config.DefaultGPTAccountRecoveryConfig()}
