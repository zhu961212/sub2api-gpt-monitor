@@ -0,0 +1,35 @@
+package service
+
+import "time"
+
+const gptRecoveryQuotaExhaustedMessage = "账号使用额度已达 100%，已跳过智商恢复取票，调度未改变"
+
+// Use the same persisted Codex 5h/7d windows as the account usage display. A
+// relative reset must stay anchored to its snapshot, never to each new check.
+// Unknown usage does not trigger a quota fetch or prevent a normal probe.
+func gptRecoveryExhaustedQuota(account *Account, now time.Time) (bool, *time.Time) {
+	if !gptRecoveryEligible(account) || account.IsOpenAIAgentIdentity() {
+		return false, nil
+	}
+	var exhausted bool
+	var next *time.Time
+	for _, window := range []string{"5h", "7d"} {
+		// Match the scheduler's expiry/staleness rules so an old snapshot with
+		// no known reset cannot keep detection suspended indefinitely.
+		utilization, usable := resolveOpenAIQuotaUtilization(account.Extra, window, now)
+		if !usable || !(utilization >= 1) {
+			continue
+		}
+		reset, known := openAICodexWindowResetAt(account.Extra, window)
+		if known && !now.Before(reset) {
+			continue
+		}
+		exhausted = true
+		// Every exhausted window must reset before detection can resume.
+		if known && (next == nil || reset.After(*next)) {
+			reset = reset.UTC()
+			next = &reset
+		}
+	}
+	return exhausted, next
+}
