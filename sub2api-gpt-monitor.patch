@@ -0,0 +1,33 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+)
+
+// UpdateGPTRecoveryResult saves display-only observations without rebuilding
+// scheduler buckets or loading a credential-bearing account snapshot. Leaving
+// updated_at unchanged also prevents observations from invalidating an in-flight
+// scheduling CAS; actual scheduling changes still update it and the outbox.
+func (r *accountRepository) UpdateGPTRecoveryResult(ctx context.Context, id int64, result service.GPTAccountRecoveryResult) error {
+	payload, err := json.Marshal(map[string]any{"gpt_account_recovery": result})
+	if err != nil {
+		return err
+	}
+	res, err := clientFromContext(ctx, r.client).ExecContext(ctx,
+		"UPDATE accounts SET extra = (COALESCE(extra, '{}'::jsonb) - 'gpt_account_monitor') || $1::jsonb WHERE id = $2 AND deleted_at IS NULL",
+		string(payload), id)
+	if err != nil {
+		return err
+	}
+	affected, err := res.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if affected == 0 {
+		return service.ErrAccountNotFound
+	}
+	return nil
+}
diff --git a/backend/internal/repository/gpt_account_recovery_shared_store.go b/backend/internal/repository/gpt_account_recovery_shared_store.go
new file mode 100644
index 0000000000000000000000000000000000000000..4fe368ada1854e9a845d1d3cbc4fce74f9d4c736
--- /dev/null
+++ b/backend/internal/repository/gpt_account_recovery_shared_store.go
@@ -0,0 +1,181 @@
+package repository
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/redis/go-redis/v9"
+)
+
+const (
+	gptRecoverySharedRouteMaxPayload = 12 * 1024
+	gptRecoverySharedRouteMaxTTL     = 2 * time.Hour
+)
+
+var (
+	gptRecoverySharedGatewayPattern = regexp.MustCompile("^unified-[0-9]{1,6}$")
+	gptRecoverySharedSessionPattern = regexp.MustCompile("^[A-Za-z0-9]{1,32}$")
+)
+
+var _ service.GPTAccountRecoverySharedRouteStore = (*gptAccountRecoveryStore)(nil)
+
+// Each candidate has its own expiring value. The sorted index contains only
+// digests, so it never exposes Cookie values, OAuth identity or proxy credentials.
+// Lua keeps publication, expiry pruning and the eight-candidate cap atomic.
+var gptRecoverySaveSharedRouteScript = redis.NewScript("\n" +
+	"local expired = redis.call('ZRANGEBYSCORE', KEYS[1], '-inf', ARGV[5])\n" +
+	"for _, member in ipairs(expired) do redis.call('DEL', ARGV[7] .. member); redis.call('ZREM', KEYS[1], member) end\n" +
+	"redis.call('SET', KEYS[2], ARGV[2], 'PX', ARGV[3])\n" +
+	"redis.call('ZADD', KEYS[1], ARGV[4], ARGV[1])\n" +
+	"local excess = redis.call('ZCARD', KEYS[1]) - tonumber(ARGV[6])\n" +
+	"if excess > 0 then local removed = redis.call('ZRANGE', KEYS[1], 0, excess - 1); for _, member in ipairs(removed) do redis.call('DEL', ARGV[7] .. member); redis.call('ZREM', KEYS[1], member) end end\n" +
+	"redis.call('PEXPIRE', KEYS[1], ARGV[8])\nreturn 1\n")
+
+var gptRecoveryLoadSharedRoutesScript = redis.NewScript("\n" +
+	"local expired = redis.call('ZRANGEBYSCORE', KEYS[1], '-inf', ARGV[1])\n" +
+	"for _, member in ipairs(expired) do redis.call('DEL', ARGV[3] .. member); redis.call('ZREM', KEYS[1], member) end\n" +
+	"local result = {}\nlocal candidates = redis.call('ZREVRANGE', KEYS[1], 0, tonumber(ARGV[2]) - 1)\n" +
+	"for _, member in ipairs(candidates) do\nlocal key = ARGV[3] .. member\n" +
+	"if string.len(member) == 64 and string.match(member, '^[0-9a-f]+$') and redis.call('PTTL', key) > 0 and redis.call('STRLEN', key) <= tonumber(ARGV[4]) then\n" +
+	"local raw = redis.call('GET', key); if raw then table.insert(result, member); table.insert(result, raw) end\n" +
+	"else redis.call('DEL', key); redis.call('ZREM', KEYS[1], member) end\nend\nreturn result\n")
+
+var gptRecoveryRejectSharedRouteScript = redis.NewScript("\n" +
+	"if redis.call('GET', KEYS[2]) == ARGV[2] then redis.call('DEL', KEYS[2]); redis.call('ZREM', KEYS[1], ARGV[1]) end\nreturn 1\n")
+
+func gptRecoverySharedDigestValid(value string) bool {
+	if len(value) != 64 || strings.ToLower(value) != value {
+		return false
+	}
+	_, err := hex.DecodeString(value)
+	return err == nil
+}
+
+func gptRecoverySharedRouteKeys(scope string) (index, prefix string, err error) {
+	if !gptRecoverySharedDigestValid(scope) {
+		return "", "", errors.New("invalid shared recovery scope")
+	}
+	base := gptAccountRecoveryKeyPrefix + ":shared:" + scope
+	return base + ":index", base + ":route:", nil
+}
+
+func gptRecoverySharedCookieValid(value string) bool {
+	if len(value) == 0 || len(value) > 4096 {
+		return false
+	}
+	for i := 0; i < len(value); i++ {
+		b := value[i]
+		if b < 0x21 || b > 0x7e || b == '"' || b == ',' || b == ';' || b == '\\' {
+			return false
+		}
+	}
+	return true
+}
+
+func gptRecoverySharedRouteValid(route *service.GPTAccountRecoverySharedRoute, now time.Time) bool {
+	if route == nil || !gptRecoverySharedCookieValid(route.CFLB) || !gptRecoverySharedCookieValid(route.OAILB) ||
+		!gptRecoverySharedGatewayPattern.MatchString(route.Gateway) || !route.CookieExpiresAt.After(now) ||
+		!gptRecoverySharedDigestValid(route.ProxyScope) {
+		return false
+	}
+	if route.ProxySession == "" {
+		return route.ProxyExpiresAt.IsZero()
+	}
+	return gptRecoverySharedSessionPattern.MatchString(route.ProxySession) && route.ProxyExpiresAt.After(now)
+}
+
+func gptRecoverySharedRouteID(route *service.GPTAccountRecoverySharedRoute) string {
+	// Expiry is excluded so refreshing the same route updates one candidate.
+	sum := sha256.Sum256([]byte(route.CFLB + "\x00" + route.OAILB + "\x00" + route.ProxyScope + "\x00" + route.ProxySession))
+	return hex.EncodeToString(sum[:])
+}
+
+func (s *gptAccountRecoveryStore) SaveSharedRoute(ctx context.Context, scope string, route *service.GPTAccountRecoverySharedRoute, ttl time.Duration) error {
+	index, prefix, err := gptRecoverySharedRouteKeys(scope)
+	if err != nil {
+		return err
+	}
+	if s == nil || s.rdb == nil {
+		return errors.New("shared recovery cache unavailable")
+	}
+	now := time.Now()
+	if ttl <= 0 || !gptRecoverySharedRouteValid(route, now) {
+		return errors.New("invalid or expired shared recovery route")
+	}
+	copy := *route
+	if ttl > gptRecoverySharedRouteMaxTTL {
+		ttl = gptRecoverySharedRouteMaxTTL
+	}
+	if remaining := copy.CookieExpiresAt.Sub(now); ttl > remaining {
+		ttl = remaining
+	}
+	if copy.ProxySession != "" {
+		if remaining := copy.ProxyExpiresAt.Sub(now); ttl > remaining {
+			ttl = remaining
+		}
+	}
+	if ttl.Milliseconds() < 1 {
+		return errors.New("expired shared recovery route")
+	}
+	// A borrower must not extend the publisher's shorter cache lease.
+	copy.CookieExpiresAt = now.Add(ttl).UTC()
+	raw, err := json.Marshal(copy)
+	if err != nil || len(raw) > gptRecoverySharedRouteMaxPayload {
+		return errors.New("invalid shared recovery payload")
+	}
+	id := gptRecoverySharedRouteID(&copy)
+	return gptRecoverySaveSharedRouteScript.Run(ctx, s.rdb, []string{index, prefix + id},
+		id, string(raw), ttl.Milliseconds(), now.Add(ttl).UnixMilli(), now.UnixMilli(),
+		service.GPTAccountRecoverySharedRouteLimit, prefix, gptRecoverySharedRouteMaxTTL.Milliseconds()).Err()
+}
+
+func (s *gptAccountRecoveryStore) LoadSharedRoutes(ctx context.Context, scope string, limit int) ([]service.GPTAccountRecoverySharedRoute, error) {
+	index, prefix, err := gptRecoverySharedRouteKeys(scope)
+	if err != nil {
+		return nil, err
+	}
+	if s == nil || s.rdb == nil {
+		return nil, errors.New("shared recovery cache unavailable")
+	}
+	if limit <= 0 {
+		return []service.GPTAccountRecoverySharedRoute{}, nil
+	}
+	if limit > service.GPTAccountRecoverySharedRouteLimit {
+		limit = service.GPTAccountRecoverySharedRouteLimit
+	}
+	values, err := gptRecoveryLoadSharedRoutesScript.Run(ctx, s.rdb, []string{index},
+		time.Now().UnixMilli(), service.GPTAccountRecoverySharedRouteLimit, prefix, gptRecoverySharedRouteMaxPayload).Slice()
+	if err != nil {
+		return nil, err
+	}
+	routes := make([]service.GPTAccountRecoverySharedRoute, 0, limit)
+	for i := 0; i+1 < len(values); i += 2 {
+		id, idOK := values[i].(string)
+		raw, rawOK := values[i+1].(string)
+		if !idOK || !rawOK {
+			continue
+		}
+		var route service.GPTAccountRecoverySharedRoute
+		decoder := json.NewDecoder(strings.NewReader(raw))
+		decoder.DisallowUnknownFields()
+		if decoder.Decode(&route) != nil || decoder.Decode(new(any)) != io.EOF ||
+			!gptRecoverySharedRouteValid(&route, time.Now()) || gptRecoverySharedRouteID(&route) != id {
+			// Remove only the malformed snapshot read above. Concurrently renewed
+			// candidates and the separate account ticket cache remain untouched.
+			_ = gptRecoveryRejectSharedRouteScript.Run(ctx, s.rdb, []string{index, prefix + id}, id, raw).Err()
+			continue
+		}
+		if len(routes) < limit {
+			routes = append(routes, route)
+		}
+	}
+	return routes, nil
+}
