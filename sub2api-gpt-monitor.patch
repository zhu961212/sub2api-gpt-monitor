+++ b/backend/internal/service/gpt_account_monitor_probe_test.go
@@ -0,0 +1,452 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/openai"
+	"github.com/stretchr/testify/require"
+)
+
+func gptMonitorCompleted(answer string) string {
+	b, _ := json.Marshal(map[string]any{"type": "response.completed", "response": map[string]any{"status": "completed", "output": []any{map[string]any{"type": "message", "role": "assistant", "content": []any{map[string]any{"type": "output_text", "text": answer}}}}}})
+	return "data: " + string(b) + "\n\n"
+}
+
+func BenchmarkGPTMonitorReadResponse(b *testing.B) {
+	delta, _ := json.Marshal(map[string]any{"type": "response.output_text.delta", "delta": strings.Repeat("x", 32768)})
+	input := "data: " + string(delta) + "\n\n" + gptMonitorCompleted("iPhone 17")
+	b.ReportAllocs()
+	b.SetBytes(int64(len(input)))
+	for b.Loop() {
+		if _, err := readGPTMonitorResponse(strings.NewReader(input)); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+func TestGPTMonitorCompletedResponseOnly(t *testing.T) {
+	for _, input := range []string{gptMonitorCompleted("iPhone 17"), strings.ReplaceAll(gptMonitorCompleted("iPhone 17"), "\n", "\r\n"), strings.TrimSpace(gptMonitorCompleted("iPhone 17"))} {
+		answer, err := readGPTMonitorResponse(strings.NewReader(input))
+		if err != nil || answer != "iPhone 17" {
+			t.Errorf("completed: %q %v", answer, err)
+		}
+	}
+	bad := []string{
+		`data: {"type":"response.output_text.delta","delta":"iPhone17"}` + "\n\n",
+		"data: [DONE]\n\n", `data: {"type":"response.failed"}` + "\n\n",
+		`data: {"type":"response.incomplete"}` + "\n\n", `data: {broken}` + "\n\n",
+		strings.Replace(gptMonitorCompleted("iPhone17"), `"status":"completed"`, `"status":"incomplete"`, 1),
+		`data: {"type":"response.output_item.added","item":{"type":"web_search_call"}}` + "\n\n" + gptMonitorCompleted("iPhone17"),
+		`data: {"type":"response.function_call_arguments.delta","delta":"iPhone17"}` + "\n\n" + gptMonitorCompleted("iPhone17"),
+		`data: {"type":"response.completed","response":{"status":"completed","output":[]}}` + "\n\n",
+		`data: {"type":"response.completed","response":{"status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"refusal","text":"iPhone17"}]}]}}` + "\n\n",
+	}
+	for _, input := range bad {
+		if answer, err := readGPTMonitorResponse(strings.NewReader(input)); err == nil {
+			t.Errorf("accepted incomplete/tool response: %q (%q)", input, answer)
+		}
+	}
+	if _, err := readGPTMonitorResponse(strings.NewReader("data: " + strings.Repeat("a", 300000))); err == nil {
+		t.Fatal("oversized event accepted")
+	}
+	if _, err := readGPTMonitorResponse(strings.NewReader(strings.Repeat(": comment padding\n", 140000) + gptMonitorCompleted("iPhone17"))); err == nil {
+		t.Fatal("oversized response accepted")
+	}
+}
+
+func TestGPTMonitorResponseDeltaLimitIsCumulative(t *testing.T) {
+	deltaEvent := func(text string) string {
+		raw, _ := json.Marshal(map[string]any{"type": "response.output_text.delta", "delta": text})
+		return "data: " + string(raw) + "\n\n"
+	}
+	atLimit := deltaEvent(strings.Repeat("x", 16384)) + deltaEvent(strings.Repeat("y", 16384))
+	if answer, err := readGPTMonitorResponse(strings.NewReader(atLimit + gptMonitorCompleted("iPhone 17"))); err != nil || answer != "iPhone 17" {
+		t.Fatalf("valid delta byte limit rejected: answer=%q err=%v", answer, err)
+	}
+	for _, overflow := range []string{deltaEvent("x"), deltaEvent("汉")} {
+		if _, err := readGPTMonitorResponse(strings.NewReader(atLimit + overflow + gptMonitorCompleted("iPhone 17"))); err == nil {
+			t.Fatal("cumulative delta byte limit exceeded without error")
+		}
+	}
+}
+
