@@ -0,0 +1,65 @@
+package service
+
+import (
+	"errors"
+	"io"
+	"net/http"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/tlsfingerprint"
+)
+
+// doGPTMonitorRequest shares the normal OpenAI transport policy and connection
+// pool while keeping the probe on the exact account proxy that was validated.
+// Only protocol compatibility can fall back; proxy switching, direct routing,
+// redirects and gateway scheduling side effects are not part of this path.
+func (s *OpenAIGatewayService) doGPTMonitorRequest(req *http.Request, account *Account) (*http.Response, error) {
+	if req == nil {
+		return nil, errors.New("无法构造检测请求")
+	}
+	if err := validateGPTMonitorAccount(account); err != nil {
+		return nil, err
+	}
+	proxyURL := account.Proxy.URL()
+	ctx := WithHTTPUpstreamProfile(req.Context(), HTTPUpstreamProfileOpenAI)
+	ctx = WithHTTPUpstreamRedirectsDisabled(ctx)
+	req = req.WithContext(ctx)
+	if s != nil && s.httpUpstream != nil {
+		var profile *tlsfingerprint.Profile
+		if s.gptMonitorTLSProfiles != nil {
+			profile = s.gptMonitorTLSProfiles.ResolveTLSProfile(account)
+		} else if account.IsTLSFingerprintEnabled() {
+			// Never silently use a different fingerprint when its configured
+			// resolver is unavailable. The production provider injects it.
+			return nil, gptMonitorError("tls_profile_unavailable", "账号 TLS 指纹配置暂不可用")
+		}
+		return s.httpUpstream.DoWithTLS(req, proxyURL, account.ID, account.Concurrency, profile)
+	}
+
+	// Small isolated service fixtures may not provide the shared transport.
+	// Preserve the same proxy and redirect restrictions in that fallback.
+	if account.IsTLSFingerprintEnabled() {
+		return nil, gptMonitorError("tls_profile_unavailable", "账号 TLS 指纹传输暂不可用")
+	}
+	client, transport, err := newGPTMonitorClient(proxyURL)
+	if err != nil {
+		return nil, err
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		transport.CloseIdleConnections()
+		return resp, err
+	}
+	resp.Body = &gptMonitorTransportBody{ReadCloser: resp.Body, transport: transport}
+	return resp, nil
+}
+
+type gptMonitorTransportBody struct {
+	io.ReadCloser
+	transport *http.Transport
+}
+
+func (b *gptMonitorTransportBody) Close() error {
+	err := b.ReadCloser.Close()
+	b.transport.CloseIdleConnections()
+	return err
+}
