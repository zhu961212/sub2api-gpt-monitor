+func TestGPTRecoveryMintAuthenticationFailureAndCancellationStopRetries(t *testing.T) {
+	for _, status := range []int{401, 403} {
+		calls := 0
+		do := func(*http.Request) (*http.Response, error) {
+			calls++
+			return &http.Response{StatusCode: status, Body: io.NopCloser(strings.NewReader("SECRET"))}, nil
+		}
+		_, err := gptRecoveryMintWithDo(context.Background(), do, gptRecoveryMintTestAccount(), "secret-token", "", config.DefaultGPTAccountRecoveryConfig(), nil)
+		require.Error(t, err)
+		require.Equal(t, 1, calls)
+		require.NotContains(t, err.Error(), "SECRET")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	calls := 0
+	do := func(*http.Request) (*http.Response, error) {
+		calls++
+		cancel()
+		return nil, errors.New("SECRET proxy error")
+	}
+	_, err := gptRecoveryMintWithDo(ctx, do, gptRecoveryMintTestAccount(), "secret-token", "", config.DefaultGPTAccountRecoveryConfig(), nil)
+	require.Error(t, err)
+	require.Equal(t, 1, calls)
+	require.NotContains(t, err.Error(), "SECRET")
+}
diff --git a/backend/internal/service/gpt_account_recovery_mint_ws.go b/backend/internal/service/gpt_account_recovery_mint_ws.go
new file mode 100644
index 0000000000000000000000000000000000000000..a1e52289b86c0afeadb91f455acf8aa08e14dac2
--- /dev/null
+++ b/backend/internal/service/gpt_account_recovery_mint_ws.go
@@ -0,0 +1,162 @@
+package service
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+)
+
+const gptRecoveryMintWSMaxEvents = 32
+
+// Adapt the bounded WebSocket metadata/created window to the same verifier as
+// SSE. A probe turn-state is observed here but is never sent into a fresh turn.
+func gptRecoveryMintWSResponse(req *http.Request, proxyURL string, dialer openAIWSClientDialer) (*http.Response, error) {
+	if req == nil || req.Body == nil || dialer == nil {
+		return nil, gptRecoveryError("invalid_request", "无法构造 WebSocket 取票请求")
+	}
+	defer req.Body.Close()
+	if _, err := validGPTRecoveryProxyURL(proxyURL); err != nil {
+		return nil, err
+	}
+	payloadRaw, err := io.ReadAll(io.LimitReader(req.Body, gptRecoveryMintScanLimit+1))
+	if err != nil || len(payloadRaw) > gptRecoveryMintScanLimit {
+		return nil, gptRecoveryError("invalid_request", "WebSocket 取票请求超过大小限制")
+	}
+	var payload map[string]any
+	if json.Unmarshal(payloadRaw, &payload) != nil || payload == nil {
+		return nil, gptRecoveryError("invalid_request", "WebSocket 取票请求无效")
+	}
+	delete(payload, "stream")
+	delete(payload, "client_metadata")
+	payload["type"] = "response.create"
+	headers := req.Header.Clone()
+	headers.Del("Content-Type")
+	headers.Del("Accept")
+	headers.Del("Accept-Encoding")
+	headers.Del("X-Codex-Turn-State")
+	headers.Set("OpenAI-Beta", openAIWSBetaV2Value)
+	conn, status, handshakeHeaders, err := dialer.Dial(req.Context(), "wss://chatgpt.com/backend-api/codex/responses", headers, proxyURL)
+	if err != nil {
+		if conn != nil {
+			closeGPTRecoveryMintWS(conn)
+		}
+		if status != 0 {
+			var handshakeErr *openAIWSHandshakeError
+			if errors.As(err, &handshakeErr) {
+				return nil, gptRecoveryHTTPError(status, bytes.NewReader(handshakeErr.Body))
+			}
+			return nil, gptRecoveryHTTPError(status, nil)
+		}
+		return nil, gptRecoveryTransportError(err)
+	}
+	if conn == nil {
+		return nil, gptRecoveryError("invalid_response", "WebSocket 取票握手无效")
+	}
+	defer closeGPTRecoveryMintWS(conn)
+	// The standard dialer reports zero on a successful, verified 101 upgrade.
+	if status != 0 && status != http.StatusSwitchingProtocols {
+		return nil, gptRecoveryHTTPError(status, nil)
+	}
+	if concrete, ok := conn.(*coderOpenAIWSClientConn); ok && concrete.conn != nil {
+		concrete.conn.SetReadLimit(gptRecoveryMintScanLimit)
+	}
+	if err := conn.WriteJSON(req.Context(), payload); err != nil {
+		return nil, gptRecoveryTransportError(err)
+	}
+	responseHeaders := handshakeHeaders.Clone()
+	if responseHeaders == nil {
+		responseHeaders = make(http.Header)
+	}
+	responseHeaders.Set("Content-Type", "text/event-stream")
+	var created []byte
+	var metadataState string
+	total := 0
+	for events := 0; events < gptRecoveryMintWSMaxEvents; events++ {
+		message, err := conn.ReadMessage(req.Context())
+		if err != nil {
+			if errors.Is(err, io.EOF) {
+				return nil, gptRecoveryError("missing_created_event", "WebSocket 上游缺少完整模型与状态声明")
+			}
+			return nil, gptRecoveryTransportError(err)
+		}
+		total += len(message)
+		if total > gptRecoveryMintScanLimit {
+			return nil, gptRecoveryError("response_too_large", "WebSocket 取票事件超过大小限制")
+		}
+		var event struct {
+			Type     string                     `json:"type"`
+			Headers  map[string]json.RawMessage `json:"headers"`
+			Response json.RawMessage            `json:"response"`
+		}
+		if json.Unmarshal(message, &event) != nil || event.Type == "" {
+			return nil, gptRecoveryError("invalid_response", "WebSocket 取票事件无效")
+		}
+		if event.Type == "codex.response.metadata" {
+			for name, raw := range event.Headers {
+				if !strings.EqualFold(name, "x-codex-turn-state") {
+					continue
+				}
+				var state string
+				if json.Unmarshal(raw, &state) != nil || state == "" || len(state) > 8192 || (metadataState != "" && metadataState != state) {
+					return nil, gptRecoveryError("invalid_ticket", "WebSocket 取票状态声明无效或矛盾")
+				}
+				metadataState = state
+			}
+		}
+		evidenceType, evidence := event.Type, message
+		if event.Type == "codex.response.metadata" && len(event.Response) > 0 && string(event.Response) != "null" {
+			// WebSocket upstreams can move the complete response envelope into
+			// metadata. Apply the same id/model/error verifier to that envelope;
+			// a top-level model string is never sufficient evidence.
+			var envelope map[string]json.RawMessage
+			if json.Unmarshal(message, &envelope) != nil {
+				return nil, gptRecoveryError("invalid_response", "WebSocket 模型声明无效")
+			}
+			envelope["type"] = json.RawMessage(`"response.created"`)
+			evidence, err = json.Marshal(envelope)
+			if err != nil {
+				return nil, gptRecoveryError("invalid_response", "WebSocket 模型声明无效")
+			}
+			evidenceType = "response.created"
+		}
+		framed := "event: " + evidenceType + "\ndata: " + string(evidence) + "\n\n"
+		_, parseErr := readGPTRecoveryCreatedModel(strings.NewReader(framed))
+		code, _, _ := gptRecoveryErrorDetails(parseErr)
+		if parseErr != nil && code != "missing_created_event" {
+			return nil, parseErr
+		}
+		if parseErr == nil {
+			if len(created) > 0 {
+				var previous, current struct {
+					Response struct{ ID, Model string } `json:"response"`
+				}
+				if json.Unmarshal(created, &previous) != nil || json.Unmarshal(evidence, &current) != nil || previous.Response != current.Response {
+					return nil, gptRecoveryError("invalid_response", "WebSocket 模型声明重复或矛盾")
+				}
+			}
+			created = append([]byte(nil), evidence...)
+		}
+		if metadataState != "" {
+			states := responseHeaders.Values("X-Codex-Turn-State")
+			if len(states) > 1 || (len(states) == 1 && states[0] != metadataState) {
+				return nil, gptRecoveryError("invalid_ticket", "WebSocket 握手与元数据状态声明不一致")
+			}
+			responseHeaders.Set("X-Codex-Turn-State", metadataState)
+		}
+		if len(created) > 0 && responseHeaders.Get("X-Codex-Turn-State") != "" {
+			return &http.Response{StatusCode: http.StatusOK, Header: responseHeaders, Body: io.NopCloser(strings.NewReader("event: response.created\ndata: " + string(created) + "\n\n"))}, nil
+		}
+	}
+	return nil, gptRecoveryError("missing_created_event", "WebSocket 上游缺少完整模型与状态声明")
+}
+
+func closeGPTRecoveryMintWS(conn openAIWSClientConn) {
+	if force, ok := conn.(openAIWSForceCloser); ok {
+		_ = force.CloseNow()
+		return
+	}
+	_ = conn.Close()
+}
