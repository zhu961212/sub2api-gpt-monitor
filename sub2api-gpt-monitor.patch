+			require.Equal(t, want, base.Headers.Get("Cookie"))
+			require.Equal(t, want, dialer.headers[0].Get("Cookie"))
+			base.Headers.Set(openAIWSTurnStateHeader, first.HandshakeHeader(openAIWSTurnStateHeader))
+			first.Release()
+			base.PreferredConnID = connectionID
+			base.ForcePreferredConn = true
+			next, err := pool.Acquire(context.Background(), base)
+			require.NoError(t, err)
+			require.True(t, next.Reused())
+			require.Equal(t, connectionID, next.ConnID())
+			next.Release()
+			require.Len(t, dialer.headers, 1, "a successful reconnect must remain compatible with the next ingress turn")
+		})
+	}
+}
diff --git a/backend/internal/service/openai_recovery_ws_metadata.go b/backend/internal/service/openai_recovery_ws_metadata.go
new file mode 100644
index 0000000000000000000000000000000000000000..3a8939beba5a6489d7dc5708e04de9b438f389cc
--- /dev/null
+++ b/backend/internal/service/openai_recovery_ws_metadata.go
@@ -0,0 +1,80 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"strings"
+
+	"github.com/tidwall/gjson"
+)
+
+// Metadata can announce the real turn-state after the 101 handshake. Keep the
+// announcement bound to the observer captured for that physical connection; a
+// newer account-wide ticket may already use another residential proxy session.
+func observeGPTRecoveryWSMetadata(ctx context.Context, message []byte, eventType string, observer func(context.Context, http.Header, http.Header), requestHeaders, handshakeHeaders http.Header) string {
+	state := gptRecoveryWSMetadataTurnState(message, eventType)
+	if state == "" || observer == nil {
+		return state
+	}
+	responseHeaders := cloneHeader(handshakeHeaders)
+	if responseHeaders == nil {
+		responseHeaders = make(http.Header)
+	}
+	for name := range responseHeaders {
+		if strings.EqualFold(name, openAICodexTurnStateHeader) {
+			delete(responseHeaders, name)
+		}
+	}
+	responseHeaders.Set(openAICodexTurnStateHeader, state)
+	observer(ctx, requestHeaders, responseHeaders)
+	return state
+}
+
+func (l *openAIWSConnLease) observeGPTRecoveryWSMetadata(ctx context.Context, message []byte, eventType string) string {
+	if eventType != "codex.response.metadata" || l == nil || l.conn == nil || l.released.Load() {
+		return ""
+	}
+	requestHeaders := make(http.Header)
+	if l.conn.requestRecoveryCookies != "" {
+		requestHeaders.Set("Cookie", l.conn.requestRecoveryCookies)
+	}
+	return observeGPTRecoveryWSMetadata(ctx, message, eventType, l.conn.recoveryTurnObserver, requestHeaders, l.conn.handshakeHeaders)
+}
+
+func gptRecoveryWSMetadataTurnState(message []byte, eventType string) string {
+	if eventType != "codex.response.metadata" || !json.Valid(message) {
+		return ""
+	}
+	headers := gjson.GetBytes(message, "headers")
+	if !headers.IsObject() {
+		return ""
+	}
+	state, valid := "", true
+	headers.ForEach(func(name, value gjson.Result) bool {
+		if !strings.EqualFold(name.String(), openAICodexTurnStateHeader) {
+			return true
+		}
+		if value.Type != gjson.String {
+			valid = false
+			return false
+		}
+		next := strings.TrimSpace(value.String())
+		if next == "" || len(next) > 16384 || (state != "" && state != next) {
+			valid = false
+			return false
+		}
+		for i := 0; i < len(next); i++ {
+			if next[i] < 0x20 || next[i] == 0x7f {
+				valid = false
+				return false
+			}
+		}
+		state = next
+		return true
+	})
+	if !valid {
+		return ""
+	}
+	return state
+}
