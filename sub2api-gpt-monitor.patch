+  next_check_at?: string | null
+  manual_requested?: boolean
+  schedulable?: boolean
+  ticket_ready?: boolean
+  cookie_ready?: boolean
+}
+
+export interface GPTAccountRecoveryStatus {
+  enabled: boolean
+  running: boolean
+  queued: boolean
+  last_run: string | null
+  next_run: string | null
+  message: string
+  total_accounts: number
+  processed_accounts?: number
+  run_total_accounts?: number
+  accounts: GPTAccountRecoveryResult[]
+}
+
+export interface GPTAccountRecoveryRunResult { queued: boolean; message: string }
+
+const base = '/admin/gpt-account-recovery'
+
+export async function getConfig(signal?: AbortSignal): Promise<GPTAccountRecoveryConfigResponse> {
+  return (await apiClient.get<GPTAccountRecoveryConfigResponse>(`${base}/config`, { signal })).data
+}
+export async function saveConfig(config: GPTAccountRecoveryConfig, signal?: AbortSignal): Promise<GPTAccountRecoveryConfigResponse> {
+  const payload: GPTAccountRecoveryConfig = {
+    enabled: config.enabled, interval_seconds: config.interval_seconds, timeout_seconds: config.timeout_seconds, max_attempts: config.max_attempts, transport: config.transport,
+    model: config.model, gateway: config.gateway, ticket_length: config.ticket_length, ticket_ttl_seconds: config.ticket_ttl_seconds, cookie_ttl_seconds: config.cookie_ttl_seconds, share_route_cookies: config.share_route_cookies, share_route_donor_account_ids: config.share_route_donor_account_ids,
+    proxy_session_mode: config.proxy_session_mode, proxy_session_ttl_seconds: config.proxy_session_ttl_seconds, account_ids: config.account_ids, run_on_start: config.run_on_start,
+  }
+  return (await apiClient.put<GPTAccountRecoveryConfigResponse>(`${base}/config`, payload, { signal })).data
+}
+export async function getStatus(signal?: AbortSignal): Promise<GPTAccountRecoveryStatus> {
+  return (await apiClient.get<GPTAccountRecoveryStatus>(`${base}/status`, { signal })).data
+}
+export async function run(signal?: AbortSignal): Promise<GPTAccountRecoveryRunResult> {
+  return (await apiClient.post<GPTAccountRecoveryRunResult>(`${base}/run`, undefined, { signal })).data
+}
+export async function runAccount(accountID: number, signal?: AbortSignal): Promise<GPTAccountRecoveryRunResult> {
+  return (await apiClient.post<GPTAccountRecoveryRunResult>(`${base}/accounts/${accountID}/run`, undefined, { signal })).data
+}
+export async function getAccountResult(accountID: number, signal?: AbortSignal): Promise<GPTAccountRecoveryResult> {
+  return (await apiClient.get<GPTAccountRecoveryResult>(`${base}/accounts/${accountID}/result`, { signal })).data
+}
+
+export default { getConfig, saveConfig, getStatus, run, runAccount, getAccountResult }
