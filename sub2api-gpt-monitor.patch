+// GPTAccountMonitorConfig controls the built-in background OAuth account probe.
+// It does not participate in normal request routing.
+type GPTAccountMonitorConfig struct {
+	Enabled            bool    `mapstructure:"enabled" json:"enabled"`
+	IntervalSeconds    int     `mapstructure:"interval_seconds" json:"interval_seconds"`
+	TimeoutSeconds     int     `mapstructure:"timeout_seconds" json:"timeout_seconds"`
+	Concurrency        int     `mapstructure:"concurrency" json:"concurrency"`
+	Model              string  `mapstructure:"model" json:"model"`
+	ReasoningEffort    string  `mapstructure:"reasoning_effort" json:"reasoning_effort"`
+	Prompt             string  `mapstructure:"prompt" json:"prompt"`
+	ExpectedGeneration int     `mapstructure:"expected_generation" json:"expected_generation"`
+	AccountIDs         []int64 `mapstructure:"account_ids" json:"account_ids"`
+	RunOnStart         bool    `mapstructure:"run_on_start" json:"run_on_start"`
+}
+
+const (
+	GPTAccountMonitorModel           = "gpt-6-astra"
+	GPTAccountMonitorReasoningEffort = "xhigh"
+	DefaultGPTAccountMonitorPrompt   = "不联网，不猜测，直接说出你知道的最新苹果手机。只回答手机型号，不要解释。"
+)
+
+// NormalizeFixedModel upgrades legacy settings and ignores model overrides.
+// The model fields remain in the config/API for compatibility and display only.
+func (c *GPTAccountMonitorConfig) NormalizeFixedModel() {
+	c.Model = GPTAccountMonitorModel
+	c.ReasoningEffort = GPTAccountMonitorReasoningEffort
+}
+
+func (c GPTAccountMonitorConfig) Validate() error {
+	if c.IntervalSeconds < 60 || c.IntervalSeconds > 86400 {
+		return fmt.Errorf("gpt_account_monitor.interval_seconds must be between 60 and 86400")
+	}
+	if c.TimeoutSeconds < 10 || c.TimeoutSeconds > 300 {
+		return fmt.Errorf("gpt_account_monitor.timeout_seconds must be between 10 and 300")
+	}
+	if c.Concurrency < 1 || c.Concurrency > 10 {
+		return fmt.Errorf("gpt_account_monitor.concurrency must be between 1 and 10")
+	}
+	if c.Model != GPTAccountMonitorModel || c.ReasoningEffort != GPTAccountMonitorReasoningEffort {
+		return fmt.Errorf("gpt_account_monitor.model and reasoning_effort must use the fixed probe configuration")
+	}
+	if strings.TrimSpace(c.Prompt) == "" || len(c.Prompt) > 8192 {
+		return fmt.Errorf("gpt_account_monitor.prompt must contain 1 to 8192 bytes")
+	}
+	if c.ExpectedGeneration < 1 || c.ExpectedGeneration > 99 {
+		return fmt.Errorf("gpt_account_monitor.expected_generation must be between 1 and 99")
+	}
+	for _, id := range c.AccountIDs {
+		if id <= 0 {
+			return fmt.Errorf("gpt_account_monitor.account_ids must contain positive IDs")
+		}
+	}
+	return nil
+}
