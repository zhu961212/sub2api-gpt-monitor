+package service
+
+import (
+	"errors"
+	"io"
+	"net/http"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/tlsfingerprint"
+)
+
+// doGPTRecoveryRequest shares the normal OpenAI transport policy and connection
+// pool while keeping the probe on the exact account proxy that was validated.
+// Only protocol compatibility can fall back; proxy switching, direct routing,
+// redirects and gateway scheduling side effects are not part of this path.
+func (s *OpenAIGatewayService) doGPTRecoveryRequest(req *http.Request, account *Account) (*http.Response, error) {
+	if req == nil {
+		return nil, errors.New("无法构造取票请求")
+	}
+	if err := validateGPTRecoveryAccount(account); err != nil {
+		return nil, err
+	}
+	proxyURL, err := s.gptRecoveryBaseProxyURL(account)
+	if err != nil {
+		return nil, err
+	}
+	if sessionProxyURL, ok := req.Context().Value(gptRecoveryRequestProxyContextKey{}).(string); ok {
+		if _, err := validGPTRecoveryProxyURL(sessionProxyURL); err != nil {
+			return nil, err
+		}
+		proxyURL = sessionProxyURL
+	} else if _, err := gptRecoverySessionProxyURL(proxyURL, "none", "", 600); err != nil {
+		return nil, err
+	}
+	ctx := WithHTTPUpstreamProfile(req.Context(), HTTPUpstreamProfileOpenAI)
+	ctx = WithHTTPUpstreamRedirectsDisabled(ctx)
+	req = req.WithContext(ctx)
+	if s != nil && s.httpUpstream != nil {
+		var profile *tlsfingerprint.Profile
+		if s.gptRecoveryTLSProfiles != nil {
+			profile = s.gptRecoveryTLSProfiles.ResolveTLSProfile(account)
+		} else if account.IsTLSFingerprintEnabled() {
+			// Never silently use a different fingerprint when its configured
+			// resolver is unavailable. The production provider injects it.
+			return nil, gptRecoveryError("tls_profile_unavailable", "账号 TLS 指纹配置暂不可用")
+		}
+		return s.httpUpstream.DoWithTLS(req, proxyURL, account.ID, account.Concurrency, profile)
+	}
+
+	// Small isolated service fixtures may not provide the shared transport.
+	// Preserve the same proxy and redirect restrictions in that fallback.
+	if account.IsTLSFingerprintEnabled() {
+		return nil, gptRecoveryError("tls_profile_unavailable", "账号 TLS 指纹传输暂不可用")
+	}
+	client, transport, err := newGPTRecoveryClient(proxyURL)
+	if err != nil {
+		return nil, err
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		transport.CloseIdleConnections()
+		return resp, err
+	}
+	resp.Body = &gptRecoveryTransportBody{ReadCloser: resp.Body, transport: transport}
+	return resp, nil
+}
+
+type gptRecoveryTransportBody struct {
+	io.ReadCloser
+	transport *http.Transport
+}
+
+func (b *gptRecoveryTransportBody) Close() error {
+	err := b.ReadCloser.Close()
+	b.transport.CloseIdleConnections()
+	return err
+}
