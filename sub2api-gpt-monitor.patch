diff --git a/backend/internal/config/gpt_account_recovery.go b/backend/internal/config/gpt_account_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..b8df9e32294dcad2b3c20cfbc36e017c4bc42940
--- /dev/null
+++ b/backend/internal/config/gpt_account_recovery.go
@@ -0,0 +1,70 @@
+package config
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+const GPTAccountRecoveryModel = "gpt-6-astra"
+
+// Recovery validates protocol and routing metadata, never model intelligence.
+type GPTAccountRecoveryConfig struct {
+	Enabled          bool    `mapstructure:"enabled" json:"enabled"`
+	IntervalSeconds  int     `mapstructure:"interval_seconds" json:"interval_seconds"`
+	TimeoutSeconds   int     `mapstructure:"timeout_seconds" json:"timeout_seconds"`
+	MaxAttempts      int     `mapstructure:"max_attempts" json:"max_attempts"`
+	Gateway          string  `mapstructure:"gateway" json:"gateway"`
+	TicketLength     int     `mapstructure:"ticket_length" json:"ticket_length"`
+	TicketTTLSeconds int     `mapstructure:"ticket_ttl_seconds" json:"ticket_ttl_seconds"`
+	CookieTTLSeconds int     `mapstructure:"cookie_ttl_seconds" json:"cookie_ttl_seconds"`
+	Model            string  `mapstructure:"model" json:"model"`
+	AccountIDs       []int64 `mapstructure:"account_ids" json:"account_ids"`
+	RunOnStart       bool    `mapstructure:"run_on_start" json:"run_on_start"`
+}
+
+func DefaultGPTAccountRecoveryConfig() GPTAccountRecoveryConfig {
+	return GPTAccountRecoveryConfig{IntervalSeconds: 1800, TimeoutSeconds: 90, MaxAttempts: 6, Gateway: "any", TicketTTLSeconds: 240, CookieTTLSeconds: 3900, Model: GPTAccountRecoveryModel, AccountIDs: []int64{}, RunOnStart: true}
+}
+
+func (c *GPTAccountRecoveryConfig) Normalize() {
+	c.Model = GPTAccountRecoveryModel
+	c.Gateway = strings.ToLower(strings.TrimSpace(c.Gateway))
+}
+
+var gptRecoveryGatewayPattern = regexp.MustCompile(`^unified-[0-9]{1,6}$`)
+
+func (c GPTAccountRecoveryConfig) Validate() error {
+	for _, v := range []struct {
+		name            string
+		value, min, max int
+	}{
+		{"interval_seconds", c.IntervalSeconds, 60, 86400},
+		{"timeout_seconds", c.TimeoutSeconds, 10, 300},
+		{"max_attempts", c.MaxAttempts, 1, 20},
+		{"ticket_ttl_seconds", c.TicketTTLSeconds, 30, 600},
+		{"cookie_ttl_seconds", c.CookieTTLSeconds, 60, 7200},
+	} {
+		if v.value < v.min || v.value > v.max {
+			return fmt.Errorf("gpt_account_recovery.%s must be between %d and %d", v.name, v.min, v.max)
+		}
+	}
+	if c.TicketLength != 0 && (c.TicketLength < 64 || c.TicketLength > 8192) {
+		return fmt.Errorf("gpt_account_recovery.ticket_length must be 0 or between 64 and 8192")
+	}
+	if c.Gateway != "any" && !gptRecoveryGatewayPattern.MatchString(c.Gateway) {
+		return fmt.Errorf("gpt_account_recovery.gateway must be any or unified-N")
+	}
+	if c.Model != GPTAccountRecoveryModel {
+		return fmt.Errorf("gpt_account_recovery.model is fixed")
+	}
+	if len(c.AccountIDs) > 10000 {
+		return fmt.Errorf("too many recovery accounts")
+	}
+	for _, id := range c.AccountIDs {
+		if id <= 0 {
+			return fmt.Errorf("recovery account IDs must be positive")
+		}
+	}
+	return nil
+}
diff --git a/backend/internal/config/gpt_account_recovery_test.go b/backend/internal/config/gpt_account_recovery_test.go
