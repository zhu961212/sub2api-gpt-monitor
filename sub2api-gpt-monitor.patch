+func TestGPTAccountMonitorDisablesAndRecoversOnlyOAuth(t *testing.T) {
+	s, r, store := gptMonitorFixture()
+	r.accounts[3].Type = AccountTypeAPIKey
+	r.accounts[4].Status = StatusDisabled
+	parent := int64(1)
+	r.accounts[5].ParentAccountID = &parent
+	s.probe = func(_ context.Context, id int64, model, prompt string) (*Account, string, error) {
+		require.Equal(t, "gpt-6-astra", model)
+		require.Equal(t, config.DefaultGPTAccountMonitorPrompt, prompt)
+		switch id {
+		case 1:
+			return r.snapshot(1), "iPhone16", nil
+		case 2:
+			return r.snapshot(2), "iPhone17 Pro", nil
+		case 3:
+			return nil, "", errors.New("proxy/token secret must not be persisted")
+		}
+		t.Errorf("ineligible account probed: %d", id)
+		return nil, "", errors.New("unexpected")
+	}
+	interval := s.runCycle(context.Background())
+	require.InDelta(t, float64(5*time.Minute), float64(interval), float64(time.Second))
+	require.Empty(t, r.writes, "one valid sample cannot change account scheduling")
+	require.Equal(t, "abnormal", r.results[1].PendingVerdict)
+	require.Equal(t, "normal", r.results[2].PendingVerdict)
+	require.Equal(t, 1, r.results[1].Consecutive)
+	require.False(t, r.results[1].Changed)
+	gptMonitorAgeConfirmation(r, 1)
+	gptMonitorAgeConfirmation(r, 2)
+	store.next = time.Time{}
+	s.runCycle(context.Background())
+	require.Equal(t, map[int64]bool{1: false, 2: true}, r.writes)
+	require.Len(t, r.results, 3)
+	require.Equal(t, "error", r.results[3].Verdict)
+	require.NotContains(t, r.results[3].Message, "secret")
+	require.True(t, r.results[2].Changed)
+	require.True(t, r.results[2].Schedulable)
+	for _, result := range r.results {
+		require.Equal(t, "gpt-6-astra", result.Model)
+		require.Equal(t, "xhigh", result.ReasoningEffort)
+	}
+	require.True(t, store.released)
+}
+func TestGPTAccountMonitorSharedScheduleAndLease(t *testing.T) {
+	s, r, store := gptMonitorFixture()
+	calls := 0
+	s.cfg.Concurrency = 1
+	s.cfg.AccountIDs = []int64{2}
+	s.probe = func(_ context.Context, id int64, _, _ string) (*Account, string, error) {
+		calls++
+		return r.snapshot(id), "iPhone17", nil
+	}
+	store.acquired = false
+	s.runCycle(context.Background())
+	require.Zero(t, calls)
+	store.acquired = true
+	store.next = time.Now().Add(time.Hour)
+	s.runCycle(context.Background())
+	require.Zero(t, calls)
+	store.next = time.Time{}
+	s.runCycle(context.Background())
+	require.Equal(t, 1, calls)
+	require.Empty(t, r.writes, "first sample only schedules confirmation")
+	require.Equal(t, "normal", r.results[2].PendingVerdict)
+	s.runCycle(context.Background())
