--- /dev/null
+++ b/backend/internal/config/gpt_account_recovery_test.go
@@ -0,0 +1,23 @@
+package config
+
+import (
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestGPTRecoveryConfig(t *testing.T) {
+	c := DefaultGPTAccountRecoveryConfig()
+	require.NoError(t, c.Validate())
+	require.Zero(t, c.TicketLength)
+	c.Model = "old-model"
+	c.Gateway = " Unified-88 "
+	c.Normalize()
+	require.Equal(t, GPTAccountRecoveryModel, c.Model)
+	require.Equal(t, "unified-88", c.Gateway)
+	require.NoError(t, c.Validate())
+	for _, change := range []func(*GPTAccountRecoveryConfig){func(c *GPTAccountRecoveryConfig) { c.MaxAttempts = 0 }, func(c *GPTAccountRecoveryConfig) { c.MaxAttempts = 21 }, func(c *GPTAccountRecoveryConfig) { c.Gateway = "https://private-host" }, func(c *GPTAccountRecoveryConfig) { c.TicketLength = 12 }, func(c *GPTAccountRecoveryConfig) { c.TimeoutSeconds = 301 }, func(c *GPTAccountRecoveryConfig) { c.TicketTTLSeconds = 601 }, func(c *GPTAccountRecoveryConfig) { c.CookieTTLSeconds = 0 }, func(c *GPTAccountRecoveryConfig) { c.AccountIDs = []int64{-1} }} {
+		c := DefaultGPTAccountRecoveryConfig()
+		change(&c)
+		require.Error(t, c.Validate())
+	}
+}
diff --git a/backend/internal/handler/admin/gpt_account_recovery_handler.go b/backend/internal/handler/admin/gpt_account_recovery_handler.go
new file mode 100644
index 0000000000000000000000000000000000000000..dfef1d47335b44564d3faa96510fcc0903c057d7
--- /dev/null
+++ b/backend/internal/handler/admin/gpt_account_recovery_handler.go
@@ -0,0 +1,193 @@
+package admin
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+type gptAccountRecoveryService interface {
+	GetConfig(context.Context) (config.GPTAccountRecoveryConfig, error)
+	SaveConfig(context.Context, config.GPTAccountRecoveryConfig) (config.GPTAccountRecoveryConfig, error)
+	Status(context.Context) (service.GPTAccountRecoveryStatus, error)
+	RunNow(context.Context) (bool, error)
+	RunAccount(context.Context, int64) (bool, error)
+	AccountResult(context.Context, int64) (service.GPTAccountRecoveryStatusAccount, error)
+}
+
+// GPTAccountRecoveryHandler is registered only within the existing admin group.
+type GPTAccountRecoveryHandler struct {
+	monitor gptAccountRecoveryService
+}
+
+func NewGPTAccountRecoveryHandler(monitor *service.GPTAccountRecoveryService) *GPTAccountRecoveryHandler {
+	h := &GPTAccountRecoveryHandler{}
+	if monitor != nil {
+		h.monitor = monitor
+	}
+	return h
+}
+
+func (h *GPTAccountRecoveryHandler) ready(c *gin.Context) bool {
+	if h == nil || h.monitor == nil {
+		response.Error(c, http.StatusServiceUnavailable, "智商恢复服务暂不可用")
+		return false
+	}
+	return true
+}
+
+func (h *GPTAccountRecoveryHandler) GetConfig(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	cfg, err := h.monitor.GetConfig(c.Request.Context())
+	if err != nil {
+		response.InternalError(c, "读取智商恢复配置失败")
+		return
+	}
+	if cfg.AccountIDs == nil {
+		cfg.AccountIDs = []int64{}
+	}
+	response.Success(c, cfg)
+}
+
+// Mutable fields are required because this endpoint replaces the settings.
+// Model fields are optional compatibility inputs; their values are fixed below.
+// Pointer fields distinguish false/zero values from absent or null.
+type gptAccountRecoveryConfigRequest struct {
+	Enabled          *bool    `json:"enabled"`
+	IntervalSeconds  *int     `json:"interval_seconds"`
+	TimeoutSeconds   *int     `json:"timeout_seconds"`
+	MaxAttempts      *int     `json:"max_attempts"`
+	Gateway          *string  `json:"gateway"`
+	TicketLength     *int     `json:"ticket_length"`
+	TicketTTLSeconds *int     `json:"ticket_ttl_seconds"`
+	CookieTTLSeconds *int     `json:"cookie_ttl_seconds"`
+	Model            *string  `json:"model"`
+	AccountIDs       *[]int64 `json:"account_ids"`
+	RunOnStart       *bool    `json:"run_on_start"`
+}
+
+func (h *GPTAccountRecoveryHandler) SaveConfig(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	decoder := json.NewDecoder(http.MaxBytesReader(c.Writer, c.Request.Body, 32*1024))
+	decoder.DisallowUnknownFields()
+	var request gptAccountRecoveryConfigRequest
+	if err := decoder.Decode(&request); err != nil {
+		response.BadRequest(c, "配置必须是有效 JSON，且不能包含未知字段或超过 32 KB")
+		return
+	}
+	if err := decoder.Decode(&struct{}{}); err != io.EOF {
+		response.BadRequest(c, "配置只能包含一个 JSON 对象")
+		return
+	}
+	if request.Enabled == nil || request.IntervalSeconds == nil || request.TimeoutSeconds == nil || request.MaxAttempts == nil || request.Gateway == nil || request.TicketLength == nil || request.TicketTTLSeconds == nil || request.CookieTTLSeconds == nil || request.AccountIDs == nil || request.RunOnStart == nil {
+		response.BadRequest(c, "请提交完整的智商恢复配置")
+		return
+	}
+	cfg := config.GPTAccountRecoveryConfig{
+		Enabled: *request.Enabled, IntervalSeconds: *request.IntervalSeconds,
+		TimeoutSeconds: *request.TimeoutSeconds, MaxAttempts: *request.MaxAttempts,
+		Gateway: strings.TrimSpace(*request.Gateway), TicketLength: *request.TicketLength, TicketTTLSeconds: *request.TicketTTLSeconds, CookieTTLSeconds: *request.CookieTTLSeconds, AccountIDs: *request.AccountIDs,
+		RunOnStart: *request.RunOnStart,
+	}
+	cfg.Normalize()
+	if err := cfg.Validate(); err != nil {
+		response.BadRequest(c, "配置无效：间隔 60–86400 秒、超时 10–300 秒、尝试 1–20 次；目标网关为 any 或 unified-N，账号 ID 必须为正整数")
+		return
+	}
+	saved, err := h.monitor.SaveConfig(c.Request.Context(), cfg)
+	if err != nil {
+		response.InternalError(c, "保存智商恢复配置失败")
+		return
+	}
+	if saved.AccountIDs == nil {
+		saved.AccountIDs = []int64{}
+	}
+	response.Success(c, saved)
+}
+
+func (h *GPTAccountRecoveryHandler) Status(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	status, err := h.monitor.Status(c.Request.Context())
+	if err != nil {
+		response.InternalError(c, "读取智商恢复状态失败")
+		return
+	}
+	response.Success(c, status)
+}
+
+func (h *GPTAccountRecoveryHandler) RunNow(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	queued, err := h.monitor.RunNow(c.Request.Context())
+	if err != nil {
+		response.Error(c, http.StatusServiceUnavailable, "暂时无法启动恢复并稍后重试")
+		return
+	}
+	message := "恢复已在运行或已排队"
+	if queued {
+		message = "已提交立即恢复任务"
+	}
+	response.Success(c, gin.H{"queued": queued, "message": message})
+}
+
+func (h *GPTAccountRecoveryHandler) RunAccount(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	accountID, err := strconv.ParseInt(c.Param("id"), 10, 64)
+	if err != nil || accountID <= 0 {
+		response.BadRequest(c, "账号 ID 必须是有效的正整数")
+		return
+	}
+	queued, err := h.monitor.RunAccount(c.Request.Context(), accountID)
+	if err != nil {
+		if infraerrors.Code(err) < http.StatusInternalServerError {
+			response.ErrorFrom(c, err)
+		} else {
+			response.Error(c, http.StatusServiceUnavailable, "暂时无法启动智商恢复，请稍后重试")
+		}
+		return
+	}
+	message := "恢复已在运行或已排队"
+	if queued {
+		message = "已提交智商恢复任务"
+	}
+	response.Success(c, gin.H{"queued": queued, "message": message})
+}
+
+func (h *GPTAccountRecoveryHandler) AccountResult(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	accountID, err := strconv.ParseInt(c.Param("id"), 10, 64)
+	if err != nil || accountID <= 0 {
+		response.BadRequest(c, "账号 ID 必须是有效的正整数")
+		return
+	}
+	result, err := h.monitor.AccountResult(c.Request.Context(), accountID)
+	if err != nil {
+		if infraerrors.Code(err) < http.StatusInternalServerError {
+			response.ErrorFrom(c, err)
+		} else {
+			response.Error(c, http.StatusServiceUnavailable, "暂时无法读取智商恢复结果，请稍后重试")
+		}
+		return
+	}
+	response.Success(c, result)
+}
