+func gptRecoveryMintTestResponse(now time.Time) *http.Response {
+	header := make(http.Header)
+	header.Set("Content-Type", "application/octet-stream")
+	header.Set("X-Codex-Turn-State", gptRecoveryMintTestState(now, 33))
+	header.Add("Set-Cookie", "__cflb=route; Expires="+now.Add(time.Hour).UTC().Format(http.TimeFormat))
+	header.Add("Set-Cookie", "__oailb="+gptRecoveryMintTestOAILB("unified-88", now.Add(3900*time.Second))+"; Max-Age=3600")
+	header.Add("Set-Cookie", "__cf_bm=DO_NOT_FORWARD; Max-Age=3600")
+	return &http.Response{StatusCode: http.StatusOK, Header: header, Body: io.NopCloser(strings.NewReader(gptRecoveryMintTestCreated(config.GPTAccountRecoveryModel)))}
