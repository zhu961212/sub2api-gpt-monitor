+func TestGPTRecoveryRoutingWSPreferredContinuationSurvivesExpiredOrReplacedTicket(t *testing.T) {
+	for _, forcePreferred := range []bool{false, true} {
+		t.Run(fmt.Sprintf("force_preferred_%t", forcePreferred), func(t *testing.T) {
+			s, account, store := recoveryRoutingFixture()
+			account.Extra = map[string]any{codexFingerprintModeExtraKey: "session", codexFingerprintSeedExtraKey: "11111111-1111-4111-8111-111111111111"}
