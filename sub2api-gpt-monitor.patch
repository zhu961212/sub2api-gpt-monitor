+func TestGPTRecoveryMintSeedFailureRetriesBareWithNewSession(t *testing.T) {
+	cfg := config.DefaultGPTAccountRecoveryConfig()
+	cfg.MaxAttempts = 2
+	now := time.Now()
+	seed := &GPTAccountRecoveryTicket{Model: config.GPTAccountRecoveryModel, CFLB: "seed-route", OAILB: gptRecoveryMintTestOAILB("unified-88", now.Add(time.Hour)), Gateway: "unified-88", CookieExpiresAt: now.Add(time.Hour)}
+	calls := 0
+	var sessions []string
+	var firstAt time.Time
+	do := func(req *http.Request) (*http.Response, error) {
+		calls++
+		sessions = append(sessions, req.Header.Get("Session-Id"))
+		if calls == 1 {
+			require.Contains(t, req.Header.Get("Cookie"), "seed-route")
+			firstAt = time.Now()
+			r := gptRecoveryMintTestResponse(now)
+			r.Body = io.NopCloser(strings.NewReader(gptRecoveryMintTestCreated("gpt-5.6-luna")))
+			return r, nil
+		}
+		require.Empty(t, req.Header.Get("Cookie"))
+		require.GreaterOrEqual(t, time.Since(firstAt), time.Second)
+		return gptRecoveryMintTestResponse(time.Now()), nil
+	}
+	ticket, err := gptRecoveryMintWithDo(context.Background(), do, gptRecoveryMintTestAccount(), "secret-token", "", cfg, seed)
+	require.NoError(t, err)
+	require.Equal(t, 2, ticket.Attempts)
+	require.NotEqual(t, sessions[0], sessions[1])
+}
