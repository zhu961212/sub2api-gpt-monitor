+		{"rate limit", gptMonitorHTTPError(429, strings.NewReader(`{"error":{"code":"rate_limit_exceeded","message":"SECRET-proxy"}}`)), "rate_limited", 429, "HTTP 429"},
+		{"model unavailable", gptMonitorHTTPError(400, strings.NewReader(`{"error":{"code":"model_not_found","message":"SECRET"}}`)), "model_unavailable", 400, "模型"},
+		{"timeout", gptMonitorTransportError(context.DeadlineExceeded), "timeout", 0, "10 秒"},
+		{"stream incomplete", gptMonitorError("incomplete_response", "上游响应中断，未收到完整回答"), "incomplete_response", 0, "未收到完整回答"},
+		{"unknown", errors.New("SECRET proxy password"), "unknown_error", 0, "原因未知"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			for _, enabled := range []bool{false, true} {
+				s, repo, _ := gptMonitorFixture()
