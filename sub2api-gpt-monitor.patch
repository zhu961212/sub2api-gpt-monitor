index 0000000000000000000000000000000000000000..d86989966039eb748cb3c3f490640c4b92decc9f
--- /dev/null
+++ b/frontend/src/composables/useGPTAccountMonitorTest.ts
@@ -0,0 +1,120 @@
+import { computed, onUnmounted, ref } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { adminAPI } from '@/api/admin'
+import type { GPTAccountMonitorResult } from '@/api/admin/gptAccountMonitor'
+import { useAppStore } from '@/stores'
+import { useStepUp, isStepUpBlocked, isStepUpCancelled, stepUpBlockReason } from '@/composables/useStepUp'
+
+export function useGPTAccountMonitorTest() {
+  const { t } = useI18n()
+  const appStore = useAppStore()
+  const stepUp = useStepUp()
+  const submitting = ref(false)
+  const occupied = ref(false)
+  const busy = computed(() => submitting.value || occupied.value)
+  const visible = ref(false)
+  const accountID = ref<number | null>(null)
+  const result = ref<GPTAccountMonitorResult | null>(null)
+  const queryError = ref('')
+  const queryPaused = ref(false)
+  const controllers = new Set<AbortController>()
+  let stopped = false
+  let pollTimer: ReturnType<typeof setTimeout> | undefined
+  let baselineCheckedAt: string | null = null
+  let queryDeadline = 0
+  let queryGeneration = 0
+  let queryController: AbortController | undefined
+  const queryWindow = 16 * 60 * 1000
+  const errorMessage = (error: unknown) => error && typeof error === 'object' && 'message' in error ? String(error.message) : t('common.unknownError')
+
+  async function queryResult() {
+    if (stopped || accountID.value === null || !occupied.value) return
+    if (Date.now() >= queryDeadline) { queryPaused.value = true; return }
+    const generation = queryGeneration
+    const targetAccountID = accountID.value
+    const controller = new AbortController()
+    queryController = controller
+    controllers.add(controller)
+    try {
+      const latest = await adminAPI.gptAccountMonitor.getAccountResult(targetAccountID, controller.signal)
+      if (stopped || controller.signal.aborted || generation !== queryGeneration) return
+      queryError.value = ''
+      const checkedAt = latest.checked_at
+      const checkedTime = checkedAt ? Date.parse(checkedAt) : NaN
+      const baselineTime = baselineCheckedAt ? Date.parse(baselineCheckedAt) : NaN
+      if (latest.account_id === accountID.value && (latest.manual_attempts || 0) >= 1 && checkedAt && !checkedAt.startsWith('0001-') && Number.isFinite(checkedTime) && checkedAt !== baselineCheckedAt && (!Number.isFinite(baselineTime) || checkedTime > baselineTime)) {
+        result.value = latest
+        occupied.value = latest.manual_requested === true || latest.manual_running === true
+        queryPaused.value = false
+      }
+    } catch (error) {
+      if (!stopped && !controller.signal.aborted && generation === queryGeneration) queryError.value = errorMessage(error)
+    } finally {
+      controllers.delete(controller)
+      if (queryController === controller) queryController = undefined
+      if (!stopped && !controller.signal.aborted && generation === queryGeneration && occupied.value) pollTimer = setTimeout(() => { void queryResult() }, 5000)
+    }
+  }
+  function resumeQuery() {
+    if (stopped || !occupied.value || !queryPaused.value) return
+    queryPaused.value = false
+    queryDeadline = Date.now() + queryWindow
+    void queryResult()
+  }
+  function stopQuery() {
+    if (stopped || submitting.value) return
+    queryGeneration++
+    clearTimeout(pollTimer)
+    queryController?.abort()
+    queryController = undefined
+    occupied.value = false
+    queryPaused.value = false
+    queryError.value = ''
+    visible.value = false
+    accountID.value = null
+    result.value = null
+  }
+
+  async function runAccount(targetAccountID: number) {
+    if (stopped || busy.value) return
+    queryGeneration++
+    submitting.value = true
+    const controller = new AbortController()
+    controllers.add(controller)
+    try {
+      const baseline = await adminAPI.gptAccountMonitor.getAccountResult(targetAccountID, controller.signal)
+      if (stopped) return
+      const accepted = await stepUp.run(() => adminAPI.gptAccountMonitor.runAccount(targetAccountID, controller.signal))
+      if (stopped) return
+      if (accepted.queued) {
+        baselineCheckedAt = baseline.checked_at
+        accountID.value = targetAccountID
+        result.value = null
+        queryError.value = ''
+        queryPaused.value = false
+        occupied.value = true
+        visible.value = true
+        queryDeadline = Date.now() + queryWindow
+        appStore.showSuccess(t('admin.gptAccountMonitor.accountQueued', { id: targetAccountID }))
+        pollTimer = setTimeout(() => { void queryResult() }, 5000)
+      } else appStore.showInfo(accepted.message || t('admin.gptAccountMonitor.queueBusy'))
+    } catch (error) {
+      if (!stopped && !isStepUpCancelled(error)) {
+        appStore.showError(isStepUpBlocked(error) ? t(stepUpBlockReason(error) === 'STEP_UP_ADMIN_API_KEY_FORBIDDEN' ? 'stepUp.adminApiKeyForbidden' : 'stepUp.notEnabled') : errorMessage(error))
+      }
+    } finally {
+      controllers.delete(controller)
+      submitting.value = false
+    }
+  }
+
+  onUnmounted(() => {
+    stopped = true
+    clearTimeout(pollTimer)
+    for (const controller of controllers) controller.abort()
+    controllers.clear()
+    stepUp.onCancel()
+  })
+
+  return { busy, runAccount, stepUp, visible, accountID, result, queryError, queryPaused, resumeQuery, stopQuery }
+}
