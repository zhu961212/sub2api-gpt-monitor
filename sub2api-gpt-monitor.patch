+	connectionID := first.ConnID()
+	first.Release()
+	cancelFirst()
+	require.NoError(t, store.SaveTicket(context.Background(), identity, recoveryProxyObserverTicket("bbbbbbbb"), time.Hour))
+	request.Headers.Set(openAIWSTurnStateHeader, "first-business-turn")
+	request.PreferredConnID, request.ForcePreferredConn = connectionID, true
+	second, err := pool.Acquire(context.Background(), request)
+	require.NoError(t, err)
+	defer second.Release()
+	require.True(t, second.Reused())
+	require.Equal(t, connectionID, second.ConnID())
+	require.Equal(t, "second-business-turn", second.observeGPTRecoveryWSMetadata(context.Background(), recoveryBusinessMetadata("second-business-turn"), "codex.response.metadata"))
+	bound, err := store.LoadTicket(context.Background(), gptRecoveryTurnRoutingKey(identity, "second-business-turn"))
+	require.NoError(t, err)
+	require.NotNil(t, bound)
+	require.Equal(t, original.ProxySession, bound.ProxySession)
+}
+
+func TestGPTRecoveryBusinessWSMetadataOnlyReconnectKeepsSession(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, entry := range []string{"http", OpenAIWSIngressModeCtxPool, OpenAIWSIngressModePassthrough} {
+		t.Run(entry, func(t *testing.T) {
+			t.Setenv(gptRecoveryProxyURLEnv, "http://fixture-user:fixture-password-US@proxy.example:1000")
+			s, account, store := recoveryRoutingFixture()
+			cfg := s.cfg
+			cfg.Gateway.OpenAIWS.Enabled, cfg.Gateway.OpenAIWS.OAuthEnabled = true, true
+			cfg.Gateway.OpenAIWS.ResponsesWebsocketsV2, cfg.Gateway.OpenAIWS.ModeRouterV2Enabled = true, true
+			cfg.Gateway.OpenAIWS.IngressModeDefault = OpenAIWSIngressModeCtxPool
+			cfg.Gateway.OpenAIWS.MaxConnsPerAccount, cfg.Gateway.OpenAIWS.MaxIdlePerAccount = 1, 1
+			cfg.Gateway.OpenAIWS.DialTimeoutSeconds, cfg.Gateway.OpenAIWS.ReadTimeoutSeconds, cfg.Gateway.OpenAIWS.WriteTimeoutSeconds = 3, 3, 3
+			account.Concurrency, account.Schedulable = 1, true
+			account.Extra = map[string]any{"openai_oauth_responses_websockets_v2_mode": entry}
+			recoveryConfig := config.DefaultGPTAccountRecoveryConfig()
+			recoveryConfig.ProxySessionMode = config.GPTRecoveryProxySessionKookeey
+			s.setGPTRecoveryProxyConfig(recoveryConfig)
+			s.cache = &stubGatewayCache{}
+			s.toolCorrector = NewCodexToolCorrector()
+			s.openaiWSResolver = NewOpenAIWSProtocolResolver(cfg)
+			pool := newOpenAIWSConnPool(cfg)
+			defer pool.Close()
+			s.openaiWSPool = pool
+			identity := s.gptRecoveryRoutingIdentityKey(account)
+			original := recoveryProxyObserverTicket("aaaaaaaa")
+			require.NoError(t, store.SaveTicket(context.Background(), identity, original, time.Hour))
+			wantProxy, err := s.gptRecoveryTicketProxyURL(account, original)
+			require.NoError(t, err)
+			dialer := &recoveryMetadataBusinessDialer{onDial: func() {
+				// The new global ticket has the same cookies and another session.
+				// Metadata must retain this physical connection's original route.
+				require.NoError(t, store.SaveTicket(context.Background(), identity, recoveryProxyObserverTicket("bbbbbbbb"), time.Hour))
+			}}
+			pool.setClientDialerForTest(dialer)
+			s.openaiWSPassthroughDialer = dialer
+			for turn := 1; turn <= 2; turn++ {
+				state := ""
+				if turn > 1 {
+					pool.ClearAccount(account.ID)
+					state = "business-turn-1"
+				}
+				if entry == "http" {
+					rec := httptest.NewRecorder()
+					c, _ := gin.CreateTestContext(rec)
+					c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+					c.Request.Header.Set(openAIWSTurnStateHeader, state)
+					result, err := s.forwardOpenAIWSV2(context.Background(), c, account, map[string]any{"model": "gpt-6-astra", "input": "hi"}, "metadata-session", "metadata-scope", account.GetOpenAIAccessToken(), OpenAIWSProtocolDecision{Transport: OpenAIUpstreamTransportResponsesWebsocketV2}, true, true, "gpt-6-astra", "gpt-6-astra", time.Now(), 0, "", nil)
+					require.NoError(t, err)
+					require.NotNil(t, result)
+					require.Contains(t, rec.Body.String(), "codex.response.metadata", "existing metadata forwarding must remain intact")
+					require.NotContains(t, rec.Body.String(), "fixture-password")
+					savedState, ok := s.getOpenAIWSStateStore().GetSessionTurnState(0, "metadata-scope")
