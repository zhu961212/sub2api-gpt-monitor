+)
+
+func TestGPTRecoverySessionProxyURL(t *testing.T) {
+	for _, tc := range []struct{ name, base, mode, session, username, password string }{
+		{"kookeey", "http://user:test-password-US@gate.example:1000", "kookeey", "a1b2c3d4", "user", "test-password-US-a1b2c3d4"},
+		{"kookeey region", "socks5://user:test-password-US_California_city_LosAngeles@gate.example:1000", "kookeey", "a1b2c3d4", "user", "test-password-US_California_city_LosAngeles-a1b2c3d4"},
+		{"kookeey global", "http://user:test-password-global@gate.example:1000", "kookeey", "a1b2c3d4", "user", "test-password-global-a1b2c3d4"},
+		{"username sid", "http://user-sid-old-country-us:secret@gate.example:1000", "username_sid", "newsession", "user-sid-newsession-country-us", "secret"},
+		{"template username", "http://user-{session}:secret@gate.example:1000", "template", "session123", "user-session123", "secret"},
+		{"template password", "http://user:secret-US-{session}@gate.example:1000", "template", "session123", "user", "secret-US-session123"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			raw, err := gptRecoverySessionProxyURL(tc.base, tc.mode, tc.session, 600)
+			require.NoError(t, err)
+			u, err := url.Parse(raw)
+			require.NoError(t, err)
+			require.Equal(t, tc.username, u.User.Username())
+			password, _ := u.User.Password()
+			require.Equal(t, tc.password, password)
+			require.Equal(t, "gate.example:1000", u.Host)
+		})
+	}
+	for _, tc := range []struct{ base, mode, session string }{
+		{"http://user:secret-US-oldsession@gate.example:1000", "kookeey", "a1b2c3d4"},
+		{"http://user:secret-US-oldsession-5m@gate.example:1000", "kookeey", "a1b2c3d4"},
+		{"http://user:secret-US@gate.example:1000", "kookeey", "too-long-session"},
+		{"http://user:secret@gate.example:1000", "username_sid", "session123"},
+		{"http://user:secret@{session}.example:1000", "template", "session123"},
+		{"http://user:secret@gate.example:1000", "template", "session123"},
+		{"http://user:{session}@gate.example:1000", "none", ""},
+		{"http://user:secret@gate.example:1000", "template", "bad@session"},
+	} {
+		_, err := gptRecoverySessionProxyURL(tc.base, tc.mode, tc.session, 600)
+		require.Error(t, err)
+		require.NotContains(t, err.Error(), "secret")
+	}
+}
+
+func TestGPTRecoveryProxyOverrideAndIdentity(t *testing.T) {
+	s, account, _ := recoveryRoutingFixture()
+	original := s.gptRecoveryProxyIdentityDigest(account)
+	t.Setenv(gptRecoveryProxyURLEnv, "http://user:secret-US@gate.example:1000")
+	require.NoError(t, validateGPTRecoveryAccount(gptRecoveryMintTestAccount()))
+	base, err := s.gptRecoveryBaseProxyURL(nil)
+	require.NoError(t, err)
+	require.Equal(t, "http://user:secret-US@gate.example:1000", base)
+	require.NotEqual(t, original, s.gptRecoveryProxyIdentityDigest(account))
+	changed := s.gptRecoveryProxyIdentityDigest(account)
+	c := config.DefaultGPTAccountRecoveryConfig()
+	c.ProxySessionMode = "kookeey"
+	s.setGPTRecoveryProxyConfig(c)
+	require.NotEqual(t, changed, s.gptRecoveryProxyIdentityDigest(account))
+	t.Setenv(gptRecoveryProxyURLEnv, "")
+	_, err = s.gptRecoveryBaseProxyURL(account)
+	require.Error(t, err)
+	t.Setenv(gptRecoveryProxyURLEnv, "http://user:secret@gate.example:1000/bad")
+	_, err = s.gptRecoveryBaseProxyURL(account)
+	require.Error(t, err)
+	require.NotContains(t, err.Error(), "secret")
+}
+
+func TestGPTRecoveryDynamicMintRotatesAndPinsSession(t *testing.T) {
+	t.Setenv(gptRecoveryProxyURLEnv, "http://user:secret-US@gate.example:1000")
+	c := config.DefaultGPTAccountRecoveryConfig()
+	c.ProxySessionMode, c.ProxySessionTTLSeconds, c.MaxAttempts = "kookeey", 60, 2
+	var proxies []string
+	do := func(req *http.Request) (*http.Response, error) {
+		proxies = append(proxies, req.Context().Value(gptRecoveryRequestProxyContextKey{}).(string))
+		if len(proxies) == 1 {
+			return nil, errors.New("network failure")
+		}
+		return gptRecoveryMintTestResponse(time.Now()), nil
+	}
+	ticket, err := gptRecoveryMintWithDo(context.Background(), do, gptRecoveryMintTestAccount(), "token", "", c, nil)
+	require.NoError(t, err)
+	require.Len(t, proxies, 2)
+	require.NotEqual(t, proxies[0], proxies[1])
+	require.Len(t, ticket.ProxySession, 8)
+	require.Equal(t, "kookeey", ticket.ProxySessionMode)
+	require.Equal(t, ticket.ProxyExpiresAt, ticket.ExpiresAt)
+	require.Equal(t, ticket.ProxyExpiresAt, ticket.CookieExpiresAt)
+	require.WithinDuration(t, time.Now().Add(time.Minute), ticket.ProxyExpiresAt, 3*time.Second)
+	s := &OpenAIGatewayService{}
+	s.setGPTRecoveryProxyConfig(c)
+	pinned, err := s.gptRecoveryTicketProxyURL(gptRecoveryMintTestAccount(), ticket)
+	require.NoError(t, err)
+	require.Equal(t, proxies[1], pinned)
+	raw, err := json.Marshal(ticket)
+	require.NoError(t, err)
+	require.NotContains(t, string(raw), "secret")
+	require.NotContains(t, string(raw), "gate.example")
+	seedProxy := pinned
+	do = func(req *http.Request) (*http.Response, error) {
+		require.Equal(t, seedProxy, req.Context().Value(gptRecoveryRequestProxyContextKey{}))
+		require.True(t, strings.Contains(req.Header.Get("Cookie"), "__cflb="))
+		return gptRecoveryMintTestResponse(time.Now()), nil
+	}
+	seeded, err := gptRecoveryMintWithDo(context.Background(), do, gptRecoveryMintTestAccount(), "token", "", c, ticket)
+	require.NoError(t, err)
+	require.Equal(t, ticket.ProxySession, seeded.ProxySession)
+	require.Equal(t, ticket.ProxyExpiresAt, seeded.ProxyExpiresAt)
+	seeded.ProxyExpiresAt = time.Now().Add(-time.Second)
+	_, err = s.gptRecoveryTicketProxyURL(gptRecoveryMintTestAccount(), seeded)
+	require.Error(t, err)
+}
+
+func TestGPTRecoveryOverrideSupportsAccountWithoutBoundProxy(t *testing.T) {
+	t.Setenv(gptRecoveryProxyURLEnv, "http://user:secret-US@gate.example:1000")
+	s, account, repo, store := recoveryServiceFixture()
