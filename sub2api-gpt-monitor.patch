+import { defineComponent } from 'vue'
+import { enableAutoUnmount, flushPromises, mount } from '@vue/test-utils'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { GPTAccountMonitorResult } from '@/api/admin/gptAccountMonitor'
+
+const { runAccount, getAccountResult, showSuccess, showError, showInfo, stepUpRun, onCancel } = vi.hoisted(() => ({
+  runAccount: vi.fn(), getAccountResult: vi.fn(), showSuccess: vi.fn(), showError: vi.fn(), showInfo: vi.fn(),
+  stepUpRun: vi.fn((action: () => Promise<unknown>) => action()), onCancel: vi.fn(),
+}))
+vi.mock('@/api/admin', () => ({ adminAPI: { gptAccountMonitor: { runAccount, getAccountResult } } }))
+vi.mock('@/stores', () => ({ useAppStore: () => ({ showSuccess, showError, showInfo }) }))
+vi.mock('vue-i18n', () => ({ useI18n: () => ({ t: (key: string) => key }) }))
+vi.mock('@/composables/useStepUp', () => ({
+  useStepUp: () => ({ run: stepUpRun, onCancel }), isStepUpCancelled: () => false, isStepUpBlocked: () => false, stepUpBlockReason: () => '',
+}))
+import { useGPTAccountMonitorTest } from '../useGPTAccountMonitorTest'
+
+enableAutoUnmount(afterEach)
+const baseline: GPTAccountMonitorResult = { account_id: 42, checked_at: '2026-10-13T06:00:00Z', name: 'Account', verdict: 'normal', answer: 'Old answer', message: 'old result', model: 'gpt-6-astra', expected_generation: 17, schedulable: true, changed: false }
+const completed: GPTAccountMonitorResult = { ...baseline, checked_at: '2026-10-13T06:05:00Z', answer: 'New answer', manual_attempts: 1, manual_requested: false, manual_running: false }
+function mountTest() {
+  let controller!: ReturnType<typeof useGPTAccountMonitorTest>
+  const wrapper = mount(defineComponent({ setup() { controller = useGPTAccountMonitorTest(); return () => null } }))
+  return { wrapper, controller }
+}
+beforeEach(() => {
+  vi.clearAllMocks()
+  vi.useFakeTimers()
+  runAccount.mockResolvedValue({ queued: true, message: 'queued' })
+  getAccountResult.mockResolvedValue(baseline)
+  stepUpRun.mockImplementation((action: () => Promise<unknown>) => action())
+})
+afterEach(() => vi.useRealTimers())
+
+describe('account menu GPT checks', () => {
+  it('uses step-up for the single account even with automatic checks disabled', async () => {
+    const { controller } = mountTest()
+    await controller.runAccount(42)
+    expect(runAccount).toHaveBeenCalledWith(42, expect.any(AbortSignal))
+    expect(stepUpRun).toHaveBeenCalledTimes(1)
+    expect(showSuccess).toHaveBeenCalledWith('admin.gptAccountMonitor.accountQueued')
