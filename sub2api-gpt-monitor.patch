index 0000000000000000000000000000000000000000..26bb50c3a1228f82dafa545c0b0698ba6f6ebb68
--- /dev/null
+++ b/backend/internal/repository/account_repo_gpt_recovery_result.go
@@ -0,0 +1,33 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+)
+
+// UpdateGPTRecoveryResult saves display-only observations without rebuilding
+// scheduler buckets or loading a credential-bearing account snapshot. Leaving
+// updated_at unchanged also prevents observations from invalidating an in-flight
+// scheduling CAS; actual scheduling changes still update it and the outbox.
+func (r *accountRepository) UpdateGPTRecoveryResult(ctx context.Context, id int64, result service.GPTAccountRecoveryResult) error {
+	payload, err := json.Marshal(map[string]any{"gpt_account_recovery": result})
+	if err != nil {
+		return err
+	}
+	res, err := clientFromContext(ctx, r.client).ExecContext(ctx,
+		"UPDATE accounts SET extra = (COALESCE(extra, '{}'::jsonb) - 'gpt_account_monitor') || $1::jsonb WHERE id = $2 AND deleted_at IS NULL",
+		string(payload), id)
+	if err != nil {
+		return err
+	}
+	affected, err := res.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if affected == 0 {
+		return service.ErrAccountNotFound
+	}
+	return nil
+}
diff --git a/backend/internal/repository/gpt_account_recovery_store.go b/backend/internal/repository/gpt_account_recovery_store.go
new file mode 100644
index 0000000000000000000000000000000000000000..439e30d2c23003ea11e1fa753d276aafc839b163
--- /dev/null
+++ b/backend/internal/repository/gpt_account_recovery_store.go
@@ -0,0 +1,211 @@
+package repository
+
+import (
+	"context"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/redis/go-redis/v9"
+)
+
+func recoveryTicketKey(key string) (string, error) {
+	if len(key) != 64 {
+		return "", errors.New("invalid recovery identity")
+	}
+	if _, err := hex.DecodeString(key); err != nil {
+		return "", errors.New("invalid recovery identity")
+	}
+	return gptAccountRecoveryKeyPrefix + ":ticket:" + key, nil
+}
+func (s *gptAccountRecoveryStore) LoadTicket(ctx context.Context, key string) (*service.GPTAccountRecoveryTicket, error) {
+	cacheKey, err := recoveryTicketKey(key)
+	if err != nil {
+		return nil, err
+	}
+	if s == nil || s.rdb == nil {
+		return nil, errors.New("recovery cache unavailable")
+	}
+	raw, err := s.rdb.Get(ctx, cacheKey).Bytes()
+	if errors.Is(err, redis.Nil) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if len(raw) > 32768 {
+		return nil, errors.New("invalid recovery cache payload")
+	}
+	var ticket service.GPTAccountRecoveryTicket
+	if json.Unmarshal(raw, &ticket) != nil {
+		return nil, errors.New("invalid recovery cache payload")
+	}
+	if !ticket.CookieExpiresAt.After(time.Now()) {
+		return nil, nil
+	}
+	return &ticket, nil
+}
+func (s *gptAccountRecoveryStore) SaveTicket(ctx context.Context, key string, ticket *service.GPTAccountRecoveryTicket, ttl time.Duration) error {
+	cacheKey, err := recoveryTicketKey(key)
+	if err != nil {
+		return err
+	}
+	if s == nil || s.rdb == nil {
+		return errors.New("recovery cache unavailable")
+	}
+	if ticket == nil || ttl <= 0 || !ticket.CookieExpiresAt.After(time.Now()) {
+		return errors.New("expired recovery ticket")
+	}
+	remaining := time.Until(ticket.CookieExpiresAt)
+	if ttl > remaining {
+		ttl = remaining
+	}
+	if ttl > 2*time.Hour {
+		ttl = 2 * time.Hour
+	}
+	raw, err := json.Marshal(ticket)
+	if err != nil {
+		return err
+	}
+	if len(raw) > 32768 {
+		return errors.New("recovery ticket too large")
+	}
+	return s.rdb.Set(ctx, cacheKey, raw, ttl).Err()
+}
+func (s *gptAccountRecoveryStore) DeleteTicket(ctx context.Context, key string) error {
+	cacheKey, err := recoveryTicketKey(key)
+	if err != nil {
+		return err
+	}
+	if s == nil || s.rdb == nil {
+		return errors.New("recovery cache unavailable")
+	}
+	return s.rdb.Del(ctx, cacheKey).Err()
+}
+
+const (
+	gptAccountRecoveryKeyPrefix       = "sub2api:gpt-account-recovery:v1"
+	gptAccountRecoveryLeaseKey        = gptAccountRecoveryKeyPrefix + ":lease"
+	gptAccountRecoveryNextRunTTL      = 7 * 24 * time.Hour
+	gptAccountRecoveryMinimumLeaseTTL = 5 * time.Second
+)
+
+var gptAccountRecoveryRenewScript = redis.NewScript(`
+if redis.call("GET", KEYS[1]) == ARGV[1] and redis.call("PTTL", KEYS[1]) > 0 then
+  return redis.call("PEXPIRE", KEYS[1], ARGV[2])
+end
+return 0
+`)
+
+var gptAccountRecoveryReleaseScript = redis.NewScript(`
+if redis.call("GET", KEYS[1]) == ARGV[1] then
+  return redis.call("DEL", KEYS[1])
+end
+return 0
+`)
+
+// Read the owner and remaining lifetime atomically. A lease with no expiry is
+// invalid; a lease near expiry does not authorize a scheduling change.
+var gptAccountRecoveryOwnsScript = redis.NewScript(`
+if redis.call("GET", KEYS[1]) == ARGV[1] and redis.call("PTTL", KEYS[1]) > tonumber(ARGV[2]) then
+  return 1
+end
+return 0
+`)
+
+type gptAccountRecoveryStore struct {
+	rdb *redis.Client
+}
+
+func NewGPTAccountRecoveryStore(redisClient *redis.Client) service.GPTAccountRecoveryStore {
+	return &gptAccountRecoveryStore{rdb: redisClient}
+}
+
+func (s *gptAccountRecoveryStore) checkOwner(owner string) error {
+	if s == nil || s.rdb == nil {
+		return errors.New("GPT account recovery Redis is unavailable")
+	}
+	if strings.TrimSpace(owner) == "" {
+		return errors.New("GPT account recovery lease owner is empty")
+	}
+	return nil
+}
+
+func (s *gptAccountRecoveryStore) Acquire(ctx context.Context, owner string, ttl time.Duration) (bool, error) {
+	if err := s.checkOwner(owner); err != nil {
+		return false, err
+	}
+	if ttl <= gptAccountRecoveryMinimumLeaseTTL {
+		return false, errors.New("GPT account recovery lease TTL must exceed five seconds")
+	}
+	return s.rdb.SetNX(ctx, gptAccountRecoveryLeaseKey, owner, ttl).Result()
+}
+
+func (s *gptAccountRecoveryStore) Renew(ctx context.Context, owner string, ttl time.Duration) (bool, error) {
+	if err := s.checkOwner(owner); err != nil {
+		return false, err
+	}
+	if ttl <= gptAccountRecoveryMinimumLeaseTTL {
+		return false, errors.New("GPT account recovery lease TTL must exceed five seconds")
+	}
+	result, err := gptAccountRecoveryRenewScript.Run(ctx, s.rdb, []string{gptAccountRecoveryLeaseKey}, owner, ttl.Milliseconds()).Int64()
+	return result == 1, err
+}
+
+func (s *gptAccountRecoveryStore) Owns(ctx context.Context, owner string) (bool, error) {
+	if err := s.checkOwner(owner); err != nil {
+		return false, err
+	}
+	result, err := gptAccountRecoveryOwnsScript.Run(ctx, s.rdb, []string{gptAccountRecoveryLeaseKey}, owner, gptAccountRecoveryMinimumLeaseTTL.Milliseconds()).Int64()
+	return result == 1, err
+}
+
+func (s *gptAccountRecoveryStore) Release(ctx context.Context, owner string) error {
+	if err := s.checkOwner(owner); err != nil {
+		return err
+	}
+	return gptAccountRecoveryReleaseScript.Run(ctx, s.rdb, []string{gptAccountRecoveryLeaseKey}, owner).Err()
+}
+
+func (s *gptAccountRecoveryStore) nextRunKey(configHash string) (string, error) {
+	if s == nil || s.rdb == nil {
+		return "", errors.New("GPT account recovery Redis is unavailable")
+	}
+	if configHash == "" || len(configHash) > 256 || strings.TrimSpace(configHash) != configHash {
+		return "", errors.New("GPT account recovery configuration hash is invalid")
+	}
+	return gptAccountRecoveryKeyPrefix + ":next:" + configHash, nil
+}
+
+func (s *gptAccountRecoveryStore) NextRun(ctx context.Context, configHash string) (time.Time, error) {
+	key, err := s.nextRunKey(configHash)
+	if err != nil {
+		return time.Time{}, err
+	}
+	value, err := s.rdb.Get(ctx, key).Int64()
+	if errors.Is(err, redis.Nil) {
+		return time.Time{}, nil
+	}
+	if err != nil {
+		return time.Time{}, fmt.Errorf("read GPT account recovery next run: %w", err)
+	}
+	if value <= 0 {
+		return time.Time{}, errors.New("GPT account recovery next run is invalid")
+	}
+	return time.Unix(value, 0).UTC(), nil
+}
+
+func (s *gptAccountRecoveryStore) SetNextRun(ctx context.Context, configHash string, next time.Time) error {
+	key, err := s.nextRunKey(configHash)
+	if err != nil {
+		return err
+	}
+	if next.IsZero() || next.Unix() <= 0 {
+		return errors.New("GPT account recovery next run is invalid")
+	}
+	return s.rdb.Set(ctx, key, next.Unix(), gptAccountRecoveryNextRunTTL).Err()
+}
diff --git a/backend/internal/repository/gpt_account_recovery_store_test.go b/backend/internal/repository/gpt_account_recovery_store_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b9d4f89b6409a89705b1db7221fbd4d465cb16db
--- /dev/null
+++ b/backend/internal/repository/gpt_account_recovery_store_test.go
@@ -0,0 +1,53 @@
+package repository
+
+import (
+	"context"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/alicebob/miniredis/v2"
+	"github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/require"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestGPTRecoveryStoreIsolationExpiryAndLease(t *testing.T) {
+	mini := miniredis.RunT(t)
+	client := redis.NewClient(&redis.Options{Addr: mini.Addr()})
+	t.Cleanup(func() { _ = client.Close() })
+	s := NewGPTAccountRecoveryStore(client)
+	ctx := context.Background()
+	key := strings.Repeat("a", 64)
+	ticket := &service.GPTAccountRecoveryTicket{CFLB: "secret-route", OAILB: "secret-jwt", TurnState: "secret-turn", CookieExpiresAt: time.Now().Add(time.Hour), ExpiresAt: time.Now().Add(time.Minute)}
+	require.NoError(t, s.SaveTicket(ctx, key, ticket, time.Hour))
+	found, e := s.LoadTicket(ctx, key)
+	require.NoError(t, e)
+	require.Equal(t, ticket.CFLB, found.CFLB)
+	missing, e := s.LoadTicket(ctx, strings.Repeat("b", 64))
+	require.NoError(t, e)
+	require.Nil(t, missing)
+	require.Error(t, s.SaveTicket(ctx, "bad key", ticket, time.Hour))
+	owned, e := s.Acquire(ctx, "owner-1", time.Minute)
+	require.NoError(t, e)
+	require.True(t, owned)
+	owned, e = s.Acquire(ctx, "owner-2", time.Minute)
+	require.NoError(t, e)
+	require.False(t, owned)
+	owned, e = s.Owns(ctx, "owner-1")
+	require.NoError(t, e)
+	require.True(t, owned)
+	require.NoError(t, s.Release(ctx, "owner-2"))
+	owned, e = s.Owns(ctx, "owner-1")
+	require.NoError(t, e)
+	require.True(t, owned)
+	require.NoError(t, s.Release(ctx, "owner-1"))
+	concrete := s.(*gptAccountRecoveryStore)
+	require.NoError(t, concrete.SetNextRun(ctx, "config", time.Now().Add(time.Minute)))
+	next, e := concrete.NextRun(ctx, "config")
+	require.NoError(t, e)
+	require.True(t, next.After(time.Now()))
+	mini.FastForward(2 * time.Hour)
+	missing, e = s.LoadTicket(ctx, key)
+	require.NoError(t, e)
+	require.Nil(t, missing)
+}
