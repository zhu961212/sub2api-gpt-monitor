+func TestGPTMonitorManualCompletionPipelineOutsideScopeWhileAutoDisabled(t *testing.T) {
+	for _, schedulable := range []bool{true, false} {
+		t.Run(map[bool]string{true: "suspend", false: "recover"}[schedulable], func(t *testing.T) {
+			s, repo, store := gptMonitorManualCompletionFixture(schedulable)
+			store.next = time.Now().Add(time.Hour)
+			sharedNext := store.next
+			calls := 0
+			s.probe = func(_ context.Context, id int64, _, _ string) (*Account, string, error) {
+				calls++
+				answer := "iPhone 17"
+				if schedulable {
+					answer = "iPhone 16"
+				}
+				return repo.snapshot(id), answer, nil
+			}
+			request := gptMonitorRequest{AccountID: 2, ConfigKey: gptMonitorConfigHash(s.cfg)}
+			_, started := s.runMonitorRequest(context.Background(), s.cfg, request, true)
+			require.True(t, started)
+			require.Equal(t, 1, calls)
+			require.Empty(t, repo.writes)
+			first := repo.results[2]
+			require.True(t, first.ManualRequested)
+			require.False(t, first.ManualRunning)
+			require.Equal(t, 1, first.ManualAttempts)
+			require.Equal(t, 1, first.Consecutive)
+			require.NotNil(t, first.NextCheckAt)
+			gptMonitorAgeConfirmation(repo.gptMonitorRepoStub, 2)
+			request.Confirmation = true
+			_, started = s.runMonitorRequest(context.Background(), s.cfg, request, true)
+			require.True(t, started)
+			require.Equal(t, 2, calls)
+			require.Equal(t, map[int64]bool{2: !schedulable}, repo.writes)
+			second := repo.results[2]
+			require.True(t, second.Changed)
+			require.False(t, second.ManualRequested)
+			require.False(t, second.ManualRunning)
+			require.Equal(t, 2, second.ManualAttempts)
+			require.Empty(t, second.PendingVerdict)
+			require.Equal(t, []int64{1}, s.cfg.AccountIDs)
+			require.Equal(t, sharedNext, store.next)
+			// Re-applying a consumed follow-up never sends a third probe.
+			s.runMonitorRequest(context.Background(), s.cfg, request, true)
+			require.Equal(t, 2, calls)
+		})
+	}
+}
