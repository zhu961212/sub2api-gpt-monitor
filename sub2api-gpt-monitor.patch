diff --git a/backend/internal/repository/gpt_account_monitor_store.go b/backend/internal/repository/gpt_account_monitor_store.go
new file mode 100644
index 0000000000000000000000000000000000000000..0f8ef45c6698d9a04d95ef7bce9091c09b62dac0
--- /dev/null
+++ b/backend/internal/repository/gpt_account_monitor_store.go
@@ -0,0 +1,135 @@
+package repository
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/redis/go-redis/v9"
+)
+
+const (
+	gptAccountMonitorKeyPrefix       = "sub2api:gpt-account-monitor:v1"
+	gptAccountMonitorLeaseKey        = gptAccountMonitorKeyPrefix + ":lease"
+	gptAccountMonitorNextRunTTL      = 7 * 24 * time.Hour
+	gptAccountMonitorMinimumLeaseTTL = 5 * time.Second
+)
+
+var gptAccountMonitorRenewScript = redis.NewScript(`
+if redis.call("GET", KEYS[1]) == ARGV[1] and redis.call("PTTL", KEYS[1]) > 0 then
+  return redis.call("PEXPIRE", KEYS[1], ARGV[2])
+end
+return 0
+`)
+
+var gptAccountMonitorReleaseScript = redis.NewScript(`
+if redis.call("GET", KEYS[1]) == ARGV[1] then
+  return redis.call("DEL", KEYS[1])
+end
+return 0
+`)
+
+// Read the owner and remaining lifetime atomically. A lease with no expiry is
+// invalid; a lease near expiry does not authorize a scheduling change.
+var gptAccountMonitorOwnsScript = redis.NewScript(`
+if redis.call("GET", KEYS[1]) == ARGV[1] and redis.call("PTTL", KEYS[1]) > tonumber(ARGV[2]) then
+  return 1
+end
+return 0
+`)
+
+type gptAccountMonitorStore struct {
+	rdb *redis.Client
+}
+
+func NewGPTAccountMonitorStore(redisClient *redis.Client) service.GPTAccountMonitorStore {
+	return &gptAccountMonitorStore{rdb: redisClient}
+}
+
+func (s *gptAccountMonitorStore) checkOwner(owner string) error {
+	if s == nil || s.rdb == nil {
+		return errors.New("GPT account monitor Redis is unavailable")
+	}
+	if strings.TrimSpace(owner) == "" {
+		return errors.New("GPT account monitor lease owner is empty")
+	}
+	return nil
+}
+
+func (s *gptAccountMonitorStore) Acquire(ctx context.Context, owner string, ttl time.Duration) (bool, error) {
+	if err := s.checkOwner(owner); err != nil {
+		return false, err
+	}
+	if ttl <= gptAccountMonitorMinimumLeaseTTL {
+		return false, errors.New("GPT account monitor lease TTL must exceed five seconds")
+	}
+	return s.rdb.SetNX(ctx, gptAccountMonitorLeaseKey, owner, ttl).Result()
+}
+
+func (s *gptAccountMonitorStore) Renew(ctx context.Context, owner string, ttl time.Duration) (bool, error) {
+	if err := s.checkOwner(owner); err != nil {
+		return false, err
+	}
+	if ttl <= gptAccountMonitorMinimumLeaseTTL {
+		return false, errors.New("GPT account monitor lease TTL must exceed five seconds")
+	}
+	result, err := gptAccountMonitorRenewScript.Run(ctx, s.rdb, []string{gptAccountMonitorLeaseKey}, owner, ttl.Milliseconds()).Int64()
+	return result == 1, err
+}
+
+func (s *gptAccountMonitorStore) Owns(ctx context.Context, owner string) (bool, error) {
+	if err := s.checkOwner(owner); err != nil {
+		return false, err
+	}
+	result, err := gptAccountMonitorOwnsScript.Run(ctx, s.rdb, []string{gptAccountMonitorLeaseKey}, owner, gptAccountMonitorMinimumLeaseTTL.Milliseconds()).Int64()
+	return result == 1, err
+}
+
+func (s *gptAccountMonitorStore) Release(ctx context.Context, owner string) error {
+	if err := s.checkOwner(owner); err != nil {
+		return err
+	}
+	return gptAccountMonitorReleaseScript.Run(ctx, s.rdb, []string{gptAccountMonitorLeaseKey}, owner).Err()
+}
+
+func (s *gptAccountMonitorStore) nextRunKey(configHash string) (string, error) {
+	if s == nil || s.rdb == nil {
+		return "", errors.New("GPT account monitor Redis is unavailable")
+	}
+	if configHash == "" || len(configHash) > 256 || strings.TrimSpace(configHash) != configHash {
+		return "", errors.New("GPT account monitor configuration hash is invalid")
+	}
+	return gptAccountMonitorKeyPrefix + ":next:" + configHash, nil
+}
+
+func (s *gptAccountMonitorStore) NextRun(ctx context.Context, configHash string) (time.Time, error) {
+	key, err := s.nextRunKey(configHash)
+	if err != nil {
+		return time.Time{}, err
+	}
+	value, err := s.rdb.Get(ctx, key).Int64()
+	if errors.Is(err, redis.Nil) {
+		return time.Time{}, nil
+	}
+	if err != nil {
+		return time.Time{}, fmt.Errorf("read GPT account monitor next run: %w", err)
+	}
+	if value <= 0 {
+		return time.Time{}, errors.New("GPT account monitor next run is invalid")
+	}
+	return time.Unix(value, 0).UTC(), nil
+}
+
+func (s *gptAccountMonitorStore) SetNextRun(ctx context.Context, configHash string, next time.Time) error {
+	key, err := s.nextRunKey(configHash)
+	if err != nil {
+		return err
+	}
+	if next.IsZero() || next.Unix() <= 0 {
+		return errors.New("GPT account monitor next run is invalid")
+	}
+	return s.rdb.Set(ctx, key, next.Unix(), gptAccountMonitorNextRunTTL).Err()
+}
