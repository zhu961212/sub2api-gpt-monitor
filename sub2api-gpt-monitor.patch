+package admin
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+type recoveryHandlerStub struct {
+	saved int
+	cfg   config.GPTAccountRecoveryConfig
+}
+
+func (s *recoveryHandlerStub) GetConfig(context.Context) (config.GPTAccountRecoveryConfig, error) {
+	return s.cfg, nil
+}
+func (s *recoveryHandlerStub) SaveConfig(_ context.Context, c config.GPTAccountRecoveryConfig) (config.GPTAccountRecoveryConfig, error) {
+	s.saved++
+	s.cfg = c
+	return c, nil
+}
+func (s *recoveryHandlerStub) Status(context.Context) (service.GPTAccountRecoveryStatus, error) {
+	return service.GPTAccountRecoveryStatus{}, nil
+}
+func (s *recoveryHandlerStub) RunNow(context.Context) (bool, error)            { return true, nil }
+func (s *recoveryHandlerStub) RunAccount(context.Context, int64) (bool, error) { return true, nil }
+func (s *recoveryHandlerStub) AccountResult(context.Context, int64) (service.GPTAccountRecoveryStatusAccount, error) {
+	return service.GPTAccountRecoveryStatusAccount{}, nil
+}
+func TestGPTRecoveryHandlerRejectsLegacyRulesAndIncompleteConfig(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	stub := &recoveryHandlerStub{cfg: config.DefaultGPTAccountRecoveryConfig()}
+	h := &GPTAccountRecoveryHandler{monitor: stub}
+	router := gin.New()
+	router.PUT("/config", h.SaveConfig)
+	for _, body := range []string{`{}`, `{"enabled":false,"prompt":"iPhone17","expected_generation":17}`, `null`} {
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, httptest.NewRequest(http.MethodPut, "/config", strings.NewReader(body)))
+		require.Equal(t, http.StatusBadRequest, w.Code)
+	}
+	require.Zero(t, stub.saved)
+	raw, e := json.Marshal(stub.cfg)
+	require.NoError(t, e)
+	w := httptest.NewRecorder()
+	router.ServeHTTP(w, httptest.NewRequest(http.MethodPut, "/config", strings.NewReader(string(raw))))
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Equal(t, 1, stub.saved)
+	require.Equal(t, config.GPTAccountRecoveryModel, stub.cfg.Model)
+}
