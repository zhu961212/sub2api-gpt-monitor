+		{"secret extra field", func(r *service.GPTAccountRecoverySharedRoute) string {
+			raw, _ := json.Marshal(r)
+			return strings.TrimSuffix(string(raw), "}") + ",\"turn_state\":\"private-turn\",\"access_token\":\"private-token\"}"
+		}, time.Hour},
+		{"multiple JSON values", func(r *service.GPTAccountRecoverySharedRoute) string {
+			raw, _ := json.Marshal(r)
+			return string(raw) + " {}"
+		}, time.Hour},
+		{"oversized payload", func(*service.GPTAccountRecoverySharedRoute) string {
+			return strings.Repeat("a", gptRecoverySharedRouteMaxPayload+1)
