index 0000000000000000000000000000000000000000..dc3e1cb0cadfc219832ba490cb6f54c100c5f68a
--- /dev/null
+++ b/backend/internal/service/gpt_account_monitor_errors.go
@@ -0,0 +1,201 @@
+package service
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// All fields are safe to persist and display. Never put upstream messages,
+// transport error strings, URLs or credentials into this error.
+type gptMonitorProbeError struct {
+	Code       string
+	Message    string
+	HTTPStatus int
+}
+
+func (e *gptMonitorProbeError) Error() string {
+	if e == nil {
+		return "检测失败，原因未知"
+	}
+	return e.Message
+}
+
+// Callers must use a stable code and a trusted, static message. Untrusted errors
+// must go through the transport, HTTP or upstream classifiers below.
+func gptMonitorError(code, message string) error {
+	return &gptMonitorProbeError{Code: code, Message: message}
+}
+
+func gptMonitorErrorDetails(err error) (code, message string, httpStatus int) {
+	if err == nil {
+		return "", "", 0
+	}
+	var probeErr *gptMonitorProbeError
+	if errors.As(err, &probeErr) && probeErr != nil {
+		return probeErr.Code, probeErr.Message, probeErr.HTTPStatus
+	}
+	return "unknown_error", "检测失败，原因未知", 0
+}
+
+func gptMonitorTransportError(err error) error {
+	var probeErr *gptMonitorProbeError
+	if errors.As(err, &probeErr) && probeErr != nil {
+		return probeErr
+	}
+	if errors.Is(err, context.Canceled) {
+		return gptMonitorError("canceled", "检测已取消")
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		return gptMonitorError("timeout", "连接或读取上游超时，请检查账号代理")
+	}
+	var networkErr net.Error
+	if errors.As(err, &networkErr) && networkErr.Timeout() {
+		return gptMonitorError("timeout", "连接或读取上游超时，请检查账号代理")
+	}
+	var dnsErr *net.DNSError
+	if errors.As(err, &dnsErr) {
+		return gptMonitorError("dns_error", "域名解析失败，请检查账号代理及 DNS")
+	}
+	var certificateErr *tls.CertificateVerificationError
+	var unknownAuthorityErr x509.UnknownAuthorityError
+	var hostnameErr x509.HostnameError
+	var invalidCertificateErr x509.CertificateInvalidError
+	var recordErr tls.RecordHeaderError
+	if errors.As(err, &certificateErr) || errors.As(err, &unknownAuthorityErr) ||
+		errors.As(err, &hostnameErr) || errors.As(err, &invalidCertificateErr) || errors.As(err, &recordErr) {
+		return gptMonitorError("tls_error", "TLS 握手或证书验证失败，请检查账号代理")
+	}
+	// Some standard-library CONNECT and TLS failures do not expose a typed
+	// error. Recognize their fixed phrases, but never return the original text.
+	var detail string
+	if err != nil {
+		detail = strings.ToLower(err.Error())
+	}
+	if strings.Contains(detail, "proxy authentication required") ||
+		strings.Contains(detail, "socks authentication failed") ||
+		strings.Contains(detail, "no acceptable authentication methods") ||
+		strings.Contains(detail, "username/password authentication failed") {
+		return gptMonitorError("proxy_auth_required", "代理认证失败，请检查代理用户名和密码")
+	}
+	if strings.Contains(detail, "tls:") || strings.Contains(detail, "tls handshake") ||
+		strings.Contains(detail, "x509:") || strings.Contains(detail, "http response to https client") {
+		return gptMonitorError("tls_error", "TLS 握手或证书验证失败，请检查账号代理")
+	}
+	var operationErr *net.OpError
+	if errors.As(err, &operationErr) && (strings.Contains(operationErr.Op, "proxyconnect") || strings.Contains(operationErr.Op, "socks connect")) {
+		return gptMonitorError("proxy_connection_failed", "代理连接或隧道建立失败，请检查账号代理")
+	}
+	if strings.Contains(detail, "proxyconnect") || strings.Contains(detail, "socks connect") {
+		return gptMonitorError("proxy_connection_failed", "代理连接或隧道建立失败，请检查账号代理")
+	}
+	return gptMonitorError("network_error", "上游网络连接失败，请检查账号代理")
+}
+
+const gptMonitorHTTPErrorBodyLimit = 64 * 1024
+
+func gptMonitorHTTPError(status int, body io.Reader) error {
+	var code, errorType, message string
+	if body != nil {
+		// Error pages can be arbitrarily large or contain credentials. Read only
+		// enough to classify a small JSON error; never preserve the raw body.
+		raw, err := io.ReadAll(io.LimitReader(body, gptMonitorHTTPErrorBodyLimit))
+		if err == nil {
+			var envelope struct {
+				Code    string          `json:"code"`
+				Type    string          `json:"type"`
+				Message string          `json:"message"`
+				Error   json.RawMessage `json:"error"`
+			}
+			if json.Unmarshal(raw, &envelope) == nil {
+				code, errorType, message = envelope.Code, envelope.Type, envelope.Message
+				var nested struct {
+					Code    string `json:"code"`
+					Type    string `json:"type"`
+					Message string `json:"message"`
+				}
+				if json.Unmarshal(envelope.Error, &nested) == nil {
+					code, errorType, message = nested.Code, nested.Type, nested.Message
+				} else {
+					var errorMessage string
+					if json.Unmarshal(envelope.Error, &errorMessage) == nil {
+						message = errorMessage
+					}
+				}
+			}
+		}
+	}
+	classified, known := classifyGPTMonitorUpstreamError(code, errorType, message)
+	// HTTP authentication, permission and server failures are authoritative;
+	// do not let a conflicting error body disguise the failure category.
+	switch {
+	case status == http.StatusProxyAuthRequired:
+		classified = &gptMonitorProbeError{Code: "proxy_auth_required", Message: "代理认证失败，请检查代理用户名和密码"}
+	case status == http.StatusUnauthorized:
+		classified = &gptMonitorProbeError{Code: "unauthorized", Message: "账号认证失败，访问令牌无效或已过期"}
+	case status == http.StatusForbidden:
+		classified = &gptMonitorProbeError{Code: "forbidden", Message: "上游拒绝访问，请检查账号权限或代理出口"}
+	case status == http.StatusTooManyRequests:
+		if !known || classified.Code != "quota_exceeded" {
+			classified = &gptMonitorProbeError{Code: "rate_limited", Message: "上游请求频率受限，请稍后重试"}
+		}
+	case status >= 500 && status <= 599:
+		classified = &gptMonitorProbeError{Code: "upstream_error", Message: "上游服务暂时异常，请稍后重试"}
+	case !known:
+		classified = &gptMonitorProbeError{Code: "http_error", Message: fmt.Sprintf("上游返回 HTTP %d，检测失败", status)}
+	}
+	classified.HTTPStatus = status
+	return classified
+}
+
+func gptMonitorUpstreamError(code, errorType, message string) error {
+	if classified, known := classifyGPTMonitorUpstreamError(code, errorType, message); known {
+		return classified
+	}
+	return gptMonitorError("upstream_error", "上游响应失败，未完成检测")
+}
+
+func classifyGPTMonitorUpstreamError(code, errorType, message string) (*gptMonitorProbeError, bool) {
+	for _, value := range []string{strings.ToLower(strings.TrimSpace(code)), strings.ToLower(strings.TrimSpace(errorType))} {
+		switch value {
+		case "model_not_found", "model_not_available", "model_not_supported", "unsupported_model", "invalid_model", "unknown_model", "model_access_denied":
+			return &gptMonitorProbeError{Code: "model_unavailable", Message: "当前账号无法使用指定检测模型，请检查模型权限"}, true
+		case "unsupported_reasoning", "unsupported_reasoning_effort", "reasoning_effort_not_supported", "invalid_reasoning_effort":
+			return &gptMonitorProbeError{Code: "reasoning_unsupported", Message: "指定检测模型不支持当前推理强度"}, true
+		case "invalid_api_key", "invalid_token", "token_expired", "authentication_error", "unauthorized":
+			return &gptMonitorProbeError{Code: "unauthorized", Message: "账号认证失败，访问令牌无效或已过期"}, true
+		case "permission_error", "permission_denied", "forbidden", "account_deactivated", "account_suspended":
+			return &gptMonitorProbeError{Code: "forbidden", Message: "上游拒绝访问，请检查账号权限或代理出口"}, true
+		case "insufficient_quota", "quota_exceeded", "billing_hard_limit_reached", "usage_limit_reached", "credits_exhausted":
+			return &gptMonitorProbeError{Code: "quota_exceeded", Message: "账号可用额度不足或使用额度已耗尽"}, true
+		case "rate_limit_exceeded", "rate_limit_error", "too_many_requests":
+			return &gptMonitorProbeError{Code: "rate_limited", Message: "上游请求频率受限，请稍后重试"}, true
+		case "server_error", "internal_error", "internal_server_error", "overloaded_error":
+			return &gptMonitorProbeError{Code: "upstream_error", Message: "上游服务暂时异常，请稍后重试"}, true
+		}
+	}
+	// The model and reasoning APIs sometimes use only invalid_request_error or
+	// unsupported_value. Inspect narrowly recognized phrases, never echo them.
+	detail := strings.ToLower(message)
+	unsupported := false
+	for _, phrase := range []string{"not supported", "does not support", "unsupported", "not available", "unavailable", "not found", "does not exist", "do not have access", "don't have access"} {
+		if strings.Contains(detail, phrase) {
+			unsupported = true
+			break
+		}
+	}
+	if unsupported && (strings.Contains(detail, "reasoning") || strings.Contains(detail, "effort") || strings.Contains(detail, "xhigh")) {
+		return &gptMonitorProbeError{Code: "reasoning_unsupported", Message: "指定检测模型不支持当前推理强度"}, true
+	}
+	if (unsupported && strings.Contains(detail, "model")) || strings.Contains(detail, "unknown model") {
+		return &gptMonitorProbeError{Code: "model_unavailable", Message: "当前账号无法使用指定检测模型，请检查模型权限"}, true
+	}
+	return nil, false
+}
diff --git a/backend/internal/service/gpt_account_monitor_errors_test.go b/backend/internal/service/gpt_account_monitor_errors_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..96b5c61039979ba339f8eb6110ea2920951f2717
--- /dev/null
+++ b/backend/internal/service/gpt_account_monitor_errors_test.go
@@ -0,0 +1,162 @@
+package service
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+const gptMonitorErrorTestSecret = "secret-token-password-private-host"
+
+func assertGPTMonitorSafeError(t *testing.T, err error, expectedCode string, expectedStatus int) {
+	t.Helper()
+	if err == nil {
+		t.Fatal("expected a classified error")
+	}
+	code, message, status := gptMonitorErrorDetails(err)
+	if code != expectedCode || status != expectedStatus || message == "" {
+		t.Fatalf("unexpected error details: code=%q message=%q status=%d", code, message, status)
+	}
+	if strings.Contains(err.Error(), gptMonitorErrorTestSecret) || strings.Contains(message, gptMonitorErrorTestSecret) || strings.Contains(code, gptMonitorErrorTestSecret) {
+		t.Fatal("untrusted upstream or transport details leaked")
+	}
+}
+
+func TestGPTMonitorTransportErrorClassification(t *testing.T) {
+	wrap := func(err error) error {
+		return &url.Error{Op: "Post", URL: "https://user:" + gptMonitorErrorTestSecret + "@private.example/", Err: err}
+	}
+	for _, test := range []struct {
+		name string
+		err  error
+		code string
+	}{
+		{"canceled", wrap(context.Canceled), "canceled"},
+		{"deadline", wrap(context.DeadlineExceeded), "timeout"},
+		{"dns_timeout", wrap(&net.DNSError{Name: gptMonitorErrorTestSecret, IsTimeout: true}), "timeout"},
+		{"dns", wrap(&net.DNSError{Name: gptMonitorErrorTestSecret, Err: "no such host"}), "dns_error"},
+		{"certificate", wrap(&tls.CertificateVerificationError{Err: x509.UnknownAuthorityError{}}), "tls_error"},
+		{"unknown_authority", wrap(x509.UnknownAuthorityError{}), "tls_error"},
+		{"tls_handshake", wrap(errors.New("remote error: tls: handshake failure " + gptMonitorErrorTestSecret)), "tls_error"},
+		{"connect", wrap(&net.OpError{Op: "proxyconnect", Net: "tcp", Err: errors.New(gptMonitorErrorTestSecret)}), "proxy_connection_failed"},
+		{"socks", wrap(errors.New("socks connect tcp: " + gptMonitorErrorTestSecret)), "proxy_connection_failed"},
+		{"proxy_auth", wrap(errors.New("Proxy Authentication Required " + gptMonitorErrorTestSecret)), "proxy_auth_required"},
+		{"socks_auth", wrap(errors.New("username/password authentication failed " + gptMonitorErrorTestSecret)), "proxy_auth_required"},
+		{"generic", wrap(errors.New(gptMonitorErrorTestSecret)), "network_error"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			assertGPTMonitorSafeError(t, gptMonitorTransportError(test.err), test.code, 0)
+		})
+	}
+}
+
+func TestGPTMonitorHTTPErrorClassification(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		status int
+		body   string
+		code   string
+	}{
+		{"model_not_found", 404, `{"error":{"code":"model_not_found","message":"` + gptMonitorErrorTestSecret + `"}}`, "model_unavailable"},
+		{"model_unsupported_message", 400, `{"error":{"type":"invalid_request_error","message":"This model is not supported: ` + gptMonitorErrorTestSecret + `"}}`, "model_unavailable"},
+		{"reasoning_unsupported", 400, `{"error":{"code":"unsupported_value","message":"reasoning.effort xhigh is not supported by this model ` + gptMonitorErrorTestSecret + `"}}`, "reasoning_unsupported"},
+		{"top_level_model", 400, `{"code":"unsupported_model","message":"` + gptMonitorErrorTestSecret + `"}`, "model_unavailable"},
+		{"string_error", 400, `{"error":"Unknown model ` + gptMonitorErrorTestSecret + `"}`, "model_unavailable"},
+		{"auth", 401, `{"error":{"code":"model_not_found","message":"` + gptMonitorErrorTestSecret + `"}}`, "unauthorized"},
+		{"forbidden", 403, `<html>` + gptMonitorErrorTestSecret + `</html>`, "forbidden"},
+		{"proxy_auth", 407, gptMonitorErrorTestSecret, "proxy_auth_required"},
+		{"rate_limit", 429, gptMonitorErrorTestSecret, "rate_limited"},
+		{"quota", 429, `{"error":{"type":"insufficient_quota","message":"` + gptMonitorErrorTestSecret + `"}}`, "quota_exceeded"},
+		{"usage_quota", 429, `{"error":{"code":"usage_limit_reached","message":"` + gptMonitorErrorTestSecret + `"}}`, "quota_exceeded"},
+		{"upstream", 503, `{"error":{"code":"model_not_found","message":"` + gptMonitorErrorTestSecret + `"}}`, "upstream_error"},
+		{"unknown_code", 400, `{"error":{"code":"` + gptMonitorErrorTestSecret + `","message":"` + gptMonitorErrorTestSecret + `"}}`, "http_error"},
+		{"unknown_http", http.StatusTeapot, gptMonitorErrorTestSecret, "http_error"},
+		{"truncated_json", 404, `{"error":{"code":"model_not_found"`, "http_error"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			assertGPTMonitorSafeError(t, gptMonitorHTTPError(test.status, strings.NewReader(test.body)), test.code, test.status)
+		})
+	}
+}
+
+func TestGPTMonitorUpstreamErrorClassification(t *testing.T) {
+	for _, test := range []struct {
+		code      string
+		errorType string
+		message   string
+		want      string
+	}{
+		{"model_not_found", "invalid_request_error", gptMonitorErrorTestSecret, "model_unavailable"},
+		{"unsupported_reasoning_effort", "", gptMonitorErrorTestSecret, "reasoning_unsupported"},
+		{"", "invalid_request_error", "The requested model does not exist: " + gptMonitorErrorTestSecret, "model_unavailable"},
+		{"", "", "Unsupported value for reasoning.effort: " + gptMonitorErrorTestSecret, "reasoning_unsupported"},
+		{"token_expired", "", gptMonitorErrorTestSecret, "unauthorized"},
+		{"", "permission_error", gptMonitorErrorTestSecret, "forbidden"},
+		{"", "insufficient_quota", gptMonitorErrorTestSecret, "quota_exceeded"},
+		{"rate_limit_exceeded", "", gptMonitorErrorTestSecret, "rate_limited"},
+		{"", "server_error", gptMonitorErrorTestSecret, "upstream_error"},
+		{gptMonitorErrorTestSecret, gptMonitorErrorTestSecret, gptMonitorErrorTestSecret, "upstream_error"},
+	} {
+		t.Run(test.want+"_"+test.code, func(t *testing.T) {
+			assertGPTMonitorSafeError(t, gptMonitorUpstreamError(test.code, test.errorType, test.message), test.want, 0)
+		})
+	}
+}
+
+type gptMonitorCountingErrorReader struct {
+	remaining int
+	read      int
+}
+
+func (r *gptMonitorCountingErrorReader) Read(p []byte) (int, error) {
+	if r.remaining == 0 {
+		return 0, io.EOF
+	}
+	n := min(len(p), r.remaining)
+	for i := 0; i < n; i++ {
+		p[i] = 'x'
+	}
+	r.remaining -= n
+	r.read += n
+	return n, nil
+}
+
+type gptMonitorFailingErrorReader struct{}
+
+func (gptMonitorFailingErrorReader) Read([]byte) (int, error) {
+	return 0, errors.New(gptMonitorErrorTestSecret)
+}
+
+func TestGPTMonitorHTTPErrorBodyReadIsBounded(t *testing.T) {
+	body := &gptMonitorCountingErrorReader{remaining: 4 * gptMonitorHTTPErrorBodyLimit}
+	assertGPTMonitorSafeError(t, gptMonitorHTTPError(502, body), "upstream_error", 502)
+	if body.read != gptMonitorHTTPErrorBodyLimit {
+		t.Fatalf("read %d bytes, expected the %d-byte limit", body.read, gptMonitorHTTPErrorBodyLimit)
+	}
+	assertGPTMonitorSafeError(t, gptMonitorHTTPError(401, gptMonitorFailingErrorReader{}), "unauthorized", 401)
+	assertGPTMonitorSafeError(t, gptMonitorHTTPError(500, nil), "upstream_error", 500)
+}
+
+func TestGPTMonitorErrorDetailsRemainSafeWhenWrapped(t *testing.T) {
+	err := fmt.Errorf("unsafe wrapper %s: %w", gptMonitorErrorTestSecret, gptMonitorError("test_code", "安全错误说明"))
+	code, message, status := gptMonitorErrorDetails(err)
+	if code != "test_code" || message != "安全错误说明" || status != 0 {
+		t.Fatalf("unexpected safe details: %q %q %d", code, message, status)
+	}
+	unknown := errors.New(gptMonitorErrorTestSecret)
+	code, message, status = gptMonitorErrorDetails(unknown)
+	if code != "unknown_error" || strings.Contains(message, gptMonitorErrorTestSecret) || status != 0 {
+		t.Fatalf("unexpected fallback details: %q %q %d", code, message, status)
+	}
+	if code, message, status := gptMonitorErrorDetails(nil); code != "" || message != "" || status != 0 {
+		t.Fatal("nil error should have empty details")
+	}
+}
