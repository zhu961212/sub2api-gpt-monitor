+func TestGPTAccountRecoveryExhaustedQuotaSkipsMint(t *testing.T) {
+	for _, window := range []string{"5h", "7d"} {
+		t.Run(window, func(t *testing.T) {
+			s, a, repo, _ := recoveryServiceFixture()
+			now := time.Now()
+			a.Extra = map[string]any{"codex_" + window + "_used_percent": 100.0, "codex_" + window + "_reset_at": now.Add(time.Hour).Format(time.RFC3339), "codex_usage_updated_at": now.Format(time.RFC3339)}
+			upstream := &recoveryServiceHTTPUpstream{err: errors.New("quota exhausted must never reach transport")}
+			s.gateway.httpUpstream = upstream
+			s.recoverAccount(context.Background(), s.defaults, a.ID, "worker-owner", 0, false)
+			require.Zero(t, upstream.calls)
+			require.Equal(t, "skipped", repo.results[a.ID].Verdict)
+			require.Equal(t, "quota_exhausted", repo.results[a.ID].ErrorCode)
+			require.False(t, a.Schedulable)
+		})
+	}
+}
+func TestGPTAccountRecoveryExpiredQuotaWindowDoesNotBlockMint(t *testing.T) {
+	s, a, repo, _ := recoveryServiceFixture()
+	now := time.Now()
+	a.Extra = map[string]any{"codex_5h_used_percent": 100.0, "codex_5h_reset_at": now.Add(-time.Minute).Format(time.RFC3339), "codex_usage_updated_at": now.Format(time.RFC3339)}
