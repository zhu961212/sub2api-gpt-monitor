+func cloneRecoveryServiceAccount(a *Account) *Account {
+	if a == nil {
+		return nil
+	}
+	copy := *a
+	copy.Credentials = make(map[string]any, len(a.Credentials))
+	for k, v := range a.Credentials {
+		copy.Credentials[k] = v
+	}
+	copy.Extra = make(map[string]any, len(a.Extra))
+	for k, v := range a.Extra {
+		copy.Extra[k] = v
+	}
+	if a.Proxy != nil {
+		proxy := *a.Proxy
+		copy.Proxy = &proxy
+	}
+	return &copy
+}
+func (r *recoveryServiceRepository) GetByID(_ context.Context, id int64) (*Account, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if account := r.accounts[id]; account != nil {
+		return cloneRecoveryServiceAccount(account), nil
+	}
+	return nil, errors.New("account not found")
+}
+func (r *recoveryServiceRepository) GetByIDs(_ context.Context, ids []int64) ([]*Account, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.batchCalls++
+	r.batchIDs = append([]int64{}, ids...)
+	result := make([]*Account, 0, len(ids))
+	for _, id := range ids {
+		if a := r.accounts[id]; a != nil {
+			result = append(result, cloneRecoveryServiceAccount(a))
+		}
+	}
+	return result, nil
+}
+func (r *recoveryServiceRepository) ListGPTRecoveryCandidates(_ context.Context, scope []int64, after int64, limit int) ([]Account, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	ids := make([]int64, 0, len(r.accounts))
+	for id, a := range r.accounts {
+		if id <= after || !gptRecoveryEligible(a) {
+			continue
+		}
+		if len(scope) > 0 {
+			match := false
+			for _, target := range scope {
+				if target == id {
+					match = true
+					break
+				}
+			}
+			if !match {
+				continue
+			}
+		}
+		ids = append(ids, id)
+	}
+	sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+	if len(ids) > limit {
+		ids = ids[:limit]
+	}
+	result := make([]Account, 0, len(ids))
+	for _, id := range ids {
+		result = append(result, *cloneRecoveryServiceAccount(r.accounts[id]))
+	}
+	return result, nil
+}
+func (r *recoveryServiceRepository) ListGPTRecoveryAccounts(ctx context.Context, scope []int64) ([]Account, error) {
+	accounts, err := r.ListGPTRecoveryCandidates(ctx, scope, 0, 10000)
+	for i := range accounts {
+		accounts[i].Credentials = nil
+		accounts[i].ProxyID = nil
+		if accounts[i].Proxy != nil {
+			accounts[i].Proxy = &Proxy{Name: accounts[i].Proxy.Name}
+		}
+	}
+	return accounts, err
+}
+func (r *recoveryServiceRepository) UpdateGPTRecoveryResult(_ context.Context, id int64, result GPTAccountRecoveryResult) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.results[id] = result
+	r.resultWrites++
+	if a := r.accounts[id]; a != nil {
+		if a.Extra == nil {
+			a.Extra = map[string]any{}
+		}
+		a.Extra["gpt_account_recovery"] = result
+	}
+	return nil
+}
+
+type recoveryServiceLeaseStore struct {
+	*recoveryRoutingTestStore
+	leaseMu sync.Mutex
+	owner   string
+}
+
+func (s *recoveryServiceLeaseStore) Acquire(_ context.Context, owner string, _ time.Duration) (bool, error) {
+	s.leaseMu.Lock()
+	defer s.leaseMu.Unlock()
+	if s.owner != "" {
+		return false, nil
+	}
+	s.owner = owner
+	return true, nil
+}
+func (s *recoveryServiceLeaseStore) Renew(_ context.Context, owner string, _ time.Duration) (bool, error) {
+	s.leaseMu.Lock()
+	defer s.leaseMu.Unlock()
+	return owner == s.owner, nil
+}
+func (s *recoveryServiceLeaseStore) Owns(_ context.Context, owner string) (bool, error) {
+	s.leaseMu.Lock()
+	defer s.leaseMu.Unlock()
+	return owner == s.owner, nil
+}
+func (s *recoveryServiceLeaseStore) Release(_ context.Context, owner string) error {
+	s.leaseMu.Lock()
+	defer s.leaseMu.Unlock()
+	if owner == s.owner {
+		s.owner = ""
+	}
+	return nil
+}
