diff --git a/backend/internal/repository/http_upstream_recovery_log_test.go b/backend/internal/repository/http_upstream_recovery_log_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4965789b2124391fcf082dd7182723e5602dc3a3
--- /dev/null
