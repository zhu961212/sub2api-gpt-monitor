diff --git a/backend/internal/config/gpt_account_recovery.go b/backend/internal/config/gpt_account_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..58d2113e3cde55a28f5fa9d260ef035a71728da4
--- /dev/null
+++ b/backend/internal/config/gpt_account_recovery.go
@@ -0,0 +1,110 @@
+package config
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+const GPTAccountRecoveryModel = "gpt-6-astra"
+
+const (
+	GPTRecoveryProxySessionNone        = "none"
+	GPTRecoveryProxySessionKookeey     = "kookeey"
+	GPTRecoveryProxySessionUsernameSID = "username_sid"
+	GPTRecoveryProxySessionTemplate    = "template"
+)
+
+// Recovery validates protocol and routing metadata, never model intelligence.
+type GPTAccountRecoveryConfig struct {
+	Enabled                   bool    `mapstructure:"enabled" json:"enabled"`
+	IntervalSeconds           int     `mapstructure:"interval_seconds" json:"interval_seconds"`
+	TimeoutSeconds            int     `mapstructure:"timeout_seconds" json:"timeout_seconds"`
+	MaxAttempts               int     `mapstructure:"max_attempts" json:"max_attempts"`
+	Gateway                   string  `mapstructure:"gateway" json:"gateway"`
+	TicketLength              int     `mapstructure:"ticket_length" json:"ticket_length"`
+	TicketTTLSeconds          int     `mapstructure:"ticket_ttl_seconds" json:"ticket_ttl_seconds"`
+	CookieTTLSeconds          int     `mapstructure:"cookie_ttl_seconds" json:"cookie_ttl_seconds"`
+	Model                     string  `mapstructure:"model" json:"model"`
+	AccountIDs                []int64 `mapstructure:"account_ids" json:"account_ids"`
+	RunOnStart                bool    `mapstructure:"run_on_start" json:"run_on_start"`
+	ProxySessionMode          string  `mapstructure:"proxy_session_mode" json:"proxy_session_mode"`
+	ProxySessionTTLSeconds    int     `mapstructure:"proxy_session_ttl_seconds" json:"proxy_session_ttl_seconds"`
+	Transport                 string  `mapstructure:"transport" json:"transport"`
+	ShareRouteCookies         bool    `mapstructure:"share_route_cookies" json:"share_route_cookies"`
+	ShareRouteDonorAccountIDs []int64 `mapstructure:"share_route_donor_account_ids" json:"share_route_donor_account_ids"`
+}
+
+func DefaultGPTAccountRecoveryConfig() GPTAccountRecoveryConfig {
+	return GPTAccountRecoveryConfig{IntervalSeconds: 1800, TimeoutSeconds: 90, MaxAttempts: 6, Gateway: "any", TicketTTLSeconds: 240, CookieTTLSeconds: 3900, Model: GPTAccountRecoveryModel, AccountIDs: []int64{}, RunOnStart: true, ProxySessionMode: GPTRecoveryProxySessionNone, ProxySessionTTLSeconds: 600, Transport: "sse", ShareRouteDonorAccountIDs: []int64{}}
+}
+
+func (c *GPTAccountRecoveryConfig) Normalize() {
+	c.Model = GPTAccountRecoveryModel
+	c.Gateway = strings.ToLower(strings.TrimSpace(c.Gateway))
+	c.ProxySessionMode = strings.ToLower(strings.TrimSpace(c.ProxySessionMode))
+	if c.ProxySessionMode == "" {
+		c.ProxySessionMode = GPTRecoveryProxySessionNone
+	}
+	if c.ProxySessionTTLSeconds == 0 {
+		c.ProxySessionTTLSeconds = 600
+	}
+	c.Transport = strings.ToLower(strings.TrimSpace(c.Transport))
+	if c.Transport == "" {
+		c.Transport = "sse"
+	}
+}
+
+var gptRecoveryGatewayPattern = regexp.MustCompile(`^unified-[0-9]{1,6}$`)
+
+func (c GPTAccountRecoveryConfig) Validate() error {
+	for _, v := range []struct {
+		name            string
+		value, min, max int
+	}{
+		{"interval_seconds", c.IntervalSeconds, 60, 86400},
+		{"timeout_seconds", c.TimeoutSeconds, 10, 300},
+		{"max_attempts", c.MaxAttempts, 1, 20},
+		{"ticket_ttl_seconds", c.TicketTTLSeconds, 30, 600},
+		{"cookie_ttl_seconds", c.CookieTTLSeconds, 60, 7200},
+		{"proxy_session_ttl_seconds", c.ProxySessionTTLSeconds, 60, 3600},
+	} {
+		if v.value < v.min || v.value > v.max {
+			return fmt.Errorf("gpt_account_recovery.%s must be between %d and %d", v.name, v.min, v.max)
+		}
+	}
+	switch c.ProxySessionMode {
+	case GPTRecoveryProxySessionNone, GPTRecoveryProxySessionKookeey, GPTRecoveryProxySessionUsernameSID, GPTRecoveryProxySessionTemplate:
+	default:
+		return fmt.Errorf("gpt_account_recovery.proxy_session_mode must be none, kookeey, username_sid or template")
+	}
+	if c.Transport != "sse" && c.Transport != "websocket" {
+		return fmt.Errorf("gpt_account_recovery.transport must be sse or websocket")
+	}
+	if c.TicketLength != 0 && (c.TicketLength < 64 || c.TicketLength > 8192) {
+		return fmt.Errorf("gpt_account_recovery.ticket_length must be 0 or between 64 and 8192")
+	}
+	if c.Gateway != "any" && !gptRecoveryGatewayPattern.MatchString(c.Gateway) {
+		return fmt.Errorf("gpt_account_recovery.gateway must be any or unified-N")
+	}
+	if c.Model != GPTAccountRecoveryModel {
+		return fmt.Errorf("gpt_account_recovery.model is fixed")
+	}
+	if len(c.AccountIDs) > 10000 {
+		return fmt.Errorf("too many recovery accounts")
+	}
+	for _, id := range c.AccountIDs {
+		if id <= 0 {
+			return fmt.Errorf("recovery account IDs must be positive")
+		}
+	}
+	if len(c.ShareRouteDonorAccountIDs) > 10000 {
+		return fmt.Errorf("too many recovery route donor accounts")
+	}
+	for _, id := range c.ShareRouteDonorAccountIDs {
+		if id <= 0 {
+			return fmt.Errorf("recovery route donor account IDs must be positive")
+		}
+	}
+	return nil
+}
diff --git a/backend/internal/config/gpt_account_recovery_test.go b/backend/internal/config/gpt_account_recovery_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..cef7c9ac8d89840023d4885d596b517a72a83727
--- /dev/null
+++ b/backend/internal/config/gpt_account_recovery_test.go
@@ -0,0 +1,66 @@
+package config
+
+import (
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestGPTRecoveryConfig(t *testing.T) {
+	c := DefaultGPTAccountRecoveryConfig()
+	require.NoError(t, c.Validate())
+	require.Zero(t, c.TicketLength)
+	c.Model = "old-model"
+	c.Gateway = " Unified-88 "
+	c.Normalize()
+	require.Equal(t, GPTAccountRecoveryModel, c.Model)
+	require.Equal(t, "unified-88", c.Gateway)
+	require.NoError(t, c.Validate())
+	for _, change := range []func(*GPTAccountRecoveryConfig){func(c *GPTAccountRecoveryConfig) { c.MaxAttempts = 0 }, func(c *GPTAccountRecoveryConfig) { c.MaxAttempts = 21 }, func(c *GPTAccountRecoveryConfig) { c.Gateway = "https://private-host" }, func(c *GPTAccountRecoveryConfig) { c.TicketLength = 12 }, func(c *GPTAccountRecoveryConfig) { c.TimeoutSeconds = 301 }, func(c *GPTAccountRecoveryConfig) { c.TicketTTLSeconds = 601 }, func(c *GPTAccountRecoveryConfig) { c.CookieTTLSeconds = 0 }, func(c *GPTAccountRecoveryConfig) { c.AccountIDs = []int64{-1} }} {
+		c := DefaultGPTAccountRecoveryConfig()
+		change(&c)
+		require.Error(t, c.Validate())
+	}
+}
+
+func TestGPTRecoveryProxySessionConfig(t *testing.T) {
+	c := DefaultGPTAccountRecoveryConfig()
+	require.Equal(t, "none", c.ProxySessionMode)
+	require.Equal(t, 600, c.ProxySessionTTLSeconds)
+	require.Equal(t, "sse", c.Transport)
+	for _, mode := range []string{"none", "kookeey", "username_sid", "template"} {
+		c.ProxySessionMode = mode
+		require.NoError(t, c.Validate())
+	}
+	c.ProxySessionMode = "rotating"
+	require.Error(t, c.Validate())
+	c = DefaultGPTAccountRecoveryConfig()
+	c.ProxySessionTTLSeconds = 59
+	require.Error(t, c.Validate())
+	c.ProxySessionTTLSeconds = 3601
+	require.Error(t, c.Validate())
+	c = DefaultGPTAccountRecoveryConfig()
+	c.Transport = "websocket"
+	require.NoError(t, c.Validate())
+	c.Transport = "unsupported"
+	require.Error(t, c.Validate())
+	c = GPTAccountRecoveryConfig{}
+	c.Normalize()
+	require.Equal(t, "none", c.ProxySessionMode)
+	require.Equal(t, 600, c.ProxySessionTTLSeconds)
+	require.Equal(t, "sse", c.Transport)
+}
+
+func TestGPTRecoverySharedRouteConfig(t *testing.T) {
+	c := DefaultGPTAccountRecoveryConfig()
+	require.False(t, c.ShareRouteCookies)
+	require.Empty(t, c.ShareRouteDonorAccountIDs)
+	c.ShareRouteCookies = true
+	c.ShareRouteDonorAccountIDs = []int64{8, 3}
+	require.NoError(t, c.Validate())
+	c.ShareRouteDonorAccountIDs = []int64{0}
+	require.Error(t, c.Validate())
+	c.ShareRouteDonorAccountIDs = []int64{-1}
+	require.Error(t, c.Validate())
+	c.ShareRouteDonorAccountIDs = make([]int64, 10001)
+	require.Error(t, c.Validate())
+}
diff --git a/backend/internal/handler/admin/gpt_account_recovery_handler.go b/backend/internal/handler/admin/gpt_account_recovery_handler.go
new file mode 100644
index 0000000000000000000000000000000000000000..c20f5695b2ce7362a06bb1077f5af12bbe64f39e
--- /dev/null
+++ b/backend/internal/handler/admin/gpt_account_recovery_handler.go
@@ -0,0 +1,234 @@
+package admin
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+type gptAccountRecoveryService interface {
+	GetConfig(context.Context) (config.GPTAccountRecoveryConfig, error)
+	SaveConfig(context.Context, config.GPTAccountRecoveryConfig) (config.GPTAccountRecoveryConfig, error)
+	Status(context.Context) (service.GPTAccountRecoveryStatus, error)
+	RunNow(context.Context) (bool, error)
+	RunAccount(context.Context, int64) (bool, error)
+	AccountResult(context.Context, int64) (service.GPTAccountRecoveryStatusAccount, error)
+}
+
+// GPTAccountRecoveryHandler is registered only within the existing admin group.
+type GPTAccountRecoveryHandler struct {
+	monitor gptAccountRecoveryService
+}
+
+func NewGPTAccountRecoveryHandler(monitor *service.GPTAccountRecoveryService) *GPTAccountRecoveryHandler {
+	h := &GPTAccountRecoveryHandler{}
+	if monitor != nil {
+		h.monitor = monitor
+	}
+	return h
+}
+
+func (h *GPTAccountRecoveryHandler) ready(c *gin.Context) bool {
+	if h == nil || h.monitor == nil {
+		response.Error(c, http.StatusServiceUnavailable, "智商恢复服务暂不可用")
+		return false
+	}
+	return true
+}
+
+func (h *GPTAccountRecoveryHandler) GetConfig(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	cfg, err := h.monitor.GetConfig(c.Request.Context())
+	if err != nil {
+		response.InternalError(c, "读取智商恢复配置失败")
+		return
+	}
+	if cfg.AccountIDs == nil {
+		cfg.AccountIDs = []int64{}
+	}
+	response.Success(c, gptAccountRecoveryConfigResponseFor(cfg))
+}
+
+// The proxy URL is server-only; administrators receive its presence, never credentials.
+type gptAccountRecoveryConfigResponse struct {
+	config.GPTAccountRecoveryConfig
+	ProxyOverrideConfigured bool `json:"proxy_override_configured"`
+}
+
+func gptAccountRecoveryConfigResponseFor(cfg config.GPTAccountRecoveryConfig) gptAccountRecoveryConfigResponse {
+	if cfg.ShareRouteDonorAccountIDs == nil {
+		cfg.ShareRouteDonorAccountIDs = []int64{}
+	}
+	proxyURL, exists := os.LookupEnv("GPT_ACCOUNT_RECOVERY_PROXY_URL")
+	return gptAccountRecoveryConfigResponse{GPTAccountRecoveryConfig: cfg, ProxyOverrideConfigured: exists && strings.TrimSpace(proxyURL) != ""}
+}
+
+// Original mutable fields are required because this endpoint replaces settings.
+// Model and newly introduced session/transport/sharing inputs remain optional for compatibility.
+// Pointer fields distinguish false/zero values from absent or null.
+type gptAccountRecoveryConfigRequest struct {
+	Enabled                   *bool    `json:"enabled"`
+	IntervalSeconds           *int     `json:"interval_seconds"`
+	TimeoutSeconds            *int     `json:"timeout_seconds"`
+	MaxAttempts               *int     `json:"max_attempts"`
+	Transport                 *string  `json:"transport"`
+	Gateway                   *string  `json:"gateway"`
+	TicketLength              *int     `json:"ticket_length"`
+	TicketTTLSeconds          *int     `json:"ticket_ttl_seconds"`
+	CookieTTLSeconds          *int     `json:"cookie_ttl_seconds"`
+	ShareRouteCookies         *bool    `json:"share_route_cookies"`
+	ShareRouteDonorAccountIDs *[]int64 `json:"share_route_donor_account_ids"`
+	ProxySessionMode          *string  `json:"proxy_session_mode"`
+	ProxySessionTTLSeconds    *int     `json:"proxy_session_ttl_seconds"`
+	Model                     *string  `json:"model"`
+	AccountIDs                *[]int64 `json:"account_ids"`
+	RunOnStart                *bool    `json:"run_on_start"`
+}
+
+func (h *GPTAccountRecoveryHandler) SaveConfig(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	decoder := json.NewDecoder(http.MaxBytesReader(c.Writer, c.Request.Body, 32*1024))
+	decoder.DisallowUnknownFields()
+	var request gptAccountRecoveryConfigRequest
+	if err := decoder.Decode(&request); err != nil {
+		response.BadRequest(c, "配置必须是有效 JSON，且不能包含未知字段或超过 32 KB")
+		return
+	}
+	if err := decoder.Decode(&struct{}{}); err != io.EOF {
+		response.BadRequest(c, "配置只能包含一个 JSON 对象")
+		return
+	}
+	if request.Enabled == nil || request.IntervalSeconds == nil || request.TimeoutSeconds == nil || request.MaxAttempts == nil || request.Gateway == nil || request.TicketLength == nil || request.TicketTTLSeconds == nil || request.CookieTTLSeconds == nil || request.AccountIDs == nil || request.RunOnStart == nil {
+		response.BadRequest(c, "请提交完整的智商恢复配置")
+		return
+	}
+	cfg := config.GPTAccountRecoveryConfig{
+		Enabled: *request.Enabled, IntervalSeconds: *request.IntervalSeconds,
+		TimeoutSeconds: *request.TimeoutSeconds, MaxAttempts: *request.MaxAttempts,
+		Gateway: strings.TrimSpace(*request.Gateway), TicketLength: *request.TicketLength, TicketTTLSeconds: *request.TicketTTLSeconds, CookieTTLSeconds: *request.CookieTTLSeconds, AccountIDs: *request.AccountIDs,
+		RunOnStart: *request.RunOnStart,
+	}
+	// Existing clients can omit newly introduced session, transport and sharing settings.
+	defaults := config.DefaultGPTAccountRecoveryConfig()
+	cfg.ShareRouteDonorAccountIDs = defaults.ShareRouteDonorAccountIDs
+	cfg.Transport = defaults.Transport
+	if request.Transport != nil {
+		cfg.Transport = *request.Transport
+	}
+	cfg.ProxySessionMode = defaults.ProxySessionMode
+	cfg.ProxySessionTTLSeconds = defaults.ProxySessionTTLSeconds
+	if request.ProxySessionMode != nil {
+		cfg.ProxySessionMode = *request.ProxySessionMode
+	}
+	if request.ProxySessionTTLSeconds != nil {
+		cfg.ProxySessionTTLSeconds = *request.ProxySessionTTLSeconds
+	}
+	if request.ShareRouteCookies != nil {
+		cfg.ShareRouteCookies = *request.ShareRouteCookies
+	}
+	if request.ShareRouteDonorAccountIDs != nil {
+		cfg.ShareRouteDonorAccountIDs = *request.ShareRouteDonorAccountIDs
+	}
+	cfg.Normalize()
+	if err := cfg.Validate(); err != nil {
+		response.BadRequest(c, "配置无效：间隔 60–86400 秒、超时 10–300 秒、尝试 1–20 次；取票通道为 sse/websocket、目标网关为 any 或 unified-N，代理会话模式为 none/kookeey/username_sid/template、会话有效期 60–3600 秒，账号 ID 必须为正整数")
+		return
+	}
+	saved, err := h.monitor.SaveConfig(c.Request.Context(), cfg)
+	if err != nil {
+		response.InternalError(c, "保存智商恢复配置失败")
+		return
+	}
+	if saved.AccountIDs == nil {
+		saved.AccountIDs = []int64{}
+	}
+	response.Success(c, gptAccountRecoveryConfigResponseFor(saved))
+}
+
+func (h *GPTAccountRecoveryHandler) Status(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	status, err := h.monitor.Status(c.Request.Context())
+	if err != nil {
+		response.InternalError(c, "读取智商恢复状态失败")
+		return
+	}
+	response.Success(c, status)
+}
+
+func (h *GPTAccountRecoveryHandler) RunNow(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	queued, err := h.monitor.RunNow(c.Request.Context())
+	if err != nil {
+		response.Error(c, http.StatusServiceUnavailable, "暂时无法启动恢复并稍后重试")
+		return
+	}
+	message := "恢复已在运行或已排队"
+	if queued {
+		message = "已提交立即恢复任务"
+	}
+	response.Success(c, gin.H{"queued": queued, "message": message})
+}
+
+func (h *GPTAccountRecoveryHandler) RunAccount(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	accountID, err := strconv.ParseInt(c.Param("id"), 10, 64)
+	if err != nil || accountID <= 0 {
+		response.BadRequest(c, "账号 ID 必须是有效的正整数")
+		return
+	}
+	queued, err := h.monitor.RunAccount(c.Request.Context(), accountID)
+	if err != nil {
+		if infraerrors.Code(err) < http.StatusInternalServerError {
+			response.ErrorFrom(c, err)
+		} else {
+			response.Error(c, http.StatusServiceUnavailable, "暂时无法启动智商恢复，请稍后重试")
+		}
+		return
+	}
+	message := "恢复已在运行或已排队"
+	if queued {
+		message = "已提交智商恢复任务"
+	}
+	response.Success(c, gin.H{"queued": queued, "message": message})
+}
+
+func (h *GPTAccountRecoveryHandler) AccountResult(c *gin.Context) {
+	if !h.ready(c) {
+		return
+	}
+	accountID, err := strconv.ParseInt(c.Param("id"), 10, 64)
+	if err != nil || accountID <= 0 {
+		response.BadRequest(c, "账号 ID 必须是有效的正整数")
+		return
+	}
+	result, err := h.monitor.AccountResult(c.Request.Context(), accountID)
+	if err != nil {
+		if infraerrors.Code(err) < http.StatusInternalServerError {
+			response.ErrorFrom(c, err)
+		} else {
+			response.Error(c, http.StatusServiceUnavailable, "暂时无法读取智商恢复结果，请稍后重试")
+		}
+		return
+	}
+	response.Success(c, result)
+}
