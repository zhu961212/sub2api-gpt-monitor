@@ -0,0 +1,562 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+type recoveryRoutingTestStore struct {
+	mu      sync.Mutex
+	tickets map[string]*GPTAccountRecoveryTicket
+	err     error
+}
+
+func (*recoveryRoutingTestStore) Acquire(context.Context, string, time.Duration) (bool, error) {
+	return true, nil
+}
+func (*recoveryRoutingTestStore) Renew(context.Context, string, time.Duration) (bool, error) {
+	return true, nil
+}
+func (*recoveryRoutingTestStore) Owns(context.Context, string) (bool, error) { return true, nil }
+func (*recoveryRoutingTestStore) Release(context.Context, string) error      { return nil }
+func (*recoveryRoutingTestStore) NextRun(context.Context, string) (time.Time, error) {
+	return time.Time{}, nil
+}
+func (*recoveryRoutingTestStore) SetNextRun(context.Context, string, time.Time) error { return nil }
+func (s *recoveryRoutingTestStore) LoadTicket(_ context.Context, key string) (*GPTAccountRecoveryTicket, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.err != nil {
+		return nil, s.err
+	}
+	if ticket := s.tickets[key]; ticket != nil {
+		copy := *ticket
+		return &copy, nil
+	}
+	return nil, nil
+}
+func (s *recoveryRoutingTestStore) SaveTicket(_ context.Context, key string, ticket *GPTAccountRecoveryTicket, _ time.Duration) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.err != nil {
+		return s.err
+	}
+	copy := *ticket
+	s.tickets[key] = &copy
+	return nil
+}
+func (s *recoveryRoutingTestStore) DeleteTicket(_ context.Context, key string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	delete(s.tickets, key)
+	return nil
+}
+
+func recoveryRoutingFixture() (*OpenAIGatewayService, *Account, *recoveryRoutingTestStore) {
+	proxyID := int64(17)
+	account := &Account{ID: 23, Platform: PlatformOpenAI, Type: AccountTypeOAuth, Status: StatusActive, ProxyID: &proxyID,
+		Proxy:       &Proxy{ID: proxyID, Protocol: "http", Host: "127.0.0.1", Port: 18123, Status: StatusActive},
+		Credentials: map[string]any{"access_token": "access-token-23", "chatgpt_account_id": "chatgpt-23", "organization_id": "org-23"},
+	}
+	store := &recoveryRoutingTestStore{tickets: make(map[string]*GPTAccountRecoveryTicket)}
+	s := &OpenAIGatewayService{cfg: &config.Config{}, gptRecoveryStore: store}
+	return s, account, store
+}
+
+func recoveryRoutingTicket(cflb, oailb string) *GPTAccountRecoveryTicket {
+	return &GPTAccountRecoveryTicket{Model: "gpt-6-astra", TurnState: "probe-turn", CFLB: cflb, OAILB: oailb,
+		IssuedAt: time.Now(), ExpiresAt: time.Now().Add(-time.Minute), CookieExpiresAt: time.Now().Add(time.Hour)}
+}
+
+func recoveryRoutingContext(path string) *gin.Context {
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Request = httptest.NewRequest(http.MethodPost, path, nil)
+	return c
+}
+
+func recoveryRoutingHeaders(account *Account) http.Header {
+	headers := make(http.Header)
+	headers.Set("Authorization", "Bearer "+account.GetOpenAIAccessToken())
+	setOpenAIChatGPTAccountHeaders(headers, account)
+	ensureCodexIdentityHeaders(headers)
+	enforceCodexIdentityHeadersWithUA(headers, account.GetOpenAIUserAgent())
+	return headers
+}
+
+func TestGPTRecoveryRoutingIdentityBindsCredentialsAndTransport(t *testing.T) {
+	s, account, _ := recoveryRoutingFixture()
+	key := s.gptRecoveryRoutingIdentityKey(account)
+	require.Len(t, key, 64)
+	require.NotContains(t, key, account.GetOpenAIAccessToken())
+	for _, tc := range []struct {
+		name   string
+		mutate func(*Account)
+	}{
+		{"another account", func(a *Account) { a.ID++ }},
+		{"token refresh", func(a *Account) { a.Credentials["access_token"] = "refreshed-token" }},
+		{"chatgpt account", func(a *Account) { a.Credentials["chatgpt_account_id"] = "other" }},
+		{"organization", func(a *Account) { a.Credentials["organization_id"] = "other" }},
+		{"proxy egress", func(a *Account) { a.Proxy.Host = "127.0.0.2" }},
+		{"proxy credential", func(a *Account) { a.Proxy.Username = "u"; a.Proxy.Password = "p" }},
+		{"user agent", func(a *Account) { a.Credentials["user_agent"] = "codex_vscode/0.160.0 (Linux)" }},
+		{"header override", func(a *Account) { a.Credentials[credKeyHeaderOverrides] = map[string]any{"x-custom": "changed"} }},
+		{"fingerprint", func(a *Account) {
+			a.Extra = map[string]any{codexFingerprintModeExtraKey: "device", codexFingerprintSeedExtraKey: "seed"}
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			_, changed, _ := recoveryRoutingFixture()
+			tc.mutate(changed)
+			require.NotEqual(t, key, s.gptRecoveryRoutingIdentityKey(changed))
+		})
+	}
+	account.Name = "renamed"
+	account.Extra = map[string]any{"quota_usage": 80}
+	require.Equal(t, key, s.gptRecoveryRoutingIdentityKey(account))
+	s.cfg.Gateway.ForceCodexCLI = true
+	require.NotEqual(t, key, s.gptRecoveryRoutingIdentityKey(account))
+}
+
+func TestGPTRecoveryRoutingHTTPBuildersAndFreshTurn(t *testing.T) {
+	for _, tc := range []struct {
+		name, path string
+		build      func(*OpenAIGatewayService, *gin.Context, *Account) (*http.Request, error)
+	}{
+		{"responses", "/v1/responses", func(s *OpenAIGatewayService, c *gin.Context, a *Account) (*http.Request, error) {
+			return s.buildUpstreamRequest(context.Background(), c, a, []byte(`{"model":"gpt-6-astra","input":"hi"}`), a.GetOpenAIAccessToken(), true, "session", true)
+		}},
+		{"compact", "/v1/responses/compact", func(s *OpenAIGatewayService, c *gin.Context, a *Account) (*http.Request, error) {
+			return s.buildUpstreamRequest(context.Background(), c, a, []byte(`{"model":"gpt-6-astra","input":"hi"}`), a.GetOpenAIAccessToken(), false, "session", true)
+		}},
+		{"passthrough", "/v1/responses", func(s *OpenAIGatewayService, c *gin.Context, a *Account) (*http.Request, error) {
+			return s.buildUpstreamRequestOpenAIPassthrough(context.Background(), c, a, []byte(`{"model":"gpt-6-astra","input":"hi"}`), a.GetOpenAIAccessToken())
+		}},
+		{"alpha search", "/v1/alpha/search", func(s *OpenAIGatewayService, c *gin.Context, a *Account) (*http.Request, error) {
+			return s.buildOpenAIAlphaSearchRequest(context.Background(), c, a, []byte(`{"commands":[]}`), a.GetOpenAIAccessToken())
+		}},
+		{"alpha responses fallback", "/v1/alpha/search", func(s *OpenAIGatewayService, c *gin.Context, a *Account) (*http.Request, error) {
