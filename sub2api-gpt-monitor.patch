+func TestGPTMonitorSchedulingGuardsEligibilitySchedulingAndProxyEndpoint(t *testing.T) {
+	for _, expires := range []*time.Time{nil, ptrTime(time.Now().Add(time.Hour))} {
+		for _, schedulable := range []bool{false, true} {
+			snapshot := gptMonitorAccountSnapshot()
+			snapshot.ExpiresAt = expires
+			snapshot.Schedulable = schedulable
+			snapshot.AutoPauseOnExpired = schedulable
+			capture := captureGPTMonitorSchedulingMutation(t, snapshot)
+			_, where, _ := strings.Cut(capture.query, " WHERE ")
+			accountWhere, _, _ := strings.Cut(where, "SELECT")
+			// Ent emits boolean equality as the column or NOT column.
+			guard := `AND "accounts"."schedulable"`
+			if !schedulable {
+				guard = `AND NOT "accounts"."schedulable"`
+			}
+			require.Contains(t, accountWhere, guard)
+			require.Equal(t, *snapshot.ProxyID, gptMonitorBoundPredicateValue(t, capture, `"proxy_id" = \$(\d+)`))
+			require.Equal(t, service.StatusActive, gptMonitorBoundPredicateValue(t, capture, `"accounts"\."status" = \$(\d+)`))
+			require.Equal(t, service.StatusActive, gptMonitorBoundPredicateValue(t, capture, `"proxies"\."status" = \$(\d+)`))
+			require.Equal(t, snapshot.Proxy.Protocol, gptMonitorBoundPredicateValue(t, capture, `"protocol" = \$(\d+)`))
+			require.Equal(t, snapshot.Proxy.Host, gptMonitorBoundPredicateValue(t, capture, `"host" = \$(\d+)`))
+			require.Equal(t, snapshot.Proxy.Port, gptMonitorBoundPredicateValue(t, capture, `"port" = \$(\d+)`))
+			require.Equal(t, snapshot.Proxy.Username, gptMonitorBoundPredicateValue(t, capture, `"username" = \$(\d+)`))
+			require.Equal(t, snapshot.Proxy.Password, gptMonitorBoundPredicateValue(t, capture, `"password" = \$(\d+)`))
+			require.Contains(t, where, `"accounts"."expires_at" IS NULL OR "accounts"."expires_at" >`)
+			require.Contains(t, where, `"proxies"."expires_at" IS NULL OR "proxies"."expires_at" >`)
+			require.NotContains(t, accountWhere, `"expires_at" =`, "renewal does not invalidate a still-eligible account")
+			require.NotContains(t, accountWhere, "auto_pause_on_expired")
+		}
+	}
+}
