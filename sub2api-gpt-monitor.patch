+package repository
+
+import (
+	"context"
+	"database/sql/driver"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/DATA-DOG/go-sqlmock"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/lib/pq"
+	"github.com/stretchr/testify/require"
+)
+
+var gptMonitorCandidateTestColumns = []string{
+	"id", "platform", "type", "status", "schedulable", "expires_at", "parent_account_id",
+}
+
+func TestListGPTMonitorCandidatesProjectsBoundedEligiblePage(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		ids  []int64
+	}{
+		{name: "all eligible accounts"},
+		{name: "selected accounts", ids: []int64{19, 23}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			db, mock, err := sqlmock.New()
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = db.Close() })
+			var query string
+			repo := newAccountRepositoryWithSQL(nil, captureQuerySQL{db: db, captured: &query}, nil)
+			expires := time.Now().Add(time.Hour)
+			args := []driver.Value{int64(17), 2}
+			if len(tc.ids) > 0 {
+				args = append(args, pq.Array(tc.ids))
+			}
+			mock.ExpectQuery("SELECT").WithArgs(args...).WillReturnRows(
+				sqlmock.NewRows(gptMonitorCandidateTestColumns).
+					AddRow(19, service.PlatformOpenAI, service.AccountTypeOAuth, service.StatusActive, false, expires, nil).
+					AddRow(23, service.PlatformOpenAI, service.AccountTypeOAuth, service.StatusActive, true, nil, nil)).RowsWillBeClosed()
+
+			accounts, err := repo.ListGPTMonitorCandidates(context.Background(), tc.ids, 17, 2)
+
+			require.NoError(t, err)
+			require.Len(t, accounts, 2)
+			require.Equal(t, int64(19), accounts[0].ID)
+			require.False(t, accounts[0].Schedulable, "disabled accounts must stay eligible for recovery")
+			require.Equal(t, expires, *accounts[0].ExpiresAt)
+			require.Nil(t, accounts[0].ParentAccountID)
+			require.Nil(t, accounts[0].Credentials)
+			require.Nil(t, accounts[0].Proxy)
+			require.Nil(t, accounts[0].Extra)
+			require.Nil(t, accounts[0].GroupIDs)
+			require.Nil(t, accounts[1].ExpiresAt)
+			normalized := normalizeSQLWhitespace(query)
+			requireGPTMonitorQueryEligibility(t, normalized)
+			require.Contains(t, normalized, "a.id > $1")
+			require.Contains(t, normalized, "ORDER BY a.id ASC LIMIT $2")
+			for _, heavy := range []string{"credentials", "extra", "JOIN", "OFFSET", "*"} {
+				require.NotContains(t, normalized, heavy)
+			}
+			if len(tc.ids) > 0 {
+				require.Contains(t, normalized, "a.id = ANY($3)")
+			} else {
+				require.NotContains(t, normalized, "ANY(")
+			}
+			require.NoError(t, mock.ExpectationsWereMet())
+		})
+	}
+}
+
+func TestListGPTMonitorCandidatesRejectsNonPositivePageSize(t *testing.T) {
+	repo := &accountRepository{}
+	for _, limit := range []int{0, -1} {
+		accounts, err := repo.ListGPTMonitorCandidates(context.Background(), nil, 0, limit)
+		require.NoError(t, err)
+		require.Empty(t, accounts)
+	}
+}
+
+func TestListGPTMonitorAccountsProjectsOnlyStatusDisplayData(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		ids  []int64
+	}{
+		{name: "all eligible accounts"},
+		{name: "selected accounts", ids: []int64{19, 23}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			db, mock, err := sqlmock.New()
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = db.Close() })
+			var query string
+			repo := newAccountRepositoryWithSQL(nil, captureQuerySQL{db: db, captured: &query}, nil)
+			args := []driver.Value{}
+			if len(tc.ids) > 0 {
+				args = append(args, pq.Array(tc.ids))
+			}
+			columns := append(append([]string{}, gptMonitorCandidateTestColumns...), "name", "proxy_name", "monitor")
+			mock.ExpectQuery("SELECT").WithArgs(args...).WillReturnRows(
+				sqlmock.NewRows(columns).
+					AddRow(19, service.PlatformOpenAI, service.AccountTypeOAuth, service.StatusActive, false, nil, nil, "paused account", "proxy display name", []byte(`{"verdict":"abnormal","checked_at":"2026-10-13T00:00:00Z"}`)).
+					AddRow(23, service.PlatformOpenAI, service.AccountTypeOAuth, service.StatusActive, true, nil, nil, "pending account", nil, nil)).RowsWillBeClosed()
+
+			accounts, err := repo.ListGPTMonitorAccounts(context.Background(), tc.ids)
+
+			require.NoError(t, err)
+			require.Len(t, accounts, 2)
+			require.Equal(t, "paused account", accounts[0].Name)
+			require.False(t, accounts[0].Schedulable)
+			require.Equal(t, &service.Proxy{Name: "proxy display name"}, accounts[0].Proxy)
+			require.Equal(t, map[string]any{"gpt_account_monitor": map[string]any{"verdict": "abnormal", "checked_at": "2026-10-13T00:00:00Z"}}, accounts[0].Extra)
+			require.Nil(t, accounts[0].Credentials)
+			require.Nil(t, accounts[0].Groups)
+			require.Nil(t, accounts[1].Proxy)
+			require.Nil(t, accounts[1].Extra)
+			normalized := normalizeSQLWhitespace(query)
+			requireGPTMonitorQueryEligibility(t, normalized)
+			projection, _, ok := strings.Cut(normalized, " FROM ")
+			require.True(t, ok)
+			require.Equal(t, "SELECT a.id, a.platform, a.type, a.status, a.schedulable, a.expires_at, a.parent_account_id , a.name, p.name, a.extra -> 'gpt_account_monitor'", projection)
+			require.Contains(t, normalized, "LEFT JOIN proxies AS p ON p.id = a.proxy_id AND p.deleted_at IS NULL")
+			for _, heavy := range []string{"credentials", "username", "password", "host", "protocol", "account_groups", "LIMIT", "OFFSET", "*"} {
+				require.NotContains(t, normalized, heavy)
+			}
+			if len(tc.ids) > 0 {
+				require.Contains(t, normalized, "a.id = ANY($1)")
+			} else {
+				require.NotContains(t, normalized, "ANY(")
+			}
+			require.NoError(t, mock.ExpectationsWereMet())
+		})
+	}
+}
+
+func requireGPTMonitorQueryEligibility(t *testing.T, query string) {
+	t.Helper()
+	_, where, ok := strings.Cut(query, " WHERE ")
+	require.True(t, ok)
+	for _, predicate := range []string{
+		"a.deleted_at IS NULL", "a.platform = 'openai'", "a.type = 'oauth'",
+		"a.status = 'active'", "a.parent_account_id IS NULL",
+		"a.expires_at IS NULL OR a.expires_at > CURRENT_TIMESTAMP",
+	} {
+		require.Contains(t, where, predicate)
+	}
+	require.NotContains(t, where, "schedulable", "paused accounts need to remain visible and eligible for recovery")
+}
+
+func TestGPTMonitorQueriesPropagateDatabaseErrors(t *testing.T) {
+	for _, status := range []bool{false, true} {
+		for _, mode := range []string{"query", "scan", "iteration"} {
+			name := "candidates " + mode
+			if status {
+				name = "status " + mode
+			}
+			t.Run(name, func(t *testing.T) {
+				db, mock, err := sqlmock.New()
+				require.NoError(t, err)
+				t.Cleanup(func() { _ = db.Close() })
+				repo := newAccountRepositoryWithSQL(nil, db, nil)
+				expected := errors.New("database failed")
+				query := mock.ExpectQuery("SELECT")
+				switch mode {
+				case "query":
+					query.WillReturnError(expected)
+				case "scan":
+					query.WillReturnRows(sqlmock.NewRows([]string{"id"}).AddRow("invalid")).RowsWillBeClosed()
+				case "iteration":
+					query.WillReturnRows(sqlmock.NewRows([]string{"id"}).AddRow(19).RowError(0, expected)).RowsWillBeClosed()
+				}
+				var accounts []service.Account
+				if status {
+					accounts, err = repo.ListGPTMonitorAccounts(context.Background(), nil)
+				} else {
+					accounts, err = repo.ListGPTMonitorCandidates(context.Background(), nil, 0, 200)
+				}
+				require.Error(t, err)
+				require.Nil(t, accounts)
+				if mode != "scan" {
+					require.ErrorIs(t, err, expected)
+				}
+				require.NoError(t, mock.ExpectationsWereMet())
+			})
+		}
+	}
+}
