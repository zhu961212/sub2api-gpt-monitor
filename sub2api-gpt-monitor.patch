+
+type gptMonitorTransportUpstream struct {
+	HTTPUpstream
+	do      func(*http.Request, string, int64, int) (*http.Response, error)
+	withTLS func(*http.Request, string, int64, int, *tlsfingerprint.Profile) (*http.Response, error)
+}
+
+func (u *gptMonitorTransportUpstream) DoWithTLS(req *http.Request, proxyURL string, accountID int64, concurrency int, profile *tlsfingerprint.Profile) (*http.Response, error) {
+	if u.withTLS != nil {
+		return u.withTLS(req, proxyURL, accountID, concurrency, profile)
+	}
+	return u.do(req, proxyURL, accountID, concurrency)
+}
+
+func (u *gptMonitorTransportUpstream) Do(req *http.Request, proxyURL string, accountID int64, concurrency int) (*http.Response, error) {
+	return u.do(req, proxyURL, accountID, concurrency)
+}
+
+func TestGPTMonitorSharedTransportKeepsProxyIdentityAndDeadline(t *testing.T) {
+	account := gptMonitorTestAccount()
+	account.Concurrency = 4
+	account.Proxy.FallbackMode = FallbackModeDirect
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Minute)
+	defer cancel()
+	deadline, _ := ctx.Deadline()
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, chatgptCodexURL, strings.NewReader(`{}`))
+	require.NoError(t, err)
+	req.Header.Set("Authorization", "Bearer test-token")
+	response := &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader(gptMonitorCompleted("iPhone 17")))}
+	calls := 0
+	s := &OpenAIGatewayService{httpUpstream: &gptMonitorTransportUpstream{do: func(actual *http.Request, proxyURL string, accountID int64, concurrency int) (*http.Response, error) {
+		calls++
+		require.Equal(t, account.Proxy.URL(), proxyURL)
+		require.Equal(t, account.ID, accountID)
+		require.Equal(t, account.Concurrency, concurrency)
+		require.Equal(t, HTTPUpstreamProfileOpenAI, HTTPUpstreamProfileFromContext(actual.Context()))
+		require.True(t, HTTPUpstreamRedirectsDisabled(actual.Context()))
+		actualDeadline, ok := actual.Context().Deadline()
+		require.True(t, ok)
+		require.Equal(t, deadline, actualDeadline, "the configured probe budget must not shrink")
+		require.Equal(t, req.URL, actual.URL)
+		require.Equal(t, req.Header, actual.Header)
+		return response, nil
+	}}}
+	got, err := s.doGPTMonitorRequest(req, account)
+	require.NoError(t, err)
+	require.Same(t, response, got)
+	require.NoError(t, got.Body.Close())
+	require.Equal(t, 1, calls)
+	require.True(t, account.Schedulable)
+	require.False(t, HTTPUpstreamRedirectsDisabled(req.Context()), "request-specific policy must not mutate the caller's context")
+}
+
+func TestGPTMonitorFingerprintResolutionMatchesOAuthConnectionTest(t *testing.T) {
+	account := gptMonitorTestAccount()
+	account.Extra = map[string]any{"enable_tls_fingerprint": true, "tls_fingerprint_profile_id": int64(9)}
+	profiles := &TLSFingerprintProfileService{}
+	// The current host enables spoofed TLS only for Anthropic identities. Both
+	// OpenAI diagnostic entry points must use the same resolver policy.
+	expected := profiles.ResolveTLSProfile(account)
+	require.Nil(t, expected)
+	calls := 0
+	s := &OpenAIGatewayService{gptMonitorTLSProfiles: profiles, httpUpstream: &gptMonitorTransportUpstream{
+		do: func(*http.Request, string, int64, int) (*http.Response, error) {
+			t.Fatal("monitor must use the same fingerprint-aware transport entry point as connection testing")
+			return nil, nil
+		},
+		withTLS: func(req *http.Request, proxyURL string, id int64, concurrency int, profile *tlsfingerprint.Profile) (*http.Response, error) {
+			calls++
