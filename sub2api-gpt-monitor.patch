+import recovery from '@/api/admin/gptAccountRecovery'
+
+describe('GPT account recovery API', () => {
+  beforeEach(() => { vi.clearAllMocks() })
+
+  it('uses recovery endpoints and forwards cancellation for all actions', async () => {
+    const signal = new AbortController().signal
+    const config = { enabled: false, interval_seconds: 1800, timeout_seconds: 90, max_attempts: 6, model: 'gpt-6-astra', gateway: 'any', ticket_length: 0, ticket_ttl_seconds: 240, cookie_ttl_seconds: 3900, account_ids: [], run_on_start: true }
+    get.mockResolvedValue({ data: config })
+    put.mockResolvedValue({ data: config })
+    post.mockResolvedValue({ data: { queued: true, message: 'queued' } })
+    expect(await recovery.getConfig(signal)).toEqual(config)
+    expect(await recovery.saveConfig(config, signal)).toEqual(config)
+    await recovery.getStatus(signal)
+    await recovery.run(signal)
+    await recovery.runAccount(42, signal)
+    await recovery.getAccountResult(42, signal)
+    expect(get.mock.calls).toEqual([
+      ['/admin/gpt-account-recovery/config', { signal }],
+      ['/admin/gpt-account-recovery/status', { signal }],
+      ['/admin/gpt-account-recovery/accounts/42/result', { signal }],
+    ])
+    expect(put).toHaveBeenCalledWith('/admin/gpt-account-recovery/config', config, { signal })
+    expect(post.mock.calls).toEqual([
+      ['/admin/gpt-account-recovery/run', undefined, { signal }],
+      ['/admin/gpt-account-recovery/accounts/42/run', undefined, { signal }],
+    ])
+  })
+})
