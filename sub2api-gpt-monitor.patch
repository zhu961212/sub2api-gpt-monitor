+package service
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestGPTMonitorManualResultReadReportsCancellationAndLostConsumedOutcomeWithoutReplaying(t *testing.T) {
+	for _, changed := range []bool{false, true} {
+		t.Run(map[bool]string{false: "lost final outcome", true: "configuration changed"}[changed], func(t *testing.T) {
+			s, repo, _ := gptMonitorFixture()
+			deadline := time.Now().UTC().Add(-time.Minute)
+			key := gptMonitorConfigHash(s.cfg)
+			if changed {
+				key = "previous configuration"
+			}
+			previous := GPTAccountMonitorResult{ConfigKey: key, Verdict: "abnormal", PendingVerdict: "abnormal", Consecutive: 1, ManualRunning: true, ManualAttempts: 2, NextCheckAt: &deadline}
+			repo.accounts[0].Extra = map[string]any{"gpt_account_monitor": previous}
+			s.probe = func(context.Context, int64, string, string) (*Account, string, error) {
+				t.Fatal("reading an unconfirmed outcome must not replay a consumed probe")
+				return nil, "", nil
+			}
+			row, err := s.AccountResult(context.Background(), 1)
+			require.NoError(t, err)
+			require.False(t, row.ManualRunning)
+			require.False(t, row.ManualRequested)
+			require.Equal(t, "error", row.Verdict)
+			require.Empty(t, row.PendingVerdict)
+			require.Empty(t, repo.writes)
+			require.Empty(t, repo.results, "GET must remain read-only")
+			require.True(t, gptMonitorSavedResult(repo.snapshot(1)).ManualRunning)
+			if changed {
+				require.Equal(t, "manual_config_changed", row.ErrorCode)
+			} else {
+				require.Equal(t, "manual_result_unconfirmed", row.ErrorCode)
+			}
+		})
+	}
+}
diff --git a/backend/internal/service/gpt_account_monitor_probe.go b/backend/internal/service/gpt_account_monitor_probe.go
new file mode 100644
index 0000000000000000000000000000000000000000..2804241007cc3ca2f478eabfa0751f8d56cc10ec
--- /dev/null
+++ b/backend/internal/service/gpt_account_monitor_probe.go
@@ -0,0 +1,194 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+)
+
+// This private context value is honored only by monitor-initiated token refresh.
+// Pin the full proxy identity so refresh cannot silently change egress or go direct.
+type gptMonitorProxyContextKey struct{}
+type gptMonitorPinnedProxy struct {
+	ID  int64
+	URL string
+}
+
+func validateGPTMonitorProxy(proxy *Proxy) error {
+	if proxy == nil || !proxy.IsActive() || proxy.IsExpired(time.Now()) || strings.TrimSpace(proxy.Host) == "" || proxy.Port < 1 || proxy.Port > 65535 {
+		return gptMonitorError("proxy_unavailable", "账号必须绑定启用且未过期的代理")
+	}
+	if _, err := validGPTMonitorProxyURL(proxy.URL()); err != nil {
+		return err
+	}
+	return nil
+}
+
+func validateGPTMonitorAccount(account *Account) error {
+	if account == nil || !account.IsActive() || !account.IsOpenAIOAuth() || account.IsShadow() || account.IsOpenAIAgentIdentity() {
+		return gptMonitorError("account_ineligible", "检测仅支持启用的独立 OpenAI OAuth 账号")
+	}
+	if account.ExpiresAt != nil && !account.ExpiresAt.After(time.Now()) {
+		return gptMonitorError("account_expired", "账号已过期")
+	}
+	if account.ProxyID == nil || account.Proxy == nil || account.Proxy.ID != *account.ProxyID {
+		return gptMonitorError("proxy_missing", "账号未绑定有效代理，请先绑定代理")
+	}
+	return validateGPTMonitorProxy(account.Proxy)
+}
+
+// ProbeGPTAccount uses the account's own OAuth credentials and pinned proxy.
+// The returned snapshot was reread after token refresh and is suitable for the
+// caller's conditional scheduling update. Errors never count as a bad answer.
+func (s *OpenAIGatewayService) ProbeGPTAccount(ctx context.Context, accountID int64, _ string, prompt string) (*Account, string, error) {
+	if s == nil || s.accountRepo == nil || accountID <= 0 {
+		return nil, "", gptMonitorError("service_unavailable", "账号检测服务不可用")
+	}
+	if strings.TrimSpace(prompt) == "" || len(prompt) > 8192 {
+		return nil, "", gptMonitorError("invalid_prompt", "检测问题无效")
+	}
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Minute)
+	defer cancel()
+	account, token, err := s.resolveGPTMonitorIdentity(ctx, accountID)
+	if err != nil {
+		return nil, "", err
+	}
+	answer, err := gptMonitorProbeWithDo(ctx, func(req *http.Request) (*http.Response, error) {
+		return s.doGPTMonitorRequest(req, account)
+	}, account, token, prompt)
+	return account, answer, err
+}
+
+func (s *OpenAIGatewayService) resolveGPTMonitorIdentity(ctx context.Context, accountID int64) (*Account, string, error) {
+	account, err := s.accountRepo.GetByID(ctx, accountID)
+	if err != nil {
+		return nil, "", gptMonitorError("account_read_failed", "读取账号失败")
+	}
+	if err := validateGPTMonitorAccount(account); err != nil {
+		return nil, "", err
+	}
+	if account.ID != accountID {
+		return nil, "", gptMonitorError("identity_changed", "账号已变化，请重新检测")
+	}
+	// The regular provider disables irrecoverably expired credentials. A monitor
+	// must leave scheduling alone when token acquisition cannot be completed.
+	if expires := account.GetCredentialAsTime("expires_at"); expires != nil && !expires.After(time.Now()) && strings.TrimSpace(account.GetOpenAIRefreshToken()) == "" && !account.IsOpenAIPersonalAccessToken() {
+		return nil, "", gptMonitorError("token_expired", "访问令牌已过期且无法刷新，请重新授权账号")
+	}
+	pinned := gptMonitorPinnedProxy{ID: account.Proxy.ID, URL: account.Proxy.URL()}
+	ctx = context.WithValue(ctx, gptMonitorProxyContextKey{}, pinned)
+	token, _, err := s.GetAccessToken(ctx, account)
+	if err != nil || strings.TrimSpace(token) == "" {
+		if ctx.Err() != nil {
+			return nil, "", gptMonitorTransportError(ctx.Err())
+		}
+		return nil, "", gptMonitorError("token_acquisition_failed", "获取或刷新账号访问令牌失败，请检查授权和代理")
+	}
+	account, err = s.accountRepo.GetByID(ctx, accountID)
+	if err != nil {
+		return nil, "", gptMonitorError("account_read_failed", "重新读取账号失败")
+	}
+	if err := validateGPTMonitorAccount(account); err != nil {
+		return nil, "", err
+	}
+	if account.ID != accountID || account.Proxy.ID != pinned.ID || account.Proxy.URL() != pinned.URL {
+		return nil, "", gptMonitorError("proxy_changed", "账号代理已变化，请重新检测")
+	}
+	if token != account.GetOpenAIAccessToken() {
+		// The provider is cache-first. A normal refresh can leave that cached
+		// value behind the database snapshot; use the current persisted token
+		// with the current account headers rather than declaring a probe failure.
+		token = strings.TrimSpace(account.GetOpenAIAccessToken())
+		if token == "" {
+			return nil, "", gptMonitorError("token_acquisition_failed", "账号缺少访问令牌，请重新授权账号")
+		}
+		if expires := account.GetCredentialAsTime("expires_at"); !account.IsOpenAIPersonalAccessToken() && expires != nil && !expires.After(time.Now()) {
+			return nil, "", gptMonitorError("token_expired", "最新访问令牌已过期，请重新检测或重新授权账号")
+		}
+	}
+	return account, token, nil
+}
+
+func validGPTMonitorProxyURL(raw string) (*url.URL, error) {
+	u, err := url.Parse(raw)
+	if err != nil || u.Hostname() == "" || u.Fragment != "" || u.RawQuery != "" || (u.Path != "" && u.Path != "/") {
+		return nil, gptMonitorError("proxy_invalid", "账号代理地址无效")
+	}
+	switch u.Scheme {
+	case "http", "https", "socks5", "socks5h":
+	default:
+		return nil, gptMonitorError("proxy_invalid", "账号代理协议不受支持")
+	}
+	return u, nil
+}
+
+func newGPTMonitorClient(proxyURL string) (*http.Client, *http.Transport, error) {
+	proxy, err := validGPTMonitorProxyURL(proxyURL)
+	if err != nil {
+		return nil, nil, err
+	}
+	// Never inherit HTTP_PROXY / HTTPS_PROXY or silently retry directly.
+	transport := &http.Transport{Proxy: http.ProxyURL(proxy),
+		DialContext:       (&net.Dialer{Timeout: 30 * time.Second, KeepAlive: 30 * time.Second}).DialContext,
+		ForceAttemptHTTP2: true, MaxIdleConns: 1, MaxIdleConnsPerHost: 1,
+		IdleConnTimeout: 30 * time.Second, TLSHandshakeTimeout: 15 * time.Second,
+		// The request context owns the configured probe deadline, including headers.
+		ResponseHeaderTimeout: 0, ExpectContinueTimeout: time.Second,
+	}
+	client := &http.Client{Transport: transport, Timeout: 5 * time.Minute, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	return client, transport, nil
+}
+
+func gptMonitorProbeWithDo(ctx context.Context, do func(*http.Request) (*http.Response, error), account *Account, token, prompt string) (string, error) {
+	// Fixed independently of saved settings, account mappings and routing aliases.
+	// An unavailable model/effort is a probe error; never retry with another model.
+	payload := map[string]any{
+		"model": config.GPTAccountMonitorModel, "reasoning": map[string]any{"effort": config.GPTAccountMonitorReasoningEffort},
+		"instructions": "Answer the user's question from your existing knowledge only. Do not browse, search, call tools, or guess. Respond with only the phone model you know.",
+		"input":        []any{map[string]any{"role": "user", "content": []any{map[string]any{"type": "input_text", "text": prompt}}}},
+		"stream":       true, "store": false, "tools": []any{}, "tool_choice": "none",
+	}
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return "", gptMonitorError("invalid_request", "无法构造检测请求")
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, chatgptCodexURL, bytes.NewReader(body))
+	if err != nil {
+		return "", gptMonitorError("invalid_request", "无法构造检测请求")
+	}
+	req.Host = "chatgpt.com"
+	canonical := resolveCodexOutboundIdentity("")
+	req.Header.Set("Originator", canonical.originator)
+	if ua := strings.TrimSpace(account.GetOpenAIUserAgent()); ua != "" {
+		req.Header.Set("User-Agent", ua)
+	} else {
+		req.Header.Set("User-Agent", canonical.userAgent)
+	}
+	setOpenAIChatGPTAccountHeaders(req.Header, account)
+	enforceCodexIdentityHeadersWithUA(req.Header, account.GetOpenAIUserAgent())
+	account.ApplyHeaderOverrides(req.Header)
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "text/event-stream")
+	req.Header.Set("OpenAI-Beta", "responses=experimental")
+	resp, err := do(req)
+	if err != nil {
+		return "", gptMonitorTransportError(err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return "", gptMonitorHTTPError(resp.StatusCode, resp.Body)
+	}
+	answer, err := readGPTMonitorResponse(resp.Body)
+	if err != nil && ctx.Err() != nil {
+		return "", gptMonitorTransportError(ctx.Err())
+	}
+	return answer, err
+}
diff --git a/backend/internal/service/gpt_account_monitor_probe_test.go b/backend/internal/service/gpt_account_monitor_probe_test.go
