+	ConfigKey       string    `json:"config_key,omitempty"`
+}
+
+type GPTAccountRecoveryStore interface {
+	Acquire(context.Context, string, time.Duration) (bool, error)
+	Renew(context.Context, string, time.Duration) (bool, error)
+	Owns(context.Context, string) (bool, error)
+	Release(context.Context, string) error
+	NextRun(context.Context, string) (time.Time, error)
+	SetNextRun(context.Context, string, time.Time) error
+	LoadTicket(context.Context, string) (*GPTAccountRecoveryTicket, error)
+	SaveTicket(context.Context, string, *GPTAccountRecoveryTicket, time.Duration) error
+	DeleteTicket(context.Context, string) error
+}
+
+type GPTAccountRecoveryResult struct {
+	CheckedAt       time.Time  `json:"checked_at"`
+	Verdict         string     `json:"verdict"`
+	Message         string     `json:"message"`
+	Model           string     `json:"model"`
+	Gateway         string     `json:"gateway,omitempty"`
+	TicketLength    int        `json:"ticket_length,omitempty"`
+	Attempts        int        `json:"attempts,omitempty"`
+	ExpiresAt       *time.Time `json:"expires_at,omitempty"`
+	CookieExpiresAt *time.Time `json:"cookie_expires_at,omitempty"`
+	ErrorCode       string     `json:"error_code,omitempty"`
+	HTTPStatus      int        `json:"http_status,omitempty"`
+	DurationMS      int64      `json:"duration_ms,omitempty"`
+	NextCheckAt     *time.Time `json:"next_check_at,omitempty"`
+	ManualRequested bool       `json:"manual_requested,omitempty"`
+	TicketReady     bool       `json:"ticket_ready"`
+	CookieReady     bool       `json:"cookie_ready"`
+	Schedulable     bool       `json:"schedulable"`
+}
+type GPTAccountRecoveryStatusAccount struct {
+	AccountID int64  `json:"account_id"`
+	Name      string `json:"name"`
+	ProxyName string `json:"proxy_name,omitempty"`
+	GPTAccountRecoveryResult
+}
+type GPTAccountRecoveryStatus struct {
+	Enabled           bool                              `json:"enabled"`
+	Running           bool                              `json:"running"`
+	Queued            bool                              `json:"queued"`
+	LastRun           *time.Time                        `json:"last_run"`
+	NextRun           *time.Time                        `json:"next_run"`
+	Message           string                            `json:"message"`
+	TotalAccounts     int                               `json:"total_accounts"`
+	ProcessedAccounts int                               `json:"processed_accounts"`
+	RunTotalAccounts  int                               `json:"run_total_accounts"`
+	Accounts          []GPTAccountRecoveryStatusAccount `json:"accounts"`
+}
+type gptRecoveryReadRepository interface {
+	ListGPTRecoveryCandidates(context.Context, []int64, int64, int) ([]Account, error)
+	ListGPTRecoveryAccounts(context.Context, []int64) ([]Account, error)
+}
+type gptRecoveryResultRepository interface {
+	UpdateGPTRecoveryResult(context.Context, int64, GPTAccountRecoveryResult) error
+}
+type gptRecoveryJob struct {
+	cfg       config.GPTAccountRecoveryConfig
+	id        int64
+	automatic bool
+}
+type GPTAccountRecoveryService struct {
+	repo            AccountRepository
+	gateway         *OpenAIGatewayService
+	store           GPTAccountRecoveryStore
+	settings        SettingRepository
+	defaults        config.GPTAccountRecoveryConfig
+	mu              sync.Mutex
+	configMu        sync.RWMutex
+	state           GPTAccountRecoveryStatus
+	jobs            chan gptRecoveryJob
+	wake            chan struct{}
+	cancel          context.CancelFunc
+	activeCancel    context.CancelFunc
+	done            chan struct{}
+	startOnce       sync.Once
+	stopOnce        sync.Once
+	revision        uint64
+	pendingID       int64
+	refreshDeadline time.Time
+	singleRun       bool
+}
+
+func NewGPTAccountRecoveryService(repo AccountRepository, gateway *OpenAIGatewayService, store GPTAccountRecoveryStore, settings SettingRepository, cfg *config.Config) *GPTAccountRecoveryService {
+	defaults := config.DefaultGPTAccountRecoveryConfig()
+	if cfg != nil {
+		defaults = cfg.GPTAccountRecovery
+	}
+	defaults.Normalize()
+	return &GPTAccountRecoveryService{repo: repo, gateway: gateway, store: store, settings: settings, defaults: defaults, jobs: make(chan gptRecoveryJob, 1), wake: make(chan struct{}, 1)}
+}
+func cloneGPTRecoveryConfig(c config.GPTAccountRecoveryConfig) config.GPTAccountRecoveryConfig {
+	c.Normalize()
+	c.AccountIDs = append([]int64{}, c.AccountIDs...)
+	sort.Slice(c.AccountIDs, func(i, j int) bool { return c.AccountIDs[i] < c.AccountIDs[j] })
+	return c
+}
+func gptRecoveryConfigKey(c config.GPTAccountRecoveryConfig) string {
+	raw, _ := json.Marshal(cloneGPTRecoveryConfig(c))
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:])
+}
+func gptRecoveryInterval(c config.GPTAccountRecoveryConfig) time.Duration {
+	interval := time.Duration(c.IntervalSeconds) * time.Second
+	lease := time.Duration(c.CookieTTLSeconds-30) * time.Second
+	if lease < interval {
+		interval = lease
+	}
+	return interval
+}
+func (s *GPTAccountRecoveryService) GetConfig(ctx context.Context) (config.GPTAccountRecoveryConfig, error) {
+	c := cloneGPTRecoveryConfig(s.defaults)
+	if s.settings == nil {
+		return c, nil
+	}
+	raw, err := s.settings.GetValue(ctx, SettingKeyGPTAccountRecoveryConfig)
+	if errors.Is(err, ErrSettingNotFound) {
+		return c, nil
+	}
+	if err != nil {
+		return c, err
+	}
+	if json.Unmarshal([]byte(raw), &c) != nil {
+		return c, errors.New("invalid recovery config")
+	}
+	c.Normalize()
+	return cloneGPTRecoveryConfig(c), c.Validate()
+}
+func (s *GPTAccountRecoveryService) SaveConfig(ctx context.Context, c config.GPTAccountRecoveryConfig) (config.GPTAccountRecoveryConfig, error) {
+	c.Normalize()
+	if err := c.Validate(); err != nil {
+		return c, infraerrors.BadRequest("INVALID_RECOVERY_CONFIG", err.Error())
+	}
+	c = cloneGPTRecoveryConfig(c)
+	ids := []int64{}
+	for _, id := range c.AccountIDs {
+		if len(ids) == 0 || ids[len(ids)-1] != id {
+			ids = append(ids, id)
+		}
+	}
+	c.AccountIDs = ids
+	if s.settings == nil {
+		return c, errors.New("recovery settings unavailable")
+	}
+	raw, err := json.Marshal(c)
+	if err != nil {
+		return c, err
+	}
+	s.configMu.Lock()
+	defer s.configMu.Unlock()
+	if err = s.settings.Set(ctx, SettingKeyGPTAccountRecoveryConfig, string(raw)); err != nil {
+		return c, err
+	}
+	s.mu.Lock()
+	s.revision++
+	if s.activeCancel != nil {
+		s.activeCancel()
+	}
+	s.state.Enabled = c.Enabled
+	s.state.NextRun = nil
+	s.mu.Unlock()
+	select {
+	case s.wake <- struct{}{}:
+	default:
+	}
+	return c, nil
+}
+func (s *GPTAccountRecoveryService) Start() {
+	if s == nil {
+		return
+	}
+	s.startOnce.Do(func() {
+		if s.repo == nil || s.gateway == nil || s.store == nil || s.defaults.Validate() != nil {
+			return
+		}
+		if _, ok := s.repo.(gptRecoveryReadRepository); !ok {
+			return
+		}
+		ctx, cancel := context.WithCancel(context.Background())
+		s.mu.Lock()
+		s.cancel = cancel
+		s.done = make(chan struct{})
+		s.mu.Unlock()
+		go s.loop(ctx)
+	})
+}
+func (s *GPTAccountRecoveryService) Stop() {
+	if s == nil {
+		return
+	}
+	s.stopOnce.Do(func() {
+		s.mu.Lock()
+		cancel, done := s.cancel, s.done
+		s.cancel = nil
+		s.mu.Unlock()
+		if cancel != nil {
+			cancel()
+			select {
+			case <-done:
+			case <-time.After(5 * time.Second):
+			}
+		}
+	})
+}
+func (s *GPTAccountRecoveryService) loop(ctx context.Context) {
+	defer close(s.done)
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	var next time.Time
+	var previous string
+	var lastRead time.Time
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case job := <-s.jobs:
+			s.execute(ctx, job)
+		case <-s.wake:
+			next = time.Time{}
+			previous = ""
+			lastRead = time.Time{}
+		case <-ticker.C:
+			if !lastRead.IsZero() && time.Since(lastRead) < 5*time.Second {
+				continue
+			}
+			readCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
+			c, err := s.GetConfig(readCtx)
+			cancel()
+			if err != nil {
+				s.mu.Lock()
+				s.state.Message = "读取恢复配置失败，等待重试"
+				s.mu.Unlock()
+				continue
+			}
+			lastRead = time.Now()
+			raw, _ := json.Marshal(c)
+			key := string(raw)
+			if key != previous {
+				previous = key
+				next = time.Now().Add(gptRecoveryInterval(c))
+				if c.RunOnStart {
+					next = time.Now()
+				}
+			}
+			if c.Enabled {
+				readCtx, readCancel := context.WithTimeout(ctx, 3*time.Second)
+				shared, e := s.store.NextRun(readCtx, gptRecoveryConfigKey(c))
+				readCancel()
+				if e != nil {
+					s.setRecoveryMessage("读取恢复计划失败，等待重试")
+					continue
+				}
+				if !shared.IsZero() {
+					next = shared
+				}
+			}
+			s.mu.Lock()
+			s.state.Enabled = c.Enabled
+			if c.Enabled {
+				nextSnapshot := next
+				s.state.NextRun = &nextSnapshot
+			} else {
+				s.state.NextRun = nil
+			}
+			s.mu.Unlock()
+			if c.Enabled && !time.Now().Before(next) {
+				s.execute(ctx, gptRecoveryJob{cfg: c, automatic: true})
+				next = time.Now().Add(gptRecoveryInterval(c))
+			}
+		}
+	}
+}
+func (s *GPTAccountRecoveryService) enqueue(ctx context.Context, id int64) (bool, error) {
+	s.configMu.RLock()
+	defer s.configMu.RUnlock()
+	c, err := s.GetConfig(ctx)
+	if err != nil {
+		return false, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.cancel == nil {
+		return false, infraerrors.ServiceUnavailable("RECOVERY_UNAVAILABLE", "恢复服务未启动")
+	}
+	if s.state.Running || s.state.Queued {
+		return false, nil
+	}
+	s.state.Queued = true
+	s.pendingID = id
+	select {
+	case s.jobs <- gptRecoveryJob{cfg: c, id: id}:
+		return true, nil
+	default:
+		s.state.Queued = false
+		s.pendingID = 0
+		return false, nil
+	}
+}
+func (s *GPTAccountRecoveryService) RunNow(ctx context.Context) (bool, error) {
+	return s.enqueue(ctx, 0)
+}
+func (s *GPTAccountRecoveryService) RunAccount(ctx context.Context, id int64) (bool, error) {
+	if id <= 0 {
+		return false, infraerrors.BadRequest("INVALID_ACCOUNT_ID", "账号 ID 必须为正整数")
+	}
+	a, err := s.repo.GetByID(ctx, id)
+	if err != nil {
+		return false, err
+	}
+	if err = validateGPTRecoveryAccount(a); err != nil {
+		return false, infraerrors.BadRequest("ACCOUNT_INELIGIBLE", err.Error())
+	}
+	return s.enqueue(ctx, id)
+}
+func (s *GPTAccountRecoveryService) execute(parent context.Context, job gptRecoveryJob) {
+	s.mu.Lock()
+	if s.state.Running || (job.automatic && s.state.Queued) {
+		s.mu.Unlock()
+		return
+	}
+	s.state.Running = true
+	s.state.Queued = false
+	s.pendingID = job.id
+	s.refreshDeadline = time.Time{}
+	s.state.ProcessedAccounts = 0
+	s.singleRun = job.id > 0
+	rev := s.revision
+	s.mu.Unlock()
+	defer func() {
+		now := time.Now().UTC()
+		s.mu.Lock()
+		s.state.Running = false
+		s.pendingID = 0
+		s.state.LastRun = &now
+		s.activeCancel = nil
+		s.mu.Unlock()
+	}()
+	readCtx, cancelRead := context.WithTimeout(parent, 5*time.Second)
+	current, err := s.GetConfig(readCtx)
+	cancelRead()
+	want, _ := json.Marshal(cloneGPTRecoveryConfig(job.cfg))
+	got, _ := json.Marshal(current)
+	if err != nil || string(want) != string(got) {
+		s.setRecoveryMessage("配置已变化，请重新提交恢复任务")
+		return
+	}
+	ctx, cancel := context.WithCancel(parent)
+	defer cancel()
+	s.mu.Lock()
+	s.activeCancel = cancel
+	s.mu.Unlock()
+	ownerBytes := make([]byte, 16)
+	if _, err = rand.Read(ownerBytes); err != nil {
+		return
+	}
+	owner := hex.EncodeToString(ownerBytes)
+	ttl := time.Duration(job.cfg.TimeoutSeconds+30) * time.Second
+	lockCtx, lockCancel := context.WithTimeout(ctx, 5*time.Second)
+	acquired, err := s.store.Acquire(lockCtx, owner, ttl)
+	lockCancel()
+	if err != nil || !acquired {
+		s.setRecoveryMessage("其他实例正在取票或协调服务不可用，请稍后重试")
+		return
+	}
+	defer func() {
+		releaseCtx, c := context.WithTimeout(context.Background(), 3*time.Second)
+		defer c()
+		_ = s.store.Release(releaseCtx, owner)
+	}()
+	if job.automatic {
+		scheduled, e := s.store.NextRun(ctx, gptRecoveryConfigKey(job.cfg))
+		if e != nil {
+			s.setRecoveryMessage("读取共享恢复计划失败")
+			return
+		}
+		if !scheduled.IsZero() && scheduled.After(time.Now()) {
+			return
+		}
+		defer func() {
+			if ctx.Err() != nil {
+				return
+			}
+			due := time.Now().Add(gptRecoveryInterval(job.cfg))
+			s.mu.Lock()
+			expiry := s.refreshDeadline
+			s.mu.Unlock()
+			if !expiry.IsZero() && expiry.Before(due) {
+				due = expiry
+			}
+			if due.Before(time.Now().Add(5 * time.Second)) {
+				due = time.Now().Add(5 * time.Second)
+			}
+			writeCtx, writeCancel := context.WithTimeout(ctx, 3*time.Second)
+			defer writeCancel()
+			owned, e := s.store.Owns(writeCtx, owner)
+			if e != nil || !owned {
+				return
+			}
+			_ = s.store.SetNextRun(writeCtx, gptRecoveryConfigKey(job.cfg), due)
+		}()
+	}
+	leaseDone := make(chan struct{})
+	defer close(leaseDone)
+	go func() {
+		t := time.NewTicker(ttl / 3)
+		defer t.Stop()
+		for {
+			select {
+			case <-leaseDone:
+				return
+			case <-ctx.Done():
+				return
+			case <-t.C:
+				rctx, c := context.WithTimeout(ctx, 5*time.Second)
+				ok, e := s.store.Renew(rctx, owner, ttl)
+				c()
+				if e != nil || !ok {
+					cancel()
+					return
+				}
+			}
+		}
+	}()
+	if job.id > 0 {
+		s.recoverAccount(ctx, job.cfg, job.id, owner, rev, job.automatic)
+		s.mu.Lock()
+		s.state.ProcessedAccounts = 1
+		s.mu.Unlock()
+		return
+	}
+	reader := s.repo.(gptRecoveryReadRepository)
+	var after int64
+	for ctx.Err() == nil {
+		accounts, e := reader.ListGPTRecoveryCandidates(ctx, job.cfg.AccountIDs, after, 100)
+		if e != nil {
+			s.setRecoveryMessage("读取恢复账号范围失败")
+			return
+		}
+		if len(accounts) == 0 {
+			break
+		}
+		for _, a := range accounts {
+			if a.ID <= after {
+				return
+			}
+			after = a.ID
+			s.mu.Lock()
+			s.pendingID = a.ID
+			s.mu.Unlock()
+			attempted := s.recoverAccount(ctx, job.cfg, a.ID, owner, rev, job.automatic)
+			s.mu.Lock()
+			s.state.ProcessedAccounts++
+			s.mu.Unlock()
+			if ctx.Err() != nil {
+				return
+			}
+			if !attempted {
+				continue
+			}
+			timer := time.NewTimer(5 * time.Second)
+			select {
+			case <-timer.C:
+			case <-ctx.Done():
+				timer.Stop()
+				return
+			}
+		}
+	}
+	s.setRecoveryMessage("范围内账号恢复取票已完成")
+}
+func (s *GPTAccountRecoveryService) setRecoveryMessage(message string) {
+	s.mu.Lock()
+	s.state.Message = message
+	s.mu.Unlock()
+}
+func gptRecoveryEligible(a *Account) bool {
+	return a != nil && a.ID > 0 && a.IsActive() && a.IsOpenAIOAuth() && !a.IsShadow() && !a.IsOpenAIAgentIdentity() && (a.ExpiresAt == nil || a.ExpiresAt.After(time.Now()))
+}
+func (s *GPTAccountRecoveryService) recoverAccount(ctx context.Context, c config.GPTAccountRecoveryConfig, id int64, owner string, revision uint64, automatic bool) (attempted bool) {
+	if automatic {
+		cachedAccount, e := s.repo.GetByID(ctx, id)
+		if e == nil && validateGPTRecoveryAccount(cachedAccount) == nil {
+			cacheCtx, cacheCancel := context.WithTimeout(ctx, 3*time.Second)
+			ticket, e := s.store.LoadTicket(cacheCtx, s.gateway.gptRecoveryRoutingIdentityKey(cachedAccount))
+			cacheCancel()
+			if e == nil && validGPTRecoveryRoutingTicket(ticket, time.Now()) && ticket.ConfigKey == gptRecoveryConfigKey(c) && ticket.CookieExpiresAt.After(time.Now().Add(30*time.Second)) && (c.Gateway == "any" || c.Gateway == ticket.Gateway) {
+				s.noteRecoveryExpiry(ticket.CookieExpiresAt)
+				return
+			}
+		}
+	}
+	started := time.Now()
+	attempted = true
+	r := GPTAccountRecoveryResult{CheckedAt: started.UTC(), Model: config.GPTAccountRecoveryModel, Verdict: "error"}
+	next := started.Add(time.Duration(c.IntervalSeconds) * time.Second)
+	r.NextCheckAt = &next
+	probeCtx, cancel := context.WithTimeout(ctx, time.Duration(c.TimeoutSeconds)*time.Second)
+	a, ticket, err := s.gateway.MintGPTAccountRecovery(probeCtx, id, c)
+	cancel()
+	if ctx.Err() != nil {
+		return
+	}
+	if a != nil {
+		r.Schedulable = a.Schedulable
+	}
+	s.configMu.RLock()
+	defer s.configMu.RUnlock()
+	if err == nil {
+		s.mu.Lock()
+		same := s.revision == revision
+		s.mu.Unlock()
+		current, e := s.GetConfig(ctx)
+		currentRaw, _ := json.Marshal(current)
+		jobRaw, _ := json.Marshal(cloneGPTRecoveryConfig(c))
+		if e != nil || !same || string(currentRaw) != string(jobRaw) {
+			err = gptRecoveryError("config_changed", "恢复配置已变化，本次票据未保存")
+		}
+		if err == nil {
+			owns, e := s.store.Owns(ctx, owner)
+			if e != nil || !owns {
+				err = gptRecoveryError("lease_lost", "恢复租约已失效，本次票据未保存")
+			}
+		}
+		if err == nil {
+			fresh, e := s.repo.GetByID(ctx, id)
+			if e != nil || validateGPTRecoveryAccount(fresh) != nil || s.gateway.gptRecoveryRoutingIdentityKey(fresh) != s.gateway.gptRecoveryRoutingIdentityKey(a) {
+				err = gptRecoveryError("identity_changed", "账号或代理已变化，本次票据未保存")
+			}
+		}
+		if err == nil {
+			if ticket == nil || !ticket.CookieExpiresAt.After(time.Now()) {
+				err = gptRecoveryError("ticket_expired", "路由票据已过期")
+			} else {
+				if ctx.Err() != nil {
+					return
+				}
+				ticket.ConfigKey = gptRecoveryConfigKey(c)
+				writeCtx, writeCancel := context.WithTimeout(ctx, 3*time.Second)
+				e = s.store.SaveTicket(writeCtx, s.gateway.gptRecoveryRoutingIdentityKey(a), ticket, time.Until(ticket.CookieExpiresAt))
+				writeCancel()
+				if e != nil {
+					err = gptRecoveryError("cache_write_failed", "保存路由票据失败")
+				}
+			}
+		}
+	}
+	if err != nil {
+		r.ErrorCode, r.Message, r.HTTPStatus = gptRecoveryErrorDetails(err)
+		if r.ErrorCode == "quota_exhausted" {
+			r.Verdict = "skipped"
+		}
+		if automatic && r.ErrorCode != "quota_exhausted" && r.ErrorCode != "quota_exceeded" && r.ErrorCode != "unauthorized" && r.ErrorCode != "forbidden" {
+			s.noteRecoveryExpiry(time.Now().Add(90 * time.Second))
+		}
+	} else {
+		r.Verdict = "ready"
+		r.Message = "路由票据已获取并通过协议校验"
+		r.Gateway = ticket.Gateway
+		r.TicketLength = len(ticket.TurnState)
+		r.Attempts = ticket.Attempts
+		r.ExpiresAt = &ticket.ExpiresAt
+		r.CookieExpiresAt = &ticket.CookieExpiresAt
+		r.TicketReady = ticket.ExpiresAt.After(time.Now())
+		r.CookieReady = true
+		s.noteRecoveryExpiry(ticket.CookieExpiresAt)
+		refresh := ticket.CookieExpiresAt.Add(-30 * time.Second)
+		if refresh.Before(next) {
+			r.NextCheckAt = &refresh
+		}
+	}
+	r.DurationMS = time.Since(started).Milliseconds()
+	if ctx.Err() != nil {
+		return
+	}
+	s.mu.Lock()
+	sameRevision := s.revision == revision
+	s.mu.Unlock()
+	if !sameRevision {
+		return
+	}
+	cfgCtx, cfgCancel := context.WithTimeout(ctx, 3*time.Second)
+	current, e := s.GetConfig(cfgCtx)
+	cfgCancel()
+	if e != nil || gptRecoveryConfigKey(current) != gptRecoveryConfigKey(c) {
+		return
+	}
+	leaseCtx, leaseCancel := context.WithTimeout(ctx, 3*time.Second)
+	owned, e := s.store.Owns(leaseCtx, owner)
+	leaseCancel()
+	if e != nil || !owned {
+		return
+	}
+	if writer, ok := s.repo.(gptRecoveryResultRepository); ok {
+		saveCtx, saveCancel := context.WithTimeout(ctx, 4*time.Second)
+		if writer.UpdateGPTRecoveryResult(saveCtx, id, r) != nil {
+			s.setRecoveryMessage("恢复结果保存失败")
+		}
+		saveCancel()
+	}
+	return
+}
+func (s *GPTAccountRecoveryService) noteRecoveryExpiry(expiry time.Time) {
+	due := expiry.Add(-30 * time.Second)
+	s.mu.Lock()
+	if s.refreshDeadline.IsZero() || due.Before(s.refreshDeadline) {
+		s.refreshDeadline = due
+	}
+	s.mu.Unlock()
+}
+func recoverySavedResult(a *Account) GPTAccountRecoveryResult {
+	r := GPTAccountRecoveryResult{Verdict: "pending", Message: "尚未取票", Model: config.GPTAccountRecoveryModel}
+	if a != nil {
+		raw, _ := json.Marshal(a.Extra["gpt_account_recovery"])
+		_ = json.Unmarshal(raw, &r)
+		r.Schedulable = a.Schedulable
+	}
+	now := time.Now()
+	r.TicketReady = r.ExpiresAt != nil && r.ExpiresAt.After(now)
+	r.CookieReady = r.CookieExpiresAt != nil && r.CookieExpiresAt.After(now)
+	return r
+}
+func (s *GPTAccountRecoveryService) Status(ctx context.Context) (GPTAccountRecoveryStatus, error) {
+	c, err := s.GetConfig(ctx)
+	if err != nil {
+		return GPTAccountRecoveryStatus{}, err
+	}
+	s.mu.Lock()
+	status := s.state
+	pending := s.pendingID
+	singleRun := s.singleRun
+	s.mu.Unlock()
+	status.Enabled = c.Enabled
+	status.Accounts = []GPTAccountRecoveryStatusAccount{}
+	reader, ok := s.repo.(gptRecoveryReadRepository)
+	if !ok {
+		return status, errors.New("recovery reader unavailable")
+	}
+	accounts, err := reader.ListGPTRecoveryAccounts(ctx, c.AccountIDs)
+	if err != nil {
+		return status, err
+	}
+	status.TotalAccounts = len(accounts)
+	status.RunTotalAccounts = status.TotalAccounts
+	if singleRun {
+		status.RunTotalAccounts = 1
+	}
+	for i := range accounts {
+		a := &accounts[i]
+		row := GPTAccountRecoveryStatusAccount{AccountID: a.ID, Name: a.Name, GPTAccountRecoveryResult: recoverySavedResult(a)}
+		if a.Proxy != nil {
+			row.ProxyName = a.Proxy.Name
+		}
+		row.ManualRequested = (status.Running || status.Queued) && a.ID == pending
+		status.Accounts = append(status.Accounts, row)
+	}
+	sort.SliceStable(status.Accounts, func(i, j int) bool { return status.Accounts[i].CheckedAt.After(status.Accounts[j].CheckedAt) })
+	if len(status.Accounts) > 200 {
+		status.Accounts = status.Accounts[:200]
+	}
+	// Read the current identity in one bounded batch after trimming the display
+	// list. The display projection intentionally contains no OAuth credentials.
+	ids := make([]int64, len(status.Accounts))
+	for i := range status.Accounts {
+		ids[i] = status.Accounts[i].AccountID
+		status.Accounts[i].CookieReady = false
+		status.Accounts[i].TicketReady = false
+	}
+	if len(ids) > 0 && s.store != nil && s.gateway != nil {
+		readCtx, cancel := context.WithTimeout(ctx, time.Second)
+		defer cancel()
+		current, e := s.repo.GetByIDs(readCtx, ids)
+		if e == nil {
+			byID := make(map[int64]*Account, len(current))
+			for _, account := range current {
+				if account != nil {
+					byID[account.ID] = account
+				}
+			}
+			indices := make(chan int, len(status.Accounts))
+			for i := range status.Accounts {
+				indices <- i
+			}
+			close(indices)
+			var readers sync.WaitGroup
+			workers := len(status.Accounts)
+			if workers > 8 {
+				workers = 8
+			}
+			readers.Add(workers)
+			for worker := 0; worker < workers; worker++ {
+				go func() {
+					defer readers.Done()
+					for i := range indices {
+						if readCtx.Err() != nil {
+							continue
+						}
+						s.refreshGPTRecoveryReadiness(readCtx, byID[status.Accounts[i].AccountID], &status.Accounts[i].GPTAccountRecoveryResult)
+					}
+				}()
+			}
+			readers.Wait()
+		}
+	}
+	return status, nil
+}
+
+func (s *GPTAccountRecoveryService) refreshGPTRecoveryReadiness(ctx context.Context, account *Account, result *GPTAccountRecoveryResult) {
+	result.CookieReady = false
+	result.TicketReady = false
+	if s.store == nil || s.gateway == nil || validateGPTRecoveryAccount(account) != nil {
+		return
+	}
+	key := s.gateway.gptRecoveryRoutingIdentityKey(account)
+	if key == "" {
+		return
+	}
+	ticket, err := s.store.LoadTicket(ctx, key)
+	now := time.Now()
+	if err != nil || !validGPTRecoveryRoutingTicket(ticket, now) {
+		return
+	}
+	result.CookieReady = true
+	result.TicketReady = ticket.ExpiresAt.After(now)
+	expires, cookieExpires := ticket.ExpiresAt, ticket.CookieExpiresAt
+	result.ExpiresAt = &expires
+	result.CookieExpiresAt = &cookieExpires
+	result.Gateway = ticket.Gateway
+	result.TicketLength = len(ticket.TurnState)
+}
+
+func (s *GPTAccountRecoveryService) AccountResult(ctx context.Context, id int64) (GPTAccountRecoveryStatusAccount, error) {
+	a, err := s.repo.GetByID(ctx, id)
+	if err != nil {
+		return GPTAccountRecoveryStatusAccount{}, err
+	}
+	row := GPTAccountRecoveryStatusAccount{AccountID: a.ID, Name: a.Name, GPTAccountRecoveryResult: recoverySavedResult(a)}
+	if a.Proxy != nil {
+		row.ProxyName = a.Proxy.Name
+	}
+	s.mu.Lock()
+	row.ManualRequested = (s.state.Running || s.state.Queued) && s.pendingID == id
+	s.mu.Unlock()
+	readCtx, cancel := context.WithTimeout(ctx, gptRecoveryRoutingCacheTimeout)
+	defer cancel()
+	s.refreshGPTRecoveryReadiness(readCtx, a, &row.GPTAccountRecoveryResult)
+	return row, nil
+}
