+func TestGPTRecoveryBorrowedCompatibilityFailureUsesOriginalBudget(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		failure   func() (*http.Response, error)
+		wantCalls int
+	}{
+		{"model mismatch", func() (*http.Response, error) {
+			resp := gptRecoveryMintTestResponse(time.Now())
+			resp.Body = io.NopCloser(strings.NewReader(gptRecoveryMintTestCreated("other-model")))
+			return resp, nil
+		}, 2},
+		{"transport", func() (*http.Response, error) { return nil, errors.New("network failed") }, 1},
+		{"quota", func() (*http.Response, error) {
+			return &http.Response{StatusCode: 429, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"error":{"code":"quota_exceeded"}}`))}, nil
+		}, 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := config.DefaultGPTAccountRecoveryConfig()
+			cfg.MaxAttempts = 2
+			route := gptRecoverySharedCandidate(strings.Repeat("a", 64))
+			seed := &GPTAccountRecoveryTicket{CFLB: route.CFLB, OAILB: route.OAILB, Gateway: route.Gateway, CookieExpiresAt: route.CookieExpiresAt, Model: config.GPTAccountRecoveryModel}
+			calls := 0
+			do := func(req *http.Request) (*http.Response, error) {
+				calls++
+				if calls == 1 {
+					require.NotEmpty(t, req.Header.Get("Cookie"))
+					return tc.failure()
+				}
+				require.Empty(t, req.Header.Get("Cookie"))
+				return gptRecoveryMintTestResponse(time.Now()), nil
+			}
+			ticket, err := gptRecoveryMintWithSeedSource(context.Background(), do, gptRecoveryMintTestAccount(), "own-token", "", cfg, seed, true)
+			require.Equal(t, tc.wantCalls, calls)
+			if tc.wantCalls == 2 {
+				require.NoError(t, err)
+				require.Equal(t, 2, ticket.Attempts)
+			} else {
+				require.Error(t, err)
+			}
+		})
+	}
+}
