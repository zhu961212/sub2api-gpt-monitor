+func TestGPTMonitorManualCompletionPersistenceFailurePreventsFollowupProbe(t *testing.T) {
+	s, repo, _ := gptMonitorManualCompletionFixture(true)
+	calls := 0
+	s.probe = func(_ context.Context, id int64, _, _ string) (*Account, string, error) {
+		calls++
+		return repo.snapshot(id), "iPhone 16", nil
+	}
+	request := gptMonitorRequest{AccountID: 2, ConfigKey: gptMonitorConfigHash(s.cfg)}
+	s.runMonitorRequest(context.Background(), s.cfg, request, true)
+	gptMonitorAgeConfirmation(repo.gptMonitorRepoStub, 2)
+	repo.failConsumption = true
+	request.Confirmation = true
+	s.runMonitorRequest(context.Background(), s.cfg, request, true)
+	require.Equal(t, 1, calls)
+	require.Empty(t, repo.writes)
+	require.True(t, repo.accounts[0].Schedulable)
+	require.True(t, repo.results[2].ManualRequested)
+	require.Equal(t, 1, repo.results[2].ManualAttempts)
+}
+
+func TestGPTMonitorManualCompletionRunningOnAnotherReplicaRejectsDuplicate(t *testing.T) {
+	s, repo, _ := gptMonitorManualCompletionFixture(true)
+	s.cancel = func() {}
+	due := time.Now().UTC().Add(time.Minute)
+	require.NoError(t, repo.UpdateExtra(context.Background(), 2, map[string]any{"gpt_account_monitor": GPTAccountMonitorResult{
+		ConfigKey: gptMonitorConfigHash(s.cfg), ManualRunning: true, ManualAttempts: 2, NextCheckAt: &due,
+	}}))
+	queued, err := s.RunAccount(context.Background(), 2)
+	require.NoError(t, err)
+	require.False(t, queued)
+	require.Empty(t, s.trigger)
+}
+
+type gptMonitorManualRestartRepo struct {
+	*gptMonitorManualCompletionRepo
+}
+
+func (r *gptMonitorManualRestartRepo) ListGPTMonitorManualConfirmations(_ context.Context, configKey string, _ int) ([]Account, error) {
+	account := r.snapshot(2)
+	previous := gptMonitorSavedResult(account)
+	if previous.ManualRequested && previous.ConfigKey == configKey {
+		return []Account{*account}, nil
+	}
+	return []Account{}, nil
+}
+
+func TestGPTMonitorManualCompletionWorkerRestoresPendingWhileAutoDisabled(t *testing.T) {
+	s, repo, _ := gptMonitorManualCompletionFixture(true)
+	var calls atomic.Int64
+	s.probe = func(_ context.Context, id int64, _, _ string) (*Account, string, error) {
+		calls.Add(1)
+		return repo.snapshot(id), "iPhone 16", nil
+	}
+	request := gptMonitorRequest{AccountID: 2, ConfigKey: gptMonitorConfigHash(s.cfg)}
+	s.runMonitorRequest(context.Background(), s.cfg, request, true)
+	require.EqualValues(t, 1, calls.Load())
+	gptMonitorAgeConfirmation(repo.gptMonitorRepoStub, 2)
+	s.repo = &gptMonitorManualRestartRepo{repo}
+	raw, err := json.Marshal(s.cfg)
+	require.NoError(t, err)
+	s.settings = &gptMonitorSettingsStub{value: string(raw)}
+	s.Start()
+	t.Cleanup(s.Stop)
+	require.Eventually(t, func() bool {
+		repo.mu.Lock()
+		defer repo.mu.Unlock()
+		result := repo.results[2]
+		return result.Changed && !result.ManualRequested && !result.ManualRunning && result.ManualAttempts == 2
+	}, 3*time.Second, 10*time.Millisecond)
+	s.Stop()
+	require.EqualValues(t, 2, calls.Load())
+	require.Equal(t, map[int64]bool{2: false}, repo.writes)
+	require.False(t, s.cfg.Enabled)
+	require.Equal(t, []int64{1}, s.cfg.AccountIDs)
+}
+
+func TestGPTMonitorManualFirstSampleCannotBorrowAutomaticConfirmation(t *testing.T) {
+	now := time.Date(2026, 10, 13, 10, 0, 0, 0, time.UTC)
+	current := GPTAccountMonitorResult{Verdict: "abnormal", Model: "gpt-6-astra", ReasoningEffort: "xhigh", ExpectedGeneration: 17, Schedulable: true}
+	automatic, apply := gptMonitorConfirmResult(current, GPTAccountMonitorResult{}, "config-a", now.Add(-5*time.Minute))
+	require.False(t, apply)
+	// An independent manual test starts a fresh pair even when an automatic
+	// sample would have been sufficient for the automatic scheduling path.
+	_, apply = gptMonitorConfirmResult(current, automatic, "config-a", now)
+	require.True(t, apply)
+	manual, apply := gptMonitorConfirmResult(current, GPTAccountMonitorResult{}, "config-a", now)
+	require.False(t, apply)
+	require.True(t, manual.Schedulable)
+	require.Equal(t, 1, manual.Consecutive)
+	require.Equal(t, now, *manual.PendingCheckedAt)
+	confirmed, apply := gptMonitorConfirmResult(current, manual, "config-a", now.Add(5*time.Minute))
+	require.True(t, apply)
+	require.Equal(t, 2, confirmed.Consecutive)
+	require.Empty(t, confirmed.PendingVerdict)
+}
+
+func TestGPTMonitorManualPairCanSuspendOrRecoverWhileAutoDisabled(t *testing.T) {
+	now := time.Date(2026, 10, 13, 10, 0, 0, 0, time.UTC)
+	for _, schedulable := range []bool{true, false} {
+		verdict := "normal"
+		if schedulable {
+			verdict = "abnormal"
+		}
+		current := GPTAccountMonitorResult{Verdict: verdict, Model: "gpt-6-astra", ReasoningEffort: "xhigh", ExpectedGeneration: 17, Schedulable: schedulable}
+		first, apply := gptMonitorConfirmResult(current, GPTAccountMonitorResult{}, "disabled-auto-config", now)
+		require.False(t, apply)
+		require.Equal(t, schedulable, first.Schedulable)
+		second, apply := gptMonitorConfirmResult(current, first, "disabled-auto-config", now.Add(5*time.Minute))
+		require.True(t, apply)
+		require.Equal(t, 2, second.Consecutive)
+		require.Nil(t, second.NextCheckAt)
+	}
+}
+
+func TestGPTMonitorManualReversedSecondSampleDoesNotChangeScheduling(t *testing.T) {
+	now := time.Date(2026, 10, 13, 10, 0, 0, 0, time.UTC)
+	for _, schedulable := range []bool{true, false} {
+		current := GPTAccountMonitorResult{Verdict: "normal", Model: "gpt-6-astra", ReasoningEffort: "xhigh", ExpectedGeneration: 17, Schedulable: schedulable}
+		if schedulable {
+			current.Verdict = "abnormal"
+		}
+		first, _ := gptMonitorConfirmResult(current, GPTAccountMonitorResult{}, "config-a", now)
+		if current.Verdict == "normal" {
+			current.Verdict = "abnormal"
+		} else {
+			current.Verdict = "normal"
+		}
+		second, apply := gptMonitorConfirmResult(current, first, "config-a", now.Add(5*time.Minute))
+		require.False(t, apply)
+		require.Equal(t, schedulable, second.Schedulable)
+		require.Empty(t, second.PendingVerdict)
+		require.Zero(t, second.Consecutive)
+		require.Nil(t, second.NextCheckAt)
+	}
+}
