+  const normalized = { ...value, model: GPT_ACCOUNT_RECOVERY_MODEL, account_ids: [...(value.account_ids || [])].sort((a, b) => a - b) }
+  Object.assign(form, normalized, { account_ids: [...normalized.account_ids] })
+  scope.value = normalized.account_ids.length ? 'selected' : 'all'
+  savedConfig.value = JSON.parse(JSON.stringify(normalized)) as GPTAccountRecoveryConfig
+}
+function resetForm() { if (savedConfig.value) applyConfig(savedConfig.value) }
+function message(error: unknown): string { return error && typeof error === 'object' && 'message' in error ? String(error.message) : t('common.unknownError') }
+function report(error: unknown) {
+  if (stopped || isStepUpCancelled(error)) return
+  appStore.showError(isStepUpBlocked(error) ? t(stepUpBlockReason(error) === 'STEP_UP_ADMIN_API_KEY_FORBIDDEN' ? 'stepUp.adminApiKeyForbidden' : 'stepUp.notEnabled') : message(error))
+}
+async function request<T>(action: (signal: AbortSignal) => Promise<T>): Promise<T> {
+  const controller = new AbortController()
+  controllers.add(controller)
+  try { return await action(controller.signal) } finally { controllers.delete(controller) }
+}
+async function loadConfig() {
+  if (stopped) return
+  loading.value = true
+  loadError.value = ''
+  try {
+    const value = await request(signal => adminAPI.gptAccountRecovery.getConfig(signal))
+    if (!stopped) { applyConfig(value); loaded.value = true }
+  } catch (error) { if (!stopped) loadError.value = message(error) }
+  finally { loading.value = false }
+}
+async function refreshStatus(force = false) {
+  if (stopped || (refreshing.value && !force)) return
+  statusController?.abort()
+  const controller = new AbortController()
+  const requestID = ++statusRequestID
+  statusController = controller
+  controllers.add(controller)
+  refreshing.value = true
+  try {
+    const value = await adminAPI.gptAccountRecovery.getStatus(controller.signal)
+    if (!stopped && !controller.signal.aborted && requestID === statusRequestID) {
+      status.value = { ...value, accounts: Array.isArray(value.accounts) ? value.accounts : [] }
+      statusError.value = ''
+    }
+  } catch (error) {
+    if (!stopped && !controller.signal.aborted && requestID === statusRequestID) statusError.value = message(error)
+  } finally {
+    controllers.delete(controller)
+    if (requestID === statusRequestID) {
+      statusController = undefined
+      refreshing.value = false
+    }
+  }
+}
+function validate(config: GPTAccountRecoveryConfig) {
+  for (const [value, min, max] of [[config.interval_seconds, 60, 86400], [config.timeout_seconds, 10, 300], [config.max_attempts, 1, 20], [config.ticket_ttl_seconds, 30, 600], [config.cookie_ttl_seconds, 60, 7200]]) {
+    if (!Number.isInteger(value) || value < min || value > max) throw new Error(tr('invalidConfig'))
+  }
+  if (!/^any$|^unified-[0-9]{1,6}$/.test(config.gateway) || !Number.isInteger(config.ticket_length) || (config.ticket_length !== 0 && (config.ticket_length < 64 || config.ticket_length > 8192))) throw new Error(tr('invalidConfig'))
+  if (scope.value === 'selected' && !config.account_ids.length) throw new Error(tr('chooseAccounts'))
+}
+async function save() {
+  if (!loaded.value || busy.value || stopped) return
+  saving.value = true
+  try {
+    const config = snapshot()
+    validate(config)
+    const value = await stepUp.run(() => request(signal => adminAPI.gptAccountRecovery.saveConfig(config, signal)))
+    if (!stopped) { applyConfig(value); appStore.showSuccess(tr('saved')); await refreshStatus(true) }
+  } catch (error) { report(error) }
+  finally { saving.value = false }
+}
+async function runNow() {
+  if (!loaded.value || busy.value || status.value.running || status.value.queued || stopped) return
+  if (dirty.value) { appStore.showError(tr('saveFirst')); return }
+  running.value = true
+  try {
+    const result = await stepUp.run(() => request(signal => adminAPI.gptAccountRecovery.run(signal)))
+    if (!stopped) {
+      if (result.queued) { status.value.queued = true; appStore.showSuccess(result.message || tr('queued')) }
+      else appStore.showInfo(result.message || tr('running'))
+      await refreshStatus(true)
+    }
+  } catch (error) { report(error) }
+  finally { running.value = false }
+}
+async function runAccount(accountID: number) {
+  if (!Number.isSafeInteger(accountID) || accountID < 1) return
+  if (!loaded.value || busy.value || status.value.running || status.value.queued || stopped) return
+  if (dirty.value) { appStore.showError(tr('saveFirst')); return }
+  running.value = true
+  runningAccountID.value = accountID
+  try {
+    const result = await stepUp.run(() => request(signal => adminAPI.gptAccountRecovery.runAccount(accountID, signal)))
+    if (!stopped) {
+      if (result.queued) {
+        status.value.queued = true
+        singleAccountID.value = accountID
+        singleResult.value = null
+        singleQueryError.value = ''
+        singleWaiting.value = true
+        singleResultVisible.value = true
+        ++singleRequestID
+        appStore.showSuccess(tr('accountQueued', { id: accountID }))
+        await refreshSingleResult()
+      } else appStore.showInfo(result.message || tr('queueBusy'))
+      await refreshStatus(true)
+    }
+  } catch (error) { report(error) }
+  finally { running.value = false; runningAccountID.value = null }
+}
+async function loadAccounts() {
+  if (stopped) return
+  accountController?.abort()
+  const controller = new AbortController()
+  accountController = controller
+  controllers.add(controller)
+  accountsLoading.value = true
+  accountError.value = ''
+  try {
+    const result = await adminAPI.accounts.list(accountPage.value, 50, { platform: 'openai', type: 'oauth', status: 'active', lite: 'true', search: accountSearch.value.trim() }, { signal: controller.signal })
+    if (stopped || controller.signal.aborted) return
+    accountOptions.value = result.items.filter(account => account.platform === 'openai' && account.type === 'oauth' && account.status === 'active' && !account.parent_account_id && (!account.expires_at || account.expires_at * 1000 > Date.now()))
+    for (const account of accountOptions.value) accountNames[account.id] = `${account.name} (#${account.id})`
+    accountPages.value = Math.max(1, result.pages || Math.ceil(result.total / 50))
+  } catch (error) { if (!stopped && !controller.signal.aborted) accountError.value = message(error) }
+  finally { controllers.delete(controller); if (accountController === controller) accountsLoading.value = false }
+}
+function toggleAccount(id: number) { form.account_ids = form.account_ids.includes(id) ? form.account_ids.filter(value => value !== id) : [...form.account_ids, id] }
+function changeAccountPage(delta: number) { accountPage.value += delta; void loadAccounts() }
+watch(accountSearch, () => {
+  clearTimeout(searchTimer)
+  accountController?.abort()
+  accountController = undefined
+  accountOptions.value = []
+  accountError.value = ''
+  accountsLoading.value = true
+  accountPage.value = 1
+  searchTimer = setTimeout(() => { void loadAccounts() }, 250)
+}, { flush: 'sync' })
+function verdictKind(verdict: string): typeof resultKinds[number] { return verdict === 'ready' || verdict === 'pending' || verdict === 'skipped' ? verdict : 'error' }
+const counts = computed(() => {
+  const value = { ready: 0, pending: 0, error: 0, skipped: 0 }
+  for (const account of status.value.accounts) {
+    const kind = verdictKind(account.verdict)
+    value[kind]++
+  }
+  return value
+})
+const filteredResults = computed(() => {
+  const search = resultSearch.value.trim().toLowerCase()
+  return status.value.accounts.filter(account => (verdictFilter.value === 'all' || verdictKind(account.verdict) === verdictFilter.value) && (!search || `${account.account_id} ${account.name} ${account.gateway || ''} ${account.message}`.toLowerCase().includes(search)))
+})
+const resultPages = computed(() => Math.max(1, Math.ceil(filteredResults.value.length / resultPageSize)))
+const pagedResults = computed(() => filteredResults.value.slice((resultPage.value - 1) * resultPageSize, resultPage.value * resultPageSize))
+const progressTotal = computed(() => status.value.run_total_accounts ?? status.value.total_accounts)
+const completedCount = computed(() => Math.min(progressTotal.value, status.value.processed_accounts ?? 0))
+watch([resultSearch, verdictFilter], () => { resultPage.value = 1 })
+watch(resultPages, pages => { if (resultPage.value > pages) resultPage.value = pages })
+function routeAvailable(account: GPTAccountRecoveryResult) {
+  return account.cookie_ready === true && (!account.cookie_expires_at || new Date(account.cookie_expires_at).getTime() > clock.value)
+}
+function ticketAvailable(account: GPTAccountRecoveryResult) {
+  return account.ticket_ready === true && (!account.expires_at || new Date(account.expires_at).getTime() > clock.value)
+}
+async function refreshSingleResult(force = false) {
+  const accountID = singleAccountID.value
+  if (stopped || accountID === null || singleReading || (!singleWaiting.value && !force)) return
+  const requestID = singleRequestID
+  singleReading = true
+  try {
+    const result = await request(signal => adminAPI.gptAccountRecovery.getAccountResult(accountID, signal))
+    if (stopped || requestID !== singleRequestID) return
+    singleResult.value = result
+    singleQueryError.value = ''
+    if (!result.manual_requested) {
+      singleWaiting.value = false
+    }
+  } catch (error) {
+    if (!stopped && requestID === singleRequestID) singleQueryError.value = message(error)
+  } finally { singleReading = false }
+}
+function verdictClass(verdict: string) {
+  if (['pending', 'skipped'].includes(verdictKind(verdict))) return 'bg-gray-100 text-gray-600 dark:bg-dark-700 dark:text-gray-300'
+  return verdictKind(verdict) === 'ready' ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-300' : 'bg-amber-50 text-amber-700 dark:bg-amber-900/20 dark:text-amber-300'
+}
+function dateText(value?: string | null) {
+  if (!value || value.startsWith('0001-')) return tr('noTime')
+  const date = new Date(value)
+  return Number.isNaN(date.getTime()) ? '—' : date.toLocaleString()
+}
+function onVisibilityChange() { if (!document.hidden) { clock.value = Date.now(); void refreshStatus(); void refreshSingleResult() } }
+onMounted(() => {
+  void Promise.allSettled([loadConfig(), refreshStatus(), loadAccounts()])
+  pollTimer = setInterval(() => { if (!document.hidden) { clock.value = Date.now(); void refreshStatus(); void refreshSingleResult() } }, 5000)
+  document.addEventListener('visibilitychange', onVisibilityChange)
+})
+onUnmounted(() => {
+  stopped = true
+  clearInterval(pollTimer)
+  clearTimeout(searchTimer)
+  document.removeEventListener('visibilitychange', onVisibilityChange)
+  for (const controller of controllers) controller.abort()
+  controllers.clear()
+  stepUp.onCancel()
+})
+</script>
+
+<style scoped>
+.recovery-label { @apply block text-sm font-medium text-gray-700 dark:text-gray-200; }
+</style>
