+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, chatgptCodexURL, nil)
+	require.NoError(t, err)
+	_, err = (&OpenAIGatewayService{}).doGPTMonitorRequest(req, account)
+	require.Error(t, err)
+	require.Equal(t, int32(1), accountHits.Load())
+	require.Zero(t, environmentHits.Load())
+	require.True(t, account.Schedulable)
+}
