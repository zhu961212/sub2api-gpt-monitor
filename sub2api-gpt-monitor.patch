diff --git a/backend/internal/service/openai_recovery_routing.go b/backend/internal/service/openai_recovery_routing.go
new file mode 100644
index 0000000000000000000000000000000000000000..7c06afa5c250dd37daa037db1f3d151b3957ac47
--- /dev/null
+++ b/backend/internal/service/openai_recovery_routing.go
@@ -0,0 +1,307 @@
+package service
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"strings"
+	"time"
+)
+
+const (
+	gptRecoveryCFLBCookie          = "__cflb"
+	gptRecoveryOAILBCookie         = "__oailb"
+	gptRecoveryRoutingCacheTimeout = 500 * time.Millisecond
+)
+
+// gptRecoveryIdentityKey binds a ticket to the credential and egress that minted
+// it. Only a digest leaves this process; tokens and proxy passwords are never
+// placed in Redis keys. Ordinary metadata and quota updates do not change it.
+func gptRecoveryIdentityKey(account *Account) string {
+	if account == nil || !account.IsOpenAIOAuth() || account.IsShadow() || account.IsOpenAIAgentIdentity() {
+		return ""
+	}
+	proxyURL := ""
+	if account.Proxy != nil {
+		proxyURL = account.Proxy.URL()
+	}
+	identity := resolveCodexOutboundIdentity(account.GetOpenAIUserAgent())
+	fingerprintSeed, _ := codexFingerprintSeed(account.Extra)
+	payload := map[string]any{
+		"version": 1, "account_id": account.ID, "platform": account.Platform, "type": account.Type,
+		"access_token": account.GetOpenAIAccessToken(), "chatgpt_account_id": account.GetChatGPTAccountID(),
+		"organization_id": account.GetOpenAIOrganizationID(), "chatgpt_user_id": account.GetChatGPTUserID(),
+		"fedramp": account.IsChatGPTAccountFedRAMP(), "auth_mode": account.GetCredential(openAIAuthModeCredentialKey),
+		"legacy_auth_mode": account.GetCredential(openAIAuthModeLegacyCredentialKey),
+		"proxy_id":         account.ProxyID, "proxy_url": proxyURL,
+		"user_agent": identity.userAgent, "originator": identity.originator, "client_version": identity.version,
+		"custom_user_agent": account.GetOpenAIUserAgent(),
+		"tls_fingerprint":   account.IsTLSFingerprintEnabled(), "tls_profile_id": account.GetTLSFingerprintProfileID(),
+		"identity_enforcement": codexIdentityEnforcement.Load(),
+		"fingerprint_mode":     account.GetCodexFingerprintMode(), "fingerprint_seed": fingerprintSeed,
+	}
+	if account.Credentials != nil {
+		payload["header_override_enabled"] = account.Credentials[credKeyHeaderOverrideEnabled]
+		payload["header_overrides"] = account.Credentials[credKeyHeaderOverrides]
+	}
+	raw, err := json.Marshal(payload)
+	if err != nil {
+		return ""
+	}
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:])
+}
+
+// ForceCodexCLI can override an account UA, so both acquisition and forwarding
+// must use this service-level key when looking up the recovered route.
+func (s *OpenAIGatewayService) gptRecoveryRoutingIdentityKey(account *Account) string {
+	key := gptRecoveryIdentityKey(account)
+	if key == "" {
+		return ""
+	}
+	if s == nil || s.cfg == nil || !s.cfg.Gateway.ForceCodexCLI {
+		return key
+	}
+	identity := resolveCodexOutboundIdentity("")
+	sum := sha256.Sum256([]byte(key + "\x00force_codex_cli\x00" + identity.userAgent + "\x00" + identity.originator + "\x00" + identity.version))
+	return hex.EncodeToString(sum[:])
+}
+
+func gptRecoveryTurnRoutingKey(identityKey, turnState string) string {
+	sum := sha256.Sum256([]byte("turn-route-v1\x00" + identityKey + "\x00" + turnState))
+	return hex.EncodeToString(sum[:])
+}
+
+func validGPTRecoveryRoutingCookie(value string) bool {
+	if value == "" || len(value) > 4096 {
+		return false
+	}
+	// RFC 6265 cookie-octet. Reject delimiters and control bytes before building
+	// a Cookie header; no login cookie or arbitrary cached header is forwarded.
+	for i := 0; i < len(value); i++ {
+		b := value[i]
+		if b < 0x21 || b > 0x7e || b == '"' || b == ',' || b == ';' || b == '\\' {
+			return false
+		}
+	}
+	return true
+}
+
+func validGPTRecoveryRoutingTicket(ticket *GPTAccountRecoveryTicket, now time.Time) bool {
+	// TurnState/ExpiresAt describe the short-lived probe turn. Routing cookies
+	// have their own lifetime and remain usable for fresh turns after it ends.
+	return ticket != nil && ticket.Model == "gpt-6-astra" &&
+		ticket.CookieExpiresAt.After(now) && validGPTRecoveryRoutingCookie(ticket.CFLB) && validGPTRecoveryRoutingCookie(ticket.OAILB)
+}
+
+func setGPTRecoveryRoutingCookies(headers http.Header, ticket *GPTAccountRecoveryTicket) {
+	for name := range headers {
+		if strings.EqualFold(name, "cookie") {
+			delete(headers, name)
+		}
+	}
+	headers.Set("Cookie", gptRecoveryCFLBCookie+"="+ticket.CFLB+"; "+gptRecoveryOAILBCookie+"="+ticket.OAILB)
+}
+
+func gptRecoveryRoutingCookieDigest(headers http.Header) string {
+	if headers == nil {
+		return ""
+	}
+	req := &http.Request{Header: headers}
+	var cflb, oailb string
+	for _, cookie := range req.Cookies() {
+		switch cookie.Name {
+		case gptRecoveryCFLBCookie:
+			cflb = cookie.Value
+		case gptRecoveryOAILBCookie:
+			oailb = cookie.Value
+		}
+	}
+	if !validGPTRecoveryRoutingCookie(cflb) || !validGPTRecoveryRoutingCookie(oailb) {
+		return ""
+	}
+	sum := sha256.Sum256([]byte(cflb + "\x00" + oailb))
+	return hex.EncodeToString(sum[:])
+}
+
+func (s *OpenAIGatewayService) applyGPTRecoveryRouting(ctx context.Context, account *Account, headers http.Header, proxyURL string) *GPTAccountRecoveryTicket {
+	if s == nil || s.gptRecoveryStore == nil || headers == nil || account == nil || validateGPTRecoveryAccount(account) != nil {
+		return nil
+	}
+	// The provider can serve a cached/refreshed token while the scheduler still
+	// holds an older account snapshot. Such a request proceeds without a ticket.
+	if proxyURL != account.Proxy.URL() || headers.Get("Authorization") != "Bearer "+account.GetOpenAIAccessToken() ||
+		strings.TrimSpace(account.GetOpenAIAccessToken()) == "" || headers.Get("Chatgpt-Account-Id") != account.GetChatGPTAccountID() {
+		return nil
+	}
+	identity := resolveCodexOutboundIdentity(s.codexIdentityOverrideUA(account))
+	if headers.Get("User-Agent") != identity.userAgent || headers.Get("Originator") != identity.originator || headers.Get("Version") != identity.version {
+		return nil
+	}
+	identityKey := s.gptRecoveryRoutingIdentityKey(account)
+	if identityKey == "" {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(ctx, gptRecoveryRoutingCacheTimeout)
+	defer cancel()
+	now := time.Now()
+	state := extractOpenAICodexTurnState(headers)
+	var ticket *GPTAccountRecoveryTicket
+	if state != "" {
+		// A continuation keeps the route that produced its real turn-state. A new
+		// account-wide recovery ticket must not move an existing turn to a new LB.
+		ticket, _ = s.gptRecoveryStore.LoadTicket(ctx, gptRecoveryTurnRoutingKey(identityKey, state))
+		if !validGPTRecoveryRoutingTicket(ticket, now) || ticket.TurnState != state {
+			ticket, _ = s.gptRecoveryStore.LoadTicket(ctx, identityKey)
+			if ticket == nil || ticket.TurnState != state {
+				return nil
+			}
+		}
+	} else {
+		ticket, _ = s.gptRecoveryStore.LoadTicket(ctx, identityKey)
+	}
+	if !validGPTRecoveryRoutingTicket(ticket, now) {
+		return nil
+	}
+	copy := *ticket
+	setGPTRecoveryRoutingCookies(headers, &copy)
+	return &copy
+}
+
+func isGPTRecoveryRoutingURL(req *http.Request) bool {
+	return req != nil && req.URL != nil && strings.EqualFold(req.URL.Scheme, "https") &&
+		strings.EqualFold(req.URL.Hostname(), "chatgpt.com") && (req.URL.Port() == "" || req.URL.Port() == "443") &&
+		(req.Host == "" || strings.EqualFold(req.Host, "chatgpt.com"))
+}
+
+// observeGPTRecoveryTurnRouting remembers only the pair actually used for this
+// successful request. It never publishes a new account-wide recovery ticket.
+func (s *OpenAIGatewayService) observeGPTRecoveryTurnRouting(ctx context.Context, account *Account, requestHeaders, responseHeaders http.Header, ticket *GPTAccountRecoveryTicket, identityKey string) {
+	if s == nil || s.gptRecoveryStore == nil || ticket == nil || account == nil || responseHeaders == nil {
+		return
+	}
+	if identityKey == "" || s.gptRecoveryRoutingIdentityKey(account) != identityKey {
+		return
+	}
+	expected := make(http.Header)
+	setGPTRecoveryRoutingCookies(expected, ticket)
+	if gptRecoveryRoutingCookieDigest(requestHeaders) != gptRecoveryRoutingCookieDigest(expected) {
+		return
+	}
+	state := extractOpenAICodexTurnState(responseHeaders)
+	if state == "" {
+		state = extractOpenAICodexTurnState(requestHeaders)
+	}
+	if state == "" || len(state) > 16384 {
+		return
+	}
+	copy := *ticket
+	copy.TurnState = state
+	now := time.Now()
+	var cflb, oailb *http.Cookie
+	for _, cookie := range (&http.Response{Header: responseHeaders}).Cookies() {
+		if cookie.Name != gptRecoveryCFLBCookie && cookie.Name != gptRecoveryOAILBCookie {
+			continue
+		}
+		if cookie.MaxAge < 0 || !validGPTRecoveryRoutingCookie(cookie.Value) {
+			return
+		}
+		if cookie.Name == gptRecoveryCFLBCookie {
+			if cflb != nil {
+				return
+			}
+			cflb = cookie
+		} else {
+			if oailb != nil {
+				return
+			}
+			oailb = cookie
+		}
+		expires := cookie.Expires
+		if cookie.MaxAge > 0 {
+			expires = now.Add(time.Duration(cookie.MaxAge) * time.Second)
+		}
+		if !expires.IsZero() && expires.Before(copy.CookieExpiresAt) {
+			copy.CookieExpiresAt = expires
+		}
+		if jwtExpiry, declared := gptRecoveryCookieJWTExpiry(cookie.Value); declared && jwtExpiry.Before(copy.CookieExpiresAt) {
+			copy.CookieExpiresAt = jwtExpiry
+		}
+	}
+	// An upstream may rotate either load balancer. A changed half-pair cannot
+	// be paired with the other cookie from an earlier response or probe.
+	if cflb != nil && oailb != nil {
+		gateway := gptRecoveryCookieGateway(cflb.Value, oailb.Value)
+		if gateway == "" {
+			return
+		}
+		copy.CFLB, copy.OAILB, copy.Gateway = cflb.Value, oailb.Value, gateway
+	} else if (cflb != nil && cflb.Value != ticket.CFLB) || (oailb != nil && oailb.Value != ticket.OAILB) {
+		return
+	}
+	if !validGPTRecoveryRoutingTicket(&copy, now) {
+		return
+	}
+	ctx, cancel := context.WithTimeout(ctx, gptRecoveryRoutingCacheTimeout)
+	defer cancel()
+	_ = s.gptRecoveryStore.SaveTicket(ctx, gptRecoveryTurnRoutingKey(identityKey, state), &copy, time.Until(copy.CookieExpiresAt))
+}
+
+func (s *OpenAIGatewayService) gptRecoveryWSHandshakeObserver(ctx context.Context, account *Account, headers http.Header) func(context.Context, http.Header, http.Header) {
+	if s == nil || s.gptRecoveryStore == nil || account == nil || gptRecoveryRoutingCookieDigest(headers) == "" {
+		return nil
+	}
+	// Snapshot the selected turn/global ticket so an overlapping recovery cannot
+	// make the handshake observer associate this connection with a later route.
+	state := extractOpenAICodexTurnState(headers)
+	identityKey := s.gptRecoveryRoutingIdentityKey(account)
+	ctx, cancel := context.WithTimeout(ctx, gptRecoveryRoutingCacheTimeout)
+	defer cancel()
+	key := identityKey
+	if state != "" {
+		key = gptRecoveryTurnRoutingKey(identityKey, state)
+	}
+	ticket, _ := s.gptRecoveryStore.LoadTicket(ctx, key)
+	if ticket == nil && state != "" {
+		ticket, _ = s.gptRecoveryStore.LoadTicket(ctx, identityKey)
+	}
+	if !validGPTRecoveryRoutingTicket(ticket, time.Now()) {
+		return nil
+	}
+	expected := make(http.Header)
+	setGPTRecoveryRoutingCookies(expected, ticket)
+	if gptRecoveryRoutingCookieDigest(expected) != gptRecoveryRoutingCookieDigest(headers) {
+		return nil
+	}
+	copy := *ticket
+	return func(dialCtx context.Context, requestHeaders, responseHeaders http.Header) {
+		// A delayed prewarm can have refreshed its ticket in HeadersFactory. Its
+		// actual handshake then belongs to that refreshed pair, not this snapshot.
+		if gptRecoveryRoutingCookieDigest(requestHeaders) != gptRecoveryRoutingCookieDigest(expected) {
+			if observer := s.gptRecoveryWSHandshakeObserver(dialCtx, account, requestHeaders); observer != nil {
+				observer(dialCtx, requestHeaders, responseHeaders)
+			}
+			return
+		}
+		s.observeGPTRecoveryTurnRouting(dialCtx, account, requestHeaders, responseHeaders, &copy, identityKey)
+	}
+}
+
+// Delayed pool prewarms must not replay cookies captured before expiry or an
+// identity change. Recheck their route at the actual dial, preserving turn-state.
+func (s *OpenAIGatewayService) refreshGPTRecoveryWSHeaders(ctx context.Context, account *Account, headers http.Header) http.Header {
+	if gptRecoveryRoutingCookieDigest(headers) == "" {
+		return headers
+	}
+	for name := range headers {
+		if strings.EqualFold(name, "cookie") {
+			delete(headers, name)
+		}
+	}
+	if account != nil && account.Proxy != nil {
+		s.applyGPTRecoveryRouting(ctx, account, headers, account.Proxy.URL())
+	}
+	return headers
+}
